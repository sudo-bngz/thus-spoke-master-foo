// Couches — Thus Spoke Master Foo, AI 02: layers. The line one scale
// cannot draw: Master Foo sets two scales on the pans of a third. One
// neuron is one line, and the opposite corners beat it; two neurons draw
// two lines and each answers one question; a third neuron takes their
// answers as its inputs and fires only between the lines: a band, two
// lines joined. A layer. More neurons, any shape; more layers, shapes of
// shapes: deep. Master Foo speaks Japanese, translated in the captions.

use "scenes/koan.alea"
use "scenes/problem.alea"
use "scenes/lines.alea"
use "scenes/band.alea"
use "scenes/shapes.alea"

work Couches {
  let total = 150.5
  let T = t * total
  let EN = "../voices/narrator.sh"
  let JA = "../voices/master.sh"

  // ── the voices: the master, in Japanese; the one who explains, in English ──
  let m1 = say("弟子は尋ねた。一つの秤で引けない線は、どうすれば引けますか。", at: 1.50, engine: JA, voice: "jm_kumo", speed: 0.82, gain: 2.3)
  let m2 = say("師は、秤をもう二つ持ってきて、三つ目の秤の皿に載せた。", at: m1.end + 1.4, engine: JA, voice: "jm_kumo", speed: 0.82, gain: 2.3)
  let n1 = say("Last time: one neuron is one straight line. It fires on one side, and stays quiet on the other.", at: 19.40, engine: EN, voice: "af_heart", speed: 1.0, gain: 2.3)
  let n2 = say("And this problem beat it: the full points in opposite corners. Whichever way the line turns, two points are on the wrong side.", at: n1.end + 1.4, engine: EN, voice: "af_heart", speed: 1.0, gain: 2.3)
  let n3 = say("The way out is not a better line. It is more neurons.", at: n2.end + 1.4, engine: EN, voice: "af_heart", speed: 1.0, gain: 2.3)
  let n4 = say("Take two neurons, each with its own weights. Each one draws its own line.", at: 41.50, engine: EN, voice: "af_heart", speed: 1.0, gain: 2.3)
  let n5 = say("Neuron A fires above its line.", at: n4.end + 1.4, engine: EN, voice: "af_heart", speed: 1.0, gain: 2.3)
  let n6 = say("Neuron B fires below its own.", at: n5.end + 1.4, engine: EN, voice: "af_heart", speed: 1.0, gain: 2.3)
  let n7 = say("Each one answers a single question: which side of my line are you on? Yes, or no.", at: n6.end + 1.4, engine: EN, voice: "af_heart", speed: 1.0, gain: 2.3)
  let n8 = say("Now look at the full points. For both of them, A says yes, and B says yes.", at: n7.end + 1.4, engine: EN, voice: "af_heart", speed: 1.0, gain: 2.3)
  let n9 = say("For the hollow ones, one of the two says no.", at: n8.end + 1.4, engine: EN, voice: "af_heart", speed: 1.0, gain: 2.3)
  let n10 = say("Add a third neuron, C. Its inputs are not the point. Its inputs are the answers of A and B.", at: 71.70, engine: EN, voice: "af_heart", speed: 1.0, gain: 2.3)
  let n11 = say("Give it a threshold that needs both answers to be yes. Then it fires only between the two lines.", at: n10.end + 1.4, engine: EN, voice: "af_heart", speed: 1.0, gain: 2.3)
  let n12 = say("Its decision is no longer a line. It is a band: two lines, joined. The full points inside, the hollow ones outside.", at: n11.end + 1.4, engine: EN, voice: "af_heart", speed: 1.0, gain: 2.3)
  let n13 = say("This is a layer: neurons working side by side, and feeding the next one. The problem that beat one neuron falls to three.", at: n12.end + 1.4, engine: EN, voice: "af_heart", speed: 1.0, gain: 2.3)
  let n14 = say("More neurons in the layer: more lines. And the shape they enclose can be any shape you like.", at: 104.20, engine: EN, voice: "af_heart", speed: 1.0, gain: 2.3)
  let n15 = say("More layers: shapes made of shapes. Edges, then corners, then faces.", at: n14.end + 1.4, engine: EN, voice: "af_heart", speed: 1.0, gain: 2.3)
  let n16 = say("That is what deep means, in deep learning: many layers, one after the other.", at: n15.end + 1.4, engine: EN, voice: "af_heart", speed: 1.0, gain: 2.3)
  let n17 = say("One question remains. The three scales must learn their weights together. How does a mistake at the end reach the first scale? Next time.", at: n16.end + 1.4, engine: EN, voice: "af_heart", speed: 1.0, gain: 2.3)
  let m3 = say("弟子は見た。三つの秤が、曲がった線を一本引いた。", at: 132.70, engine: JA, voice: "jm_kumo", speed: 0.82, gain: 2.3)
  let m4 = say("師は言った。秤の上に秤。それが、深さだ。", at: m3.end + 1.4, engine: JA, voice: "jm_kumo", speed: 0.82, gain: 2.3)
  let m5 = say("その時、弟子は悟った。", at: m4.end + 1.6, engine: JA, voice: "jm_kumo", speed: 0.82, gain: 2.3)

  // ── the scenes: ink on paper, a vermilion accent, under the captions ──
  let PAPER = ["#efe9dc", "#d3c9b4", "#3b352c", "#17140f"]
  let fit(piece) = zoom(piece, by: 0.82, x: 0.5, y: 0.66)
  let ink(piece, accent) = overlay(paint(fit(piece), palette: PAPER, range: [0, 1]), paint(fit(accent), palette: ["#000000", "#c23b22"], range: [0, 1], alpha: fit(accent)))
  let reel = timeline([
      scene(ink(Koan(draw0: ((m1.start) - 0.00) / 17.9, draw1: ((m1.end) - 0.00) / 17.9, word: ((m2.end + 0.8) - 0.00) / 17.9, title: ((m2.end + 1.0) - 0.00) / 17.9, kana: ["レ", "イ", "ヤ", "ー"], episode: "AI 02  ·  layers", accent: 0), Koan(draw0: ((m1.start) - 0.00) / 17.9, draw1: ((m1.end) - 0.00) / 17.9, word: ((m2.end + 0.8) - 0.00) / 17.9, title: ((m2.end + 1.0) - 0.00) / 17.9, kana: ["レ", "イ", "ヤ", "ー"], episode: "AI 02  ·  layers", accent: 1)), 17.9),  wipe(0.8, angle: 0, softness: 0.12),
      scene(ink(Problem(show: ((n1.start - 0.8) - 17.90) / 22.1, line0: ((n1.words[3]) - 17.90) / 22.1, turn0: ((n2.words[12]) - 17.90) / 22.1, wrong0: ((n2.words[17]) - 17.90) / 22.1, accent: 0), Problem(show: ((n1.start - 0.8) - 17.90) / 22.1, line0: ((n1.words[3]) - 17.90) / 22.1, turn0: ((n2.words[12]) - 17.90) / 22.1, wrong0: ((n2.words[17]) - 17.90) / 22.1, accent: 1)), 22.1),  pixels(0.6, size: 0.05),
      scene(ink(Lines(net0: ((n4.start - 0.8) - 40.00) / 30.2, a0: ((n5.words[1]) - 40.00) / 30.2, b0: ((n6.words[1]) - 40.00) / 30.2, each0: ((n7.words[6]) - 40.00) / 30.2, full0: ((n8.words[3]) - 40.00) / 30.2, hollow0: ((n9.words[2]) - 40.00) / 30.2, accent: 0), Lines(net0: ((n4.start - 0.8) - 40.00) / 30.2, a0: ((n5.words[1]) - 40.00) / 30.2, b0: ((n6.words[1]) - 40.00) / 30.2, each0: ((n7.words[6]) - 40.00) / 30.2, full0: ((n8.words[3]) - 40.00) / 30.2, hollow0: ((n9.words[2]) - 40.00) / 30.2, accent: 1)), 30.2),  wipe(0.7, angle: 90, softness: 0.1),
      scene(ink(Band(c0: ((n10.words[2]) - 70.20) / 32.5, both0: ((n11.words[5]) - 70.20) / 32.5, band0: ((n12.words[8]) - 70.20) / 32.5, layer0: ((n13.words[3]) - 70.20) / 32.5, accent: 0), Band(c0: ((n10.words[2]) - 70.20) / 32.5, both0: ((n11.words[5]) - 70.20) / 32.5, band0: ((n12.words[8]) - 70.20) / 32.5, layer0: ((n13.words[3]) - 70.20) / 32.5, accent: 1)), 32.5),  morph(0.8, amount: 0.15),
      scene(ink(Shapes(lines0: ((n14.words[4]) - 102.70) / 28.5, lines1: ((n14.words[9]) - 102.70) / 28.5, fill0: ((n14.words[12]) - 102.70) / 28.5, deep0: ((n15.words[1]) - 102.70) / 28.5, accent: 0), Shapes(lines0: ((n14.words[4]) - 102.70) / 28.5, lines1: ((n14.words[9]) - 102.70) / 28.5, fill0: ((n14.words[12]) - 102.70) / 28.5, deep0: ((n15.words[1]) - 102.70) / 28.5, accent: 1)), 28.5),  wipe(0.8, angle: 180, softness: 0.12),
      scene(ink(Koan(draw0: ((m3.start) - 131.20) / 19.3, draw1: ((m5.end) - 131.20) / 19.3, word: ((m5.start + 0.5) - 131.20) / 19.3, title: ((m5.end + 0.6) - 131.20) / 19.3, kana: ["レ", "イ", "ヤ", "ー"], episode: "AI 02  ·  layers", accent: 0), Koan(draw0: ((m3.start) - 131.20) / 19.3, draw1: ((m5.end) - 131.20) / 19.3, word: ((m5.start + 0.5) - 131.20) / 19.3, title: ((m5.end + 0.6) - 131.20) / 19.3, kana: ["レ", "イ", "ヤ", "ー"], episode: "AI 02  ·  layers", accent: 1)), 19.3),  morph(1.2, amount: 0.2),
  ], loop: 1)

  // ── over it: the series, the step, the captions (the master's, translated, in vermilion) ──
  let adv = 0.021722
  let header = merge(text("1 / 4   the problem", x: 0.06, y: -0.15, size: 0.03, font: "mono", align: "left") * (reel.index > 1 - 0.5) * (reel.index < 1 + 0.5), text("2 / 4   two neurons", x: 0.06, y: -0.15, size: 0.03, font: "mono", align: "left") * (reel.index > 2 - 0.5) * (reel.index < 2 + 0.5), text("3 / 4   the third neuron", x: 0.06, y: -0.15, size: 0.03, font: "mono", align: "left") * (reel.index > 3 - 0.5) * (reel.index < 3 + 0.5), text("4 / 4   deeper", x: 0.06, y: -0.15, size: 0.03, font: "mono", align: "left") * (reel.index > 4 - 0.5) * (reel.index < 4 + 0.5)) * 0.7
  let series = text("thus spoke master foo  ·  AI 02", x: 0.94, y: -0.3, size: 0.024, font: "mono", align: "right") * 0.45
  let c_m1 = merge(text("The novice asked: the line 1", x: 0.06, y: -0.060, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - m1.start) / (m1.duration * 0.92), 0, 1) * 64) - 0, 0, 28) * adv), text("scale cannot draw, how is it", x: 0.06, y: -0.008, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - m1.start) / (m1.duration * 0.92), 0, 1) * 64) - 29, 0, 28) * adv), text("drawn?", x: 0.06, y: 0.044, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - m1.start) / (m1.duration * 0.92), 0, 1) * 64) - 58, 0, 6) * adv)) * (T >= m1.start) * (T < min(m1.end + 1.5, m2.start))
  let c_m2 = merge(text("Master Foo brought 2 more scales,", x: 0.06, y: -0.060, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - m2.start) / (m2.duration * 0.92), 0, 1) * 68) - 0, 0, 33) * adv), text("and set them on the pans of a", x: 0.06, y: -0.008, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - m2.start) / (m2.duration * 0.92), 0, 1) * 68) - 34, 0, 29) * adv), text("3rd.", x: 0.06, y: 0.044, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - m2.start) / (m2.duration * 0.92), 0, 1) * 68) - 64, 0, 4) * adv)) * (T >= m2.start) * (T < min(m2.end + 1.5, n1.start))
  let c_n1 = merge(text("Last time: 1 neuron is 1 straight", x: 0.06, y: -0.060, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - n1.start) / (n1.duration * 0.92), 0, 1) * 89) - 0, 0, 33) * adv), text("line. It fires on 1 side, and", x: 0.06, y: -0.008, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - n1.start) / (n1.duration * 0.92), 0, 1) * 89) - 34, 0, 29) * adv), text("stays quiet on the other.", x: 0.06, y: 0.044, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - n1.start) / (n1.duration * 0.92), 0, 1) * 89) - 64, 0, 25) * adv)) * (T >= n1.start) * (T < min(n1.end + 1.5, n2.start))
  let c_n2 = merge(text("And this problem beat it: the", x: 0.06, y: -0.060, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - n2.start) / (n2.duration * 0.92), 0, 1) * 124) - 0, 0, 29) * adv), text("full points in opposite corners.", x: 0.06, y: -0.008, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - n2.start) / (n2.duration * 0.92), 0, 1) * 124) - 30, 0, 32) * adv), text("Whichever way the line turns, 2", x: 0.06, y: 0.044, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - n2.start) / (n2.duration * 0.92), 0, 1) * 124) - 63, 0, 31) * adv), text("points are on the wrong side.", x: 0.06, y: 0.096, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - n2.start) / (n2.duration * 0.92), 0, 1) * 124) - 95, 0, 29) * adv)) * (T >= n2.start) * (T < min(n2.end + 1.5, n3.start))
