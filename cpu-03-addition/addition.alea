// Addition — Thus Spoke Master Foo, CPU 03: the first thing worth
// building. 1 + 1 = 10; the half adder, XOR for the sum and AND for the
// carry, its table computed; the full adder with the carry in, 8 cases
// computed, 2 half adders and an OR inside; 4 of them chained, the
// carries rippling right to left, 5 + 7 added column by column; and
// subtraction with the same adder, 2's complement. Master Foo speaks
// Japanese, translated in the captions.

use "scenes/koan.alea"
use "scenes/half.alea"
use "scenes/full.alea"
use "scenes/ripple.alea"
use "scenes/minus.alea"

work Addition {
  let total = 160.1
  let T = t * total
  let EN = "../voices/narrator.sh"
  let JA = "../voices/master.sh"

  // ── the voices: the master, in Japanese; the one who explains, in English ──
  let m1 = say("弟子は尋ねた。機械は、数を数えられるのですか。", at: 1.50, engine: JA, voice: "jm_kumo", speed: 0.82, gain: 2.3)
  let m2 = say("師は言った。1と1を足してみよ。", at: m1.end + 1.4, engine: JA, voice: "jm_kumo", speed: 0.82, gain: 2.3)
  let m3 = say("弟子は答えた。2です。師は言った。機械には、2という数字はない。", at: m2.end + 1.4, engine: JA, voice: "jm_kumo", speed: 0.82, gain: 2.3)
  let n1 = say("In binary, one plus one is not two. There is no digit two. One plus one is one zero: zero, and carry one. Just like nine plus one is ten.", at: 22.50, engine: EN, voice: "af_heart", speed: 1.0, gain: 2.3)
  let n2 = say("So adding two bits gives two answers: the sum, and the carry. Zero and zero. Zero and one. One and zero. One and one. The sum is on when exactly one input is on: exclusive or.", at: n1.end + 1.4, engine: EN, voice: "af_heart", speed: 1.0, gain: 2.3)
  let n3 = say("The carry is on when both are on: AND. Two gates from last time, and we have a half adder.", at: n2.end + 1.4, engine: EN, voice: "af_heart", speed: 1.0, gain: 2.3)
  let n4 = say("Half, because a real column has three things to add: the two bits, and the carry coming in from the right.", at: 53.50, engine: EN, voice: "af_heart", speed: 1.0, gain: 2.3)
  let n5 = say("Three inputs: eight cases. The sum is on when an odd number of them are on. The carry, when at least two are on.", at: n4.end + 1.4, engine: EN, voice: "af_heart", speed: 1.0, gain: 2.3)
  let n6 = say("Two half adders and an OR gate do it. That is a full adder: one column of an addition, in five gates.", at: n5.end + 1.4, engine: EN, voice: "af_heart", speed: 1.0, gain: 2.3)
  let n7 = say("Now chain four of them. Each column passes its carry to the next, right to left, like you learned at school.", at: 77.60, engine: EN, voice: "af_heart", speed: 1.0, gain: 2.3)
  let n8 = say("Five plus seven. Zero one zero one, plus zero one one one. Watch the carry ripple.", at: n7.end + 1.4, engine: EN, voice: "af_heart", speed: 1.0, gain: 2.3)
  let n9 = say("Right column: one plus one, zero, carry one. Next: zero plus one plus the carry, zero, carry one. Next: one plus one plus one: one, carry one. Last: zero plus zero plus one: one.", at: n8.end + 1.4, engine: EN, voice: "af_heart", speed: 1.0, gain: 2.3)
  let n10 = say("One one zero zero: twelve. That is a ripple adder. Twenty gates, and it adds. The first piece of our machine.", at: n9.end + 1.4, engine: EN, voice: "af_heart", speed: 1.0, gain: 2.3)
  let n11 = say("And subtracting? No new circuit. Seven minus five. Take five: zero one zero one. Flip every bit: one zero one zero. Add one: one zero one one.", at: 115.10, engine: EN, voice: "af_heart", speed: 1.0, gain: 2.3)
  let n12 = say("Now add that to seven. Zero one one one plus one zero one one: one zero zero one zero. The fifth bit falls off the end. Zero zero one zero: two.", at: n11.end + 1.4, engine: EN, voice: "af_heart", speed: 1.0, gain: 2.3)
  let n13 = say("Two's complement: the same adder subtracts. Next time: how a wire remembers.", at: n12.end + 1.4, engine: EN, voice: "af_heart", speed: 1.0, gain: 2.3)
  let m4 = say("師は言った。1と1で、10。それだけを知る機械が、", at: 145.00, engine: JA, voice: "jm_kumo", speed: 0.82, gain: 2.3)
  let m5 = say("すべての数を足す。", at: m4.end + 1.4, engine: JA, voice: "jm_kumo", speed: 0.82, gain: 2.3)
  let m6 = say("その時、弟子は悟った。", at: m5.end + 1.6, engine: JA, voice: "jm_kumo", speed: 0.82, gain: 2.3)

  // ── the scenes: ink on paper, a vermilion accent, under the captions ──
  let PAPER = ["#efe9dc", "#d3c9b4", "#3b352c", "#17140f"]
  let fit(piece) = zoom(piece, by: 0.82, x: 0.5, y: 0.66)
  let ink(piece, accent) = overlay(paint(fit(piece), palette: PAPER, range: [0, 1]), paint(fit(accent), palette: ["#000000", "#c23b22"], range: [0, 1], alpha: fit(accent)))
  let reel = timeline([
