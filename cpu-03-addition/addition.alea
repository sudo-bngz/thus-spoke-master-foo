      scene(ink(Full(box0: ((n4.words[5]) - 52.00) / 24.1, cases0: ((n5.words[0]) - 52.00) / 24.1, cycle: 0.3734, inside0: ((n6.words[0]) - 52.00) / 24.1, accent: 0), Full(box0: ((n4.words[5]) - 52.00) / 24.1, cases0: ((n5.words[0]) - 52.00) / 24.1, cycle: 0.3734, inside0: ((n6.words[0]) - 52.00) / 24.1, accent: 1)), 24.1),  wipe(0.7, angle: 90, softness: 0.1),
      scene(ink(Ripple(draw0: ((n7.words[2]) - 76.10) / 37.5, nums0: ((n8.words[0]) - 76.10) / 37.5, steps: [((n9.words[0]) - 76.10) / 37.5, ((n9.words[7]) - 76.10) / 37.5, ((n9.words[16]) - 76.10) / 37.5, ((n9.words[25]) - 76.10) / 37.5], value0: ((n10.words[0]) - 76.10) / 37.5, accent: 0), Ripple(draw0: ((n7.words[2]) - 76.10) / 37.5, nums0: ((n8.words[0]) - 76.10) / 37.5, steps: [((n9.words[0]) - 76.10) / 37.5, ((n9.words[7]) - 76.10) / 37.5, ((n9.words[16]) - 76.10) / 37.5, ((n9.words[25]) - 76.10) / 37.5], value0: ((n10.words[0]) - 76.10) / 37.5, accent: 1)), 37.5),  morph(0.8, amount: 0.15),
      scene(ink(Minus(q0: ((n11.words[0]) - 113.60) / 29.9, five0: ((n11.words[8]) - 113.60) / 29.9, flip0: ((n11.words[14]) - 113.60) / 29.9, plus0: ((n11.words[22]) - 113.60) / 29.9, add0: ((n12.words[0]) - 113.60) / 29.9, drop0: ((n12.words[16]) - 113.60) / 29.9, result0: ((n12.words[25]) - 113.60) / 29.9, accent: 0), Minus(q0: ((n11.words[0]) - 113.60) / 29.9, five0: ((n11.words[8]) - 113.60) / 29.9, flip0: ((n11.words[14]) - 113.60) / 29.9, plus0: ((n11.words[22]) - 113.60) / 29.9, add0: ((n12.words[0]) - 113.60) / 29.9, drop0: ((n12.words[16]) - 113.60) / 29.9, result0: ((n12.words[25]) - 113.60) / 29.9, accent: 1)), 29.9),  wipe(0.8, angle: 180, softness: 0.12),
      scene(ink(Koan(draw0: ((m4.start) - 143.50) / 16.6, draw1: ((m6.end) - 143.50) / 16.6, word: ((m6.start + 0.5) - 143.50) / 16.6, title: ((m6.end + 0.6) - 143.50) / 16.6, kana: ["タ", "シ", "ザ", "ン"], episode: "CPU 03  ·  addition", accent: 0), Koan(draw0: ((m4.start) - 143.50) / 16.6, draw1: ((m6.end) - 143.50) / 16.6, word: ((m6.start + 0.5) - 143.50) / 16.6, title: ((m6.end + 0.6) - 143.50) / 16.6, kana: ["タ", "シ", "ザ", "ン"], episode: "CPU 03  ·  addition", accent: 1)), 16.6),  morph(1.2, amount: 0.2),
  ], loop: 1)

  // ── over it: the series, the step, the captions (the master's, translated, in vermilion) ──
