  let c_n9 = merge(text("Right column: 1 + 1, 0, carry 1.", x: 0.06, y: -0.060, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - n9.start) / (n9.duration * 0.92), 0, 1) * 118) - 0, 0, 32) * adv), text("Next: 0 + 1 + the carry, 0, carry", x: 0.06, y: -0.008, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - n9.start) / (n9.duration * 0.92), 0, 1) * 118) - 33, 0, 33) * adv), text("1. Next: 1 + 1 + 1: 1, carry 1.", x: 0.06, y: 0.044, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - n9.start) / (n9.duration * 0.92), 0, 1) * 118) - 67, 0, 31) * adv), text("Last: 0 + 0 + 1: 1.", x: 0.06, y: 0.096, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - n9.start) / (n9.duration * 0.92), 0, 1) * 118) - 99, 0, 19) * adv)) * (T >= n9.start) * (T < min(n9.end + 1.5, n10.start))
  let c_n10 = merge(text("1100: 12. That is a ripple adder.", x: 0.06, y: -0.060, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - n10.start) / (n10.duration * 0.92), 0, 1) * 88) - 0, 0, 33) * adv), text("20 gates, and it adds. The first", x: 0.06, y: -0.008, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - n10.start) / (n10.duration * 0.92), 0, 1) * 88) - 34, 0, 32) * adv), text("piece of our machine.", x: 0.06, y: 0.044, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - n10.start) / (n10.duration * 0.92), 0, 1) * 88) - 67, 0, 21) * adv)) * (T >= n10.start) * (T < min(n10.end + 1.5, n11.start))
  let c_n11 = merge(text("And subtracting? No new circuit.", x: 0.06, y: -0.060, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - n11.start) / (n11.duration * 0.92), 0, 1) * 88) - 0, 0, 32) * adv), text("7 - 5. Take 5: 0101. Flip every", x: 0.06, y: -0.008, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - n11.start) / (n11.duration * 0.92), 0, 1) * 88) - 33, 0, 31) * adv), text("bit: 1010. Add 1: 1011.", x: 0.06, y: 0.044, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - n11.start) / (n11.duration * 0.92), 0, 1) * 88) - 65, 0, 23) * adv)) * (T >= n11.start) * (T < min(n11.end + 1.5, n12.start))
  let c_n12 = merge(text("Now add that to 7. 0111 + 1011:", x: 0.06, y: -0.060, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - n12.start) / (n12.duration * 0.92), 0, 1) * 78) - 0, 0, 31) * adv), text("10010. The 5th bit falls off the", x: 0.06, y: -0.008, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - n12.start) / (n12.duration * 0.92), 0, 1) * 78) - 32, 0, 32) * adv), text("end. 0010: 2.", x: 0.06, y: 0.044, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - n12.start) / (n12.duration * 0.92), 0, 1) * 78) - 65, 0, 13) * adv)) * (T >= n12.start) * (T < min(n12.end + 1.5, n13.start))
  let c_n13 = merge(text("2's complement: the same adder", x: 0.06, y: -0.060, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - n13.start) / (n13.duration * 0.92), 0, 1) * 74) - 0, 0, 30) * adv), text("subtracts. Next time: how a wire", x: 0.06, y: -0.008, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - n13.start) / (n13.duration * 0.92), 0, 1) * 74) - 31, 0, 32) * adv), text("remembers.", x: 0.06, y: 0.044, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - n13.start) / (n13.duration * 0.92), 0, 1) * 74) - 64, 0, 10) * adv)) * (T >= n13.start) * (T < min(n13.end + 1.5, m4.start))
  let c_m4 = merge(text("Master Foo said: 1 and 1 make 10.", x: 0.06, y: -0.060, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - m4.start) / (m4.duration * 0.92), 0, 1) * 64) - 0, 0, 33) * adv), text("A machine that knows only that", x: 0.06, y: -0.008, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - m4.start) / (m4.duration * 0.92), 0, 1) * 64) - 34, 0, 30) * adv)) * (T >= m4.start) * (T < min(m4.end + 1.5, m5.start))
  let c_m5 = text("adds every number there is.", x: 0.06, y: -0.060, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - m5.start) / (m5.duration * 0.92), 0, 1) * 27) - 0, 0, 27) * adv) * (T >= m5.start) * (T < min(m5.end + 1.5, m6.start))
  let c_m6 = text("And the novice was enlightened.", x: 0.06, y: -0.060, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - m6.start) / (m6.duration * 0.92), 0, 1) * 31) - 0, 0, 31) * adv) * (T >= m6.start) * (T < m6.end + 3)
  let said = merge(c_n1, c_n2, c_n3, c_n4, c_n5, c_n6, c_n7, c_n8, c_n9, c_n10, c_n11, c_n12, c_n13)
  let spoken = merge(c_m1, c_m2, c_m3, c_m4, c_m5, c_m6)
  let dark = paint(merge(header, series, said), palette: ["#000000", "#1a1712"], range: [0, 1], alpha: merge(header, series, said))
  let red  = paint(spoken, palette: ["#000000", "#b8361f"], range: [0, 1], alpha: spoken)
  let look = film(vignette(overlay(reel, dark, red), amount: 0.06), amount: 0.035)

  // ── the sound ──
  let pad = synth {
    let env = adsr(attack: 3, decay: 1, sustain: 0.9, release: 4)
    lowpass(saw(note.freq) + saw(note.freq * 1.003) + sine(note.freq * 0.5), cutoff: 260 + 300 * note.level, resonance: 0.2) * env
  }
  let brush = synth { bandpass(noise(), cutoff: 1400, resonance: 0.3) * adsr(attack: 0.12, decay: 0.3, sustain: 0.3, release: 0.5) * note.velocity }
  let tick = synth { highpass(noise(), cutoff: 4000, resonance: 0.2) * perc(release: 0.015) * note.velocity + sine(note.freq) * perc(release: 0.05) * 0.4 }
  let knock = synth { lowpass(noise(), cutoff: 700, resonance: 0.5) * perc(attack: 0.002, release: 0.12) * note.velocity + sine(note.freq) * perc(release: 0.1) * 0.5 }
  let chord = synth {
    let env = adsr(attack: 0.3, decay: 0.6, sustain: 0.8, release: 2.5)
    chorus(lowpass(saw(note.freq) + saw(note.freq * 1.004) + sine(note.freq * 0.5), cutoff: 1200, resonance: 0.15) * env, depth: 0.6)
  }
  // the temple bell when the master speaks; the question
  pattern bells = repeat 2 event(t: [m1.start - 1.0, m4.start - 1.0][i] / total, x: 0.5, y: 0.95, size: 0.12, intensity: 0.9)
  pattern asked = repeat 1 event(t: (m2.start + 0.85 * m2.duration) / total, x: 0.5, y: 0.5, size: 0.06, intensity: 0.8)
  // 1 + 1; the rows; the 2 gates cycling
  pattern oneone = repeat 1 event(t: n1.words[9] / total, x: 0.5, y: 0.3, size: 0.1, intensity: 0.7)
  pattern hrows = repeat 4 event(t: [n2.words[12], n2.words[15], n2.words[18], n2.words[21]][i] / total, x: 0.4, y: 0.63 + 0.07 * i, size: 0.04, intensity: 0.5)
  pattern hcases = repeat 4 event(t: (n3.words[8] + 0.05 * 31.0 + 1.5 * i) / total, x: 0.14, y: 1.12, size: 0.03, intensity: 0.4)
  // the 8 cases of the full adder
  pattern fcases = repeat 8 event(t: (n5.words[0] + 9.0 * (i / 8)) / total, x: 0.2, y: 0.55, size: 0.03, intensity: 0.35)
  pattern inside = repeat 3 event(t: (n6.words[0] + 0.03 * 24.1 * i) / total, x: 0.3 + 0.22 * i, y: 1.05, size: 0.05, intensity: 0.5)
  // the 4 columns, right to left; the value
  pattern columns = repeat 4 event(t: [n9.words[0], n9.words[7], n9.words[16], n9.words[25]][i] / total, x: 0.8 - 0.2 * i, y: 0.66, size: 0.08, intensity: 0.6 + 0.1 * i)
  pattern carries = repeat 3 event(t: ([n9.words[0], n9.words[7], n9.words[16]][i] + 0.05 * 37.5) / total, x: 0.7 - 0.2 * i, y: 0.66, size: 0.03, intensity: 0.5)
  pattern twelve = repeat 1 event(t: n10.words[0] / total, x: 0.5, y: 0.98, size: 0.1, intensity: 0.8)
  // the rows of the subtraction; the dropped bit; the result
  pattern mrows = repeat 5 event(t: [n11.words[8], n11.words[14], n11.words[22], n12.words[0], n12.words[0] + 0.06 * 29.9][i] / total, x: 0.6, y: 0.48 + 0.08 * i, size: 0.04, intensity: 0.45)
  pattern dropped = repeat 1 event(t: n12.words[16] / total, x: 0.45, y: 1.04, size: 0.04, intensity: 0.6)
  pattern two = repeat 1 event(t: n12.words[25] / total, x: 0.5, y: 1.22, size: 0.1, intensity: 0.8)

  let music = [
    m1, m2, m3, n1, n2, n3, n4, n5, n6, n7, n8, n9, n10, n11, n12, n13, m4, m5, m6,
    drone(0.45 + 0.15 * lfo(3) + x * 0, voices: 2, instrument: pad, scale: "hirajoshi", key: 55, gain: 0.9),
    notes(bells, instrument: "bell", scale: "hirajoshi", key: 110, gain: 0.7),
    notes(asked, instrument: "kalimba", scale: "hirajoshi", key: 392, gain: 0.6),
    notes(oneone, instrument: "glass", scale: "hirajoshi", key: 523, gain: 0.5),
    notes(hrows, instrument: "wood", scale: "hirajoshi", key: 330, gain: 0.45),
    notes(hcases, instrument: tick, scale: "hirajoshi", key: 880, gain: 0.3),
    notes(fcases, instrument: tick, scale: "hirajoshi", key: 880, gain: 0.3),
    notes(inside, instrument: "kalimba", scale: "hirajoshi", key: 392, gain: 0.45),
    notes(columns, instrument: "kalimba", scale: "hirajoshi", key: 262, gain: 0.5),
    notes(carries, instrument: "glass", scale: "hirajoshi", key: 784, gain: 0.4),
    notes(twelve, instrument: chord, scale: "major", key: 110, gain: 0.45),
    notes(mrows, instrument: "wood", scale: "hirajoshi", key: 330, gain: 0.4),
    notes(dropped, instrument: knock, scale: "hirajoshi", key: 165, gain: 0.6),
    notes(two, instrument: chord, scale: "major", key: 110, gain: 0.45),
    notes(reel.cues, instrument: brush, scale: "chromatic", key: 100, gain: 0.3),
  ]

  render image(look, width: 1080, height: 1920, at: 0.6744)
  render video(look, fps: 30, width: 1080, height: 1920, sound: music, room: 0.12, echo: 0)
}
