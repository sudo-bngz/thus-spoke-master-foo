// Minus — subtraction with the same adder: flip every bit of the number
// to subtract, add 1, then add; the 5th bit dropped. 7 - 5, in rows of
// bits appearing at their moments. `accent: 1` gives only the flipped
// bits and the result. Times are the scene's own (0 to 1). What it
// returns: 0 paper, up to 1 ink.

work Minus(q0 = 0.05, five0 = 0.2, flip0 = 0.3, plus0 = 0.4, add0 = 0.6, drop0 = 0.75, result0 = 0.85, accent = 0) {
  let bits(v, xx, yy, shown, tone) = merge([merge(text("0", xx + 0.05 * k, yy, 0.036, 0, "mono") * (1 - floor(v / 2 ^ (3 - k)) % 2), text("1", xx + 0.05 * k, yy, 0.036, 0, "mono") * (floor(v / 2 ^ (3 - k)) % 2)) for k in range(4)]) * tone * shown
  let x0 = 0.5
  let q = text("7 - 5 ?", 0.5, 0.3, 0.06, 0, "mono") * smoothstep(q0, q0 + 0.04, t)
  let r1 = 0.48
  let five = merge(text("5", 0.26, r1, 0.03, 0, "mono", "right") * 0.6, bits(5, x0, r1, 1, 0.85)) * smoothstep(five0, five0 + 0.04, t)
  let flipped = merge(text("flipped", 0.26, r1 + 0.08, 0.03, 0, "mono", "right") * 0.6, bits(10, x0, r1 + 0.08, 1, 0.85)) * smoothstep(flip0, flip0 + 0.04, t)
  let plusone = merge(text("+ 1", 0.26, r1 + 0.16, 0.03, 0, "mono", "right") * 0.6, bits(11, x0, r1 + 0.16, 1, 0.85)) * smoothstep(plus0, plus0 + 0.04, t)
  let r2 = 0.86
  let seven = merge(text("7", 0.26, r2, 0.03, 0, "mono", "right") * 0.6, bits(7, x0, r2, 1, 0.85)) * smoothstep(add0, add0 + 0.04, t)
  let addrow = merge(text("+", 0.26, r2 + 0.08, 0.03, 0, "mono", "right") * 0.6, bits(11, x0, r2 + 0.08, 1, 0.85), line(x0 - 0.03, r2 + 0.13, x0 + 0.18, r2 + 0.13, 0.003, 0.002) * 0.5) * smoothstep(add0 + 0.06, add0 + 0.1, t)
  let fifth = text("1", x0 - 0.05, r2 + 0.18, 0.036, 0, "mono") * 0.85 * smoothstep(add0 + 0.12, add0 + 0.16, t) * (1 - 0.8 * smoothstep(drop0, drop0 + 0.04, t))
  let dropline = line(x0 - 0.08, r2 + 0.18, x0 - 0.02, r2 + 0.18, 0.004, 0.002) * smoothstep(drop0, drop0 + 0.04, t)
  let result = bits(2, x0, r2 + 0.18, 1, 1) * smoothstep(add0 + 0.12, add0 + 0.16, t)
  let dropped = text("the 5th bit falls off the end", 0.5, r2 + 0.26, 0.024, 0, "mono") * 0.55 * smoothstep(drop0, drop0 + 0.04, t)
  let two = text("= 2", 0.5, r2 + 0.36, 0.06, 0, "mono") * smoothstep(result0, result0 + 0.04, t)
  let twos = text("2's complement: the same adder subtracts", 0.5, r2 + 0.46, 0.026, 0, "mono") * 0.7 * smoothstep(result0 + 0.08, result0 + 0.12, t)
  output accent * merge(bits(10, x0, r1 + 0.08, 1, 1) * smoothstep(flip0, flip0 + 0.04, t) * (1 - smoothstep(plus0, plus0 + 0.04, t)), result * smoothstep(drop0, drop0 + 0.04, t), two) + (1 - accent) * merge(q, five, flipped, plusone, seven, addrow, fifth, dropline, result * (1 - smoothstep(drop0, drop0 + 0.04, t)), dropped, twos)
}
