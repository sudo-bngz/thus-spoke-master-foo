// Switch — a switch and a lamp: open, or closed; 0, or 1. The blade
// swings closed at `close0`, open again at `open0`; the lamp lights when
// it is closed, closed again at `close1`; then the names, and the bit. `accent: 1` gives only the
// lamp. Times are the scene's own (0 to 1). What it returns: 0 paper,
// up to 1 ink.

work Switch(draw0 = 0.05, close0 = 0.3, open0 = 0.45, close1 = 0.7, names0 = 0.6, bit0 = 0.8, accent = 0) {
  let shown = smoothstep(draw0, draw0 + 0.06, t)
  let cy = 0.62
  // the circuit: a loop with the switch at the top and the lamp at the right
  let closed = clamp(smoothstep(close0, close0 + 0.05, t) * (1 - smoothstep(open0, open0 + 0.05, t)) + smoothstep(close1, close1 + 0.05, t), 0, 1)
  let wires = merge(line(0.2, cy - 0.2, 0.38, cy - 0.2, 0.004, 0.002), line(0.62, cy - 0.2, 0.8, cy - 0.2, 0.004, 0.002),
                    line(0.8, cy - 0.2, 0.8, cy + 0.12, 0.004, 0.002), line(0.8, cy + 0.2, 0.8, cy + 0.3, 0.004, 0.002),
                    line(0.2, cy + 0.3, 0.8, cy + 0.3, 0.004, 0.002), line(0.2, cy - 0.2, 0.2, cy + 0.3, 0.004, 0.002)) * 0.6 * shown
  let battery = merge(line(0.45, cy + 0.26, 0.45, cy + 0.34, 0.006, 0.002), line(0.49, cy + 0.28, 0.49, cy + 0.32, 0.004, 0.002)) * 0.6 * shown
  let batterygap = rect(0.47, cy + 0.3, 0.06, 0.02, 0, 0.001)
  // the switch: a pivot at the left, a blade that swings
  let ang = -32 * (1 - closed)
  let blade = merge(circle(0.38, cy - 0.2, 0.01, 0.002), line(0.38, cy - 0.2, 0.38 + 0.24 * cos(ang * tau / 360), cy - 0.2 + 0.24 * sin(ang * tau / 360), 0.006, 0.002), circle(0.62, cy - 0.2, 0.01, 0.002)) * 0.85 * shown
  // the lamp
  let lamp = merge(cut(circle(0.8, cy + 0.16, 0.05, 0.002), circle(0.8, cy + 0.16, 0.044, 0.002)) * 0.7, line(0.78, cy + 0.14, 0.82, cy + 0.18, 0.004, 0.002) * 0.4, line(0.82, cy + 0.14, 0.78, cy + 0.18, 0.004, 0.002) * 0.4) * shown
  let lit = glow(x: 0.8, y: cy + 0.16, size: 0.12) * closed
  // the names
  let ns = smoothstep(names0, names0 + 0.04, t)
  let name = merge(text("open", 0.5, cy - 0.32, 0.034, 0, "mono") * (1 - closed), text("closed", 0.5, cy - 0.32, 0.034, 0, "mono") * closed) * 0.8 * shown
  let digit = merge(text("0", 0.5, cy + 0.02, 0.1, 0, "mono") * (1 - closed), text("1", 0.5, cy + 0.02, 0.1, 0, "mono") * closed) * ns
  let between = text("nothing in between", 0.5, cy + 0.42, 0.026, 0, "mono") * 0.55 * smoothstep(names0 + 0.1, names0 + 0.14, t)
  let bit = text("1 switch  ·  1 bit  ·  2 possibilities", 0.5, cy + 0.52, 0.03, 0, "mono") * 0.75 * smoothstep(bit0, bit0 + 0.04, t)
  output accent * lit + (1 - accent) * merge(cut(wires, batterygap), battery, blade, lamp, name, digit, between, bit)
}
