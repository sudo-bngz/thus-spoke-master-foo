 / (n13.ends[0] - n13.words[0]), 0, 1) * 11 + clamp((T - n13.words[1]) / (n13.ends[1] - n13.words[1]), 0, 1) * 5 + clamp((T - n13.words[2]) / (n13.ends[2] - n13.words[2]), 0, 1) * 3 + clamp((T - n13.words[3]) / (n13.ends[3] - n13.words[3]), 0, 1) * 5 + clamp((T - n13.words[4]) / (n13.ends[4] - n13.words[4]), 0, 1) * 7 + clamp((T - n13.words[5]) / (n13.ends[5] - n13.words[5]), 0, 1) * 3 + clamp((T - n13.words[6]) / (n13.ends[6] - n13.words[6]), 0, 1) * 6 + clamp((T - n13.words[7]) / (n13.ends[7] - n13.words[7]), 0, 1) * 5 + clamp((T - n13.words[8]) / (n13.ends[8] - n13.words[8]), 0, 1) * 6 + clamp((T - n13.words[9]) / (n13.ends[9] - n13.words[9]), 0, 1) * 2 + clamp((T - n13.words[10]) / (n13.ends[10] - n13.words[10]), 0, 1) * 8 + clamp((T - n13.words[11]) / (n13.ends[11] - n13.words[11]), 0, 1) * 2 + clamp((T - n13.words[12]) / (n13.ends[12] - n13.words[12]), 0, 1) * 5 + clamp((T - n13.words[13]) / (n13.ends[13] - n13.words[13]), 0, 1) * 2 + clamp((T - n13.words[14]) / (n13.ends[14] - n13.words[14]), 0, 1) * 4 + clamp((T - n13.words[15]) / (n13.ends[15] - n13.words[15]), 0, 1) * 3 + clamp((T - n13.words[16]) / (n13.ends[16] - n13.words[16]), 0, 1) * 6 + clamp((T - n13.words[17]) / (n13.ends[17] - n13.words[17]), 0, 1) * 5 + clamp((T - n13.words[18]) / (n13.ends[18] - n13.words[18]), 0, 1) * 6 + clamp((T - n13.words[19]) / (n13.ends[19] - n13.words[19]), 0, 1) * 7 + clamp((T - n13.words[20]) / (n13.ends[20] - n13.words[20]), 0, 1) * 2 + clamp((T - n13.words[21]) / (n13.ends[21] - n13.words[21]), 0, 1) * 7 + clamp((T - n13.words[22]) / (n13.ends[22] - n13.words[22]), 0, 1) * 2 + clamp((T - n13.words[23]) / (n13.ends[23] - n13.words[23]), 0, 1) * 10 + clamp((T - n13.words[24]) / (n13.ends[24] - n13.words[24]), 0, 1) * 6) - 68, 0, 32) * adv), text("a switch a question. Logic.", x: 0.06, y: 0.096, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - n13.words[0]) / (n13.ends[0] - n13.words[0]), 0, 1) * 11 + clamp((T - n13.words[1]) / (n13.ends[1] - n13.words[1]), 0, 1) * 5 + clamp((T - n13.words[2]) / (n13.ends[2] - n13.words[2]), 0, 1) * 3 + clamp((T - n13.words[3]) / (n13.ends[3] - n13.words[3]), 0, 1) * 5 + clamp((T - n13.words[4]) / (n13.ends[4] - n13.words[4]), 0, 1) * 7 + clamp((T - n13.words[5]) / (n13.ends[5] - n13.words[5]), 0, 1) * 3 + clamp((T - n13.words[6]) / (n13.ends[6] - n13.words[6]), 0, 1) * 6 + clamp((T - n13.words[7]) / (n13.ends[7] - n13.words[7]), 0, 1) * 5 + clamp((T - n13.words[8]) / (n13.ends[8] - n13.words[8]), 0, 1) * 6 + clamp((T - n13.words[9]) / (n13.ends[9] - n13.words[9]), 0, 1) * 2 + clamp((T - n13.words[10]) / (n13.ends[10] - n13.words[10]), 0, 1) * 8 + clamp((T - n13.words[11]) / (n13.ends[11] - n13.words[11]), 0, 1) * 2 + clamp((T - n13.words[12]) / (n13.ends[12] - n13.words[12]), 0, 1) * 5 + clamp((T - n13.words[13]) / (n13.ends[13] - n13.words[13]), 0, 1) * 2 + clamp((T - n13.words[14]) / (n13.ends[14] - n13.words[14]), 0, 1) * 4 + clamp((T - n13.words[15]) / (n13.ends[15] - n13.words[15]), 0, 1) * 3 + clamp((T - n13.words[16]) / (n13.ends[16] - n13.words[16]), 0, 1) * 6 + clamp((T - n13.words[17]) / (n13.ends[17] - n13.words[17]), 0, 1) * 5 + clamp((T - n13.words[18]) / (n13.ends[18] - n13.words[18]), 0, 1) * 6 + clamp((T - n13.words[19]) / (n13.ends[19] - n13.words[19]), 0, 1) * 7 + clamp((T - n13.words[20]) / (n13.ends[20] - n13.words[20]), 0, 1) * 2 + clamp((T - n13.words[21]) / (n13.ends[21] - n13.words[21]), 0, 1) * 7 + clamp((T - n13.words[22]) / (n13.ends[22] - n13.words[22]), 0, 1) * 2 + clamp((T - n13.words[23]) / (n13.ends[23] - n13.words[23]), 0, 1) * 10 + clamp((T - n13.words[24]) / (n13.ends[24] - n13.words[24]), 0, 1) * 6) - 101, 0, 27) * adv)) * (T >= n13.start) * (T < min(n13.end + 1.5, m4.start))
  let c_m4 = merge(text("Master Foo said: 1 switch knows 2", x: 0.06, y: -0.060, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - m4.start) / (m4.duration * 0.92), 0, 1) * 41) - 0, 0, 33) * adv), text("things.", x: 0.06, y: -0.008, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - m4.start) / (m4.duration * 0.92), 0, 1) * 41) - 34, 0, 7) * adv)) * (T >= m4.start) * (T < min(m4.end + 1.5, m5.start))
  let c_m5 = text("64 switches know the world.", x: 0.06, y: -0.060, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - m5.start) / (m5.duration * 0.92), 0, 1) * 27) - 0, 0, 27) * adv) * (T >= m5.start) * (T < min(m5.end + 1.5, m6.start))
  let c_m6 = text("And the novice was enlightened.", x: 0.06, y: -0.060, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - m6.start) / (m6.duration * 0.92), 0, 1) * 31) - 0, 0, 31) * adv) * (T >= m6.start) * (T < m6.end + 3)
  let said = merge(c_n1, c_n2, c_n3, c_n4, c_n5, c_n6, c_n7, c_n8, c_n9, c_n10, c_n11, c_n12, c_n13)
  let spoken = merge(c_m1, c_m2, c_m3, c_m4, c_m5, c_m6)
  let dark = paint(merge(header, series, said), palette: ["#000000", "#1a1712"], range: [0, 1], alpha: merge(header, series, said))
  let red  = paint(spoken, palette: ["#000000", "#b8361f"], range: [0, 1], alpha: spoken)
  let look = film(vignette(overlay(reel, dark, red), amount: 0.06), amount: 0.035)

  // ── the sound ──
  let pad = synth {
    let env = adsr(attack: 3, decay: 1, sustain: 0.9, release: 4)
    lowpass(saw(note.freq) + saw(note.freq * 1.003) + sine(note.freq * 0.5), cutoff: 260 + 300 * note.level, resonance: 0.2) * env
  }
  let brush = synth { bandpass(noise(), cutoff: 1400, resonance: 0.3) * adsr(attack: 0.12, decay: 0.3, sustain: 0.3, release: 0.5) * note.velocity }
  let tick = synth { highpass(noise(), cutoff: 4000, resonance: 0.2) * perc(release: 0.015) * note.velocity + sine(note.freq) * perc(release: 0.05) * 0.4 }
  let knock = synth { lowpass(noise(), cutoff: 700, resonance: 0.5) * perc(attack: 0.002, release: 0.12) * note.velocity + sine(note.freq) * perc(release: 0.1) * 0.5 }
  let chord = synth {
    let env = adsr(attack: 0.3, decay: 0.6, sustain: 0.8, release: 2.5)
    chorus(lowpass(saw(note.freq) + saw(note.freq * 1.004) + sine(note.freq * 0.5), cutoff: 1200, resonance: 0.15) * env, depth: 0.6)
  }
  // the temple bell when the master speaks; the question
  pattern bells = repeat 2 event(t: [m1.start - 1.0, m4.start - 1.0][i] / total, x: 0.5, y: 0.95, size: 0.12, intensity: 0.9)
  pattern asked = repeat 1 event(t: (m2.start + 0.85 * m2.duration) / total, x: 0.5, y: 0.5, size: 0.06, intensity: 0.8)
  // the switch closing, opening, closing; the lamp
  pattern clicks = repeat 3 event(t: [n1.words[13], n1.words[16], n2.words[4]][i] / total, x: 0.5, y: 0.42, size: 0.04, intensity: 0.8)
  pattern lamp = repeat 2 event(t: ([n1.words[13], n2.words[4]][i] + 0.04 * 23.0) / total, x: 0.8, y: 0.78, size: 0.1, intensity: 0.5)
  // the dial marks; the needle trembling; the switch
  pattern marks = repeat 10 event(t: (n4.words[6] + 0.06 * 27.2 * (i / 10)) / total, x: 0.3 + 0.04 * i, y: 0.4, intensity: 0.3)
  pattern tremble = repeat 16 event(t: (n5.words[7] + 0.3 * 27.2 * (i / 16)) / total, x: ~between(0.4, 0.6), y: 0.45, size: 0.02, intensity: 0.2)
  pattern certain = repeat 1 event(t: n5.words[19] / total, x: 0.5, y: 0.93, size: 0.06, intensity: 0.8)
  // the 4 squares; the worths; the examples; the run of 16
  pattern squares = repeat 4 event(t: (n7.words[6] + 0.01 * 31.6 * i) / total, x: 0.26 + 0.16 * i, y: 0.58, size: 0.05, intensity: 0.5)
  pattern worths = repeat 4 event(t: (n8.words[3] + 0.04 * 31.6 * i) / total, x: 0.74 - 0.16 * i, y: 0.46, size: 0.04, intensity: 0.5 + 0.1 * i)
  pattern examples = repeat 4 event(t: [n9.words[0], n9.words[6], n9.words[12], n9.words[18]][i] / total, x: 0.5, y: 0.84, size: 0.06, intensity: 0.6)
  pattern sixteen = repeat 16 event(t: (n10.words[7] + 6.4 * (i / 16)) / total, x: 0.26 + 0.48 * (i % 4) / 3, y: 0.58, size: 0.03, intensity: 0.3 + 0.4 * (i / 16))
  // the byte; the word
  pattern eight = repeat 8 event(t: (n11.words[0] + 0.01 * 26.2 * i) / total, x: 0.18 + 0.09 * i, y: 0.42, intensity: 0.3)
  pattern sixtyfour = repeat 64 event(t: (n12.words[0] + 0.003 * 26.2 * i) / total, x: 0.12 + 0.76 * (i % 32) / 31, y: 0.76 + 0.035 * floor(i / 32), intensity: 0.15)
  pattern big = repeat 1 event(t: (n12.words[0] + 0.26 * 26.2) / total, x: 0.5, y: 0.92, size: 0.2, intensity: 0.6)

  let music = [
    m1, m2, m3, n1, n2, n3, n4, n5, n6, n7, n8, n9, n10, n11, n12, n13, m4, m5, m6,
    drone(0.45 + 0.15 * lfo(3) + x * 0, voices: 2, instrument: pad, scale: "hirajoshi", key: 55, gain: 0.9),
    notes(bells, instrument: "bell", scale: "hirajoshi", key: 110, gain: 0.7),
    notes(asked, instrument: "kalimba", scale: "hirajoshi", key: 392, gain: 0.6),
    notes(clicks, instrument: knock, scale: "hirajoshi", key: 220, gain: 0.7),
    notes(lamp, instrument: "glass", scale: "hirajoshi", key: 659, gain: 0.5),
    notes(marks, instrument: tick, scale: "hirajoshi", key: 880, gain: 0.3),
    notes(tremble, instrument: tick, scale: "hirajoshi", key: 1320, gain: 0.15),
    notes(certain, instrument: knock, scale: "hirajoshi", key: 220, gain: 0.7),
    notes(squares, instrument: "wood", scale: "hirajoshi", key: 330, gain: 0.45),
    notes(worths, instrument: "kalimba", scale: "hirajoshi", key: 262, gain: 0.5),
    notes(examples, instrument: "glass", scale: "hirajoshi", key: 523, gain: 0.5),
    notes(sixteen, instrument: "kalimba", scale: "hirajoshi", key: 392, gain: 0.4),
    notes(eight, instrument: tick, scale: "hirajoshi", key: 880, gain: 0.3),
    notes(sixtyfour, instrument: tick, scale: "hirajoshi", key: 1320, gain: 0.15),
    notes(big, instrument: chord, scale: "major", key: 110, gain: 0.4),
    notes(reel.cues, instrument: brush, scale: "chromatic", key: 100, gain: 0.3),
  ]

  render image(look, width: 1080, height: 1920, at: 0.6826)
  render video(look, fps: 30, width: 1080, height: 1920, sound: music, room: 0.12, echo: 0)
}
