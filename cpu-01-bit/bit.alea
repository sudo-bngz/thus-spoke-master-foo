  let c_n8 = merge(text("The rightmost bit counts 1. The", x: 0.06, y: -0.060, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - n8.start) / (n8.duration * 0.92), 0, 1) * 96) - 0, 0, 31) * adv), text("next, 2. Then 4. Then 8. Each bit", x: 0.06, y: -0.008, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - n8.start) / (n8.duration * 0.92), 0, 1) * 96) - 32, 0, 33) * adv), text("is worth twice the one before.", x: 0.06, y: 0.044, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - n8.start) / (n8.duration * 0.92), 0, 1) * 96) - 66, 0, 30) * adv)) * (T >= n8.start) * (T < min(n8.end + 1.5, n9.start))
