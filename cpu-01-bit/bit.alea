// Bit — Thus Spoke Master Foo, CPU 01: what a computer is made of. A
// switch, open or closed, 0 or 1, nothing in between: a bit. Why 2 and
// not 10: a dial with 10 positions and a trembling needle, a switch that
// is never ambiguous. Counting with 4 switches, each worth twice the one
// before, the 16 numbers computed from the bits. The byte, the 64-bit
// word, and the row of bits everything else is built from. Master Foo
// speaks Japanese, translated in the captions.

use "scenes/koan.alea"
use "scenes/switch.alea"
use "scenes/two.alea"
use "scenes/count.alea"
use "scenes/byte.alea"

work Bit {
  let total = 147.0
  let T = t * total
  let EN = "../voices/narrator.sh"
  let JA = "../voices/master.sh"

  // ── the voices: the master, in Japanese; the one who explains, in English ──
  let m1 = say("弟子は尋ねた。機械は、どれだけのことを知っているのですか。", at: 1.50, engine: JA, voice: "jm_kumo", speed: 0.82, gain: 2.3)
  let m2 = say("師は言った。2つだけだ。入か、切か。", at: m1.end + 1.4, engine: JA, voice: "jm_kumo", speed: 0.82, gain: 2.3)
  let m3 = say("弟子は言った。たった2つ？ 師は言った。では、2つ同時に聞け。", at: m2.end + 1.4, engine: JA, voice: "jm_kumo", speed: 0.82, gain: 2.3)
  let n1 = say("A computer is made of switches. A switch has two positions: open, or closed. Current flows, or it does not.", at: 23.20, engine: EN, voice: "af_heart", speed: 1.0, gain: 2.3)
  let n2 = say("Call them zero and one. Nothing in between. A half-open switch does not exist.", at: n1.end + 1.4, engine: EN, voice: "af_heart", speed: 1.0, gain: 2.3)
  let n3 = say("That is a bit: the smallest thing a computer can hold. One switch, one bit, two possibilities.", at: n2.end + 1.4, engine: EN, voice: "af_heart", speed: 1.0, gain: 2.3)
  let n4 = say("Why not ten, like our fingers? Ten positions would need a switch that is a little open, more open, almost closed.", at: 46.20, engine: EN, voice: "af_heart", speed: 1.0, gain: 2.3)
  let n5 = say("A little open and more open are hard to tell apart, especially when the signal is weak, or noisy. Open or closed is never ambiguous.", at: n4.end + 1.4, engine: EN, voice: "af_heart", speed: 1.0, gain: 2.3)
  let n6 = say("So the machine uses the dumbest switch there is, and asks it many times. Billions of switches, each one certain.", at: n5.end + 1.4, engine: EN, voice: "af_heart", speed: 1.0, gain: 2.3)
  let n7 = say("How do you count with switches? Line up four. Each one is a bit. Read them together, as a number.", at: 73.40, engine: EN, voice: "af_heart", speed: 1.0, gain: 2.3)
  let n8 = say("The rightmost bit counts one. The next, two. Then four. Then eight. Each bit is worth twice the one before.", at: n7.end + 1.4, engine: EN, voice: "af_heart", speed: 1.0, gain: 2.3)
  let n9 = say("Zero zero zero zero is zero. Zero zero zero one is one. Zero zero one zero is two. One zero one one: eight plus two plus one, eleven.", at: n8.end + 1.4, engine: EN, voice: "af_heart", speed: 1.0, gain: 2.3)
  let n10 = say("Four bits: sixteen numbers, zero to fifteen. Watch them all.", at: n9.end + 1.4, engine: EN, voice: "af_heart", speed: 1.0, gain: 2.3)
  let n11 = say("Eight bits: two hundred fifty-six numbers. That is a byte. One letter, one small number, one shade of grey.", at: 105.00, engine: EN, voice: "af_heart", speed: 1.0, gain: 2.3)
  let n12 = say("A word today is sixty-four bits. That is eighteen billion billion possibilities, in one row of switches.", at: n11.end + 1.4, engine: EN, voice: "af_heart", speed: 1.0, gain: 2.3)
  let n13 = say("Everything else in this series is built from this: a switch, a bit, a row of bits. Next time: asking a switch a question. Logic.", at: n12.end + 1.4, engine: EN, voice: "af_heart", speed: 1.0, gain: 2.3)
  let m4 = say("師は言った。1つのスイッチは、2つを知る。", at: 131.20, engine: JA, voice: "jm_kumo", speed: 0.82, gain: 2.3)
  let m5 = say("64のスイッチは、世界を知る。", at: m4.end + 1.4, engine: JA, voice: "jm_kumo", speed: 0.82, gain: 2.3)
  let m6 = say("その時、弟子は悟った。", at: m5.end + 1.6, engine: JA, voice: "jm_kumo", speed: 0.82, gain: 2.3)

  // ── the scenes: ink on paper, a vermilion accent, under the captions ──
  let PAPER = ["#efe9dc", "#d3c9b4", "#3b352c", "#17140f"]
  let fit(piece) = zoom(piece, by: 0.82, x: 0.5, y: 0.66)
  let ink(piece, accent) = overlay(paint(fit(piece), palette: PAPER, range: [0, 1]), paint(fit(accent), palette: ["#000000", "#c23b22"], range: [0, 1], alpha: fit(accent)))
  let reel = timeline([
      scene(ink(Koan(draw0: ((m1.start) - 0.00) / 21.7, draw1: ((m1.end) - 0.00) / 21.7, word: ((m3.end + 0.8) - 0.00) / 21.7, title: ((m3.end + 1.0) - 0.00) / 21.7, kana: ["ビ", "ッ", "ト"], episode: "CPU 01  ·  bit", accent: 0), Koan(draw0: ((m1.start) - 0.00) / 21.7, draw1: ((m1.end) - 0.00) / 21.7, word: ((m3.end + 0.8) - 0.00) / 21.7, title: ((m3.end + 1.0) - 0.00) / 21.7, kana: ["ビ", "ッ", "ト"], episode: "CPU 01  ·  bit", accent: 1)), 21.7),  wipe(0.8, angle: 0, softness: 0.12),
      scene(ink(Switch(draw0: ((n1.words[6]) - 21.70) / 23.0, close0: ((n1.words[13]) - 21.70) / 23.0, open0: ((n1.words[16]) - 21.70) / 23.0, close1: ((n2.words[4]) - 21.70) / 23.0, names0: ((n2.words[2]) - 21.70) / 23.0, bit0: ((n3.words[9]) - 21.70) / 23.0, accent: 0), Switch(draw0: ((n1.words[6]) - 21.70) / 23.0, close0: ((n1.words[13]) - 21.70) / 23.0, open0: ((n1.words[16]) - 21.70) / 23.0, close1: ((n2.words[4]) - 21.70) / 23.0, names0: ((n2.words[2]) - 21.70) / 23.0, bit0: ((n3.words[9]) - 21.70) / 23.0, accent: 1)), 23.0),  pixels(0.6, size: 0.05),
      scene(ink(Two(dial0: ((n4.words[6]) - 44.70) / 27.2, noise0: ((n5.words[7]) - 44.70) / 27.2, switch0: ((n5.words[19]) - 44.70) / 27.2, many0: ((n6.words[13]) - 44.70) / 27.2, accent: 0), Two(dial0: ((n4.words[6]) - 44.70) / 27.2, noise0: ((n5.words[7]) - 44.70) / 27.2, switch0: ((n5.words[19]) - 44.70) / 27.2, many0: ((n6.words[13]) - 44.70) / 27.2, accent: 1)), 27.2),  wipe(0.7, angle: 90, softness: 0.1),
      scene(ink(Count(line0: ((n7.words[6]) - 71.90) / 31.6, worth0: ((n8.words[3]) - 71.90) / 31.6, showat: [((n9.words[0]) - 71.90) / 31.6, ((n9.words[6]) - 71.90) / 31.6, ((n9.words[12]) - 71.90) / 31.6, ((n9.words[18]) - 71.90) / 31.6], run0: ((n10.words[7]) - 71.90) / 31.6, run1: ((n10.words[7] + 6.4) - 71.90) / 31.6, accent: 0), Count(line0: ((n7.words[6]) - 71.90) / 31.6, worth0: ((n8.words[3]) - 71.90) / 31.6, showat: [((n9.words[0]) - 71.90) / 31.6, ((n9.words[6]) - 71.90) / 31.6, ((n9.words[12]) - 71.90) / 31.6, ((n9.words[18]) - 71.90) / 31.6], run0: ((n10.words[7]) - 71.90) / 31.6, run1: ((n10.words[7] + 6.4) - 71.90) / 31.6, accent: 1)), 31.6),  morph(0.8, amount: 0.15),
      scene(ink(Byte(byte0: ((n11.words[0]) - 103.50) / 26.2, word0: ((n12.words[0]) - 103.50) / 26.2, built0: ((n13.words[7]) - 103.50) / 26.2, accent: 0), Byte(byte0: ((n11.words[0]) - 103.50) / 26.2, word0: ((n12.words[0]) - 103.50) / 26.2, built0: ((n13.words[7]) - 103.50) / 26.2, accent: 1)), 26.2),  wipe(0.8, angle: 180, softness: 0.12),
      scene(ink(Koan(draw0: ((m4.start) - 129.70) / 17.3, draw1: ((m6.end) - 129.70) / 17.3, word: ((m6.start + 0.5) - 129.70) / 17.3, title: ((m6.end + 0.6) - 129.70) / 17.3, kana: ["ビ", "ッ", "ト"], episode: "CPU 01  ·  bit", accent: 0), Koan(draw0: ((m4.start) - 129.70) / 17.3, draw1: ((m6.end) - 129.70) / 17.3, word: ((m6.start + 0.5) - 129.70) / 17.3, title: ((m6.end + 0.6) - 129.70) / 17.3, kana: ["ビ", "ッ", "ト"], episode: "CPU 01  ·  bit", accent: 1)), 17.3),  morph(1.2, amount: 0.2),
  ], loop: 1)

  // ── over it: the series, the step, the captions (the master's, translated, in vermilion) ──
  let adv = 0.021722
  let header = merge(text("1 / 4   the switch", x: 0.06, y: -0.15, size: 0.03, font: "mono", align: "left") * (reel.index > 1 - 0.5) * (reel.index < 1 + 0.5), text("2 / 4   why two", x: 0.06, y: -0.15, size: 0.03, font: "mono", align: "left") * (reel.index > 2 - 0.5) * (reel.index < 2 + 0.5), text("3 / 4   counting", x: 0.06, y: -0.15, size: 0.03, font: "mono", align: "left") * (reel.index > 3 - 0.5) * (reel.index < 3 + 0.5), text("4 / 4   the byte", x: 0.06, y: -0.15, size: 0.03, font: "mono", align: "left") * (reel.index > 4 - 0.5) * (reel.index < 4 + 0.5)) * 0.7
  let series = text("thus spoke master foo  ·  CPU 01", x: 0.94, y: -0.3, size: 0.024, font: "mono", align: "right") * 0.45
  let c_m1 = merge(text("The novice asked: how much does", x: 0.06, y: -0.060, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - m1.start) / (m1.duration * 0.92), 0, 1) * 49) - 0, 0, 31) * adv), text("the machine know?", x: 0.06, y: -0.008, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - m1.start) / (m1.duration * 0.92), 0, 1) * 49) - 32, 0, 17) * adv)) * (T >= m1.start) * (T < min(m1.end + 1.5, m2.start))
  let c_m2 = merge(text("Master Foo said: 2 things only.", x: 0.06, y: -0.060, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - m2.start) / (m2.duration * 0.92), 0, 1) * 43) - 0, 0, 31) * adv), text("On, or off.", x: 0.06, y: -0.008, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - m2.start) / (m2.duration * 0.92), 0, 1) * 43) - 32, 0, 11) * adv)) * (T >= m2.start) * (T < min(m2.end + 1.5, m3.start))
  let c_m3 = merge(text("The novice said: only 2? Master", x: 0.06, y: -0.060, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - m3.start) / (m3.duration * 0.92), 0, 1) * 73) - 0, 0, 31) * adv), text("Foo said: then ask it 2 things at", x: 0.06, y: -0.008, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - m3.start) / (m3.duration * 0.92), 0, 1) * 73) - 32, 0, 33) * adv), text("a time.", x: 0.06, y: 0.044, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - m3.start) / (m3.duration * 0.92), 0, 1) * 73) - 66, 0, 7) * adv)) * (T >= m3.start) * (T < min(m3.end + 1.5, n1.start))
  let c_n1 = merge(text("A computer is made of switches. A", x: 0.06, y: -0.060, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - n1.start) / (n1.duration * 0.92), 0, 1) * 105) - 0, 0, 33) * adv), text("switch has 2 positions: open, or", x: 0.06, y: -0.008, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - n1.start) / (n1.duration * 0.92), 0, 1) * 105) - 34, 0, 32) * adv), text("closed. Current flows, or it does", x: 0.06, y: 0.044, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - n1.start) / (n1.duration * 0.92), 0, 1) * 105) - 67, 0, 33) * adv), text("not.", x: 0.06, y: 0.096, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - n1.start) / (n1.duration * 0.92), 0, 1) * 105) - 101, 0, 4) * adv)) * (T >= n1.start) * (T < min(n1.end + 1.5, n2.start))
