// Algorithme — Thus Spoke Master Foo, 01: what is an algorithm? A novice
// asks; Master Foo hands him sixteen cards. An algorithm is a recipe: steps,
// in order, until the work is done. Two recipes sort the same cards: by
// insertion (each card slides left past the bigger ones) and by merging
// (pairs, then fours, eights, the whole deck); a counter adds up their
// comparisons, and for a thousand cards the difference is a large square
// against a small one. Every edition draws its own deck, so the cards, the
// counts and the music change: each card sounds its value, the comparisons
// tick down the cards they pass, and the merges sweep up in scales.
// Written by gen.py (the script and the timing); the scenes are in scenes/.

use "scenes/koan.alea"
use "scenes/recipe.alea"
use "scenes/insertion.alea"
use "scenes/merge.alea"
use "scenes/cost.alea"

work Algorithme {
  let total = 99.9
  let T = t * total
  let ENGINE = "../voices/kokoro.py"

  // ── the deck: sixteen cards, a value each, shuffled by the edition ──
  let N = 16
  let u = [~between(0, 1) for k in range(N)]
  let h = [(sum([u[j] < u[k] for j in range(N)]) + 1) / N for k in range(N)]

  // ── the voices: the master, and the one who explains ──
  let m1 = say("A novice asked Master Foo: what is an algorithm?", at: 1.40, engine: ENGINE, voice: "bm_george", speed: 0.88, gain: 2.3)
  let m2 = say("Master Foo shuffled sixteen cards, and said: sort them.", at: m1.end + 1.2, engine: ENGINE, voice: "bm_george", speed: 0.88, gain: 2.3)
  let n1 = say("An algorithm is a recipe.", at: 15.90, engine: ENGINE, voice: "af_heart", speed: 0.95, gain: 2.3)
  let n2 = say("Precise steps, followed in order, until the work is done.", at: n1.end + 0.8, engine: ENGINE, voice: "af_heart", speed: 0.95, gain: 2.3)
  let n3 = say("A computer does not understand them. It only follows them, very fast.", at: n2.end + 1.0, engine: ENGINE, voice: "af_heart", speed: 0.95, gain: 2.3)
  let n4 = say("Here is one, for the cards: take the next card, and slide it left, past every bigger one.", at: 32.90, engine: ENGINE, voice: "af_heart", speed: 0.95, gain: 2.3)
  let n5 = say("Each card is compared with the ones before it. Again, and again.", at: n4.end + 1.0, engine: ENGINE, voice: "af_heart", speed: 0.95, gain: 2.3)
  let n6 = say("Sorted. Count the comparisons.", at: n5.end + 2.6, engine: ENGINE, voice: "af_heart", speed: 0.95, gain: 2.3)
  let n7 = say("A second recipe: cut the deck in pairs, and sort each pair.", at: 51.20, engine: ENGINE, voice: "af_heart", speed: 0.95, gain: 2.3)
  let n8 = say("Then merge two sorted piles into one: only their top cards need comparing.", at: n7.end + 1.2, engine: ENGINE, voice: "af_heart", speed: 0.95, gain: 2.3)
  let n9 = say("Fours make eights, eights make sixteen. Sorted, with fewer comparisons.", at: n8.end + 1.2, engine: ENGINE, voice: "af_heart", speed: 0.95, gain: 2.3)
  let n10 = say("With sixteen cards, the difference is small.", at: 69.60, engine: ENGINE, voice: "af_heart", speed: 0.95, gain: 2.3)
  let n11 = say("With a thousand, the first recipe needs about a quarter of a million comparisons.", at: n10.end + 1.2, engine: ENGINE, voice: "af_heart", speed: 0.95, gain: 2.3)
  let n12 = say("The second, fewer than ten thousand.", at: n11.end + 0.8, engine: ENGINE, voice: "af_heart", speed: 0.95, gain: 2.3)
  let n13 = say("An algorithm is a way. Some ways are shorter.", at: n12.end + 1.6, engine: ENGINE, voice: "af_heart", speed: 0.95, gain: 2.3)
  let m3 = say("Then Master Foo shuffled a thousand cards.", at: 89.00, engine: ENGINE, voice: "bm_george", speed: 0.88, gain: 2.3)
  let m4 = say("And the novice was enlightened.", at: m3.end + 1.4, engine: ENGINE, voice: "bm_george", speed: 0.88, gain: 2.3)

  // ── the moments the pictures and the sounds follow ──
  // insertion: card k is taken from "take" until the end of the second sentence
  let ins0 = n4.words[6]
  let ins1 = n5.end - 0.4
  let insmove = (ins1 - ins0) / (N - 1) * 0.75
  let insat = [ins0 + (ins1 - ins0) * (k - 1) / (N - 2) for k in range(1, N)]
  // merging: the pairs on "sort", the piles on "merge", the eights and the deck on their words
  let mat = [n7.words[9], n8.words[1], n9.words[2], n9.words[5]]
  let mmove = 0.9

  // ── the scenes: ink on paper, a vermilion accent, under the captions ──
  let PAPER = ["#efe9dc", "#d3c9b4", "#3b352c", "#17140f"]
  let fit(piece) = zoom(piece, by: 0.82, x: 0.5, y: 0.66)
  let ink(piece, accent) = overlay(paint(fit(piece), palette: PAPER, range: [0, 1]), paint(fit(accent), palette: ["#000000", "#c23b22"], range: [0, 1], alpha: fit(accent)))
  // the counts, for the cost scene: the same sums the scenes make
  let bigger(k) = sum([(j < k) * (h[j] > h[k]) for j in range(N)])
  let inscount = sum([bigger(k) + (bigger(k) < k) for k in range(1, N)])
  let inb(j, B, b) = (floor(j / B) == b)
  let top(B, b) = maximum([h[j] * inb(j, B, b) for j in range(N)])
  let mcost(Lv) = sum([2 ^ Lv - sum([inb(j, 2 ^ Lv, b) * (h[j] > min(top(2 ^ (Lv - 1), 2 * b), top(2 ^ (Lv - 1), 2 * b + 1))) for j in range(N)]) for b in range(N / 2 ^ Lv)])
  let mcount = sum([mcost(Lv) for Lv in range(1, 5)])
  let reel = timeline([
      scene(ink(Koan(draw0: ((m1.words[0]) - 0.00) / 14.5, draw1: ((m1.end) - 0.00) / 14.5, word: ((m1.words[6]) - 0.00) / 14.5, title: ((m2.words[0]) - 0.00) / 14.5, accent: 0), Koan(draw0: ((m1.words[0]) - 0.00) / 14.5, draw1: ((m1.end) - 0.00) / 14.5, word: ((m1.words[6]) - 0.00) / 14.5, title: ((m2.words[0]) - 0.00) / 14.5, accent: 1)), 14.5),  wipe(0.8, angle: 0, softness: 0.12),
      scene(ink(Recipe(show: [((n2.words[0]) - 14.50) / 17.0, ((n2.words[1]) - 14.50) / 17.0, ((n2.words[3]) - 14.50) / 17.0, ((n2.words[5]) - 14.50) / 17.0], run0: ((n3.words[6]) - 14.50) / 17.0, run1: ((n3.end + 2.2) - 14.50) / 17.0, accent: 0), Recipe(show: [((n2.words[0]) - 14.50) / 17.0, ((n2.words[1]) - 14.50) / 17.0, ((n2.words[3]) - 14.50) / 17.0, ((n2.words[5]) - 14.50) / 17.0], run0: ((n3.words[6]) - 14.50) / 17.0, run1: ((n3.end + 2.2) - 14.50) / 17.0, accent: 1)), 17.0),  morph(0.8, amount: 0.15),
      scene(ink(Insertion(h: h, starts: [((s) - 31.50) / 18.3 for s in insat], move: insmove / 18.3, accent: 0), Insertion(h: h, starts: [((s) - 31.50) / 18.3 for s in insat], move: insmove / 18.3, accent: 1)), 18.3),  wipe(0.7, angle: 90, softness: 0.1),
      scene(ink(Merge(h: h, at: [((s) - 49.80) / 18.4 for s in mat], split: ((n7.words[3]) - 49.80) / 18.4, move: mmove / 18.4, accent: 0), Merge(h: h, at: [((s) - 49.80) / 18.4 for s in mat], split: ((n7.words[3]) - 49.80) / 18.4, move: mmove / 18.4, accent: 1)), 18.4),  morph(0.8, amount: 0.15),
      scene(ink(Cost(counts: [inscount, mcount], show16: ((n10.words[1]) - 68.20) / 19.4, grow1: ((n11.words[2]) - 68.20) / 19.4, grow2: ((n12.words[1]) - 68.20) / 19.4, span: 3.5 / 19.4, accent: 0), Cost(counts: [inscount, mcount], show16: ((n10.words[1]) - 68.20) / 19.4, grow1: ((n11.words[2]) - 68.20) / 19.4, grow2: ((n12.words[1]) - 68.20) / 19.4, span: 3.5 / 19.4, accent: 1)), 19.4),  wipe(0.8, angle: 180, softness: 0.12),
      scene(ink(Koan(draw0: ((m3.words[0]) - 87.60) / 12.3, draw1: ((m4.end) - 87.60) / 12.3, word: ((m3.words[2]) - 87.60) / 12.3, title: ((m4.end + 0.6) - 87.60) / 12.3, accent: 0), Koan(draw0: ((m3.words[0]) - 87.60) / 12.3, draw1: ((m4.end) - 87.60) / 12.3, word: ((m3.words[2]) - 87.60) / 12.3, title: ((m4.end + 0.6) - 87.60) / 12.3, accent: 1)), 12.3),  morph(1.2, amount: 0.2),
  ], loop: 1)

  // ── over it: the series, the step, the captions (the master's in vermilion) ──
  let adv = 0.021722
  let header = merge(text("1 / 4   the recipe", x: 0.06, y: -0.15, size: 0.03, font: "mono", align: "left") * (reel.index > 1 - 0.5) * (reel.index < 1 + 0.5), text("2 / 4   sorting by insertion", x: 0.06, y: -0.15, size: 0.03, font: "mono", align: "left") * (reel.index > 2 - 0.5) * (reel.index < 2 + 0.5), text("3 / 4   sorting by merging", x: 0.06, y: -0.15, size: 0.03, font: "mono", align: "left") * (reel.index > 3 - 0.5) * (reel.index < 3 + 0.5), text("4 / 4   the cost", x: 0.06, y: -0.15, size: 0.03, font: "mono", align: "left") * (reel.index > 4 - 0.5) * (reel.index < 4 + 0.5)) * 0.7
  let series = text("thus spoke master foo  ·  01", x: 0.94, y: -0.3, size: 0.024, font: "mono", align: "right") * 0.45
  let c_m1 = merge(text("A novice asked Master Foo: what", x: 0.06, y: -0.060, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - m1.words[0]) / (m1.ends[0] - m1.words[0]), 0, 1) * 2 + clamp((T - m1.words[1]) / (m1.ends[1] - m1.words[1]), 0, 1) * 7 + clamp((T - m1.words[2]) / (m1.ends[2] - m1.words[2]), 0, 1) * 6 + clamp((T - m1.words[3]) / (m1.ends[3] - m1.words[3]), 0, 1) * 7 + clamp((T - m1.words[4]) / (m1.ends[4] - m1.words[4]), 0, 1) * 5 + clamp((T - m1.words[5]) / (m1.ends[5] - m1.words[5]), 0, 1) * 5 + clamp((T - m1.words[6]) / (m1.ends[6] - m1.words[6]), 0, 1) * 3 + clamp((T - m1.words[7]) / (m1.ends[7] - m1.words[7]), 0, 1) * 3 + clamp((T - m1.words[8]) / (m1.ends[8] - m1.words[8]), 0, 1) * 10) - 0, 0, 31) * adv), text("is an algorithm?", x: 0.06, y: -0.008, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - m1.words[0]) / (m1.ends[0] - m1.words[0]), 0, 1) * 2 + clamp((T - m1.words[1]) / (m1.ends[1] - m1.words[1]), 0, 1) * 7 + clamp((T - m1.words[2]) / (m1.ends[2] - m1.words[2]), 0, 1) * 6 + clamp((T - m1.words[3]) / (m1.ends[3] - m1.words[3]), 0, 1) * 7 + clamp((T - m1.words[4]) / (m1.ends[4] - m1.words[4]), 0, 1) * 5 + clamp((T - m1.words[5]) / (m1.ends[5] - m1.words[5]), 0, 1) * 5 + clamp((T - m1.words[6]) / (m1.ends[6] - m1.words[6]), 0, 1) * 3 + clamp((T - m1.words[7]) / (m1.ends[7] - m1.words[7]), 0, 1) * 3 + clamp((T - m1.words[8]) / (m1.ends[8] - m1.words[8]), 0, 1) * 10) - 32, 0, 16) * adv)) * (T >= m1.start) * (T < min(m1.end + 1.5, m2.start))
  let c_m2 = merge(text("Master Foo shuffled sixteen", x: 0.06, y: -0.060, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - m2.words[0]) / (m2.ends[0] - m2.words[0]), 0, 1) * 7 + clamp((T - m2.words[1]) / (m2.ends[1] - m2.words[1]), 0, 1) * 4 + clamp((T - m2.words[2]) / (m2.ends[2] - m2.words[2]), 0, 1) * 9 + clamp((T - m2.words[3]) / (m2.ends[3] - m2.words[3]), 0, 1) * 8 + clamp((T - m2.words[4]) / (m2.ends[4] - m2.words[4]), 0, 1) * 7 + clamp((T - m2.words[5]) / (m2.ends[5] - m2.words[5]), 0, 1) * 4 + clamp((T - m2.words[6]) / (m2.ends[6] - m2.words[6]), 0, 1) * 6 + clamp((T - m2.words[7]) / (m2.ends[7] - m2.words[7]), 0, 1) * 5 + clamp((T - m2.words[8]) / (m2.ends[8] - m2.words[8]), 0, 1) * 5) - 0, 0, 27) * adv), text("cards, and said: sort them.", x: 0.06, y: -0.008, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - m2.words[0]) / (m2.ends[0] - m2.words[0]), 0, 1) * 7 + clamp((T - m2.words[1]) / (m2.ends[1] - m2.words[1]), 0, 1) * 4 + clamp((T - m2.words[2]) / (m2.ends[2] - m2.words[2]), 0, 1) * 9 + clamp((T - m2.words[3]) / (m2.ends[3] - m2.words[3]), 0, 1) * 8 + clamp((T - m2.words[4]) / (m2.ends[4] - m2.words[4]), 0, 1) * 7 + clamp((T - m2.words[5]) / (m2.ends[5] - m2.words[5]), 0, 1) * 4 + clamp((T - m2.words[6]) / (m2.ends[6] - m2.words[6]), 0, 1) * 6 + clamp((T - m2.words[7]) / (m2.ends[7] - m2.words[7]), 0, 1) * 5 + clamp((T - m2.words[8]) / (m2.ends[8] - m2.words[8]), 0, 1) * 5) - 28, 0, 27) * adv)) * (T >= m2.start) * (T < min(m2.end + 1.5, n1.start))
  let c_n1 = text("An algorithm is a recipe.", x: 0.06, y: -0.060, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - n1.words[0]) / (n1.ends[0] - n1.words[0]), 0, 1) * 3 + clamp((T - n1.words[1]) / (n1.ends[1] - n1.words[1]), 0, 1) * 10 + clamp((T - n1.words[2]) / (n1.ends[2] - n1.words[2]), 0, 1) * 3 + clamp((T - n1.words[3]) / (n1.ends[3] - n1.words[3]), 0, 1) * 2 + clamp((T - n1.words[4]) / (n1.ends[4] - n1.words[4]), 0, 1) * 7) - 0, 0, 25) * adv) * (T >= n1.start) * (T < min(n1.end + 1.5, n2.start))
  let c_n2 = merge(text("Precise steps, followed in order,", x: 0.06, y: -0.060, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - n2.words[0]) / (n2.ends[0] - n2.words[0]), 0, 1) * 8 + clamp((T - n2.words[1]) / (n2.ends[1] - n2.words[1]), 0, 1) * 7 + clamp((T - n2.words[2]) / (n2.ends[2] - n2.words[2]), 0, 1) * 9 + clamp((T - n2.words[3]) / (n2.ends[3] - n2.words[3]), 0, 1) * 3 + clamp((T - n2.words[4]) / (n2.ends[4] - n2.words[4]), 0, 1) * 7 + clamp((T - n2.words[5]) / (n2.ends[5] - n2.words[5]), 0, 1) * 6 + clamp((T - n2.words[6]) / (n2.ends[6] - n2.words[6]), 0, 1) * 4 + clamp((T - n2.words[7]) / (n2.ends[7] - n2.words[7]), 0, 1) * 5 + clamp((T - n2.words[8]) / (n2.ends[8] - n2.words[8]), 0, 1) * 3 + clamp((T - n2.words[9]) / (n2.ends[9] - n2.words[9]), 0, 1) * 5) - 0, 0, 33) * adv), text("until the work is done.", x: 0.06, y: -0.008, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - n2.words[0]) / (n2.ends[0] - n2.words[0]), 0, 1) * 8 + clamp((T - n2.words[1]) / (n2.ends[1] - n2.words[1]), 0, 1) * 7 + clamp((T - n2.words[2]) / (n2.ends[2] - n2.words[2]), 0, 1) * 9 + clamp((T - n2.words[3]) / (n2.ends[3] - n2.words[3]), 0, 1) * 3 + clamp((T - n2.words[4]) / (n2.ends[4] - n2.words[4]), 0, 1) * 7 + clamp((T - n2.words[5]) / (n2.ends[5] - n2.words[5]), 0, 1) * 6 + clamp((T - n2.words[6]) / (n2.ends[6] - n2.words[6]), 0, 1) * 4 + clamp((T - n2.words[7]) / (n2.ends[7] - n2.words[7]), 0, 1) * 5 + clamp((T - n2.words[8]) / (n2.ends[8] - n2.words[8]), 0, 1) * 3 + clamp((T - n2.words[9]) / (n2.ends[9] - n2.words[9]), 0, 1) * 5) - 34, 0, 23) * adv)) * (T >= n2.start) * (T < min(n2.end + 1.5, n3.start))
