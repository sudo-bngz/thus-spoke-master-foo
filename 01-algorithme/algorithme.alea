  let c_n13 = merge(text("An algorithm is a way. Some ways", x: 0.06, y: -0.060, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - n13.words[0]) / (n13.ends[0] - n13.words[0]), 0, 1) * 3 + clamp((T - n13.words[1]) / (n13.ends[1] - n13.words[1]), 0, 1) * 10 + clamp((T - n13.words[2]) / (n13.ends[2] - n13.words[2]), 0, 1) * 3 + clamp((T - n13.words[3]) / (n13.ends[3] - n13.words[3]), 0, 1) * 2 + clamp((T - n13.words[4]) / (n13.ends[4] - n13.words[4]), 0, 1) * 5 + clamp((T - n13.words[5]) / (n13.ends[5] - n13.words[5]), 0, 1) * 5 + clamp((T - n13.words[6]) / (n13.ends[6] - n13.words[6]), 0, 1) * 5 + clamp((T - n13.words[7]) / (n13.ends[7] - n13.words[7]), 0, 1) * 4 + clamp((T - n13.words[8]) / (n13.ends[8] - n13.words[8]), 0, 1) * 8) - 0, 0, 32) * adv), text("are shorter.", x: 0.06, y: -0.008, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - n13.words[0]) / (n13.ends[0] - n13.words[0]), 0, 1) * 3 + clamp((T - n13.words[1]) / (n13.ends[1] - n13.words[1]), 0, 1) * 10 + clamp((T - n13.words[2]) / (n13.ends[2] - n13.words[2]), 0, 1) * 3 + clamp((T - n13.words[3]) / (n13.ends[3] - n13.words[3]), 0, 1) * 2 + clamp((T - n13.words[4]) / (n13.ends[4] - n13.words[4]), 0, 1) * 5 + clamp((T - n13.words[5]) / (n13.ends[5] - n13.words[5]), 0, 1) * 5 + clamp((T - n13.words[6]) / (n13.ends[6] - n13.words[6]), 0, 1) * 5 + clamp((T - n13.words[7]) / (n13.ends[7] - n13.words[7]), 0, 1) * 4 + clamp((T - n13.words[8]) / (n13.ends[8] - n13.words[8]), 0, 1) * 8) - 33, 0, 12) * adv)) * (T >= n13.start) * (T < min(n13.end + 1.5, m3.start))
  let c_m3 = merge(text("Then Master Foo shuffled a", x: 0.06, y: -0.060, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - m3.words[0]) / (m3.ends[0] - m3.words[0]), 0, 1) * 5 + clamp((T - m3.words[1]) / (m3.ends[1] - m3.words[1]), 0, 1) * 7 + clamp((T - m3.words[2]) / (m3.ends[2] - m3.words[2]), 0, 1) * 4 + clamp((T - m3.words[3]) / (m3.ends[3] - m3.words[3]), 0, 1) * 9 + clamp((T - m3.words[4]) / (m3.ends[4] - m3.words[4]), 0, 1) * 2 + clamp((T - m3.words[5]) / (m3.ends[5] - m3.words[5]), 0, 1) * 9 + clamp((T - m3.words[6]) / (m3.ends[6] - m3.words[6]), 0, 1) * 6) - 0, 0, 26) * adv), text("thousand cards.", x: 0.06, y: -0.008, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - m3.words[0]) / (m3.ends[0] - m3.words[0]), 0, 1) * 5 + clamp((T - m3.words[1]) / (m3.ends[1] - m3.words[1]), 0, 1) * 7 + clamp((T - m3.words[2]) / (m3.ends[2] - m3.words[2]), 0, 1) * 4 + clamp((T - m3.words[3]) / (m3.ends[3] - m3.words[3]), 0, 1) * 9 + clamp((T - m3.words[4]) / (m3.ends[4] - m3.words[4]), 0, 1) * 2 + clamp((T - m3.words[5]) / (m3.ends[5] - m3.words[5]), 0, 1) * 9 + clamp((T - m3.words[6]) / (m3.ends[6] - m3.words[6]), 0, 1) * 6) - 27, 0, 15) * adv)) * (T >= m3.start) * (T < min(m3.end + 1.5, m4.start))
  let c_m4 = text("And the novice was enlightened.", x: 0.06, y: -0.060, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - m4.words[0]) / (m4.ends[0] - m4.words[0]), 0, 1) * 4 + clamp((T - m4.words[1]) / (m4.ends[1] - m4.words[1]), 0, 1) * 4 + clamp((T - m4.words[2]) / (m4.ends[2] - m4.words[2]), 0, 1) * 7 + clamp((T - m4.words[3]) / (m4.ends[3] - m4.words[3]), 0, 1) * 4 + clamp((T - m4.words[4]) / (m4.ends[4] - m4.words[4]), 0, 1) * 12) - 0, 0, 31) * adv) * (T >= m4.start) * (T < m4.end + 2.5)
  let said = merge(c_n1, c_n2, c_n3, c_n4, c_n5, c_n6, c_n7, c_n8, c_n9, c_n10, c_n11, c_n12, c_n13)
  let spoken = merge(c_m1, c_m2, c_m3, c_m4)
  let dark = paint(merge(header, series, said), palette: ["#000000", "#1a1712"], range: [0, 1], alpha: merge(header, series, said))
  let red  = paint(spoken, palette: ["#000000", "#b8361f"], range: [0, 1], alpha: spoken)
  let look = film(vignette(overlay(reel, dark, red), amount: 0.06), amount: 0.035)

  // ── the sound ──
  // a card is a plucked string as high as its value; a comparison a knock of
  // wood at the pitch of the card passed; the merges ring like a kalimba
  let pitch(v) = 0.97 - v * 0.9
  let brush = synth { bandpass(noise(), cutoff: 1400, resonance: 0.3) * adsr(attack: 0.12, decay: 0.3, sustain: 0.3, release: 0.5) * note.velocity }
  let pad = synth {
    let env = adsr(attack: 3, decay: 1, sustain: 0.9, release: 4)
    lowpass(saw(note.freq) + saw(note.freq * 1.003) + sine(note.freq * 0.5), cutoff: 260 + 300 * note.level, resonance: 0.2) * env
  }
  // the temple bell, when the master speaks
  pattern bells = repeat 2 event(t: [m1.start - 1.0, m3.start - 1.0][i] / total, x: 0.5, y: 0.95, size: 0.12, intensity: 0.9)
  // the recipe: a knock for every line the cursor reads
  pattern written = repeat 4 event(t: [n2.words[0], n2.words[1], n2.words[3], n2.words[5]][i] / total, x: 0.4, y: 0.6 - 0.08 * i, intensity: 0.6)
  let rs0 = n3.words[6]
  let rs1 = n3.end + 2.2
  pattern reads = repeat 63 event(t: (rs0 + (rs1 - rs0) * (i / 63) ^ 0.55) / total, x: 0.3 + 0.4 * (i % 2), y: [0.7, 0.6, 0.5, 0.4][[0, 1, 2, 1, 3, 0, 1, 3, 0, 1, 2, 1, 2, 1, 3, 0, 1, 2, 1, 3, 0, 1, 3, 0, 1, 2, 1, 2, 1, 2, 1, 3, 0, 1, 2, 1, 3, 0, 1, 3, 0, 1, 2, 1, 2, 1, 3, 0, 1, 2, 1, 3, 0, 1, 2, 1, 2, 1, 2, 1, 2, 1, 3][i]], intensity: 0.45)
  // insertion: the card taken, then a knock for each card it passes
  let posI(q, k) = (q < k) * sum([(j < k) * (h[j] < h[q]) for j in range(N)]) + (q >= k) * q
  let comps = [bigger(k) + (bigger(k) < k) for k in range(1, N)]
  pattern taken = repeat 15 event(t: insat[i] / total, x: 0.2 + 0.6 * (i + 1) / N, y: pitch(h[i + 1]), size: 0.04, intensity: 0.85)
  pattern passed = repeat 225 event(t: (insat[floor(i / 15)] + insmove * ((i % 15) + 1) / (comps[floor(i / 15)] + 1)) / total,
                                    x: 0.2 + 0.6 * (floor(i / 15) - (i % 15)) / N,
                                    y: pitch(sum([(q <= floor(i / 15)) * (posI(q, floor(i / 15) + 1) == floor(i / 15) - (i % 15)) * h[q] for q in range(N)])),
                                    intensity: ((i % 15) < comps[floor(i / 15)]) * 0.5)
  // merging: each level, every card rings as it lands, left to right: the
  // runs climb, and the last level is one scale
  let posM(q, Lv) = floor(q / 2 ^ Lv) * 2 ^ Lv + sum([(floor(j / 2 ^ Lv) == floor(q / 2 ^ Lv)) * (h[j] < h[q]) for j in range(N)])
  pattern landed = repeat 64 event(t: (mat[floor(i / 16)] + 0.25 + 0.05 * posM(i % 16, floor(i / 16) + 1)) / total,
                                   x: 0.15 + 0.7 * posM(i % 16, floor(i / 16) + 1) / N, y: pitch(h[i % 16]), size: 0.03, intensity: 0.5 + 0.2 * (floor(i / 16) == 3))
  // the cost: the big square fills with a rain of ticks, the small one with a few
  pattern rainA = repeat 120 event(t: (n11.words[2] + 3.5 * i / 120) / total, x: ~between(0.1, 0.6), y: ~between(0.3, 0.7), intensity: ~between(0.2, 0.5))
  pattern rainB = repeat 6 event(t: (n12.words[1] + 1.05 * i / 6) / total, x: ~between(0.7, 0.9), y: ~between(0.3, 0.7), intensity: 0.5)

  let music = [
    m1, m2, n1, n2, n3, n4, n5, n6, n7, n8, n9, n10, n11, n12, n13, m3, m4,
    drone(0.35 + 0.15 * lfo(3) + x * 0, voices: 2, instrument: pad, scale: "hirajoshi", key: 55, gain: 0.5),
    notes(bells, instrument: "bell", scale: "hirajoshi", key: 110, gain: 0.7),
    notes(written, instrument: "wood", scale: "hirajoshi", key: 330, gain: 0.35),
    notes(reads, instrument: "wood", scale: "hirajoshi", key: 440, gain: 0.25),
    notes(taken, instrument: "pluck", scale: "hirajoshi", key: 196, gain: 0.55),
    notes(passed, instrument: "wood", scale: "hirajoshi", key: 196, gain: 0.3),
    notes(landed, instrument: "kalimba", scale: "hirajoshi", key: 196, gain: 0.45),
    notes(rainA, instrument: "tick", gain: 0.25),
    notes(rainB, instrument: "kalimba", scale: "hirajoshi", key: 784, gain: 0.3),
    notes(reel.cues, instrument: brush, scale: "chromatic", key: 100, gain: 0.3),
  ]

  render image(look, width: 1080, height: 1920, at: 0.4289)
  render video(look, fps: 30, width: 1080, height: 1920, sound: music, room: 0.12, echo: 0)
}
