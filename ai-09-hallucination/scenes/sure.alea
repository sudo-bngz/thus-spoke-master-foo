// Sure — the same voice for a fact and an invention: two sentences in the
// same font; under each, a hidden number, how sure the die was, revealed
// as a bar; then: same font, same voice, same calm. `accent: 1` gives
// only the revealed numbers. Times are the scene's own (0 to 1). What it
// returns: 0 paper, up to 1 ink.

work Sure(s0 = 0.05, s1 = 0.15, reveal0 = 0.45, same0 = 0.75, accent = 0) {
  let lines = ["The Eiffel Tower is 330 m tall.", "The Vellmar bridge was built in 1954."]
  let probs = [92, 31]
  let ly(k) = 0.42 + 0.3 * k
  let on(k) = smoothstep([s0, s1][k], [s0, s1][k] + 0.04, t)
  let sentence(k) = text(lines[k], 0.5, ly(k), 0.034, 0, "mono") * 0.9 * on(k)
  let rs = smoothstep(reveal0, reveal0 + 0.06, t)
  let w(k) = 0.6 * probs[k] / 100 * rs
  let bar(k) = rect(0.2 + w(k) / 2, ly(k) + 0.07, w(k), 0.012, 0, 0.002) * 0.6 * (t > reveal0)
  let pct(k) = text("{probs[k]} %", 0.2 + w(k) + 0.02, ly(k) + 0.07, 0.026, 0, "mono", "left") * (t > reveal0 + 0.06)
  let hidden = text("under each sentence, a number you never see", 0.5, 0.26, 0.026, 0, "mono") * 0.6 * smoothstep(reveal0 - 0.06, reveal0 - 0.02, t)
  let same = text("same font  ·  same voice  ·  same calm", 0.5, 1.02, 0.028, 0, "mono") * 0.7 * smoothstep(same0, same0 + 0.04, t)
  let alike = text("a fact and an invention look exactly alike from outside", 0.5, 1.09, 0.024, 0, "mono") * 0.5 * smoothstep(same0 + 0.12, same0 + 0.16, t)
  output accent * merge([pct(k) for k in range(2)]) + (1 - accent) * merge(merge([merge(sentence(k), bar(k)) for k in range(2)]), hidden, same, alike)
}
