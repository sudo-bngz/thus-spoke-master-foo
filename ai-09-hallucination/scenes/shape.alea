// Shape — a sentence shaped like a fact: the prompt, two candidates with
// their bars (illustrative), the die picking the wrong one, typed in
// vermilion; nothing inside protests. `accent: 1` gives only the pick.
// Times are the scene's own (0 to 1). What it returns: 0 paper, up to 1 ink.

work Shape(prompt0 = 0.05, bars0 = 0.25, pick0 = 0.45, wrong0 = 0.6, shaped0 = 0.8, accent = 0) {
  let py = 0.36
  let ps = smoothstep(prompt0, prompt0 + 0.04, t)
  let prompt = text("The capital of Australia is", 0.5, py, 0.038, 0, "mono") * 0.9 * ps
  let cand = ["Sydney", "Canberra"]
  let prob = [40, 35]
  let ry(k) = 0.58 + 0.1 * k
  let grown(k) = clamp((t - bars0 - 0.03 * k) / 0.06, 0, 1)
  let w(k) = 0.42 * prob[k] / 50 * grown(k)
  let label(k) = text(cand[k], 0.36, ry(k), 0.034, 0, "mono", "right") * 0.85 * smoothstep(bars0 + 0.03 * k, bars0 + 0.03 * k + 0.03, t)
  let bar(k) = rect(0.38 + w(k) / 2, ry(k), w(k), 0.045, 0, 0.002) * 0.7 * (t > bars0 + 0.03 * k)
  let pct(k) = text("{prob[k]} %", 0.4 + w(k), ry(k), 0.028, 0, "mono", "left") * 0.7 * (t > bars0 + 0.03 * k + 0.06)
  let both = text("both shaped like an answer", 0.5, 0.8, 0.026, 0, "mono") * 0.55 * smoothstep(bars0 + 0.14, bars0 + 0.18, t)
  // the pick: the die lands on Sydney, typed after the prompt
  let adv = 0.01965
  let typed = clamp((t - pick0 - 0.02) / 0.06, 0, 1) * 7
  let pick = text("Sydney.", 0.5, py + 0.07, 0.038, 0, "mono") * (x < 0.5 - 3.5 * adv + typed * adv) * (t > pick0)
  let mark = circle(0.17, ry(0), 0.012, 0.002) * smoothstep(pick0, pick0 + 0.03, t)
  // nothing protests; wrong
  let fine = text("grammar: perfect  ·  sentence: complete", 0.5, 0.95, 0.026, 0, "mono") * 0.55 * smoothstep(wrong0, wrong0 + 0.04, t)
  let wrong = text("and wrong", 0.5, 1.01, 0.03, 0, "mono") * 0.8 * smoothstep(wrong0 + 0.1, wrong0 + 0.14, t)
  let shaped = text("a sentence shaped like a fact, with no fact behind it", 0.5, 1.14, 0.026, 0, "mono") * 0.65 * smoothstep(shaped0, shaped0 + 0.04, t)
  output accent * merge(pick, mark) + (1 - accent) * merge(prompt, merge([merge(label(k), bar(k), pct(k)) for k in range(2)]), both, fine, wrong, shaped)
}
