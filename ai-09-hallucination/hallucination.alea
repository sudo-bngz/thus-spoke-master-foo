// Hallucination — Thus Spoke Master Foo, AI 09: sure, and wrong. The
// machine was never asked to be right, only to continue; a sentence
// shaped like a fact, with no fact behind it; why: the weights hold the
// internet blurred, a sharp peak for what was seen a million times, a
// flat spread for what was seen twice, and the gap filled anyway; the
// same voice for a fact and an invention, the number under the words
// never shown; and what to do: give it the text, ask twice, check what
// matters. The percentages and the paper are illustrative. Master Foo
// speaks Japanese, translated in the captions.

use "scenes/koan.alea"
use "scenes/shape.alea"
use "scenes/blur.alea"
use "scenes/sure.alea"
use "scenes/check.alea"

work Hallucination {
  let total = 151.1
  let T = t * total
  let EN = "../voices/narrator.sh"
  let JA = "../voices/master.sh"

  // ── the voices: the master, in Japanese; the one who explains, in English ──
  let m1 = say("弟子は尋ねた。機械は、嘘をつくのですか。", at: 1.50, engine: JA, voice: "jm_kumo", speed: 0.82, gain: 2.3)
  let m2 = say("師は言った。嘘をつくには、まず真実を知らねばならぬ。", at: m1.end + 1.4, engine: JA, voice: "jm_kumo", speed: 0.82, gain: 2.3)
  let m3 = say("弟子は、黙った。", at: m2.end + 1.4, engine: JA, voice: "jm_kumo", speed: 0.82, gain: 2.3)
  let n1 = say("The machine was never asked to be right. Only to guess the next word. A sentence that sounds right is enough.", at: 19.60, engine: EN, voice: "af_heart", speed: 1.0, gain: 2.3)
  let n2 = say("The capital of Australia is: Sydney, forty percent. Canberra, thirty-five. Both are shaped like an answer. The die picks.", at: n1.end + 1.4, engine: EN, voice: "af_heart", speed: 1.0, gain: 2.3)
  let n3 = say("It picks Sydney. Nothing inside protests. The grammar is perfect, the sentence is complete, and it is wrong.", at: n2.end + 1.4, engine: EN, voice: "af_heart", speed: 1.0, gain: 2.3)
  let n4 = say("That is a hallucination: a sentence shaped like a fact, with no fact behind it.", at: n3.end + 1.4, engine: EN, voice: "af_heart", speed: 1.0, gain: 2.3)
  let n5 = say("Why? The weights hold the internet, blurred. A fact seen a million times leaves a sharp peak: Paris.", at: 50.70, engine: EN, voice: "af_heart", speed: 1.0, gain: 2.3)
  let n6 = say("A fact seen twice, a small town, a paper from nineteen eighty-seven, leaves almost nothing. A flat spread.", at: n5.end + 1.4, engine: EN, voice: "af_heart", speed: 1.0, gain: 2.3)
  let n7 = say("But the sentence must go on. So the machine fills the gap with the most plausible words. A name that sounds like a name. A date that sounds like a date.", at: n6.end + 1.4, engine: EN, voice: "af_heart", speed: 1.0, gain: 2.3)
  let n8 = say("And it says it with the same voice. The tone does not come from the truth. It comes from the texts it learned from, and people write with confidence.", at: 76.60, engine: EN, voice: "af_heart", speed: 1.0, gain: 2.3)
  let n9 = say("Under each sentence there is a number: how sure the die was. Ninety-two percent. Thirty-one percent. You never see it. Only the words.", at: n8.end + 1.4, engine: EN, voice: "af_heart", speed: 1.0, gain: 2.3)
  let n10 = say("Same font, same voice, same calm. A fact and an invention look exactly alike from the outside.", at: n9.end + 1.4, engine: EN, voice: "af_heart", speed: 1.0, gain: 2.3)
  let n11 = say("So what can you do? Three things. One: give it the text. Put the document in the window, and it reads instead of guessing.", at: 103.90, engine: EN, voice: "af_heart", speed: 1.0, gain: 2.3)
  let n12 = say("Two: ask twice. Two rolls of the die. If the answers disagree, the spread was flat.", at: n11.end + 1.4, engine: EN, voice: "af_heart", speed: 1.0, gain: 2.3)
  let n13 = say("Three: check what matters. A name, a date, a number, a law. The machine continues sentences. Whether they are true is your job.", at: n12.end + 1.4, engine: EN, voice: "af_heart", speed: 1.0, gain: 2.3)
  let n14 = say("This closes the series on AI. From the neuron to the next token, and back.", at: n13.end + 1.4, engine: EN, voice: "af_heart", speed: 1.0, gain: 2.3)
  let m4 = say("師は言った。機械は、ありそうな言葉を続けるだけだ。", at: 135.00, engine: JA, voice: "jm_kumo", speed: 0.82, gain: 2.3)
  let m5 = say("疑うのは、お前の仕事だ。", at: m4.end + 1.4, engine: JA, voice: "jm_kumo", speed: 0.82, gain: 2.3)
  let m6 = say("その時、弟子は悟った。", at: m5.end + 1.6, engine: JA, voice: "jm_kumo", speed: 0.82, gain: 2.3)

  // ── the scenes: ink on paper, a vermilion accent, under the captions ──
  let PAPER = ["#efe9dc", "#d3c9b4", "#3b352c", "#17140f"]
  let fit(piece) = zoom(piece, by: 0.82, x: 0.5, y: 0.66)
  let ink(piece, accent) = overlay(paint(fit(piece), palette: PAPER, range: [0, 1]), paint(fit(accent), palette: ["#000000", "#c23b22"], range: [0, 1], alpha: fit(accent)))
  let reel = timeline([
