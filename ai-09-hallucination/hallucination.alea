  let c_n11 = merge(text("So what can you do? 3 things. 1:", x: 0.06, y: -0.060, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - n11.start) / (n11.duration * 0.92), 0, 1) * 116) - 0, 0, 32) * adv), text("give it the text. Put the", x: 0.06, y: -0.008, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - n11.start) / (n11.duration * 0.92), 0, 1) * 116) - 33, 0, 25) * adv), text("document in the window, and it", x: 0.06, y: 0.044, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - n11.start) / (n11.duration * 0.92), 0, 1) * 116) - 59, 0, 30) * adv), text("reads instead of guessing.", x: 0.06, y: 0.096, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - n11.start) / (n11.duration * 0.92), 0, 1) * 116) - 90, 0, 26) * adv)) * (T >= n11.start) * (T < min(n11.end + 1.5, n12.start))
  let c_n12 = merge(text("2: ask twice. 2 rolls of the die.", x: 0.06, y: -0.060, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - n12.start) / (n12.duration * 0.92), 0, 1) * 79) - 0, 0, 33) * adv), text("If the answers disagree, the", x: 0.06, y: -0.008, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - n12.start) / (n12.duration * 0.92), 0, 1) * 79) - 34, 0, 28) * adv), text("spread was flat.", x: 0.06, y: 0.044, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - n12.start) / (n12.duration * 0.92), 0, 1) * 79) - 63, 0, 16) * adv)) * (T >= n12.start) * (T < min(n12.end + 1.5, n13.start))
  let c_n13 = merge(text("3: check what matters. A name, a", x: 0.06, y: -0.060, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - n13.start) / (n13.duration * 0.92), 0, 1) * 123) - 0, 0, 32) * adv), text("date, a number, a law. The", x: 0.06, y: -0.008, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - n13.start) / (n13.duration * 0.92), 0, 1) * 123) - 33, 0, 26) * adv), text("machine continues sentences.", x: 0.06, y: 0.044, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - n13.start) / (n13.duration * 0.92), 0, 1) * 123) - 60, 0, 28) * adv), text("Whether they are true is your", x: 0.06, y: 0.096, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - n13.start) / (n13.duration * 0.92), 0, 1) * 123) - 89, 0, 29) * adv), text("job.", x: 0.06, y: 0.148, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - n13.start) / (n13.duration * 0.92), 0, 1) * 123) - 119, 0, 4) * adv)) * (T >= n13.start) * (T < min(n13.end + 1.5, n14.start))
  let c_n14 = merge(text("This closes the series on AI.", x: 0.06, y: -0.060, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - n14.words[0]) / (n14.ends[0] - n14.words[0]), 0, 1) * 5 + clamp((T - n14.words[1]) / (n14.ends[1] - n14.words[1]), 0, 1) * 7 + clamp((T - n14.words[2]) / (n14.ends[2] - n14.words[2]), 0, 1) * 4 + clamp((T - n14.words[3]) / (n14.ends[3] - n14.words[3]), 0, 1) * 7 + clamp((T - n14.words[4]) / (n14.ends[4] - n14.words[4]), 0, 1) * 3 + clamp((T - n14.words[5]) / (n14.ends[5] - n14.words[5]), 0, 1) * 4 + clamp((T - n14.words[6]) / (n14.ends[6] - n14.words[6]), 0, 1) * 5 + clamp((T - n14.words[7]) / (n14.ends[7] - n14.words[7]), 0, 1) * 4 + clamp((T - n14.words[8]) / (n14.ends[8] - n14.words[8]), 0, 1) * 7 + clamp((T - n14.words[9]) / (n14.ends[9] - n14.words[9]), 0, 1) * 3 + clamp((T - n14.words[10]) / (n14.ends[10] - n14.words[10]), 0, 1) * 4 + clamp((T - n14.words[11]) / (n14.ends[11] - n14.words[11]), 0, 1) * 5 + clamp((T - n14.words[12]) / (n14.ends[12] - n14.words[12]), 0, 1) * 7 + clamp((T - n14.words[13]) / (n14.ends[13] - n14.words[13]), 0, 1) * 4 + clamp((T - n14.words[14]) / (n14.ends[14] - n14.words[14]), 0, 1) * 5) - 0, 0, 29) * adv), text("From the neuron to the next", x: 0.06, y: -0.008, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - n14.words[0]) / (n14.ends[0] - n14.words[0]), 0, 1) * 5 + clamp((T - n14.words[1]) / (n14.ends[1] - n14.words[1]), 0, 1) * 7 + clamp((T - n14.words[2]) / (n14.ends[2] - n14.words[2]), 0, 1) * 4 + clamp((T - n14.words[3]) / (n14.ends[3] - n14.words[3]), 0, 1) * 7 + clamp((T - n14.words[4]) / (n14.ends[4] - n14.words[4]), 0, 1) * 3 + clamp((T - n14.words[5]) / (n14.ends[5] - n14.words[5]), 0, 1) * 4 + clamp((T - n14.words[6]) / (n14.ends[6] - n14.words[6]), 0, 1) * 5 + clamp((T - n14.words[7]) / (n14.ends[7] - n14.words[7]), 0, 1) * 4 + clamp((T - n14.words[8]) / (n14.ends[8] - n14.words[8]), 0, 1) * 7 + clamp((T - n14.words[9]) / (n14.ends[9] - n14.words[9]), 0, 1) * 3 + clamp((T - n14.words[10]) / (n14.ends[10] - n14.words[10]), 0, 1) * 4 + clamp((T - n14.words[11]) / (n14.ends[11] - n14.words[11]), 0, 1) * 5 + clamp((T - n14.words[12]) / (n14.ends[12] - n14.words[12]), 0, 1) * 7 + clamp((T - n14.words[13]) / (n14.ends[13] - n14.words[13]), 0, 1) * 4 + clamp((T - n14.words[14]) / (n14.ends[14] - n14.words[14]), 0, 1) * 5) - 30, 0, 27) * adv), text("token, and back.", x: 0.06, y: 0.044, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - n14.words[0]) / (n14.ends[0] - n14.words[0]), 0, 1) * 5 + clamp((T - n14.words[1]) / (n14.ends[1] - n14.words[1]), 0, 1) * 7 + clamp((T - n14.words[2]) / (n14.ends[2] - n14.words[2]), 0, 1) * 4 + clamp((T - n14.words[3]) / (n14.ends[3] - n14.words[3]), 0, 1) * 7 + clamp((T - n14.words[4]) / (n14.ends[4] - n14.words[4]), 0, 1) * 3 + clamp((T - n14.words[5]) / (n14.ends[5] - n14.words[5]), 0, 1) * 4 + clamp((T - n14.words[6]) / (n14.ends[6] - n14.words[6]), 0, 1) * 5 + clamp((T - n14.words[7]) / (n14.ends[7] - n14.words[7]), 0, 1) * 4 + clamp((T - n14.words[8]) / (n14.ends[8] - n14.words[8]), 0, 1) * 7 + clamp((T - n14.words[9]) / (n14.ends[9] - n14.words[9]), 0, 1) * 3 + clamp((T - n14.words[10]) / (n14.ends[10] - n14.words[10]), 0, 1) * 4 + clamp((T - n14.words[11]) / (n14.ends[11] - n14.words[11]), 0, 1) * 5 + clamp((T - n14.words[12]) / (n14.ends[12] - n14.words[12]), 0, 1) * 7 + clamp((T - n14.words[13]) / (n14.ends[13] - n14.words[13]), 0, 1) * 4 + clamp((T - n14.words[14]) / (n14.ends[14] - n14.words[14]), 0, 1) * 5) - 58, 0, 16) * adv)) * (T >= n14.start) * (T < min(n14.end + 1.5, m4.start))
  let c_m4 = merge(text("Master Foo said: the machine only", x: 0.06, y: -0.060, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - m4.start) / (m4.duration * 0.92), 0, 1) * 69) - 0, 0, 33) * adv), text("continues with the likeliest", x: 0.06, y: -0.008, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - m4.start) / (m4.duration * 0.92), 0, 1) * 69) - 34, 0, 28) * adv), text("words.", x: 0.06, y: 0.044, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - m4.start) / (m4.duration * 0.92), 0, 1) * 69) - 63, 0, 6) * adv)) * (T >= m4.start) * (T < min(m4.end + 1.5, m5.start))
  let c_m5 = text("Doubting them is your job.", x: 0.06, y: -0.060, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - m5.start) / (m5.duration * 0.92), 0, 1) * 26) - 0, 0, 26) * adv) * (T >= m5.start) * (T < min(m5.end + 1.5, m6.start))
  let c_m6 = text("And the novice was enlightened.", x: 0.06, y: -0.060, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - m6.start) / (m6.duration * 0.92), 0, 1) * 31) - 0, 0, 31) * adv) * (T >= m6.start) * (T < m6.end + 3)
  let said = merge(c_n1, c_n2, c_n3, c_n4, c_n5, c_n6, c_n7, c_n8, c_n9, c_n10, c_n11, c_n12, c_n13, c_n14)
  let spoken = merge(c_m1, c_m2, c_m3, c_m4, c_m5, c_m6)
  let dark = paint(merge(header, series, said), palette: ["#000000", "#1a1712"], range: [0, 1], alpha: merge(header, series, said))
  let red  = paint(spoken, palette: ["#000000", "#b8361f"], range: [0, 1], alpha: spoken)
  let look = film(vignette(overlay(reel, dark, red), amount: 0.06), amount: 0.035)

  // ── the sound ──
  let pad = synth {
    let env = adsr(attack: 3, decay: 1, sustain: 0.9, release: 4)
    lowpass(saw(note.freq) + saw(note.freq * 1.003) + sine(note.freq * 0.5), cutoff: 260 + 300 * note.level, resonance: 0.2) * env
  }
  let brush = synth { bandpass(noise(), cutoff: 1400, resonance: 0.3) * adsr(attack: 0.12, decay: 0.3, sustain: 0.3, release: 0.5) * note.velocity }
  let tick = synth { highpass(noise(), cutoff: 4000, resonance: 0.2) * perc(release: 0.015) * note.velocity + sine(note.freq) * perc(release: 0.05) * 0.4 }
  let knock = synth { lowpass(noise(), cutoff: 700, resonance: 0.5) * perc(attack: 0.002, release: 0.12) * note.velocity + sine(note.freq) * perc(release: 0.1) * 0.5 }
  let chord = synth {
    let env = adsr(attack: 0.3, decay: 0.6, sustain: 0.8, release: 2.5)
    chorus(lowpass(saw(note.freq) + saw(note.freq * 1.004) + sine(note.freq * 0.5), cutoff: 1200, resonance: 0.15) * env, depth: 0.6)
  }
  // the temple bell when the master speaks; the question
  pattern bells = repeat 2 event(t: [m1.start - 1.0, m4.start - 1.0][i] / total, x: 0.5, y: 0.95, size: 0.12, intensity: 0.9)
  pattern asked = repeat 1 event(t: (m2.start + 0.85 * m2.duration) / total, x: 0.5, y: 0.5, size: 0.06, intensity: 0.8)
  // the two bars; the pick; wrong
  pattern bars = repeat 2 event(t: (n2.words[5] + 0.03 * 31.1 * i) / total, x: 0.5, y: 0.58 + 0.1 * i, size: 0.05, intensity: 0.5)
  pattern picked = repeat 1 event(t: n3.words[2] / total, x: 0.5, y: 0.43, size: 0.06, intensity: 0.8)
  pattern wrong = repeat 1 event(t: (n3.words[6] + 0.1 * 31.1) / total, x: 0.5, y: 1.0, size: 0.08, intensity: 0.9)
  // the sharp peak; the flat spread; the gap filled
  pattern peak = repeat 1 event(t: n5.words[9] / total, x: 0.5, y: 0.42, size: 0.05, intensity: 0.7)
  pattern spread = repeat 12 event(t: (n6.words[0] + 0.08 * 25.9 * (i / 12)) / total, x: 0.12 + 0.76 * i / 12, y: 0.8, intensity: 0.25)
  pattern filled = repeat 8 event(t: (n7.words[7] + 0.03 * 25.9 + 0.14 * 25.9 * (i / 8)) / total, x: 0.2 + 0.6 * i / 8, y: 1.0, intensity: 0.3)
  // the two sentences; the numbers revealed
  pattern said = repeat 2 event(t: [n8.words[2], n8.words[8]][i] / total, x: 0.5, y: 0.42 + 0.3 * i, size: 0.1, intensity: 0.5)
  pattern revealed = repeat 2 event(t: (n9.words[13] + 0.06 * 27.3) / total, x: 0.5, y: 0.49 + 0.3 * i, size: 0.05, intensity: 0.6)
  // the three things; the series closed
  pattern things = repeat 3 event(t: [n11.words[6], n12.words[0], n13.words[0]][i] / total, x: 0.12, y: 0.38 + 0.22 * i, size: 0.06, intensity: 0.7)
  pattern series = repeat 9 event(t: (n14.words[2] + 0.05 * 31.1 * i) / total, x: 0.1 + 0.8 * i / 8, y: 1.12, intensity: 0.4)

  let music = [
    m1, m2, m3, n1, n2, n3, n4, n5, n6, n7, n8, n9, n10, n11, n12, n13, n14, m4, m5, m6,
    drone(0.45 + 0.15 * lfo(3) + x * 0, voices: 2, instrument: pad, scale: "hirajoshi", key: 55, gain: 0.9),
    notes(bells, instrument: "bell", scale: "hirajoshi", key: 110, gain: 0.7),
    notes(asked, instrument: "kalimba", scale: "hirajoshi", key: 392, gain: 0.6),
    notes(bars, instrument: "kalimba", scale: "hirajoshi", key: 392, gain: 0.45),
    notes(picked, instrument: "glass", scale: "hirajoshi", key: 523, gain: 0.5),
    notes(wrong, instrument: knock, scale: "hirajoshi", key: 165, gain: 0.7),
    notes(peak, instrument: "glass", scale: "hirajoshi", key: 659, gain: 0.5),
    notes(spread, instrument: tick, scale: "hirajoshi", key: 880, gain: 0.25),
    notes(filled, instrument: tick, scale: "hirajoshi", key: 1100, gain: 0.25),
    notes(said, instrument: chord, scale: "major", key: 110, gain: 0.4),
    notes(revealed, instrument: "wood", scale: "hirajoshi", key: 330, gain: 0.5),
    notes(things, instrument: "kalimba", scale: "hirajoshi", key: 262, gain: 0.5),
    notes(series, instrument: "glass", scale: "hirajoshi", key: 523, gain: 0.35),
    notes(reel.cues, instrument: brush, scale: "chromatic", key: 100, gain: 0.3),
  ]

  render image(look, width: 1080, height: 1920, at: 0.6325)
  render video(look, fps: 30, width: 1080, height: 1920, sound: music, room: 0.12, echo: 0)
}
