      scene(ink(Shape(prompt0: ((n2.words[0]) - 18.10) / 31.1, bars0: ((n2.words[5]) - 18.10) / 31.1, pick0: ((n3.words[2]) - 18.10) / 31.1, wrong0: ((n3.words[6]) - 18.10) / 31.1, shaped0: ((n4.words[4]) - 18.10) / 31.1, accent: 0), Shape(prompt0: ((n2.words[0]) - 18.10) / 31.1, bars0: ((n2.words[5]) - 18.10) / 31.1, pick0: ((n3.words[2]) - 18.10) / 31.1, wrong0: ((n3.words[6]) - 18.10) / 31.1, shaped0: ((n4.words[4]) - 18.10) / 31.1, accent: 1)), 31.1),  pixels(0.6, size: 0.05),
      scene(ink(Blur(sharp0: ((n5.words[9]) - 49.20) / 25.9, flat0: ((n6.words[0]) - 49.20) / 25.9, fill0: ((n7.words[7]) - 49.20) / 25.9, accent: 0), Blur(sharp0: ((n5.words[9]) - 49.20) / 25.9, flat0: ((n6.words[0]) - 49.20) / 25.9, fill0: ((n7.words[7]) - 49.20) / 25.9, accent: 1)), 25.9),  wipe(0.7, angle: 90, softness: 0.1),
      scene(ink(Sure(s0: ((n8.words[2]) - 75.10) / 27.3, s1: ((n8.words[8]) - 75.10) / 27.3, reveal0: ((n9.words[13]) - 75.10) / 27.3, same0: ((n10.words[0]) - 75.10) / 27.3, accent: 0), Sure(s0: ((n8.words[2]) - 75.10) / 27.3, s1: ((n8.words[8]) - 75.10) / 27.3, reveal0: ((n9.words[13]) - 75.10) / 27.3, same0: ((n10.words[0]) - 75.10) / 27.3, accent: 1)), 27.3),  morph(0.8, amount: 0.15),
      scene(ink(Check(at: [((n11.words[6]) - 102.40) / 31.1, ((n12.words[0]) - 102.40) / 31.1, ((n13.words[0]) - 102.40) / 31.1], end0: ((n14.words[2]) - 102.40) / 31.1, accent: 0), Check(at: [((n11.words[6]) - 102.40) / 31.1, ((n12.words[0]) - 102.40) / 31.1, ((n13.words[0]) - 102.40) / 31.1], end0: ((n14.words[2]) - 102.40) / 31.1, accent: 1)), 31.1),  wipe(0.8, angle: 180, softness: 0.12),
      scene(ink(Koan(draw0: ((m4.start) - 133.50) / 17.6, draw1: ((m6.end) - 133.50) / 17.6, word: ((m6.start + 0.5) - 133.50) / 17.6, title: ((m6.end + 0.6) - 133.50) / 17.6, kana: ["ゲ", "ン", "カ", "ク"], episode: "AI 09  ·  hallucination", accent: 0), Koan(draw0: ((m4.start) - 133.50) / 17.6, draw1: ((m6.end) - 133.50) / 17.6, word: ((m6.start + 0.5) - 133.50) / 17.6, title: ((m6.end + 0.6) - 133.50) / 17.6, kana: ["ゲ", "ン", "カ", "ク"], episode: "AI 09  ·  hallucination", accent: 1)), 17.6),  morph(1.2, amount: 0.2),
  ], loop: 1)

  // ── over it: the series, the step, the captions (the master's, translated, in vermilion) ──
