12]), 0, 1) * 9) - 34, 0, 29) * adv), text("together.", x: 0.06, y: 0.044, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - n8.words[0]) / (n8.ends[0] - n8.words[0]), 0, 1) * 4 + clamp((T - n8.words[1]) / (n8.ends[1] - n8.words[1]), 0, 1) * 5 + clamp((T - n8.words[2]) / (n8.ends[2] - n8.words[2]), 0, 1) * 9 + clamp((T - n8.words[3]) / (n8.ends[3] - n8.words[3]), 0, 1) * 4 + clamp((T - n8.words[4]) / (n8.ends[4] - n8.words[4]), 0, 1) * 4 + clamp((T - n8.words[5]) / (n8.ends[5] - n8.words[5]), 0, 1) * 2 + clamp((T - n8.words[6]) / (n8.ends[6] - n8.words[6]), 0, 1) * 6 + clamp((T - n8.words[7]) / (n8.ends[7] - n8.words[7]), 0, 1) * 6 + clamp((T - n8.words[8]) / (n8.ends[8] - n8.words[8]), 0, 1) * 4 + clamp((T - n8.words[9]) / (n8.ends[9] - n8.words[9]), 0, 1) * 9 + clamp((T - n8.words[10]) / (n8.ends[10] - n8.words[10]), 0, 1) * 8 + clamp((T - n8.words[11]) / (n8.ends[11] - n8.words[11]), 0, 1) * 3 + clamp((T - n8.words[12]) / (n8.ends[12] - n8.words[12]), 0, 1) * 9) - 64, 0, 9) * adv)) * (T >= n8.start) * (T < min(n8.end + 1.5, n9.start))
  let c_n9 = merge(text("1 neuron can swing forever and", x: 0.06, y: -0.060, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - n9.start) / (n9.duration * 0.92), 0, 1) * 95) - 0, 0, 30) * adv), text("never find it. For that, you need", x: 0.06, y: -0.008, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - n9.start) / (n9.duration * 0.92), 0, 1) * 95) - 31, 0, 33) * adv), text("several, in layers. Next time.", x: 0.06, y: 0.044, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - n9.start) / (n9.duration * 0.92), 0, 1) * 95) - 65, 0, 30) * adv)) * (T >= n9.start) * (T < min(n9.end + 1.5, m4.start))
  let c_m4 = merge(text("After 1 000 mistakes, the scale", x: 0.06, y: -0.060, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - m4.start) / (m4.duration * 0.92), 0, 1) * 45) - 0, 0, 31) * adv), text("tipped right.", x: 0.06, y: -0.008, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - m4.start) / (m4.duration * 0.92), 0, 1) * 45) - 32, 0, 13) * adv)) * (T >= m4.start) * (T < min(m4.end + 1.5, m5.start))
  let c_m5 = merge(text("Master Foo said: there are lines", x: 0.06, y: -0.060, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - m5.start) / (m5.duration * 0.92), 0, 1) * 53) - 0, 0, 32) * adv), text("1 scale cannot draw.", x: 0.06, y: -0.008, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - m5.start) / (m5.duration * 0.92), 0, 1) * 53) - 33, 0, 20) * adv)) * (T >= m5.start) * (T < min(m5.end + 1.5, m6.start))
  let c_m6 = text("And the novice was enlightened.", x: 0.06, y: -0.060, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - m6.start) / (m6.duration * 0.92), 0, 1) * 31) - 0, 0, 31) * adv) * (T >= m6.start) * (T < m6.end + 3)
  let said = merge(c_n1, c_n2, c_n3, c_n4, c_n5, c_n6, c_n7, c_n8, c_n9)
  let spoken = merge(c_m1, c_m2, c_m3, c_m4, c_m5, c_m6)
  let dark = paint(merge(header, series, said), palette: ["#000000", "#1a1712"], range: [0, 1], alpha: merge(header, series, said))
  let red  = paint(spoken, palette: ["#000000", "#b8361f"], range: [0, 1], alpha: spoken)
  let look = film(vignette(overlay(reel, dark, red), amount: 0.06), amount: 0.035)

  // ── the sound ──
  let pad = synth {
    let env = adsr(attack: 3, decay: 1, sustain: 0.9, release: 4)
    lowpass(saw(note.freq) + saw(note.freq * 1.003) + sine(note.freq * 0.5), cutoff: 260 + 300 * note.level, resonance: 0.2) * env
  }
  let brush = synth { bandpass(noise(), cutoff: 1400, resonance: 0.3) * adsr(attack: 0.12, decay: 0.3, sustain: 0.3, release: 0.5) * note.velocity }
  let tick = synth { highpass(noise(), cutoff: 4000, resonance: 0.2) * perc(release: 0.015) * note.velocity + sine(note.freq) * perc(release: 0.05) * 0.4 }
  let knock = synth { lowpass(noise(), cutoff: 700, resonance: 0.5) * perc(attack: 0.002, release: 0.12) * note.velocity + sine(note.freq) * perc(release: 0.1) * 0.5 }
  let chord = synth {
    let env = adsr(attack: 0.3, decay: 0.6, sustain: 0.8, release: 2.5)
    chorus(lowpass(saw(note.freq) + saw(note.freq * 1.004) + sine(note.freq * 0.5), cutoff: 1200, resonance: 0.15) * env, depth: 0.6)
  }
  // the temple bell when the master speaks; the scale handed over
  pattern bells = repeat 2 event(t: [m1.start - 1.0, m4.start - 1.0][i] / total, x: 0.5, y: 0.95, size: 0.12, intensity: 0.9)
  pattern scale = repeat 1 event(t: m2.start / total + 0.6 * m2.duration / total, x: 0.5, y: 0.5, size: 0.06, intensity: 0.8)
  // the cell: the inputs, the wires, the sum filling, the fire, the second try
  pattern inputs = repeat 3 event(t: (n1.words[5] + 0.04 * 16.3 * i) / total, x: 0.2, y: 0.4 + 0.15 * i, intensity: 0.5)
  pattern fires = repeat 1 event(t: n2.words[16] / total, x: 0.86, y: 0.5, size: 0.08, intensity: 0.9)
  pattern silent = repeat 1 event(t: (n2.words[18] + 0.15 * 16.3) / total, x: 0.86, y: 0.5, size: 0.04, intensity: 0.4)
  // the line drawn, the wrong points ringed
  pattern drawn = repeat 1 event(t: n3.words[6] / total, x: 0.5, y: 0.5, size: 0.08, intensity: 0.7)
  pattern wrongs = repeat 4 event(t: (n4.words[9] + 0.12 * i) / total, x: 0.3 + 0.1 * i, y: 0.4, intensity: 0.6)
  // the steps: a tick at each, slowly then faster; a knock when the line moves is in the scene's own moments (unknown here), so every step ticks and the pass changes ring
  pattern steps = repeat 96 event(t: (n5.words[4] + (n6.end + 0.5 - n5.words[4]) * ((i + 1) / 96) ^ (1 / 1.8)) / total, x: 0.3 + 0.4 * (i % 2), y: 0.6 - 0.3 * (i % 12) / 12, intensity: 0.35 + 0.3 * ((i % 12) == 0))
  pattern settled = repeat 3 event(t: (n6.end + 0.5) / total, x: 0.5, y: [0.5, 0.4, 0.3][i], size: 0.1, intensity: 0.7)
  pattern xsteps = repeat 96 event(t: (n9.words[0] + (n9.end + 1.0 - n9.words[0]) * ((i + 1) / 96) ^ (1 / 1.8)) / total, x: 0.3 + 0.4 * (i % 2), y: 0.6 - 0.3 * (i % 4) / 4, intensity: 0.35 + 0.3 * ((i % 4) == 0))
  pattern never = repeat 1 event(t: (n9.end + 1.0) / total, x: 0.5, y: 0.7, size: 0.1, intensity: 0.8)

  let music = [
    m1, m2, m3, n1, n2, n3, n4, n5, n6, n7, n8, n9, m4, m5, m6,
    drone(0.45 + 0.15 * lfo(3) + x * 0, voices: 2, instrument: pad, scale: "hirajoshi", key: 55, gain: 0.9),
    notes(bells, instrument: "bell", scale: "hirajoshi", key: 110, gain: 0.7),
    notes(scale, instrument: "kalimba", scale: "hirajoshi", key: 392, gain: 0.6),
    notes(inputs, instrument: "kalimba", scale: "hirajoshi", key: 392, gain: 0.4),
    notes(fires, instrument: chord, scale: "major", key: 110, gain: 0.45),
    notes(silent, instrument: knock, scale: "hirajoshi", key: 110, gain: 0.4),
    notes(drawn, instrument: "glass", scale: "hirajoshi", key: 392, gain: 0.5),
    notes(wrongs, instrument: knock, scale: "hirajoshi", key: 165, gain: 0.45),
    notes(steps, instrument: tick, scale: "hirajoshi", key: 880, gain: 0.3),
    notes(settled, instrument: chord, scale: "major", key: 110, gain: 0.4),
    notes(xsteps, instrument: tick, scale: "hirajoshi", key: 880, gain: 0.3),
    notes(never, instrument: knock, scale: "hirajoshi", key: 82, gain: 0.6),
    notes(reel.cues, instrument: brush, scale: "chromatic", key: 100, gain: 0.3),
  ]

  render image(look, width: 1080, height: 1920, at: 0.5659)
  render video(look, fps: 30, width: 1080, height: 1920, sound: music, room: 0.12, echo: 0)
}
