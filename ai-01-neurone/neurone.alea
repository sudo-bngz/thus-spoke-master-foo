// Neurone — Thus Spoke Master Foo, AI 01: the perceptron. A novice asks
// how a machine learns; Master Foo hands him a scale with two pans. A
// neuron: inputs on weighted wires, a sum, a threshold, it fires or not.
// With two inputs it is a line; at first the line is wrong; the rule
// (show it a point; if wrong, move the weights toward the answer) swings
// the line until it is never wrong again (Rosenblatt, 1958). Then the
// limit: the opposite corners together, which no line separates. The
// edition draws the points; the weights are grown step by step by the
// rule itself (`grow`), so each edition learns its own line. Master Foo
// speaks Japanese, translated in the captions.

use "scenes/koan.alea"
use "scenes/cell.alea"
use "scenes/line.alea"
use "scenes/learn.alea"

work Neurone {
  let total = 106.2
  let T = t * total
  let EN = "../voices/narrator.sh"
  let JA = "../voices/master.sh"

  // ── the voices: the master, in Japanese; the one who explains, in English ──
  let m1 = say("弟子は尋ねた。機械は、どうやって学ぶのですか。", at: 1.40, engine: JA, voice: "jm_kumo", speed: 0.82, gain: 2.3)
  let m2 = say("師は、皿が二つある秤を渡した。", at: m1.end + 1.2, engine: JA, voice: "jm_kumo", speed: 0.82, gain: 2.3)
  let m3 = say("師は言った。重りを置け。間違えたら、動かせ。", at: m2.end + 1.2, engine: JA, voice: "jm_kumo", speed: 0.82, gain: 2.3)
  let n1 = say("A neuron is a small machine. Inputs come in, each through a wire with a weight.", at: 20.90, engine: EN, voice: "af_heart", speed: 0.95, gain: 2.3)
  let n2 = say("It adds them up: a heavy weight counts more. If the sum passes a threshold, it fires: one. If not: zero.", at: n1.end + 1.2, engine: EN, voice: "af_heart", speed: 0.95, gain: 2.3)
  let n3 = say("With two inputs, the neuron draws a line. On one side it fires, on the other it does not.", at: 37.20, engine: EN, voice: "af_heart", speed: 0.95, gain: 2.3)
  let n4 = say("At first the weights are random, and the line is wrong.", at: n3.end + 1.2, engine: EN, voice: "af_heart", speed: 0.95, gain: 2.3)
  let n5 = say("Learning is a rule: show it a point. If it is wrong, move the weights a little toward the right answer.", at: 50.90, engine: EN, voice: "af_heart", speed: 0.95, gain: 2.3)
  let n6 = say("Point by point, the line swings. After a few passes, it is never wrong again.", at: n5.end + 1.2, engine: EN, voice: "af_heart", speed: 0.95, gain: 2.3)
  let n7 = say("That is a perceptron, from nineteen fifty-eight. One cell. It can learn any line.", at: n6.end + 1.4, engine: EN, voice: "af_heart", speed: 0.95, gain: 2.3)
  let n8 = say("But some problems are not a line: here, the opposite corners go together.", at: 72.10, engine: EN, voice: "af_heart", speed: 0.95, gain: 2.3)
  let n9 = say("One neuron can swing forever and never find it. For that, you need several, in layers. Next time.", at: n8.end + 1.2, engine: EN, voice: "af_heart", speed: 0.95, gain: 2.3)
  let m4 = say("千回の間違いのあと、秤は正しく傾いた。", at: 87.40, engine: JA, voice: "jm_kumo", speed: 0.82, gain: 2.3)
  let m5 = say("師は言った。一つの秤では、引けない線もある。", at: m4.end + 1.2, engine: JA, voice: "jm_kumo", speed: 0.82, gain: 2.3)
  let m6 = say("その時、弟子は悟った。", at: m5.end + 1.4, engine: JA, voice: "jm_kumo", speed: 0.82, gain: 2.3)

  // ── the points: two kinds, drawn by the edition; and the four corners, the opposite ones together ──
  let N = 12
  let px = join([~between(0.1, 0.4) for q in range(6)], [~between(0.6, 0.9) for q in range(6)])
  let py = join([~between(0.2, 0.5) for q in range(6)], [~between(0.5, 0.8) for q in range(6)])
  let lab = join([-1 for q in range(6)], [1 for q in range(6)])
  let qx = [0.22 + ~between(-0.05, 0.05), 0.78 + ~between(-0.05, 0.05), 0.22 + ~between(-0.05, 0.05), 0.78 + ~between(-0.05, 0.05)]
  let qy = [0.22 + ~between(-0.05, 0.05), 0.78 + ~between(-0.05, 0.05), 0.78 + ~between(-0.05, 0.05), 0.22 + ~between(-0.05, 0.05)]
  let qlab = [1, 1, -1, -1]
  // ── the perceptron, grown: at each step one point is shown (step k, point k mod N);
  // if it is on the wrong side, the weights move a little toward it (the x * 0 keeps the rule
  // alive: a rule that reads neither x nor y is folded into a constant) ──
  let S = 144
  let lr = 0.12
  let w10 = 0.15
  let w20 = -0.25
  let b0 = 0.05
  grow over 4 for 144 {
    w1 = w10
      then w1 + x * 0 + lr * sum([((floor(t * S + 0.5) % N) == q) * (lab[q] * (w1 * px[q] + w2 * py[q] + b) <= 0) * lab[q] * px[q] for q in range(N)])
    w2 = w20
      then w2 + x * 0 + lr * sum([((floor(t * S + 0.5) % N) == q) * (lab[q] * (w1 * px[q] + w2 * py[q] + b) <= 0) * lab[q] * py[q] for q in range(N)])
    b = b0
      then b + x * 0 + lr * sum([((floor(t * S + 0.5) % N) == q) * (lab[q] * (w1 * px[q] + w2 * py[q] + b) <= 0) * lab[q] for q in range(N)])
    v1 = 0.3
      then v1 + x * 0 + lr * sum([((floor(t * S + 0.5) % 4) == q) * (qlab[q] * (v1 * qx[q] + v2 * qy[q] + c) <= 0) * qlab[q] * qx[q] for q in range(4)])
    v2 = 0.2
      then v2 + x * 0 + lr * sum([((floor(t * S + 0.5) % 4) == q) * (qlab[q] * (v1 * qx[q] + v2 * qy[q] + c) <= 0) * qlab[q] * qy[q] for q in range(4)])
    c = -0.2
      then c + x * 0 + lr * sum([((floor(t * S + 0.5) % 4) == q) * (qlab[q] * (v1 * qx[q] + v2 * qy[q] + c) <= 0) * qlab[q] for q in range(4)])
  }

  // ── the scenes: ink on paper, a vermilion accent, under the captions ──
  let PAPER = ["#efe9dc", "#d3c9b4", "#3b352c", "#17140f"]
  let fit(piece) = zoom(piece, by: 0.82, x: 0.5, y: 0.66)
  let ink(piece, accent) = overlay(paint(fit(piece), palette: PAPER, range: [0, 1]), paint(fit(accent), palette: ["#000000", "#c23b22"], range: [0, 1], alpha: fit(accent)))
  let reel = timeline([
      scene(ink(Koan(draw0: ((m1.start) - 0.00) / 19.5, draw1: ((m1.end) - 0.00) / 19.5, word: ((m3.end + 0.8) - 0.00) / 19.5, title: ((m3.end + 1.0) - 0.00) / 19.5, kana: ["ニ", "ュ", "ー", "ロ", "ン"], episode: "AI 01  ·  neuron", accent: 0), Koan(draw0: ((m1.start) - 0.00) / 19.5, draw1: ((m1.end) - 0.00) / 19.5, word: ((m3.end + 0.8) - 0.00) / 19.5, title: ((m3.end + 1.0) - 0.00) / 19.5, kana: ["ニ", "ュ", "ー", "ロ", "ン"], episode: "AI 01  ·  neuron", accent: 1)), 19.5),  wipe(0.8, angle: 0, softness: 0.12),
      scene(ink(Cell(inputs0: ((n1.words[5]) - 19.50) / 16.3, wires0: ((n1.words[10]) - 19.50) / 16.3, sum0: ((n2.words[1]) - 19.50) / 16.3, thresh0: ((n2.words[14]) - 19.50) / 16.3, fire0: ((n2.words[16]) - 19.50) / 16.3, again0: ((n2.words[18]) - 19.50) / 16.3, accent: 0), Cell(inputs0: ((n1.words[5]) - 19.50) / 16.3, wires0: ((n1.words[10]) - 19.50) / 16.3, sum0: ((n2.words[1]) - 19.50) / 16.3, thresh0: ((n2.words[14]) - 19.50) / 16.3, fire0: ((n2.words[16]) - 19.50) / 16.3, again0: ((n2.words[18]) - 19.50) / 16.3, accent: 1)), 16.3),  pixels(0.6, size: 0.05),
      scene(ink(Line(px: px, py: py, lab: lab, w1: w10, w2: w20, b: b0, points0: ((n3.start - 0.8) - 35.80) / 13.7, line0: ((n3.words[6]) - 35.80) / 13.7, fire0: ((n3.words[13]) - 35.80) / 13.7, wrong0: ((n4.words[9]) - 35.80) / 13.7, accent: 0), Line(px: px, py: py, lab: lab, w1: w10, w2: w20, b: b0, points0: ((n3.start - 0.8) - 35.80) / 13.7, line0: ((n3.words[6]) - 35.80) / 13.7, fire0: ((n3.words[13]) - 35.80) / 13.7, wrong0: ((n4.words[9]) - 35.80) / 13.7, accent: 1)), 13.7),  wipe(0.7, angle: 90, softness: 0.1),
      scene(ink(Learn(px: px, py: py, lab: lab, w1: w1, w2: w2, b: b, S: S, l0: ((n5.words[4]) - 49.50) / 21.2, l1: ((n6.end + 0.5) - 49.50) / 21.2, done: "never wrong again", accent: 0), Learn(px: px, py: py, lab: lab, w1: w1, w2: w2, b: b, S: S, l0: ((n5.words[4]) - 49.50) / 21.2, l1: ((n6.end + 0.5) - 49.50) / 21.2, done: "never wrong again", accent: 1)), 21.2),  morph(0.8, amount: 0.15),
      scene(ink(Learn(px: qx, py: qy, lab: qlab, w1: v1, w2: v2, b: c, S: S, l0: ((n9.words[0]) - 70.70) / 15.3, l1: ((n9.end + 1.0) - 70.70) / 15.3, done: "no line", accent: 0), Learn(px: qx, py: qy, lab: qlab, w1: v1, w2: v2, b: c, S: S, l0: ((n9.words[0]) - 70.70) / 15.3, l1: ((n9.end + 1.0) - 70.70) / 15.3, done: "no line", accent: 1)), 15.3),  wipe(0.8, angle: 180, softness: 0.12),
      scene(ink(Koan(draw0: ((m4.start) - 86.00) / 20.2, draw1: ((m6.end) - 86.00) / 20.2, word: ((m6.start + 0.5) - 86.00) / 20.2, title: ((m6.end + 0.6) - 86.00) / 20.2, kana: ["ニ", "ュ", "ー", "ロ", "ン"], episode: "AI 01  ·  neuron", accent: 0), Koan(draw0: ((m4.start) - 86.00) / 20.2, draw1: ((m6.end) - 86.00) / 20.2, word: ((m6.start + 0.5) - 86.00) / 20.2, title: ((m6.end + 0.6) - 86.00) / 20.2, kana: ["ニ", "ュ", "ー", "ロ", "ン"], episode: "AI 01  ·  neuron", accent: 1)), 20.2),  morph(1.2, amount: 0.2),
  ], loop: 1)

  // ── over it: the series, the step, the captions (the master's, translated, in vermilion) ──
  let adv = 0.021722
  let header = merge(text("1 / 4   the cell", x: 0.06, y: -0.15, size: 0.03, font: "mono", align: "left") * (reel.index > 1 - 0.5) * (reel.index < 1 + 0.5), text("2 / 4   the line", x: 0.06, y: -0.15, size: 0.03, font: "mono", align: "left") * (reel.index > 2 - 0.5) * (reel.index < 2 + 0.5), text("3 / 4   the rule", x: 0.06, y: -0.15, size: 0.03, font: "mono", align: "left") * (reel.index > 3 - 0.5) * (reel.index < 3 + 0.5), text("4 / 4   the limit", x: 0.06, y: -0.15, size: 0.03, font: "mono", align: "left") * (reel.index > 4 - 0.5) * (reel.index < 4 + 0.5)) * 0.7
  let series = text("thus spoke master foo  ·  AI 01", x: 0.94, y: -0.3, size: 0.024, font: "mono", align: "right") * 0.45
  let c_m1 = merge(text("The novice asked: how does a", x: 0.06, y: -0.060, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - m1.start) / (m1.duration * 0.92), 0, 1) * 43) - 0, 0, 28) * adv), text("machine learn?", x: 0.06, y: -0.008, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - m1.start) / (m1.duration * 0.92), 0, 1) * 43) - 29, 0, 14) * adv)) * (T >= m1.start) * (T < min(m1.end + 1.5, m2.start))
  let c_m2 = merge(text("Master Foo handed him a scale", x: 0.06, y: -0.060, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - m2.start) / (m2.duration * 0.92), 0, 1) * 42) - 0, 0, 29) * adv), text("with 2 pans.", x: 0.06, y: -0.008, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - m2.start) / (m2.duration * 0.92), 0, 1) * 42) - 30, 0, 12) * adv)) * (T >= m2.start) * (T < min(m2.end + 1.5, m3.start))
  let c_m3 = merge(text("Master Foo said: put the weights", x: 0.06, y: -0.060, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - m3.start) / (m3.duration * 0.92), 0, 1) * 65) - 0, 0, 32) * adv), text("on. When it is wrong, move them.", x: 0.06, y: -0.008, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - m3.start) / (m3.duration * 0.92), 0, 1) * 65) - 33, 0, 32) * adv)) * (T >= m3.start) * (T < min(m3.end + 1.5, n1.start))
  let c_n1 = merge(text("A neuron is a small machine.", x: 0.06, y: -0.060, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - n1.words[0]) / (n1.ends[0] - n1.words[0]), 0, 1) * 2 + clamp((T - n1.words[1]) / (n1.ends[1] - n1.words[1]), 0, 1) * 7 + clamp((T - n1.words[2]) / (n1.ends[2] - n1.words[2]), 0, 1) * 3 + clamp((T - n1.words[3]) / (n1.ends[3] - n1.words[3]), 0, 1) * 2 + clamp((T - n1.words[4]) / (n1.ends[4] - n1.words[4]), 0, 1) * 6 + clamp((T - n1.words[5]) / (n1.ends[5] - n1.words[5]), 0, 1) * 9 + clamp((T - n1.words[6]) / (n1.ends[6] - n1.words[6]), 0, 1) * 7 + clamp((T - n1.words[7]) / (n1.ends[7] - n1.words[7]), 0, 1) * 5 + clamp((T - n1.words[8]) / (n1.ends[8] - n1.words[8]), 0, 1) * 4 + clamp((T - n1.words[9]) / (n1.ends[9] - n1.words[9]), 0, 1) * 5 + clamp((T - n1.words[10]) / (n1.ends[10] - n1.words[10]), 0, 1) * 8 + clamp((T - n1.words[11]) / (n1.ends[11] - n1.words[11]), 0, 1) * 2 + clamp((T - n1.words[12]) / (n1.ends[12] - n1.words[12]), 0, 1) * 5 + clamp((T - n1.words[13]) / (n1.ends[13] - n1.words[13]), 0, 1) * 5 + clamp((T - n1.words[14]) / (n1.ends[14] - n1.words[14]), 0, 1) * 2 + clamp((T - n1.words[15]) / (n1.ends[15] - n1.words[15]), 0, 1) * 7) - 0, 0, 28) * adv), text("Inputs come in, each through a", x: 0.06, y: -0.008, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - n1.words[0]) / (n1.ends[0] - n1.words[0]), 0, 1) * 2 + clamp((T - n1.words[1]) / (n1.ends[1] - n1.words[1]), 0, 1) * 7 + clamp((T - n1.words[2]) / (n1.ends[2] - n1.words[2]), 0, 1) * 3 + clamp((T - n1.words[3]) / (n1.ends[3] - n1.words[3]), 0, 1) * 2 + clamp((T - n1.words[4]) / (n1.ends[4] - n1.words[4]), 0, 1) * 6 + clamp((T - n1.words[5]) / (n1.ends[5] - n1.words[5]), 0, 1) * 9 + clamp((T - n1.words[6]) / (n1.ends[6] - n1.words[6]), 0, 1) * 7 + clamp((T - n1.words[7]) / (n1.ends[7] - n1.words[7]), 0, 1) * 5 + clamp((T - n1.words[8]) / (n1.ends[8] - n1.words[8]), 0, 1) * 4 + clamp((T - n1.words[9]) / (n1.ends[9] - n1.words[9]), 0, 1) * 5 + clamp((T - n1.words[10]) / (n1.ends[10] - n1.words[10]), 0, 1) * 8 + clamp((T - n1.words[11]) / (n1.ends[11] - n1.words[11]), 0, 1) * 2 + clamp((T - n1.words[12]) / (n1.ends[12] - n1.words[12]), 0, 1) * 5 + clamp((T - n1.words[13]) / (n1.ends[13] - n1.words[13]), 0, 1) * 5 + clamp((T - n1.words[14]) / (n1.ends[14] - n1.words[14]), 0, 1) * 2 + clamp((T - n1.words[15]) / (n1.ends[15] - n1.words[15]), 0, 1) * 7) - 29, 0, 30) * adv), text("wire with a weight.", x: 0.06, y: 0.044, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - n1.words[0]) / (n1.ends[0] - n1.words[0]), 0, 1) * 2 + clamp((T - n1.words[1]) / (n1.ends[1] - n1.words[1]), 0, 1) * 7 + clamp((T - n1.words[2]) / (n1.ends[2] - n1.words[2]), 0, 1) * 3 + clamp((T - n1.words[3]) / (n1.ends[3] - n1.words[3]), 0, 1) * 2 + clamp((T - n1.words[4]) / (n1.ends[4] - n1.words[4]), 0, 1) * 6 + clamp((T - n1.words[5]) / (n1.ends[5] - n1.words[5]), 0, 1) * 9 + clamp((T - n1.words[6]) / (n1.ends[6] - n1.words[6]), 0, 1) * 7 + clamp((T - n1.words[7]) / (n1.ends[7] - n1.words[7]), 0, 1) * 5 + clamp((T - n1.words[8]) / (n1.ends[8] - n1.words[8]), 0, 1) * 4 + clamp((T - n1.words[9]) / (n1.ends[9] - n1.words[9]), 0, 1) * 5 + clamp((T - n1.words[10]) / (n1.ends[10] - n1.words[10]), 0, 1) * 8 + clamp((T - n1.words[11]) / (n1.ends[11] - n1.words[11]), 0, 1) * 2 + clamp((T - n1.words[12]) / (n1.ends[12] - n1.words[12]), 0, 1) * 5 + clamp((T - n1.words[13]) / (n1.ends[13] - n1.words[13]), 0, 1) * 5 + clamp((T - n1.words[14]) / (n1.ends[14] - n1.words[14]), 0, 1) * 2 + clamp((T - n1.words[15]) / (n1.ends[15] - n1.words[15]), 0, 1) * 7) - 60, 0, 19) * adv)) * (T >= n1.start) * (T < min(n1.end + 1.5, n2.start))
