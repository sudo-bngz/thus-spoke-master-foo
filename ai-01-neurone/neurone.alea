// Neurone — Thus Spoke Master Foo, AI 01: the perceptron. A novice asks
// how a machine learns; Master Foo hands him a scale with two pans. A
// neuron: inputs on weighted wires, a sum, a threshold, it fires or not.
// With two inputs it is a line; at first the line is wrong; the rule
// (show it a point; if wrong, move the weights toward the answer) swings
// the line until it is never wrong again (Rosenblatt, 1958). Then the
// limit: the opposite corners together, which no line separates. The
// edition draws the points; the weights are grown step by step by the
// rule itself (`grow`), so each edition learns its own line. Master Foo
// speaks Japanese, translated in the captions.

use "scenes/koan.alea"
use "scenes/cell.alea"
use "scenes/line.alea"
use "scenes/learn.alea"

work Neurone {
  let total = 180.3
  let T = t * total
  let EN = "../voices/narrator.sh"
  let JA = "../voices/master.sh"

  // ── the voices: the master, in Japanese; the one who explains, in English ──
  let m1 = say("弟子は尋ねた。機械は、どうやって学ぶのですか。", at: 1.50, engine: JA, voice: "jm_kumo", speed: 0.82, gain: 2.3)
  let m2 = say("師は、皿が二つある秤を渡した。", at: m1.end + 1.4, engine: JA, voice: "jm_kumo", speed: 0.82, gain: 2.3)
  let m3 = say("師は言った。重りを置け。間違えたら、動かせ。", at: m2.end + 1.4, engine: JA, voice: "jm_kumo", speed: 0.82, gain: 2.3)
  let n1 = say("A neuron is a small machine that makes one decision: yes, or no.", at: 20.90, engine: EN, voice: "af_heart", speed: 1.0, gain: 2.3)
  let n2 = say("It has inputs. Here, three of them. Each input is a number: how strong that signal is.", at: n1.end + 1.4, engine: EN, voice: "af_heart", speed: 1.0, gain: 2.3)
  let n3 = say("Each input arrives through a wire. And each wire has a weight: how much that input counts.", at: n2.end + 1.4, engine: EN, voice: "af_heart", speed: 1.0, gain: 2.3)
  let n4 = say("A heavy weight: this input matters a lot. A light one: it barely matters.", at: n3.end + 1.6, engine: EN, voice: "af_heart", speed: 1.0, gain: 2.3)
  let n5 = say("The neuron multiplies each input by its weight, and adds everything up.", at: n4.end + 1.4, engine: EN, voice: "af_heart", speed: 1.0, gain: 2.3)
  let n6 = say("Then it compares the sum to a threshold.", at: n5.end + 1.6, engine: EN, voice: "af_heart", speed: 1.0, gain: 2.3)
  let n7 = say("Above the threshold, it fires: one. Yes.", at: n6.end + 1.6, engine: EN, voice: "af_heart", speed: 1.0, gain: 2.3)
  let n8 = say("Other inputs. The sum stays below. Nothing: zero. No.", at: n7.end + 1.6, engine: EN, voice: "af_heart", speed: 1.0, gain: 2.3)
  let n9 = say("That is all a neuron does. Weigh, add, decide.", at: n8.end + 1.4, engine: EN, voice: "af_heart", speed: 1.0, gain: 2.3)
  let n10 = say("Now give it two inputs only, and draw them as a point: input one left to right, input two bottom to top.", at: 70.60, engine: EN, voice: "af_heart", speed: 1.0, gain: 2.3)
  let n11 = say("Here are points of two kinds: hollow, and full. We want the neuron to fire on the full ones only.", at: n10.end + 1.4, engine: EN, voice: "af_heart", speed: 1.0, gain: 2.3)
  let n12 = say("With two inputs, the neuron's decision is a straight line. On one side it fires. On the other, it stays quiet.", at: n11.end + 1.4, engine: EN, voice: "af_heart", speed: 1.0, gain: 2.3)
  let n14 = say("At first, the weights are random. So the line is random, and some points are on the wrong side.", at: n12.end + 1.4, engine: EN, voice: "af_heart", speed: 1.0, gain: 2.3)
  let n15 = say("How does it learn? With a rule simple enough to say in one sentence.", at: 101.60, engine: EN, voice: "af_heart", speed: 1.0, gain: 2.3)
  let n16 = say("Show it one point. If the neuron is right, do nothing.", at: n15.end + 1.4, engine: EN, voice: "af_heart", speed: 1.0, gain: 2.3)
  let n17 = say("If it is wrong, move every weight a little, toward the right answer. The line shifts a bit.", at: n16.end + 1.4, engine: EN, voice: "af_heart", speed: 1.0, gain: 2.3)
  let n18 = say("Then the next point. And the next. One by one, around and around.", at: n17.end + 1.4, engine: EN, voice: "af_heart", speed: 1.0, gain: 2.3)
  let n20 = say("Until one pass goes by without a single mistake. Then it stops. It has learned.", at: n18.end + 1.4, engine: EN, voice: "af_heart", speed: 1.0, gain: 2.3)
  let n21 = say("This is the perceptron, from nineteen fifty-eight. One cell, one rule, any line.", at: n20.end + 1.4, engine: EN, voice: "af_heart", speed: 1.0, gain: 2.3)
  let n23 = say("But some problems are not a line. Here, the full points sit in opposite corners.", at: 137.30, engine: EN, voice: "af_heart", speed: 1.0, gain: 2.3)
  let n24 = say("You can't. Whichever way the line turns, two points are always on the wrong side.", at: n23.end + 1.4, engine: EN, voice: "af_heart", speed: 1.0, gain: 2.3)
  let n25 = say("The neuron swings forever, and never settles. One cell is not enough.", at: n24.end + 1.4, engine: EN, voice: "af_heart", speed: 1.0, gain: 2.3)
  let n26 = say("For this, you need several neurons, in layers. That is the next episode.", at: n25.end + 1.4, engine: EN, voice: "af_heart", speed: 1.0, gain: 2.3)
  let m4 = say("千回の間違いのあと、秤は正しく傾いた。", at: 162.10, engine: JA, voice: "jm_kumo", speed: 0.82, gain: 2.3)
  let m5 = say("師は言った。一つの秤では、引けない線もある。", at: m4.end + 1.4, engine: JA, voice: "jm_kumo", speed: 0.82, gain: 2.3)
  let m6 = say("その時、弟子は悟った。", at: m5.end + 1.6, engine: JA, voice: "jm_kumo", speed: 0.82, gain: 2.3)

  // ── the points: two kinds, drawn by the edition; and the four corners, the opposite ones together ──
  let N = 12
  let px = join([~between(0.1, 0.4) for q in range(6)], [~between(0.6, 0.9) for q in range(6)])
  let py = join([~between(0.2, 0.5) for q in range(6)], [~between(0.5, 0.8) for q in range(6)])
  let lab = join([-1 for q in range(6)], [1 for q in range(6)])
  let qx = [0.22 + ~between(-0.05, 0.05), 0.78 + ~between(-0.05, 0.05), 0.22 + ~between(-0.05, 0.05), 0.78 + ~between(-0.05, 0.05)]
  let qy = [0.22 + ~between(-0.05, 0.05), 0.78 + ~between(-0.05, 0.05), 0.78 + ~between(-0.05, 0.05), 0.22 + ~between(-0.05, 0.05)]
  let qlab = [1, 1, -1, -1]
  // ── the perceptron, grown: at each step one point is shown (step k, point k mod N);
  // if it is on the wrong side, the weights move a little toward it (the x * 0 keeps the rule
  // alive: a rule that reads neither x nor y is folded into a constant) ──
  let S = 144
  let lr = 0.12
  let w10 = 0.15
  let w20 = -0.25
  let b0 = 0.05
  grow over 4 for 144 {
    w1 = w10
      then w1 + x * 0 + lr * sum([((floor(t * S + 0.5) % N) == q) * (lab[q] * (w1 * px[q] + w2 * py[q] + b) <= 0) * lab[q] * px[q] for q in range(N)])
    w2 = w20
      then w2 + x * 0 + lr * sum([((floor(t * S + 0.5) % N) == q) * (lab[q] * (w1 * px[q] + w2 * py[q] + b) <= 0) * lab[q] * py[q] for q in range(N)])
    b = b0
      then b + x * 0 + lr * sum([((floor(t * S + 0.5) % N) == q) * (lab[q] * (w1 * px[q] + w2 * py[q] + b) <= 0) * lab[q] for q in range(N)])
    v1 = 0.3
      then v1 + x * 0 + lr * sum([((floor(t * S + 0.5) % 4) == q) * (qlab[q] * (v1 * qx[q] + v2 * qy[q] + c) <= 0) * qlab[q] * qx[q] for q in range(4)])
    v2 = 0.2
      then v2 + x * 0 + lr * sum([((floor(t * S + 0.5) % 4) == q) * (qlab[q] * (v1 * qx[q] + v2 * qy[q] + c) <= 0) * qlab[q] * qy[q] for q in range(4)])
    c = -0.2
      then c + x * 0 + lr * sum([((floor(t * S + 0.5) % 4) == q) * (qlab[q] * (v1 * qx[q] + v2 * qy[q] + c) <= 0) * qlab[q] for q in range(4)])
  }

  // ── the scenes: ink on paper, a vermilion accent, under the captions ──
  let PAPER = ["#efe9dc", "#d3c9b4", "#3b352c", "#17140f"]
  let fit(piece) = zoom(piece, by: 0.82, x: 0.5, y: 0.66)
  let ink(piece, accent) = overlay(paint(fit(piece), palette: PAPER, range: [0, 1]), paint(fit(accent), palette: ["#000000", "#c23b22"], range: [0, 1], alpha: fit(accent)))
  let reel = timeline([
      scene(ink(Koan(draw0: ((m1.start) - 0.00) / 19.4, draw1: ((m1.end) - 0.00) / 19.4, word: ((m3.end + 0.8) - 0.00) / 19.4, title: ((m3.end + 1.0) - 0.00) / 19.4, kana: ["ニ", "ュ", "ー", "ロ", "ン"], episode: "AI 01  ·  neuron", accent: 0), Koan(draw0: ((m1.start) - 0.00) / 19.4, draw1: ((m1.end) - 0.00) / 19.4, word: ((m3.end + 0.8) - 0.00) / 19.4, title: ((m3.end + 1.0) - 0.00) / 19.4, kana: ["ニ", "ュ", "ー", "ロ", "ン"], episode: "AI 01  ·  neuron", accent: 1)), 19.4),  wipe(0.8, angle: 0, softness: 0.12),
      scene(ink(Cell(inputs0: ((n2.words[2]) - 19.40) / 49.7, wires0: ((n3.words[4]) - 19.40) / 49.7, heavy0: ((n4.words[0]) - 19.40) / 49.7, light0: ((n4.words[8]) - 19.40) / 49.7, sum0: ((n5.words[8]) - 19.40) / 49.7, thresh0: ((n6.words[6]) - 19.40) / 49.7, fire0: ((n7.words[3]) - 19.40) / 49.7, again0: ((n8.words[0]) - 19.40) / 49.7, zero0: ((n8.words[7]) - 19.40) / 49.7, accent: 0), Cell(inputs0: ((n2.words[2]) - 19.40) / 49.7, wires0: ((n3.words[4]) - 19.40) / 49.7, heavy0: ((n4.words[0]) - 19.40) / 49.7, light0: ((n4.words[8]) - 19.40) / 49.7, sum0: ((n5.words[8]) - 19.40) / 49.7, thresh0: ((n6.words[6]) - 19.40) / 49.7, fire0: ((n7.words[3]) - 19.40) / 49.7, again0: ((n8.words[0]) - 19.40) / 49.7, zero0: ((n8.words[7]) - 19.40) / 49.7, accent: 1)), 49.7),  pixels(0.6, size: 0.05),
      scene(ink(Line(px: px, py: py, lab: lab, w1: w10, w2: w20, b: b0, axes0: ((n10.words[9]) - 69.10) / 31.0, points0: ((n11.words[0]) - 69.10) / 31.0, line0: ((n12.words[6]) - 69.10) / 31.0, fire0: ((n12.words[10]) - 69.10) / 31.0, wrong0: ((n14.words[12]) - 69.10) / 31.0, accent: 0), Line(px: px, py: py, lab: lab, w1: w10, w2: w20, b: b0, axes0: ((n10.words[9]) - 69.10) / 31.0, points0: ((n11.words[0]) - 69.10) / 31.0, line0: ((n12.words[6]) - 69.10) / 31.0, fire0: ((n12.words[10]) - 69.10) / 31.0, wrong0: ((n14.words[12]) - 69.10) / 31.0, accent: 1)), 31.0),  wipe(0.7, angle: 90, softness: 0.1),
      scene(ink(Learn(px: px, py: py, lab: lab, w1: w1, w2: w2, b: b, S: S, l0: ((n16.words[0]) - 100.10) / 35.7, l1: ((n20.words[11]) - 100.10) / 35.7, pace: 2.5, done: "never wrong again", accent: 0), Learn(px: px, py: py, lab: lab, w1: w1, w2: w2, b: b, S: S, l0: ((n16.words[0]) - 100.10) / 35.7, l1: ((n20.words[11]) - 100.10) / 35.7, pace: 2.5, done: "never wrong again", accent: 1)), 35.7),  morph(0.8, amount: 0.15),
      scene(ink(Learn(px: qx, py: qy, lab: qlab, w1: v1, w2: v2, b: c, S: S, l0: ((n24.words[2]) - 135.80) / 24.8, l1: ((n25.end) - 135.80) / 24.8, pace: 1.8, done: "no line", accent: 0), Learn(px: qx, py: qy, lab: qlab, w1: v1, w2: v2, b: c, S: S, l0: ((n24.words[2]) - 135.80) / 24.8, l1: ((n25.end) - 135.80) / 24.8, pace: 1.8, done: "no line", accent: 1)), 24.8),  wipe(0.8, angle: 180, softness: 0.12),
      scene(ink(Koan(draw0: ((m4.start) - 160.60) / 19.7, draw1: ((m6.end) - 160.60) / 19.7, word: ((m6.start + 0.5) - 160.60) / 19.7, title: ((m6.end + 0.6) - 160.60) / 19.7, kana: ["ニ", "ュ", "ー", "ロ", "ン"], episode: "AI 01  ·  neuron", accent: 0), Koan(draw0: ((m4.start) - 160.60) / 19.7, draw1: ((m6.end) - 160.60) / 19.7, word: ((m6.start + 0.5) - 160.60) / 19.7, title: ((m6.end + 0.6) - 160.60) / 19.7, kana: ["ニ", "ュ", "ー", "ロ", "ン"], episode: "AI 01  ·  neuron", accent: 1)), 19.7),  morph(1.2, amount: 0.2),
  ], loop: 1)

  // ── over it: the series, the step, the captions (the master's, translated, in vermilion) ──
  let adv = 0.021722
  let header = merge(text("1 / 4   the cell", x: 0.06, y: -0.15, size: 0.03, font: "mono", align: "left") * (reel.index > 1 - 0.5) * (reel.index < 1 + 0.5), text("2 / 4   the line", x: 0.06, y: -0.15, size: 0.03, font: "mono", align: "left") * (reel.index > 2 - 0.5) * (reel.index < 2 + 0.5), text("3 / 4   the rule", x: 0.06, y: -0.15, size: 0.03, font: "mono", align: "left") * (reel.index > 3 - 0.5) * (reel.index < 3 + 0.5), text("4 / 4   the limit", x: 0.06, y: -0.15, size: 0.03, font: "mono", align: "left") * (reel.index > 4 - 0.5) * (reel.index < 4 + 0.5)) * 0.7
  let series = text("thus spoke master foo  ·  AI 01", x: 0.94, y: -0.3, size: 0.024, font: "mono", align: "right") * 0.45
  let c_m1 = merge(text("The novice asked: how does a", x: 0.06, y: -0.060, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - m1.start) / (m1.duration * 0.92), 0, 1) * 43) - 0, 0, 28) * adv), text("machine learn?", x: 0.06, y: -0.008, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - m1.start) / (m1.duration * 0.92), 0, 1) * 43) - 29, 0, 14) * adv)) * (T >= m1.start) * (T < min(m1.end + 1.5, m2.start))
  let c_m2 = merge(text("Master Foo handed him a scale", x: 0.06, y: -0.060, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - m2.start) / (m2.duration * 0.92), 0, 1) * 42) - 0, 0, 29) * adv), text("with 2 pans.", x: 0.06, y: -0.008, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - m2.start) / (m2.duration * 0.92), 0, 1) * 42) - 30, 0, 12) * adv)) * (T >= m2.start) * (T < min(m2.end + 1.5, m3.start))
  let c_m3 = merge(text("Master Foo said: put the weights", x: 0.06, y: -0.060, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - m3.start) / (m3.duration * 0.92), 0, 1) * 65) - 0, 0, 32) * adv), text("on. When it is wrong, move them.", x: 0.06, y: -0.008, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - m3.start) / (m3.duration * 0.92), 0, 1) * 65) - 33, 0, 32) * adv)) * (T >= m3.start) * (T < min(m3.end + 1.5, n1.start))
  let c_n1 = merge(text("A neuron is a small machine that", x: 0.06, y: -0.060, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - n1.start) / (n1.duration * 0.92), 0, 1) * 62) - 0, 0, 32) * adv), text("makes 1 decision: yes, or no.", x: 0.06, y: -0.008, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - n1.start) / (n1.duration * 0.92), 0, 1) * 62) - 33, 0, 29) * adv)) * (T >= n1.start) * (T < min(n1.end + 1.5, n2.start))
