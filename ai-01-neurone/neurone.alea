.words[9]), 0, 1) * 5 + clamp((T - n23.words[10]) / (n23.ends[10] - n23.words[10]), 0, 1) * 7 + clamp((T - n23.words[11]) / (n23.ends[11] - n23.words[11]), 0, 1) * 4 + clamp((T - n23.words[12]) / (n23.ends[12] - n23.words[12]), 0, 1) * 3 + clamp((T - n23.words[13]) / (n23.ends[13] - n23.words[13]), 0, 1) * 9 + clamp((T - n23.words[14]) / (n23.ends[14] - n23.words[14]), 0, 1) * 8) - 34, 0, 28) * adv), text("opposite corners.", x: 0.06, y: 0.044, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - n23.words[0]) / (n23.ends[0] - n23.words[0]), 0, 1) * 4 + clamp((T - n23.words[1]) / (n23.ends[1] - n23.words[1]), 0, 1) * 5 + clamp((T - n23.words[2]) / (n23.ends[2] - n23.words[2]), 0, 1) * 9 + clamp((T - n23.words[3]) / (n23.ends[3] - n23.words[3]), 0, 1) * 4 + clamp((T - n23.words[4]) / (n23.ends[4] - n23.words[4]), 0, 1) * 4 + clamp((T - n23.words[5]) / (n23.ends[5] - n23.words[5]), 0, 1) * 2 + clamp((T - n23.words[6]) / (n23.ends[6] - n23.words[6]), 0, 1) * 6 + clamp((T - n23.words[7]) / (n23.ends[7] - n23.words[7]), 0, 1) * 6 + clamp((T - n23.words[8]) / (n23.ends[8] - n23.words[8]), 0, 1) * 4 + clamp((T - n23.words[9]) / (n23.ends[9] - n23.words[9]), 0, 1) * 5 + clamp((T - n23.words[10]) / (n23.ends[10] - n23.words[10]), 0, 1) * 7 + clamp((T - n23.words[11]) / (n23.ends[11] - n23.words[11]), 0, 1) * 4 + clamp((T - n23.words[12]) / (n23.ends[12] - n23.words[12]), 0, 1) * 3 + clamp((T - n23.words[13]) / (n23.ends[13] - n23.words[13]), 0, 1) * 9 + clamp((T - n23.words[14]) / (n23.ends[14] - n23.words[14]), 0, 1) * 8) - 63, 0, 17) * adv)) * (T >= n23.start) * (T < min(n23.end + 1.5, n24.start))
  let c_n24 = merge(text("You can't. Whichever way the line", x: 0.06, y: -0.060, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - n24.start) / (n24.duration * 0.92), 0, 1) * 79) - 0, 0, 33) * adv), text("turns, 2 points are always on the", x: 0.06, y: -0.008, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - n24.start) / (n24.duration * 0.92), 0, 1) * 79) - 34, 0, 33) * adv), text("wrong side.", x: 0.06, y: 0.044, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - n24.start) / (n24.duration * 0.92), 0, 1) * 79) - 68, 0, 11) * adv)) * (T >= n24.start) * (T < min(n24.end + 1.5, n25.start))
  let c_n25 = merge(text("The neuron swings forever, and", x: 0.06, y: -0.060, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - n25.start) / (n25.duration * 0.92), 0, 1) * 67) - 0, 0, 30) * adv), text("never settles. 1 cell is not", x: 0.06, y: -0.008, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - n25.start) / (n25.duration * 0.92), 0, 1) * 67) - 31, 0, 28) * adv), text("enough.", x: 0.06, y: 0.044, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - n25.start) / (n25.duration * 0.92), 0, 1) * 67) - 60, 0, 7) * adv)) * (T >= n25.start) * (T < min(n25.end + 1.5, n26.start))
  let c_n26 = merge(text("For this, you need several", x: 0.06, y: -0.060, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - n26.words[0]) / (n26.ends[0] - n26.words[0]), 0, 1) * 4 + clamp((T - n26.words[1]) / (n26.ends[1] - n26.words[1]), 0, 1) * 6 + clamp((T - n26.words[2]) / (n26.ends[2] - n26.words[2]), 0, 1) * 4 + clamp((T - n26.words[3]) / (n26.ends[3] - n26.words[3]), 0, 1) * 5 + clamp((T - n26.words[4]) / (n26.ends[4] - n26.words[4]), 0, 1) * 8 + clamp((T - n26.words[5]) / (n26.ends[5] - n26.words[5]), 0, 1) * 9 + clamp((T - n26.words[6]) / (n26.ends[6] - n26.words[6]), 0, 1) * 3 + clamp((T - n26.words[7]) / (n26.ends[7] - n26.words[7]), 0, 1) * 8 + clamp((T - n26.words[8]) / (n26.ends[8] - n26.words[8]), 0, 1) * 5 + clamp((T - n26.words[9]) / (n26.ends[9] - n26.words[9]), 0, 1) * 3 + clamp((T - n26.words[10]) / (n26.ends[10] - n26.words[10]), 0, 1) * 4 + clamp((T - n26.words[11]) / (n26.ends[11] - n26.words[11]), 0, 1) * 5 + clamp((T - n26.words[12]) / (n26.ends[12] - n26.words[12]), 0, 1) * 8) - 0, 0, 26) * adv), text("neurons, in layers. That is the", x: 0.06, y: -0.008, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - n26.words[0]) / (n26.ends[0] - n26.words[0]), 0, 1) * 4 + clamp((T - n26.words[1]) / (n26.ends[1] - n26.words[1]), 0, 1) * 6 + clamp((T - n26.words[2]) / (n26.ends[2] - n26.words[2]), 0, 1) * 4 + clamp((T - n26.words[3]) / (n26.ends[3] - n26.words[3]), 0, 1) * 5 + clamp((T - n26.words[4]) / (n26.ends[4] - n26.words[4]), 0, 1) * 8 + clamp((T - n26.words[5]) / (n26.ends[5] - n26.words[5]), 0, 1) * 9 + clamp((T - n26.words[6]) / (n26.ends[6] - n26.words[6]), 0, 1) * 3 + clamp((T - n26.words[7]) / (n26.ends[7] - n26.words[7]), 0, 1) * 8 + clamp((T - n26.words[8]) / (n26.ends[8] - n26.words[8]), 0, 1) * 5 + clamp((T - n26.words[9]) / (n26.ends[9] - n26.words[9]), 0, 1) * 3 + clamp((T - n26.words[10]) / (n26.ends[10] - n26.words[10]), 0, 1) * 4 + clamp((T - n26.words[11]) / (n26.ends[11] - n26.words[11]), 0, 1) * 5 + clamp((T - n26.words[12]) / (n26.ends[12] - n26.words[12]), 0, 1) * 8) - 27, 0, 31) * adv), text("next episode.", x: 0.06, y: 0.044, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - n26.words[0]) / (n26.ends[0] - n26.words[0]), 0, 1) * 4 + clamp((T - n26.words[1]) / (n26.ends[1] - n26.words[1]), 0, 1) * 6 + clamp((T - n26.words[2]) / (n26.ends[2] - n26.words[2]), 0, 1) * 4 + clamp((T - n26.words[3]) / (n26.ends[3] - n26.words[3]), 0, 1) * 5 + clamp((T - n26.words[4]) / (n26.ends[4] - n26.words[4]), 0, 1) * 8 + clamp((T - n26.words[5]) / (n26.ends[5] - n26.words[5]), 0, 1) * 9 + clamp((T - n26.words[6]) / (n26.ends[6] - n26.words[6]), 0, 1) * 3 + clamp((T - n26.words[7]) / (n26.ends[7] - n26.words[7]), 0, 1) * 8 + clamp((T - n26.words[8]) / (n26.ends[8] - n26.words[8]), 0, 1) * 5 + clamp((T - n26.words[9]) / (n26.ends[9] - n26.words[9]), 0, 1) * 3 + clamp((T - n26.words[10]) / (n26.ends[10] - n26.words[10]), 0, 1) * 4 + clamp((T - n26.words[11]) / (n26.ends[11] - n26.words[11]), 0, 1) * 5 + clamp((T - n26.words[12]) / (n26.ends[12] - n26.words[12]), 0, 1) * 8) - 59, 0, 13) * adv)) * (T >= n26.start) * (T < min(n26.end + 1.5, m4.start))
  let c_m4 = merge(text("After 1 000 mistakes, the scale", x: 0.06, y: -0.060, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - m4.start) / (m4.duration * 0.92), 0, 1) * 45) - 0, 0, 31) * adv), text("tipped right.", x: 0.06, y: -0.008, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - m4.start) / (m4.duration * 0.92), 0, 1) * 45) - 32, 0, 13) * adv)) * (T >= m4.start) * (T < min(m4.end + 1.5, m5.start))
  let c_m5 = merge(text("Master Foo said: there are lines", x: 0.06, y: -0.060, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - m5.start) / (m5.duration * 0.92), 0, 1) * 53) - 0, 0, 32) * adv), text("1 scale cannot draw.", x: 0.06, y: -0.008, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - m5.start) / (m5.duration * 0.92), 0, 1) * 53) - 33, 0, 20) * adv)) * (T >= m5.start) * (T < min(m5.end + 1.5, m6.start))
  let c_m6 = text("And the novice was enlightened.", x: 0.06, y: -0.060, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - m6.start) / (m6.duration * 0.92), 0, 1) * 31) - 0, 0, 31) * adv) * (T >= m6.start) * (T < m6.end + 3)
  let said = merge(c_n1, c_n2, c_n3, c_n4, c_n5, c_n6, c_n7, c_n8, c_n9, c_n10, c_n11, c_n12, c_n14, c_n15, c_n16, c_n17, c_n18, c_n20, c_n21, c_n23, c_n24, c_n25, c_n26)
  let spoken = merge(c_m1, c_m2, c_m3, c_m4, c_m5, c_m6)
  let dark = paint(merge(header, series, said), palette: ["#000000", "#1a1712"], range: [0, 1], alpha: merge(header, series, said))
  let red  = paint(spoken, palette: ["#000000", "#b8361f"], range: [0, 1], alpha: spoken)
  let look = film(vignette(overlay(reel, dark, red), amount: 0.06), amount: 0.035)

  // ── the sound ──
  let pad = synth {
    let env = adsr(attack: 3, decay: 1, sustain: 0.9, release: 4)
    lowpass(saw(note.freq) + saw(note.freq * 1.003) + sine(note.freq * 0.5), cutoff: 260 + 300 * note.level, resonance: 0.2) * env
  }
  let brush = synth { bandpass(noise(), cutoff: 1400, resonance: 0.3) * adsr(attack: 0.12, decay: 0.3, sustain: 0.3, release: 0.5) * note.velocity }
  let tick = synth { highpass(noise(), cutoff: 4000, resonance: 0.2) * perc(release: 0.015) * note.velocity + sine(note.freq) * perc(release: 0.05) * 0.4 }
  let knock = synth { lowpass(noise(), cutoff: 700, resonance: 0.5) * perc(attack: 0.002, release: 0.12) * note.velocity + sine(note.freq) * perc(release: 0.1) * 0.5 }
  let chord = synth {
    let env = adsr(attack: 0.3, decay: 0.6, sustain: 0.8, release: 2.5)
    chorus(lowpass(saw(note.freq) + saw(note.freq * 1.004) + sine(note.freq * 0.5), cutoff: 1200, resonance: 0.15) * env, depth: 0.6)
  }
  // the temple bell when the master speaks; the scale handed over
  pattern bells = repeat 2 event(t: [m1.start - 1.0, m4.start - 1.0][i] / total, x: 0.5, y: 0.95, size: 0.12, intensity: 0.9)
  pattern scale = repeat 1 event(t: m2.start / total + 0.6 * m2.duration / total, x: 0.5, y: 0.5, size: 0.06, intensity: 0.8)
  // the cell: the inputs, the sum filling, the fire, the second try
  pattern inputs = repeat 3 event(t: (n2.words[2] + 0.04 * 49.7 * i) / total, x: 0.2, y: 0.4 + 0.15 * i, intensity: 0.5)
  pattern fires = repeat 1 event(t: n7.words[3] / total, x: 0.86, y: 0.5, size: 0.08, intensity: 0.9)
  pattern silent = repeat 1 event(t: n8.words[7] / total, x: 0.86, y: 0.5, size: 0.04, intensity: 0.4)
  // the line drawn, the wrong points ringed
  pattern drawn = repeat 1 event(t: n12.words[6] / total, x: 0.5, y: 0.5, size: 0.08, intensity: 0.7)
  pattern wrongs = repeat 4 event(t: (n14.words[12] + 0.12 * i) / total, x: 0.3 + 0.1 * i, y: 0.4, intensity: 0.6)
  // the steps: a tick at each, slowly then faster; the pass changes ring
  pattern steps = repeat 144 event(t: (n16.words[0] + (n20.words[11] - n16.words[0]) * ((i + 1) / 144) ^ (1 / 2.5)) / total, x: 0.3 + 0.4 * (i % 2), y: 0.6 - 0.3 * (i % 12) / 12, intensity: 0.35 + 0.3 * ((i % 12) == 0))
  pattern settled = repeat 3 event(t: n20.words[11] / total, x: 0.5, y: [0.5, 0.4, 0.3][i], size: 0.1, intensity: 0.7)
  pattern xsteps = repeat 144 event(t: (n24.words[2] + (n25.end - n24.words[2]) * ((i + 1) / 144) ^ (1 / 1.8)) / total, x: 0.3 + 0.4 * (i % 2), y: 0.6 - 0.3 * (i % 4) / 4, intensity: 0.35 + 0.3 * ((i % 4) == 0))
  pattern never = repeat 1 event(t: n25.end / total, x: 0.5, y: 0.7, size: 0.1, intensity: 0.8)

  let music = [
    m1, m2, m3, n1, n2, n3, n4, n5, n6, n7, n8, n9, n10, n11, n12, n14, n15, n16, n17, n18, n20, n21, n23, n24, n25, n26, m4, m5, m6,
    drone(0.45 + 0.15 * lfo(3) + x * 0, voices: 2, instrument: pad, scale: "hirajoshi", key: 55, gain: 0.9),
    notes(bells, instrument: "bell", scale: "hirajoshi", key: 110, gain: 0.7),
    notes(scale, instrument: "kalimba", scale: "hirajoshi", key: 392, gain: 0.6),
    notes(inputs, instrument: "kalimba", scale: "hirajoshi", key: 392, gain: 0.4),
    notes(fires, instrument: chord, scale: "major", key: 110, gain: 0.45),
    notes(silent, instrument: knock, scale: "hirajoshi", key: 110, gain: 0.4),
    notes(drawn, instrument: "glass", scale: "hirajoshi", key: 392, gain: 0.5),
    notes(wrongs, instrument: knock, scale: "hirajoshi", key: 165, gain: 0.45),
    notes(steps, instrument: tick, scale: "hirajoshi", key: 880, gain: 0.3),
    notes(settled, instrument: chord, scale: "major", key: 110, gain: 0.4),
    notes(xsteps, instrument: tick, scale: "hirajoshi", key: 880, gain: 0.3),
    notes(never, instrument: knock, scale: "hirajoshi", key: 82, gain: 0.6),
    notes(reel.cues, instrument: brush, scale: "chromatic", key: 100, gain: 0.3),
  ]

  render image(look, width: 1080, height: 1920, at: 0.6542)
  render video(look, fps: 30, width: 1080, height: 1920, sound: music, room: 0.12, echo: 0)
}
