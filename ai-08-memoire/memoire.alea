// Mémoire — Thus Spoke Master Foo, AI 08: the window. The weights never
// change once training is done; a conversation lives in the text, fed
// back in whole at every message; the text has a limit, the window;
// why: every token looks at every other, so twice the text is 4 times
// the work; at the edge the oldest tokens fall out, never seen; and the
// machine's two memories, the weights and the window, with the trick: a
// note at the top of the window. The window of 12 is illustrative.
// Master Foo speaks Japanese, translated in the captions.

use "scenes/koan.alea"
use "scenes/window.alea"
use "scenes/cost.alea"
use "scenes/edge.alea"
use "scenes/two.alea"

work Memoire {
  let total = 147.4
  let T = t * total
  let EN = "../voices/narrator.sh"
  let JA = "../voices/master.sh"

  // ── the voices: the master, in Japanese; the one who explains, in English ──
  let m1 = say("弟子は尋ねた。機械は、私のことを覚えていますか。", at: 1.50, engine: JA, voice: "jm_kumo", speed: 0.82, gain: 2.3)
  let m2 = say("師は言った。昨日、機械と何を話した？", at: m1.end + 1.4, engine: JA, voice: "jm_kumo", speed: 0.82, gain: 2.3)
  let m3 = say("弟子は答えた。覚えていません。師は言った。機械も同じだ。", at: m2.end + 1.4, engine: JA, voice: "jm_kumo", speed: 0.82, gain: 2.3)
  let n1 = say("Last time, the weights. Once training is done, they never change. Ask the machine a question today, or next year: the same weights answer.", at: 22.80, engine: EN, voice: "af_heart", speed: 1.0, gain: 2.3)
  let n2 = say("So where does a conversation live? Not in the weights. In the text. Every time you send a message, the whole conversation is fed back in, from the start.", at: n1.end + 1.4, engine: EN, voice: "af_heart", speed: 1.0, gain: 2.3)
  let n3 = say("That text has a limit: the window. Here, a window of twelve tokens. Real ones hold a hundred thousand, or more.", at: n2.end + 1.4, engine: EN, voice: "af_heart", speed: 1.0, gain: 2.3)
  let n4 = say("Everything inside the window, the machine sees. Outside it, nothing. It has no other memory of you.", at: n3.end + 1.4, engine: EN, voice: "af_heart", speed: 1.0, gain: 2.3)
  let n5 = say("Why a limit? Attention. Every token looks at every other token. Four tokens: sixteen looks.", at: 58.10, engine: EN, voice: "af_heart", speed: 1.0, gain: 2.3)
  let n6 = say("Twice the text, four times the looks. Eight tokens: sixty-four. Forty tokens: one thousand six hundred. A long conversation is expensive, and slow.", at: n5.end + 1.4, engine: EN, voice: "af_heart", speed: 1.0, gain: 2.3)
  let n7 = say("That is why the window is a window, and not a wall of everything you ever said.", at: n6.end + 1.4, engine: EN, voice: "af_heart", speed: 1.0, gain: 2.3)
  let n8 = say("What happens at the edge? When the conversation grows past the window, the oldest tokens fall out.", at: 83.70, engine: EN, voice: "af_heart", speed: 1.0, gain: 2.3)
  let n9 = say("The machine answers as if they were never said. It did not forget them: it never saw them.", at: n8.end + 1.4, engine: EN, voice: "af_heart", speed: 1.0, gain: 2.3)
  let n10 = say("A long chat that goes strange halfway through? Often, the beginning fell out of the window.", at: n9.end + 1.4, engine: EN, voice: "af_heart", speed: 1.0, gain: 2.3)
  let n11 = say("So the machine has two memories. The weights: slow, learned once, from everything ever written. And the window: fast, this conversation, gone when it closes.", at: 105.00, engine: EN, voice: "af_heart", speed: 1.0, gain: 2.3)
  let n12 = say("To make it remember, write it down. A note at the top of the window, put back in every time. That is all a memory feature is: text.", at: n11.end + 1.4, engine: EN, voice: "af_heart", speed: 1.0, gain: 2.3)
  let n13 = say("Next time: when the machine is sure, and wrong. Hallucination.", at: n12.end + 1.4, engine: EN, voice: "af_heart", speed: 1.0, gain: 2.3)
  let m4 = say("師は言った。機械は、目の前にあるものだけを見ている。", at: 131.60, engine: JA, voice: "jm_kumo", speed: 0.82, gain: 2.3)
  let m5 = say("覚えていてほしければ、書いておけ。", at: m4.end + 1.4, engine: JA, voice: "jm_kumo", speed: 0.82, gain: 2.3)
  let m6 = say("その時、弟子は悟った。", at: m5.end + 1.6, engine: JA, voice: "jm_kumo", speed: 0.82, gain: 2.3)

  // ── the scenes: ink on paper, a vermilion accent, under the captions ──
  let PAPER = ["#efe9dc", "#d3c9b4", "#3b352c", "#17140f"]
  let fit(piece) = zoom(piece, by: 0.82, x: 0.5, y: 0.66)
  let ink(piece, accent) = overlay(paint(fit(piece), palette: PAPER, range: [0, 1]), paint(fit(accent), palette: ["#000000", "#c23b22"], range: [0, 1], alpha: fit(accent)))
  let reel = timeline([
      scene(ink(Koan(draw0: ((m1.start) - 0.00) / 21.3, draw1: ((m1.end) - 0.00) / 21.3, word: ((m3.end + 0.8) - 0.00) / 21.3, title: ((m3.end + 1.0) - 0.00) / 21.3, kana: ["キ", "オ", "ク"], episode: "AI 08  ·  memory", accent: 0), Koan(draw0: ((m1.start) - 0.00) / 21.3, draw1: ((m1.end) - 0.00) / 21.3, word: ((m3.end + 0.8) - 0.00) / 21.3, title: ((m3.end + 1.0) - 0.00) / 21.3, kana: ["キ", "オ", "ク"], episode: "AI 08  ·  memory", accent: 1)), 21.3),  wipe(0.8, angle: 0, softness: 0.12),
      scene(ink(Window(weights0: ((n1.words[2]) - 21.30) / 35.3, text0: ((n2.words[9]) - 21.30) / 35.3, frame0: ((n3.words[5]) - 21.30) / 35.3, outside0: ((n4.words[7]) - 21.30) / 35.3, accent: 0), Window(weights0: ((n1.words[2]) - 21.30) / 35.3, text0: ((n2.words[9]) - 21.30) / 35.3, frame0: ((n3.words[5]) - 21.30) / 35.3, outside0: ((n4.words[7]) - 21.30) / 35.3, accent: 1)), 35.3),  pixels(0.6, size: 0.05),
      scene(ink(Cost(at: [((n5.words[9]) - 56.60) / 25.6, ((n6.words[6]) - 56.60) / 25.6, ((n6.words[9]) - 56.60) / 25.6], wall0: ((n7.words[9]) - 56.60) / 25.6, accent: 0), Cost(at: [((n5.words[9]) - 56.60) / 25.6, ((n6.words[6]) - 56.60) / 25.6, ((n6.words[9]) - 56.60) / 25.6], wall0: ((n7.words[9]) - 56.60) / 25.6, accent: 1)), 25.6),  wipe(0.7, angle: 90, softness: 0.1),
      scene(ink(Edge(slide0: ((n8.words[6]) - 82.20) / 21.3, slide1: ((n9.words[0]) - 82.20) / 21.3, never0: ((n9.words[9]) - 82.20) / 21.3, accent: 0), Edge(slide0: ((n8.words[6]) - 82.20) / 21.3, slide1: ((n9.words[0]) - 82.20) / 21.3, never0: ((n9.words[9]) - 82.20) / 21.3, accent: 1)), 21.3),  morph(0.8, amount: 0.15),
      scene(ink(Two(weights0: ((n11.words[6]) - 103.50) / 26.6, window0: ((n11.words[20]) - 103.50) / 26.6, note0: ((n12.words[6]) - 103.50) / 26.6, accent: 0), Two(weights0: ((n11.words[6]) - 103.50) / 26.6, window0: ((n11.words[20]) - 103.50) / 26.6, note0: ((n12.words[6]) - 103.50) / 26.6, accent: 1)), 26.6),  wipe(0.8, angle: 180, softness: 0.12),
      scene(ink(Koan(draw0: ((m4.start) - 130.10) / 17.3, draw1: ((m6.end) - 130.10) / 17.3, word: ((m6.start + 0.5) - 130.10) / 17.3, title: ((m6.end + 0.6) - 130.10) / 17.3, kana: ["キ", "オ", "ク"], episode: "AI 08  ·  memory", accent: 0), Koan(draw0: ((m4.start) - 130.10) / 17.3, draw1: ((m6.end) - 130.10) / 17.3, word: ((m6.start + 0.5) - 130.10) / 17.3, title: ((m6.end + 0.6) - 130.10) / 17.3, kana: ["キ", "オ", "ク"], episode: "AI 08  ·  memory", accent: 1)), 17.3),  morph(1.2, amount: 0.2),
  ], loop: 1)

  // ── over it: the series, the step, the captions (the master's, translated, in vermilion) ──
  let adv = 0.021722
  let header = merge(text("1 / 4   the window", x: 0.06, y: -0.15, size: 0.03, font: "mono", align: "left") * (reel.index > 1 - 0.5) * (reel.index < 1 + 0.5), text("2 / 4   the cost", x: 0.06, y: -0.15, size: 0.03, font: "mono", align: "left") * (reel.index > 2 - 0.5) * (reel.index < 2 + 0.5), text("3 / 4   the edge", x: 0.06, y: -0.15, size: 0.03, font: "mono", align: "left") * (reel.index > 3 - 0.5) * (reel.index < 3 + 0.5), text("4 / 4   two memories", x: 0.06, y: -0.15, size: 0.03, font: "mono", align: "left") * (reel.index > 4 - 0.5) * (reel.index < 4 + 0.5)) * 0.7
  let series = text("thus spoke master foo  ·  AI 08", x: 0.94, y: -0.3, size: 0.024, font: "mono", align: "right") * 0.45
  let c_m1 = merge(text("The novice asked: does the", x: 0.06, y: -0.060, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - m1.start) / (m1.duration * 0.92), 0, 1) * 47) - 0, 0, 26) * adv), text("machine remember me?", x: 0.06, y: -0.008, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - m1.start) / (m1.duration * 0.92), 0, 1) * 47) - 27, 0, 20) * adv)) * (T >= m1.start) * (T < min(m1.end + 1.5, m2.start))
  let c_m2 = merge(text("Master Foo said: what did you say", x: 0.06, y: -0.060, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - m2.start) / (m2.duration * 0.92), 0, 1) * 50) - 0, 0, 33) * adv), text("to it yesterday?", x: 0.06, y: -0.008, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - m2.start) / (m2.duration * 0.92), 0, 1) * 50) - 34, 0, 16) * adv)) * (T >= m2.start) * (T < min(m2.end + 1.5, m3.start))
  let c_m3 = merge(text("The novice answered: I don't", x: 0.06, y: -0.060, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - m3.start) / (m3.duration * 0.92), 0, 1) * 81) - 0, 0, 28) * adv), text("remember. Master Foo said:", x: 0.06, y: -0.008, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - m3.start) / (m3.duration * 0.92), 0, 1) * 81) - 29, 0, 26) * adv), text("neither does the machine.", x: 0.06, y: 0.044, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - m3.start) / (m3.duration * 0.92), 0, 1) * 81) - 56, 0, 25) * adv)) * (T >= m3.start) * (T < min(m3.end + 1.5, n1.start))
  let c_n1 = merge(text("Last time, the weights. Once", x: 0.06, y: -0.060, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - n1.words[0]) / (n1.ends[0] - n1.words[0]), 0, 1) * 5 + clamp((T - n1.words[1]) / (n1.ends[1] - n1.words[1]), 0, 1) * 6 + clamp((T - n1.words[2]) / (n1.ends[2] - n1.words[2]), 0, 1) * 4 + clamp((T - n1.words[3]) / (n1.ends[3] - n1.words[3]), 0, 1) * 9 + clamp((T - n1.words[4]) / (n1.ends[4] - n1.words[4]), 0, 1) * 5 + clamp((T - n1.words[5]) / (n1.ends[5] - n1.words[5]), 0, 1) * 9 + clamp((T - n1.words[6]) / (n1.ends[6] - n1.words[6]), 0, 1) * 3 + clamp((T - n1.words[7]) / (n1.ends[7] - n1.words[7]), 0, 1) * 6 + clamp((T - n1.words[8]) / (n1.ends[8] - n1.words[8]), 0, 1) * 5 + clamp((T - n1.words[9]) / (n1.ends[9] - n1.words[9]), 0, 1) * 6 + clamp((T - n1.words[10]) / (n1.ends[10] - n1.words[10]), 0, 1) * 8 + clamp((T - n1.words[11]) / (n1.ends[11] - n1.words[11]), 0, 1) * 4 + clamp((T - n1.words[12]) / (n1.ends[12] - n1.words[12]), 0, 1) * 4 + clamp((T - n1.words[13]) / (n1.ends[13] - n1.words[13]), 0, 1) * 8 + clamp((T - n1.words[14]) / (n1.ends[14] - n1.words[14]), 0, 1) * 2 + clamp((T - n1.words[15]) / (n1.ends[15] - n1.words[15]), 0, 1) * 9 + clamp((T - n1.words[16]) / (n1.ends[16] - n1.words[16]), 0, 1) * 7 + clamp((T - n1.words[17]) / (n1.ends[17] - n1.words[17]), 0, 1) * 3 + clamp((T - n1.words[18]) / (n1.ends[18] - n1.words[18]), 0, 1) * 5 + clamp((T - n1.words[19]) / (n1.ends[19] - n1.words[19]), 0, 1) * 6 + clamp((T - n1.words[20]) / (n1.ends[20] - n1.words[20]), 0, 1) * 4 + clamp((T - n1.words[21]) / (n1.ends[21] - n1.words[21]), 0, 1) * 5 + clamp((T - n1.words[22]) / (n1.ends[22] - n1.words[22]), 0, 1) * 8 + clamp((T - n1.words[23]) / (n1.ends[23] - n1.words[23]), 0, 1) * 7) - 0, 0, 28) * adv), text("training is done, they never", x: 0.06, y: -0.008, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - n1.words[0]) / (n1.ends[0] - n1.words[0]), 0, 1) * 5 + clamp((T - n1.words[1]) / (n1.