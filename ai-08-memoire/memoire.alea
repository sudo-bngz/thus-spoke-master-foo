  let c_n13 = merge(text("Next time: when the machine is", x: 0.06, y: -0.060, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - n13.words[0]) / (n13.ends[0] - n13.words[0]), 0, 1) * 5 + clamp((T - n13.words[1]) / (n13.ends[1] - n13.words[1]), 0, 1) * 6 + clamp((T - n13.words[2]) / (n13.ends[2] - n13.words[2]), 0, 1) * 5 + clamp((T - n13.words[3]) / (n13.ends[3] - n13.words[3]), 0, 1) * 4 + clamp((T - n13.words[4]) / (n13.ends[4] - n13.words[4]), 0, 1) * 8 + clamp((T - n13.words[5]) / (n13.ends[5] - n13.words[5]), 0, 1) * 3 + clamp((T - n13.words[6]) / (n13.ends[6] - n13.words[6]), 0, 1) * 6 + clamp((T - n13.words[7]) / (n13.ends[7] - n13.words[7]), 0, 1) * 4 + clamp((T - n13.words[8]) / (n13.ends[8] - n13.words[8]), 0, 1) * 7 + clamp((T - n13.words[9]) / (n13.ends[9] - n13.words[9]), 0, 1) * 14) - 0, 0, 30) * adv), text("sure, and wrong. Hallucination.", x: 0.06, y: -0.008, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - n13.words[0]) / (n13.ends[0] - n13.words[0]), 0, 1) * 5 + clamp((T - n13.words[1]) / (n13.ends[1] - n13.words[1]), 0, 1) * 6 + clamp((T - n13.words[2]) / (n13.ends[2] - n13.words[2]), 0, 1) * 5 + clamp((T - n13.words[3]) / (n13.ends[3] - n13.words[3]), 0, 1) * 4 + clamp((T - n13.words[4]) / (n13.ends[4] - n13.words[4]), 0, 1) * 8 + clamp((T - n13.words[5]) / (n13.ends[5] - n13.words[5]), 0, 1) * 3 + clamp((T - n13.words[6]) / (n13.ends[6] - n13.words[6]), 0, 1) * 6 + clamp((T - n13.words[7]) / (n13.ends[7] - n13.words[7]), 0, 1) * 4 + clamp((T - n13.words[8]) / (n13.ends[8] - n13.words[8]), 0, 1) * 7 + clamp((T - n13.words[9]) / (n13.ends[9] - n13.words[9]), 0, 1) * 14) - 31, 0, 31) * adv)) * (T >= n13.start) * (T < min(n13.end + 1.5, m4.start))
  let c_m4 = merge(text("Master Foo said: the machine sees", x: 0.06, y: -0.060, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - m4.start) / (m4.duration * 0.92), 0, 1) * 62) - 0, 0, 33) * adv), text("only what is in front of it.", x: 0.06, y: -0.008, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - m4.start) / (m4.duration * 0.92), 0, 1) * 62) - 34, 0, 28) * adv)) * (T >= m4.start) * (T < min(m4.end + 1.5, m5.start))
  let c_m5 = merge(text("If you want it to remember, write", x: 0.06, y: -0.060, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - m5.start) / (m5.duration * 0.92), 0, 1) * 42) - 0, 0, 33) * adv), text("it down.", x: 0.06, y: -0.008, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - m5.start) / (m5.duration * 0.92), 0, 1) * 42) - 34, 0, 8) * adv)) * (T >= m5.start) * (T < min(m5.end + 1.5, m6.start))
  let c_m6 = text("And the novice was enlightened.", x: 0.06, y: -0.060, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - m6.start) / (m6.duration * 0.92), 0, 1) * 31) - 0, 0, 31) * adv) * (T >= m6.start) * (T < m6.end + 3)
  let said = merge(c_n1, c_n2, c_n3, c_n4, c_n5, c_n6, c_n7, c_n8, c_n9, c_n10, c_n11, c_n12, c_n13)
  let spoken = merge(c_m1, c_m2, c_m3, c_m4, c_m5, c_m6)
  let dark = paint(merge(header, series, said), palette: ["#000000", "#1a1712"], range: [0, 1], alpha: merge(header, series, said))
  let red  = paint(spoken, palette: ["#000000", "#b8361f"], range: [0, 1], alpha: spoken)
  let look = film(vignette(overlay(reel, dark, red), amount: 0.06), amount: 0.035)

  // ── the sound ──
  let pad = synth {
    let env = adsr(attack: 3, decay: 1, sustain: 0.9, release: 4)
    lowpass(saw(note.freq) + saw(note.freq * 1.003) + sine(note.freq * 0.5), cutoff: 260 + 300 * note.level, resonance: 0.2) * env
  }
  let brush = synth { bandpass(noise(), cutoff: 1400, resonance: 0.3) * adsr(attack: 0.12, decay: 0.3, sustain: 0.3, release: 0.5) * note.velocity }
  let tick = synth { highpass(noise(), cutoff: 4000, resonance: 0.2) * perc(release: 0.015) * note.velocity + sine(note.freq) * perc(release: 0.05) * 0.4 }
  let knock = synth { lowpass(noise(), cutoff: 700, resonance: 0.5) * perc(attack: 0.002, release: 0.12) * note.velocity + sine(note.freq) * perc(release: 0.1) * 0.5 }
  let chord = synth {
    let env = adsr(attack: 0.3, decay: 0.6, sustain: 0.8, release: 2.5)
    chorus(lowpass(saw(note.freq) + saw(note.freq * 1.004) + sine(note.freq * 0.5), cutoff: 1200, resonance: 0.15) * env, depth: 0.6)
  }
  // the temple bell when the master speaks; the question
  pattern bells = repeat 2 event(t: [m1.start - 1.0, m4.start - 1.0][i] / total, x: 0.5, y: 0.95, size: 0.12, intensity: 0.9)
  pattern asked = repeat 1 event(t: (m2.start + 0.85 * m2.duration) / total, x: 0.5, y: 0.5, size: 0.06, intensity: 0.8)
  // the weights; the tokens arriving; the frame; outside
  pattern weights = repeat 1 event(t: n1.words[2] / total, x: 0.5, y: 0.3, size: 0.2, intensity: 0.5)
  pattern tokens = repeat 20 event(t: (n2.words[9] + 35.3 * (0.07 * floor(i / 7) + 0.006 * (i % 7))) / total, x: 0.08 + 0.84 * i / 19, y: 0.72, intensity: 0.3)
  pattern frame = repeat 1 event(t: n3.words[5] / total, x: 0.7, y: 0.72, size: 0.15, intensity: 0.8)
  // the three grids
  pattern grids = repeat 3 event(t: [n5.words[9], n6.words[6], n6.words[9]][i] / total, x: 0.5, y: 0.62, size: 0.1 + 0.1 * i, intensity: 0.5 + 0.2 * i)
  pattern looks = repeat 16 event(t: (n6.words[9] + 0.05 * 25.6 * (i / 16)) / total, x: 0.2 + 0.6 * i / 16, y: 0.62, intensity: 0.2)
  // the tokens falling out
  pattern falling = repeat 12 event(t: (n8.words[6] + (n9.words[0] - n8.words[6]) * ((i + 0.5) / 12)) / total, x: 0.2, y: 0.8, size: 0.05, intensity: 0.5)
  // the two memories; the note
  pattern memories = repeat 2 event(t: [n11.words[6], n11.words[20]][i] / total, x: 0.5, y: 0.36 + 0.42 * i, size: 0.3, intensity: 0.6)
  pattern note = repeat 1 event(t: (n12.words[6] + 0.03 * 26.6) / total, x: 0.3, y: 0.9, size: 0.06, intensity: 0.7)

  let music = [
    m1, m2, m3, n1, n2, n3, n4, n5, n6, n7, n8, n9, n10, n11, n12, n13, m4, m5, m6,
    drone(0.45 + 0.15 * lfo(3) + x * 0, voices: 2, instrument: pad, scale: "hirajoshi", key: 55, gain: 0.9),
    notes(bells, instrument: "bell", scale: "hirajoshi", key: 110, gain: 0.7),
    notes(asked, instrument: "kalimba", scale: "hirajoshi", key: 392, gain: 0.6),
    notes(weights, instrument: chord, scale: "major", key: 82, gain: 0.4),
    notes(tokens, instrument: tick, scale: "hirajoshi", key: 880, gain: 0.3),
    notes(frame, instrument: "glass", scale: "hirajoshi", key: 523, gain: 0.5),
    notes(grids, instrument: "kalimba", scale: "hirajoshi", key: 262, gain: 0.5),
    notes(looks, instrument: tick, scale: "hirajoshi", key: 1320, gain: 0.2),
    notes(falling, instrument: "wood", scale: "hirajoshi", key: 220, gain: 0.45),
    notes(memories, instrument: chord, scale: "major", key: 110, gain: 0.4),
    notes(note, instrument: "glass", scale: "hirajoshi", key: 659, gain: 0.5),
    notes(reel.cues, instrument: brush, scale: "chromatic", key: 100, gain: 0.3),
  ]

  render image(look, width: 1080, height: 1920, at: 0.6299)
  render video(look, fps: 30, width: 1080, height: 1920, sound: music, room: 0.12, echo: 0)
}
