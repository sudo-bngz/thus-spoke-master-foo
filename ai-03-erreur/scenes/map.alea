// Map — the error landscape: `E` is the error as a field over the square
// (u, v in 0..1, the two weights), drawn as contour lines, the valleys
// light and the hills dark. `cx`, `cy`, `side` place the square. What it
// returns: 0 paper, up to 1 ink.

work Map(E = 0, cx = 0.5, cy = 0.8, side = 0.7, show = 0) {
  let u = (x - cx + side / 2) / side
  let v = (cy + side / 2 - y) / side
  let inside = (abs(x - cx) < side / 2) * (abs(y - cy) < side / 2)
  let e = move(E, x: x - u, y: y - v)
  let lines = (fract(e * 6) < 0.08) * 0.45
  let shade = clamp((e - 0.3) / 1.8, 0, 1) * 0.1
  let frame = cut(rect(cx, cy, side + 0.006, side + 0.006, 0, 0.002), rect(cx, cy, side, side, 0, 0.002)) * 0.35
  let labels = merge(text("weight 1  →", cx, cy + side / 2 + 0.05, 0.024, 0, "mono"), text("weight 2  →", cx - side / 2 - 0.05, cy, 0.024, -90, "mono")) * 0.6
  output merge(merge(lines, shade) * inside, frame, labels) * smoothstep(show, show + 0.05, t)
}
