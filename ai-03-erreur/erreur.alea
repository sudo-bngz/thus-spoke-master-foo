// Erreur — Thus Spoke Master Foo, AI 03: how the scales learn. Look at
// the last pan: how far it tipped is the mistake; send it back the way it
// came. The error as one number (the gaps between answers and right
// answers, added up); the error as a landscape over the weights, hills and
// valleys; the slope under one's feet, and the walk down, step by step
// (gradient descent, grown here by the slope itself, with steps too small
// and too big beside it); the blame sent backward along the wires
// (backpropagation). The landscape is the edition's. Master Foo speaks
// Japanese, translated in the captions.

use "scenes/koan.alea"
use "scenes/error.alea"
use "scenes/landscape.alea"
use "scenes/descent.alea"
use "scenes/backward.alea"

work Erreur {
  let total = 159.3
  let T = t * total
  let EN = "../voices/narrator.sh"
  let JA = "../voices/master.sh"

  // ── the voices: the master, in Japanese; the one who explains, in English ──
  let m1 = say("弟子は尋ねた。三つの秤は、どうやって一緒に学ぶのですか。", at: 1.50, engine: JA, voice: "jm_kumo", speed: 0.82, gain: 2.3)
  let m2 = say("師は言った。終わりの皿を見よ。どれだけ傾いたか。それが、間違いだ。", at: m1.end + 1.4, engine: JA, voice: "jm_kumo", speed: 0.82, gain: 2.3)
  let m3 = say("その間違いを、来た道を逆に、秤から秤へ戻せ。", at: m2.end + 1.4, engine: JA, voice: "jm_kumo", speed: 0.82, gain: 2.3)
  let n1 = say("Last time, three scales drew a bent line. But their weights were set by hand. Now they must find the weights themselves.", at: 26.60, engine: EN, voice: "af_heart", speed: 1.0, gain: 2.3)
  let n2 = say("For that, the network first needs a way to know how wrong it is. One number.", at: n1.end + 1.4, engine: EN, voice: "af_heart", speed: 1.0, gain: 2.3)
  let n3 = say("Show it an example. It answers with a number between zero and one. Compare with the right answer: the gap is its mistake.", at: n2.end + 1.4, engine: EN, voice: "af_heart", speed: 1.0, gain: 2.3)
  let n4 = say("Do this for every example, and add the gaps up. That total is the error. Zero would be perfect.", at: n3.end + 1.4, engine: EN, voice: "af_heart", speed: 1.0, gain: 2.3)
  let n5 = say("Now imagine turning one weight slowly, from low to high, and writing down the error each time. You get a curve: high here, low there.", at: 57.20, engine: EN, voice: "af_heart", speed: 1.0, gain: 2.3)
  let n6 = say("With two weights, you get a landscape: hills where the error is high, valleys where it is low.", at: n5.end + 1.4, engine: EN, voice: "af_heart", speed: 1.0, gain: 2.3)
  let n7 = say("Learning is nothing more than this: finding the bottom of a valley.", at: n6.end + 1.4, engine: EN, voice: "af_heart", speed: 1.0, gain: 2.3)
  let n8 = say("But the network cannot see the landscape. It only knows where it stands.", at: n7.end + 1.4, engine: EN, voice: "af_heart", speed: 1.0, gain: 2.3)
  let n9 = say("What it can feel is the slope under its feet: which way is down, and how steep. That is called the gradient.", at: 84.40, engine: EN, voice: "af_heart", speed: 1.0, gain: 2.3)
  let n10 = say("So it takes one small step downhill. Then feels the slope again. Then steps again.", at: n9.end + 1.4, engine: EN, voice: "af_heart", speed: 1.0, gain: 2.3)
  let n11 = say("Step by step, it walks down into the valley. This is gradient descent.", at: n10.end + 1.4, engine: EN, voice: "af_heart", speed: 1.0, gain: 2.3)
  let n12 = say("The size of the step matters. Too small, and it takes forever. Too big, and it jumps over the valley, and bounces.", at: n11.end + 1.4, engine: EN, voice: "af_heart", speed: 1.0, gain: 2.3)
  let n13 = say("One thing left. With many weights, in many layers, which weights are to blame for the error?", at: 113.20, engine: EN, voice: "af_heart", speed: 1.0, gain: 2.3)
  let n14 = say("The error is measured at the end. So it is sent backward, layer by layer, along the same wires the answer came through.", at: n13.end + 1.4, engine: EN, voice: "af_heart", speed: 1.0, gain: 2.3)
  let n15 = say("Each wire receives its share of the blame, and moves its weight by that much.", at: n14.end + 1.4, engine: EN, voice: "af_heart", speed: 1.0, gain: 2.3)
  let n16 = say("Forward to answer. Backward to blame. This is backpropagation, and every network learns this way.", at: n15.end + 1.4, engine: EN, voice: "af_heart", speed: 1.0, gain: 2.3)
  let m4 = say("弟子は、谷を下る水のように、重りを動かした。", at: 141.60, engine: JA, voice: "jm_kumo", speed: 0.82, gain: 2.3)
  let m5 = say("師は言った。一歩ずつ。急げば、谷を跳び越える。", at: m4.end + 1.4, engine: JA, voice: "jm_kumo", speed: 0.82, gain: 2.3)
  let m6 = say("その時、弟子は悟った。", at: m5.end + 1.6, engine: JA, voice: "jm_kumo", speed: 0.82, gain: 2.3)

  // ── the landscape: the error over the two weights (u, v in 0..1), a bowl with hills, the edition's ──
  let cu = ~between(0.5, 0.75)
  let cv = ~between(0.3, 0.6)
  let bump = ~between(3, 9)
  let E = 2.2 * ((x - cu) ^ 2 + (y - cv) ^ 2) + 0.28 * noise(x * 3.5, y * 3.5, bump) + 0.3
  // ── the walk down, grown: at each step, the slope under the ball, and a step against it;
  // three walkers from the same start: the right step, one too small, one too big ──
  let S = 120
  let h = 0.01
  let x0 = 0.12 + ~between(0, 0.08)
  let y0 = 0.82 + ~between(0, 0.08)
  let slopex(px, py) = (move(E, x: x - px - h, y: y - py) - move(E, x: x - px + h, y: y - py)) / (2 * h)
  let slopey(px, py) = (move(E, x: x - px, y: y - py - h) - move(E, x: x - px, y: y - py + h)) / (2 * h)
  grow over 64 for 120 {
    bx = x0
      then bx + x * 0 - 0.03 * slopex(bx, by)
    by = y0
      then by + x * 0 - 0.03 * slopey(bx, by)
    sx = x0
      then sx + x * 0 - 0.004 * slopex(sx, sy)
    sy = y0
      then sy + x * 0 - 0.004 * slopey(sx, sy)
    gx = x0
      then clamp(gx + x * 0 - 0.2 * slopex(gx, gy), 0.03, 0.97)
    gy = y0
      then clamp(gy + x * 0 - 0.2 * slopey(gx, gy), 0.03, 0.97)
    // the trails: a dot stamped where each walker stands, kept
    tb = 0
      then max(tb, exp(-((x - bx) ^ 2 + (y - by) ^ 2) / 0.00005))
    ts = 0
      then max(ts, exp(-((x - sx) ^ 2 + (y - sy) ^ 2) / 0.00003))
    tg = 0
      then max(tg, exp(-((x - gx) ^ 2 + (y - gy) ^ 2) / 0.00005))
  }

  // ── the scenes: ink on paper, a vermilion accent, under the captions ──
  let PAPER = ["#efe9dc", "#d3c9b4", "#3b352c", "#17140f"]
  let fit(piece) = zoom(piece, by: 0.82, x: 0.5, y: 0.66)
  let ink(piece, accent) = overlay(paint(fit(piece), palette: PAPER, range: [0, 1]), paint(fit(accent), palette: ["#000000", "#c23b22"], range: [0, 1], alpha: fit(accent)))
  let reel = timeline([
      scene(ink(Koan(draw0: ((m1.start) - 0.00) / 25.1, draw1: ((m1.end) - 0.00) / 25.1, word: ((m3.end + 0.8) - 0.00) / 25.1, title: ((m3.end + 1.0) - 0.00) / 25.1, kana: ["エ", "ラ", "ー"], episode: "AI 03  ·  error", accent: 0), Koan(draw0: ((m1.start) - 0.00) / 25.1, draw1: ((m1.end) - 0.00) / 25.1, word: ((m3.end + 0.8) - 0.00) / 25.1, title: ((m3.end + 1.0) - 0.00) / 25.1, kana: ["エ", "ラ", "ー"], episode: "AI 03  ·  error", accent: 1)), 25.1),  wipe(0.8, angle: 0, softness: 0.12),
      scene(ink(Error(first0: ((n3.words[0]) - 25.10) / 30.6, gap0: ((n3.words[17]) - 25.10) / 30.6, rest0: ((n4.words[0]) - 25.10) / 30.6, total0: ((n4.words[12]) - 25.10) / 30.6, accent: 0), Error(first0: ((n3.words[0]) - 25.10) / 30.6, gap0: ((n3.words[17]) - 25.10) / 30.6, rest0: ((n4.words[0]) - 25.10) / 30.6, total0: ((n4.words[12]) - 25.10) / 30.6, accent: 1)), 30.6),  pixels(0.6, size: 0.05),
      scene(ink(Landscape(E: E, bx: x0, by: y0, cu: cu, cv: cv, curve0: ((n5.words[1]) - 55.70) / 27.2, map0: ((n6.words[0]) - 55.70) / 27.2, valley0: ((n6.words[6]) - 55.70) / 27.2, here0: ((n8.words[9]) - 55.70) / 27.2, accent: 0), Landscape(E: E, bx: x0, by: y0, cu: cu, cv: cv, curve0: ((n5.words[1]) - 55.70) / 27.2, map0: ((n6.words[0]) - 55.70) / 27.2, valley0: ((n6.words[6]) - 55.70) / 27.2, here0: ((n8.words[9]) - 55.70) / 27.2, accent: 1)), 27.2),  wipe(0.7, angle: 90, softness: 0.1),
      scene(ink(Descent(E: E, bx: bx, by: by, sx: sx, sy: sy, gx: gx, gy: gy, tb: tb, ts: ts, tg: tg, S: S, arrow0: ((n9.words[5]) - 82.90) / 28.8, l0: ((n10.words[3]) - 82.90) / 28.8, l1: ((n11.end + 0.8) - 82.90) / 28.8, size0: ((n12.words[6]) - 82.90) / 28.8, accent: 0), Descent(E: E, bx: bx, by: by, sx: sx, sy: sy, gx: gx, gy: gy, tb: tb, ts: ts, tg: tg, S: S, arrow0: ((n9.words[5]) - 82.90) / 28.8, l0: ((n10.words[3]) - 82.90) / 28.8, l1: ((n11.end + 0.8) - 82.90) / 28.8, size0: ((n12.words[6]) - 82.90) / 28.8, accent: 1)), 28.8),  morph(0.8, amount: 0.15),
      scene(ink(Backward(fwd0: ((n13.start - 0.9) - 111.70) / 28.4, gap0: ((n14.words[4]) - 111.70) / 28.4, back0: ((n14.words[8]) - 111.70) / 28.4, move0: ((n15.words[8]) - 111.70) / 28.4, accent: 0), Backward(fwd0: ((n13.start - 0.9) - 111.70) / 28.4, gap0: ((n14.words[4]) - 111.70) / 28.4, back0: ((n14.words[8]) - 111.70) / 28.4, move0: ((n15.words[8]) - 111.70) / 28.4, accent: 1)), 28.4),  wipe(0.8, angle: 180, softness: 0.12),
      scene(ink(Koan(draw0: ((m4.start) - 140.10) / 19.2, draw1: ((m6.end) - 140.10) / 19.2, word: ((m6.start + 0.5) - 140.10) / 19.2, title: ((m6.end + 0.6) - 140.10) / 19.2, kana: ["エ", "ラ", "ー"], episode: "AI 03  ·  error", accent: 0), Koan(draw0: ((m4.start) - 140.10) / 19.2, draw1: ((m6.end) - 140.10) / 19.2, word: ((m6.start + 0.5) - 140.10) / 19.2, title: ((m6.end + 0.6) - 140.10) / 19.2, kana: ["エ", "ラ", "ー"], episode: "AI 03  ·  error", accent: 1)), 19.2),  morph(1.2, amount: 0.2),
  ], loop: 1)

  // ── over it: the series, the step, the captions (the master's, translated, in vermilion) ──
  let adv = 0.021722
  let header = merge(text("1 / 4   the error", x: 0.06, y: -0.15, size: 0.03, font: "mono", align: "left") * (reel.index > 1 - 0.5) * (reel.index < 1 + 0.5), text("2 / 4   the landscape", x: 0.06, y: -0.15, size: 0.03, font: "mono", align: "left") * (reel.index > 2 - 0.5) * (reel.index < 2 + 0.5), text("3 / 4   the slope", x: 0.06, y: -0.15, size: 0.03, font: "mono", align: "left") * (reel.index > 3 - 0.5) * (reel.index < 3 + 0.5), text("4 / 4   backward", x: 0.06, y: -0.15, size: 0.03, font: "mono", align: "left") * (reel.index > 4 - 0.5) * (reel.index < 4 + 0.5)) * 0.7
  let series = text("thus spoke master foo  ·  AI 03", x: 0.94, y: -0.3, size: 0.024, font: "mono", align: "right") * 0.45
  let c_m1 = merge(text("The novice asked: how do 3 scales", x: 0.06, y: -0.060, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - m1.start) / (m1.duration * 0.92), 0, 1) * 49) - 0, 0, 33) * adv), text("learn together?", x: 0.06, y: -0.008, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - m1.start) / (m1.duration * 0.92), 0, 1) * 49) - 34, 0, 15) * adv)) * (T >= m1.start) * (T < min(m1.end + 1.5, m2.start))
  let c_m2 = merge(text("Master Foo said: look at the last", x: 0.06, y: -0.060, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - m2.start) / (m2.duration * 0.92), 0, 1) * 78) - 0, 0, 33) * adv), text("pan. How far it tipped: that is", x: 0.06, y: -0.008, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - m2.start) / (m2.duration * 0.92), 0, 1) * 78) - 34, 0, 31) * adv), text("the mistake.", x: 0.06, y: 0.044, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - m2.start) / (m2.duration * 0.92), 0, 1) * 78) - 66, 0, 12) * adv)) * (T >= m2.start) * (T < min(m2.end + 1.5, m3.start))
  let c_m3 = merge(text("Send that mistake back the way it", x: 0.06, y: -0.060, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - m3.start) / (m3.duration * 0.92), 0, 1) * 55) - 0, 0, 33) * adv), text("came, scale to scale.", x: 0.06, y: -0.008, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - m3.start) / (m3.duration * 0.92), 0, 1) * 55) - 34, 0, 21) * adv)) * (T >= m3.start) * (T < min(m3.end + 1.5, n1.start))
  let c_n1 = merge(text("Last time, 3 scales drew a bent", x: 0.06, y: -0.060, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - n1.start) / (n1.duration * 0.92), 0, 1) * 116) - 0, 0, 31) * adv), text("line. But their weights were set", x: 0.06, y: -0.008, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - n1.start) / (n1.duration * 0.92), 0, 1) * 116) - 32, 0, 32) * adv), text("by hand. Now they must find the", x: 0.06, y: 0.044, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - n1.start) / (n1.duration * 0.92), 0, 1) * 116) - 65, 0, 31) * adv), text("weights themselves.", x: 0.06, y: 0.096, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - n1.start) / (n1.duration * 0.92), 0, 1) * 116) - 97, 0, 19) * adv)) * (T >= n1.start) * (T < min(n1.end + 1.5, n2.start))
  let c_n2 = merge(text("For that, the network first needs", x: 0.06, y: -0.060, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - n2.start) / (n2.duration * 0.92), 0, 1) * 74) - 0, 0, 33) * adv), text("a way to know how wrong it is. 1", x: 0.06, y: -0.008, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - n2.start) / (n2.duration * 0.92), 0, 1) * 74) - 34, 0, 32) * adv), text("number.", x: 0.06, y: 0.044, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - n2.start) / (n2.duration * 0.92), 0, 1) * 74) - 67, 0, 7) * adv)) * (T >= n2.start) * (T < min(n2.end + 1.5, n3.start))
  let c_n3 = merge(text("Show it an example. It answers", x: 0.06, y: -0.060, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - n3.start) / (n3.duration * 0.92), 0, 1) * 116) - 0, 0, 30) * adv), text("with a number between 0 and 1.", x: 0.06, y: -0.008, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - n3.start) / (n3.duration * 0.92), 0, 1) * 116) - 31, 0, 30) * adv), text("Compare with the right answer:", x: 0.06, y: 0.044, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - n3.start) / (n3.duration * 0.92), 0, 1) * 116) - 62, 0, 30) * adv), text("the gap is its mistake.", x: 0.06, y: 0.096, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - n3.start) / (n3.duration * 0.92), 0, 1) * 116) - 93, 0, 23) * adv)) * (T >= n3.start) * (T < min(n3.end + 1.5, n4.start))
  let c_n4 = merge(text("Do this for every example, and", x: 0.06, y: -0.060, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - n4.start) / (n4.duration * 0.92), 0, 1) * 92) - 0, 0, 30) * adv), text("add the gaps up. That total is", x: 0.06, y: -0.008, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - n4.start) / (n4.duration * 0.92), 0, 1) * 92) - 31, 0, 30) * adv), text("the error. 0 would be perfect.", x: 0.06, y: 0.044, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - n4.start) / (n4.duration * 0.92), 0, 1) * 92) - 62, 0, 30) * adv)) * (T >= n4.start) * (T < min(n4.end + 1.5, n5.start))
