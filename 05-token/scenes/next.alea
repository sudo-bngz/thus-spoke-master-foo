// Next — the next token: the text so far at the top; under it, the
// candidates with their probabilities as bars that grow; the most likely
// is picked (vermilion), slides up into the text, and it starts again:
// three rounds. The probabilities are illustrative. `ctx` the three
// contexts (`lens` their lengths), `cand` the candidates (4 per round), `prob` their percentages,
// `round0`, `round1`, `round2` when each round starts. `accent: 1` gives
// only the picked one. Times are the scene's own (0 to 1). What it
// returns: 0 paper, up to 1 ink.

work Next(ctx = ["Once upon a", "Once upon a time,", "Once upon a time, there"], cand = ["time", "midnight", "the", "dragon", "there", "a", "in", "the", "was", "lived", "were", "is"], prob = [62, 8, 5, 1, 40, 22, 15, 9, 71, 18, 6, 2], lens = [11, 17, 23], starts = [0.1, 0.4, 0.7], pick = 0.2, accent = 0) {
  let bars = 0.35
  let growing = 0.1
  let round(r) = (t >= starts[r]) * (t < starts[min(r + 1, 2)] + (r == 2) * 10)
  let context(r) = text(ctx[r], 0.5, 0.3, 0.04, 0, "mono") * round(r)
  let cursor(r) = rect(0.5 + (lens[r] + 1) * 0.0207 / 2 + 0.0, 0.3, 0.016, 0.045, 0, 0.001) * (fract(t * 40) < 0.5) * round(r) * (t < starts[r] + pick)
  let row(k) = 0.48 + 0.09 * k
  let width(r, k) = 0.55 * prob[4 * r + k] / 100 * clamp((t - starts[r] - 0.02) / growing, 0, 1)
  let bar(r, k) = rect(0.38 + width(r, k) / 2, row(k), width(r, k), 0.05, 0, 0.002) * round(r) * (t < starts[r] + pick + 0.05 + (k > 0) * 10)
  let label(r, k) = text(cand[4 * r + k], 0.36, row(k), 0.036, 0, "mono", "right") * round(r) * smoothstep(starts[r], starts[r] + 0.02, t)
  let pct(r, k) = text("{prob[4 * r + k]} %", 0.4 + width(r, k), row(k), 0.024, 0, "mono", "left") * round(r) * (t > starts[r] + 0.02 + growing) * 0.6
  let rest(r) = text("and 50 000 others…", 0.36, row(4), 0.024, 0, "mono", "right") * round(r) * (t > starts[r] + 0.02 + growing) * 0.45
  // the pick: the top candidate, in vermilion, then it slides up to the text
  let rise(r) = clamp((t - starts[r] - pick) / 0.05, 0, 1)
  let picked(r) = merge(rect(0.38 + width(r, 0) / 2, row(0), width(r, 0), 0.045, 0, 0.002) * (rise(r) == 0),
                        text(cand[4 * r], 0.36 + (0.5 + (lens[r] + 2) * 0.0207 / 2 - 0.36) * rise(r), row(0) - (row(0) - 0.3) * rise(r), 0.03 + 0.01 * rise(r), 0, "mono", "right") * (rise(r) > 0) * (rise(r) < 1))
           * round(r) * (t > starts[r] + pick)
  let rounds = merge([merge(context(r), cursor(r), merge([merge(bar(r, k), label(r, k), pct(r, k)) for k in range(4)]), rest(r)) for r in range(3)])
  let picks = merge([picked(r) for r in range(3)])
  output accent * picks + (1 - accent) * rounds
}
