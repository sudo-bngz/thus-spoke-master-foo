 n12.words[8]), 0, 1) * 5 + clamp((T - n12.words[9]) / (n12.ends[9] - n12.words[9]), 0, 1) * 7 + clamp((T - n12.words[10]) / (n12.ends[10] - n12.words[10]), 0, 1) * 11 + clamp((T - n12.words[11]) / (n12.ends[11] - n12.words[11]), 0, 1) * 6 + clamp((T - n12.words[12]) / (n12.ends[12] - n12.words[12]), 0, 1) * 2 + clamp((T - n12.words[13]) / (n12.ends[13] - n12.words[13]), 0, 1) * 4 + clamp((T - n12.words[14]) / (n12.ends[14] - n12.words[14]), 0, 1) * 5 + clamp((T - n12.words[15]) / (n12.ends[15] - n12.words[15]), 0, 1) * 8) - 31, 0, 29) * adv), text("looks a lot like knowing.", x: 0.06, y: 0.044, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - n12.words[0]) / (n12.ends[0] - n12.words[0]), 0, 1) * 3 + clamp((T - n12.words[1]) / (n12.ends[1] - n12.words[1]), 0, 1) * 5 + clamp((T - n12.words[2]) / (n12.ends[2] - n12.words[2]), 0, 1) * 4 + clamp((T - n12.words[3]) / (n12.ends[3] - n12.words[3]), 0, 1) * 6 + clamp((T - n12.words[4]) / (n12.ends[4] - n12.words[4]), 0, 1) * 3 + clamp((T - n12.words[5]) / (n12.ends[5] - n12.words[5]), 0, 1) * 10 + clamp((T - n12.words[6]) / (n12.ends[6] - n12.words[6]), 0, 1) * 4 + clamp((T - n12.words[7]) / (n12.ends[7] - n12.words[7]), 0, 1) * 3 + clamp((T - n12.words[8]) / (n12.ends[8] - n12.words[8]), 0, 1) * 5 + clamp((T - n12.words[9]) / (n12.ends[9] - n12.words[9]), 0, 1) * 7 + clamp((T - n12.words[10]) / (n12.ends[10] - n12.words[10]), 0, 1) * 11 + clamp((T - n12.words[11]) / (n12.ends[11] - n12.words[11]), 0, 1) * 6 + clamp((T - n12.words[12]) / (n12.ends[12] - n12.words[12]), 0, 1) * 2 + clamp((T - n12.words[13]) / (n12.ends[13] - n12.words[13]), 0, 1) * 4 + clamp((T - n12.words[14]) / (n12.ends[14] - n12.words[14]), 0, 1) * 5 + clamp((T - n12.words[15]) / (n12.ends[15] - n12.words[15]), 0, 1) * 8) - 61, 0, 25) * adv)) * (T >= n12.start) * (T < min(n12.end + 1.5, m4.start))
  let c_m4 = merge(text("Master Foo said: that is all the", x: 0.06, y: -0.060, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - m4.start) / (m4.duration * 0.92), 0, 1) * 46) - 0, 0, 32) * adv), text("machine does.", x: 0.06, y: -0.008, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - m4.start) / (m4.duration * 0.92), 0, 1) * 46) - 33, 0, 13) * adv)) * (T >= m4.start) * (T < min(m4.end + 1.5, m5.start))
  let c_m5 = merge(text("1 word at a time. Billions of", x: 0.06, y: -0.060, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - m5.start) / (m5.duration * 0.92), 0, 1) * 36) - 0, 0, 29) * adv), text("times.", x: 0.06, y: -0.008, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - m5.start) / (m5.duration * 0.92), 0, 1) * 36) - 30, 0, 6) * adv)) * (T >= m5.start) * (T < min(m5.end + 1.5, m6.start))
  let c_m6 = text("And the novice was enlightened.", x: 0.06, y: -0.060, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - m6.start) / (m6.duration * 0.92), 0, 1) * 31) - 0, 0, 31) * adv) * (T >= m6.start) * (T < m6.end + 3)
  let said = merge(c_n1, c_n2, c_n3, c_n4, c_n5, c_n6, c_n7, c_n8, c_n9, c_n10, c_n11, c_n12)
  let spoken = merge(c_m1, c_m2, c_m3, c_m4, c_m5, c_m6)
  let dark = paint(merge(header, series, said), palette: ["#000000", "#1a1712"], range: [0, 1], alpha: merge(header, series, said))
  let red  = paint(spoken, palette: ["#000000", "#b8361f"], range: [0, 1], alpha: spoken)
  let look = film(vignette(overlay(reel, dark, red), amount: 0.06), amount: 0.035)

  // ── the sound ──
  let pad = synth {
    let env = adsr(attack: 3, decay: 1, sustain: 0.9, release: 4)
    lowpass(saw(note.freq) + saw(note.freq * 1.003) + sine(note.freq * 0.5), cutoff: 260 + 300 * note.level, resonance: 0.2) * env
  }
  let brush = synth { bandpass(noise(), cutoff: 1400, resonance: 0.3) * adsr(attack: 0.12, decay: 0.3, sustain: 0.3, release: 0.5) * note.velocity }
  let snip = synth { highpass(noise(), cutoff: 3000, resonance: 0.3) * perc(attack: 0.001, release: 0.04) * note.velocity }
  let sweep = synth { lowpass(saw(note.freq * (1 + 0.5 * note.time)), cutoff: 800 + 2000 * note.time, resonance: 0.3) * adsr(attack: 0.02, decay: 0.3, sustain: 0.5, release: 0.2) * 0.5 }
  let tumble = synth { bandpass(noise(), cutoff: 1200, resonance: 0.6) * perc(release: 0.03) * note.velocity + sine(note.freq) * perc(release: 0.04) * 0.3 }
  // the temple bell when the master speaks; the question, and the answer
  pattern bells = repeat 2 event(t: [m1.start - 1.0, m4.start - 1.0][i] / total, x: 0.5, y: 0.95, size: 0.12, intensity: 0.9)
  pattern asked = repeat 1 event(t: (m2.end - 0.3) / total, x: 0.5, y: 0.5, size: 0.06, intensity: 0.8)
  // the cuts between tokens, the numbers; the long word cut
  pattern cuts = repeat 3 event(t: (n1.words[11] + (n1.words[14] - n1.words[11]) * (i + 1) / 3) / total, x: 0.3 + 0.2 * i, y: 0.5, intensity: 0.7)
  pattern ids = repeat 4 event(t: (n1.words[11] + (n1.words[14] - n1.words[11]) * i / 3 + 0.4) / total, x: 0.3 + 0.15 * i, y: 0.4 + 0.1 * (i % 2), intensity: 0.4)
  pattern wcuts = repeat 2 event(t: (n2.words[1] + 14.5 * (0.1 + 0.08 * i)) / total, x: 0.4 + 0.2 * i, y: 0.6, intensity: 0.7)
  // the bars growing, the pick, three rounds
  pattern grows = repeat 3 event(t: ([n4.words[0], n5.words[9], n6.words[0]][i] + 0.02 * 27.0) / total, x: 0.5, y: 0.6, size: 0.05, intensity: 0.5)
  pattern picked = repeat 3 event(t: ([n4.words[0], n5.words[9], n6.words[0]][i] + n5.words[1] - n4.words[0]) / total, x: 0.5, y: 0.35, size: 0.05, intensity: 0.8)
  // the die tumbling, three times, and landing
  pattern tumbles = repeat 30 event(t: ([n8.words[4], n7.words[8], n8.words[9]][floor(i / 10)] + 20.6 * (0.12 + 0.05 * (i % 10) / 10)) / total, x: ~between(0.3, 0.7), y: ~between(0.4, 0.7), intensity: 0.4)
  pattern lands = repeat 3 event(t: ([n8.words[4], n7.words[8], n8.words[9]][i] + 20.6 * 0.17) / total, x: 0.8, y: [0.5, 0.5, 0.3][i], size: 0.05, intensity: 0.8)
  // the reading: a crackle of knobs turning, fading as they settle
  let turning = (T > n10.words[6]) * (1 - smoothstep(n11.end - 3, n11.end, T)) + x * 0

  let music = [
    m1, m2, m3, n1, n2, n3, n4, n5, n6, n7, n8, n9, n10, n11, n12, m4, m5, m6,
    drone(0.45 + 0.15 * lfo(3) + x * 0, voices: 2, instrument: pad, scale: "hirajoshi", key: 55, gain: 0.9),
    notes(bells, instrument: "bell", scale: "hirajoshi", key: 110, gain: 0.7),
    notes(asked, instrument: "kalimba", scale: "hirajoshi", key: 392, gain: 0.6),
    notes(cuts, instrument: snip, gain: 0.5),
    notes(ids, instrument: "wood", scale: "hirajoshi", key: 330, gain: 0.3),
    notes(wcuts, instrument: snip, gain: 0.5),
    notes(grows, instrument: sweep, scale: "hirajoshi", key: 110, gain: 0.35),
    notes(picked, instrument: "kalimba", scale: "hirajoshi", key: 392, gain: 0.55),
    notes(tumbles, instrument: tumble, scale: "chromatic", key: 600, gain: 0.3),
    notes(lands, instrument: "glass", scale: "hirajoshi", key: 392, gain: 0.5),
    texture(turning, kind: "crackle", gain: 0.5),
    notes(reel.cues, instrument: brush, scale: "chromatic", key: 100, gain: 0.3),
  ]

  render image(look, width: 1080, height: 1920, at: 0.3444)
  render video(look, fps: 30, width: 1080, height: 1920, sound: music, room: 0.12, echo: 0)
}
