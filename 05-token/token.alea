// Token — Thus Spoke Master Foo, 05: what is a language model? A novice
// asks how a machine speaks; Master Foo says "once upon a time, in a
// certain place…" and asks for the next word. A model reads tokens, pieces
// of words, each a number; its only job is a probability for every token
// that could come next; it picks one, adds it, asks again. It rolls a die
// weighted by the probabilities, and temperature shapes the die. The
// probabilities come from reading nearly everything, hundreds of billions
// of knobs turned until the guesses matched. The probabilities shown are
// illustrative (gen.py). Master Foo speaks Japanese, translated in the
// captions.

use "scenes/koan.alea"
use "scenes/tokens.alea"
use "scenes/next.alea"
use "scenes/dice.alea"
use "scenes/knobs.alea"

work Token {
  let total = 120.8
  let T = t * total
  let EN = "../voices/narrator.sh"
  let JA = "../voices/master.sh"

  // ── the voices: the master, in Japanese; the one who explains, in English ──
  let m1 = say("弟子は尋ねた。機械は、どうやって話すのですか。", at: 1.40, engine: JA, voice: "jm_kumo", speed: 0.82, gain: 2.3)
  let m2 = say("師は言った。むかしむかし、あるところに。次の言葉は？", at: m1.end + 1.2, engine: JA, voice: "jm_kumo", speed: 0.82, gain: 2.3)
  let m3 = say("弟子は答えた。おじいさん。", at: m2.end + 1.4, engine: JA, voice: "jm_kumo", speed: 0.82, gain: 2.3)
  let n1 = say("A language model does not read letters, nor words. It reads tokens: pieces of words, each one a number.", at: 20.40, engine: EN, voice: "af_heart", speed: 0.95, gain: 2.3)
  let n2 = say("A long word can be three tokens.", at: n1.end + 1.2, engine: EN, voice: "af_heart", speed: 0.95, gain: 2.3)
  let n3 = say("Its only job: given the tokens so far, a probability for every token that could come next.", at: 34.90, engine: EN, voice: "af_heart", speed: 0.95, gain: 2.3)
  let n4 = say("Once upon a: time, sixty-two percent. Midnight, eight. The, five. And fifty thousand others.", at: n3.end + 1.2, engine: EN, voice: "af_heart", speed: 0.95, gain: 2.3)
  let n5 = say("It picks one, adds it to the text, and asks again. One token at a time.", at: n4.end + 1.2, engine: EN, voice: "af_heart", speed: 0.95, gain: 2.3)
  let n6 = say("That is the whole machine. Everything it writes is this, repeated.", at: n5.end + 1.2, engine: EN, voice: "af_heart", speed: 0.95, gain: 2.3)
  let n7 = say("It does not always take the most likely one. It rolls a die, weighted by the probabilities.", at: 61.90, engine: EN, voice: "af_heart", speed: 0.95, gain: 2.3)
  let n8 = say("Temperature shapes the die: at zero, always the top. Higher, and the rare words come out.", at: n7.end + 1.2, engine: EN, voice: "af_heart", speed: 0.95, gain: 2.3)
  let n9 = say("The same question, different answers: a die, with a very good memory.", at: n8.end + 1.4, engine: EN, voice: "af_heart", speed: 0.95, gain: 2.3)
  let n10 = say("Where do the probabilities come from? From reading nearly everything ever written.", at: 82.50, engine: EN, voice: "af_heart", speed: 0.95, gain: 2.3)
  let n11 = say("Hundreds of billions of knobs, turned a little at each sentence, until the guesses matched the text.", at: n10.end + 1.2, engine: EN, voice: "af_heart", speed: 0.95, gain: 2.3)
  let n12 = say("It does not know. It predicts. And at this scale, predicting looks a lot like knowing.", at: n11.end + 1.6, engine: EN, voice: "af_heart", speed: 0.95, gain: 2.3)
  let m4 = say("師は言った。それが、機械のすることのすべてだ。", at: 104.00, engine: JA, voice: "jm_kumo", speed: 0.82, gain: 2.3)
  let m5 = say("一語ずつ。何十億回も。", at: m4.end + 1.2, engine: JA, voice: "jm_kumo", speed: 0.82, gain: 2.3)
  let m6 = say("その時、弟子は悟った。", at: m5.end + 1.4, engine: JA, voice: "jm_kumo", speed: 0.82, gain: 2.3)

  // ── the candidates and their probabilities (illustrative), and the die's three temperatures (gen.py) ──
  let cand = ["time", "midnight", "the", "dragon"]
  let tprobs = [100, 0, 0, 0, 92, 5, 3, 0, 66, 17, 12, 4]
  let picks = [0, 0, 3]

  // ── the scenes: ink on paper, a vermilion accent, under the captions ──
  let PAPER = ["#efe9dc", "#d3c9b4", "#3b352c", "#17140f"]
  let fit(piece) = zoom(piece, by: 0.82, x: 0.5, y: 0.66)
  let ink(piece, accent) = overlay(paint(fit(piece), palette: PAPER, range: [0, 1]), paint(fit(accent), palette: ["#000000", "#c23b22"], range: [0, 1], alpha: fit(accent)))
  let reel = timeline([
      scene(ink(Koan(draw0: ((m1.start) - 0.00) / 19.0, draw1: ((m1.end) - 0.00) / 19.0, word: ((m3.end + 0.8) - 0.00) / 19.0, title: ((m3.end + 1.0) - 0.00) / 19.0, kana: ["ト", "ー", "ク", "ン"], episode: "05  ·  token", big: "?", bigsize: 0.2, bigat: [((m2.end - 0.3) - 0.00) / 19.0, ((m3.end + 5) - 0.00) / 19.0], bigoff: ((m3.start + 0.6 * m3.duration) - 0.00) / 19.0, accent: 0), Koan(draw0: ((m1.start) - 0.00) / 19.0, draw1: ((m1.end) - 0.00) / 19.0, word: ((m3.end + 0.8) - 0.00) / 19.0, title: ((m3.end + 1.0) - 0.00) / 19.0, kana: ["ト", "ー", "ク", "ン"], episode: "05  ·  token", big: "?", bigsize: 0.2, bigat: [((m2.end - 0.3) - 0.00) / 19.0, ((m3.end + 5) - 0.00) / 19.0], bigoff: ((m3.start + 0.6 * m3.duration) - 0.00) / 19.0, accent: 1)), 19.0),  wipe(0.8, angle: 0, softness: 0.12),
      scene(ink(Tokens(cut0: ((n1.words[11]) - 19.00) / 14.5, cut1: ((n1.words[14]) - 19.00) / 14.5, word0: ((n2.words[1]) - 19.00) / 14.5, accent: 0), Tokens(cut0: ((n1.words[11]) - 19.00) / 14.5, cut1: ((n1.words[14]) - 19.00) / 14.5, word0: ((n2.words[1]) - 19.00) / 14.5, accent: 1)), 14.5),  pixels(0.6, size: 0.05),
      scene(ink(Next(cand: ["time", "midnight", "the", "dragon", "there", "a", "in", "the", "was", "lived", "were", "is"], starts: [((n4.words[0]) - 33.50) / 27.0, ((n5.words[9]) - 33.50) / 27.0, ((n6.words[0]) - 33.50) / 27.0], pick: (n5.words[1] - n4.words[0]) / 27.0, accent: 0), Next(cand: ["time", "midnight", "the", "dragon", "there", "a", "in", "the", "was", "lived", "were", "is"], starts: [((n4.words[0]) - 33.50) / 27.0, ((n5.words[9]) - 33.50) / 27.0, ((n6.words[0]) - 33.50) / 27.0], pick: (n5.words[1] - n4.words[0]) / 27.0, accent: 1)), 27.0),  wipe(0.7, angle: 90, softness: 0.1),
      scene(ink(Dice(cand: cand, probs: tprobs, picks: picks, at: [((n8.words[4]) - 60.50) / 20.6, ((n7.words[8]) - 60.50) / 20.6, ((n8.words[9]) - 60.50) / 20.6], accent: 0), Dice(cand: cand, probs: tprobs, picks: picks, at: [((n8.words[4]) - 60.50) / 20.6, ((n7.words[8]) - 60.50) / 20.6, ((n8.words[9]) - 60.50) / 20.6], accent: 1)), 20.6),  morph(0.8, amount: 0.15),
      scene(ink(Knobs(read0: ((n10.words[6]) - 81.10) / 21.5, settle: ((n11.end) - 81.10) / 21.5, accent: 0), Knobs(read0: ((n10.words[6]) - 81.10) / 21.5, settle: ((n11.end) - 81.10) / 21.5, accent: 1)), 21.5),  wipe(0.8, angle: 180, softness: 0.12),
      scene(ink(Koan(draw0: ((m4.start) - 102.60) / 18.2, draw1: ((m6.end) - 102.60) / 18.2, word: ((m6.start + 0.5) - 102.60) / 18.2, title: ((m6.end + 0.6) - 102.60) / 18.2, kana: ["ト", "ー", "ク", "ン"], episode: "05  ·  token", accent: 0), Koan(draw0: ((m4.start) - 102.60) / 18.2, draw1: ((m6.end) - 102.60) / 18.2, word: ((m6.start + 0.5) - 102.60) / 18.2, title: ((m6.end + 0.6) - 102.60) / 18.2, kana: ["ト", "ー", "ク", "ン"], episode: "05  ·  token", accent: 1)), 18.2),  morph(1.2, amount: 0.2),
  ], loop: 1)

  // ── over it: the series, the step, the captions (the master's, translated, in vermilion) ──
  let adv = 0.021722
  let header = merge(text("1 / 4   tokens", x: 0.06, y: -0.15, size: 0.03, font: "mono", align: "left") * (reel.index > 1 - 0.5) * (reel.index < 1 + 0.5), text("2 / 4   the next token", x: 0.06, y: -0.15, size: 0.03, font: "mono", align: "left") * (reel.index > 2 - 0.5) * (reel.index < 2 + 0.5), text("3 / 4   the die", x: 0.06, y: -0.15, size: 0.03, font: "mono", align: "left") * (reel.index > 3 - 0.5) * (reel.index < 3 + 0.5), text("4 / 4   the knobs", x: 0.06, y: -0.15, size: 0.03, font: "mono", align: "left") * (reel.index > 4 - 0.5) * (reel.index < 4 + 0.5)) * 0.7
  let series = text("thus spoke master foo  ·  05", x: 0.94, y: -0.3, size: 0.024, font: "mono", align: "right") * 0.45
  let c_m1 = merge(text("The novice asked: how does a", x: 0.06, y: -0.060, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - m1.start) / (m1.duration * 0.92), 0, 1) * 43) - 0, 0, 28) * adv), text("machine speak?", x: 0.06, y: -0.008, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - m1.start) / (m1.duration * 0.92), 0, 1) * 43) - 29, 0, 14) * adv)) * (T >= m1.start) * (T < min(m1.end + 1.5, m2.start))
  let c_m2 = merge(text("Master Foo said: once upon a", x: 0.06, y: -0.060, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - m2.start) / (m2.duration * 0.92), 0, 1) * 69) - 0, 0, 28) * adv), text("time, in a certain place… The", x: 0.06, y: -0.008, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - m2.start) / (m2.duration * 0.92), 0, 1) * 69) - 29, 0, 29) * adv), text("next word?", x: 0.06, y: 0.044, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - m2.start) / (m2.duration * 0.92), 0, 1) * 69) - 59, 0, 10) * adv)) * (T >= m2.start) * (T < min(m2.end + 1.5, m3.start))
  let c_m3 = text("The novice answered: an old man.", x: 0.06, y: -0.060, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - m3.start) / (m3.duration * 0.92), 0, 1) * 32) - 0, 0, 32) * adv) * (T >= m3.start) * (T < min(m3.end + 1.5, n1.start))
  let c_n1 = merge(text("A language model does not read", x: 0.06, y: -0.060, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - n1.words[0]) / (n1.ends[0] - n1.words[0]), 0, 1) * 2 + clamp((T - n1.words[1]) / (n1.ends[1] - n1.words[1]), 0, 1) * 9 + clamp((T - n1.words[2]) / (n1.ends[2] - n1.words[2]), 0, 1) * 6 + clamp((T - n1.words[3]) / (n1.ends[3] - n1.words[3]), 0, 1) * 5 + clamp((T - n1.words[4]) / (n1.ends[4] - n1.words[4]), 0, 1) * 4 + clamp((T - n1.words[5]) / (n1.ends[5] - n1.words[5]), 0, 1) * 5 + clamp((T - n1.words[6]) / (n1.ends[6] - n1.words[6]), 0, 1) * 9 + clamp((T - n1.words[7]) / (n1.ends[7] - n1.words[7]), 0, 1) * 4 + clamp((T - n1.words[8]) / (n1.ends[8] - n1.words[8]), 0, 1) * 7 + clamp((T - n1.words[9]) / (n1.ends[9] - n1.words[9]), 0, 1) * 3 + clamp((T - n1.words[10]) / (n1.ends[10] - n1.words[10]), 0, 1) * 6 + clamp((T - n1.words[11]) / (n1.ends[11] - n1.words[11]), 0, 1) * 8 + clamp((T - n1.words[12]) / (n1.ends[12] - n1.words[12]), 0, 1) * 7 + clamp((T - n1.words[13]) / (n1.ends[13] - n1.words[13]), 0, 1) * 3 + clamp((T - n1.words[14]) / (n1.ends[14] - n1.words[14]), 0, 1) * 7 + clamp((T - n1.words[15]) / (n1.ends[15] - n1.words[15]), 0, 1) * 5 + clamp((T - n1.words[16]) / (n1.ends[16] - n1.words[16]), 0, 1) * 4 + clamp((T - n1.words[17]) / (n1.ends[17] - n1.words[17]), 0, 1) * 2 + clamp((T - n1.words[18]) / (n1.ends[18] - n1.words[18]), 0, 1) * 7) - 0, 0, 30) * adv), text("letters, nor words. It reads", x: 0.06, y: -0.008, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - n1.words[0]) / (n1.ends[0] - n1.words[0]), 0, 1) * 2 + clamp((T - n1.words[1]) / (n1.ends[1] - n1.words[1]), 0, 1) * 9 + clamp((T - n1.words[2]) / (n1.ends[2] - n1.words[2]), 0, 1) * 6 + clamp((T - n1.words[3]) / (n1.ends[3] - n1.words[3]), 0, 1) * 5 + clamp((T - n1.words[4]) / (n1.ends[4] - n1.words[4]), 0, 1) * 4 + clamp((T - n1.words[5]) / (n1.ends[5] - n1.words[5]), 0, 1) * 5 + clamp((T - n1.words[6]) / (n1.ends[6] - n1.words[6]), 0, 1) * 9 + clamp((T - n1.words[7]) / (n1.ends[7] - n1.words[7]), 0, 1) * 4 + clamp((T - n1.words[8]) / (n1.ends[8] - n1.words[8]), 0, 1) * 7 + clamp((T - n1.words[9]) / (n1.ends[9] - n1.words[9]), 0, 1) * 3 + clamp((T - n1.words[10]) / (n1.ends[10] - n1.words[10]), 0, 1) * 6 + clamp((T - n1.words[11]) / (n1.ends[11] - n1.words[11]), 0, 1) * 8 + clamp((T - n1.words[12]) / (n1.ends[12] - n1.words[12]), 0, 1) * 7 + clamp((T - n1.words[13]) / (n1.ends[13] - n1.words[13]), 0, 1) * 3 + clamp((T - n1.words[14]) / (n1.ends[14] - n1.words[14]), 0, 1) * 7 + clamp((T - n1.words[15]) / (n1.ends[15] - n1.words[15]), 0, 1) * 5 + clamp((T - n1.words[16]) / (n1.ends[16] - n1.words[16]), 0, 1) * 4 + clamp((T - n1.words[17]) / (n1.ends[17] - n1.words[17]), 0, 1) * 2 + clamp((T - n1.words[18]) / (n1.ends[18] - n1.words[18]), 0, 1) * 7) - 31, 0, 28) * adv), text("tokens: pieces of words, each one", x: 0.06, y: 0.044, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - n1.words[0]) / (n1.ends[0] - n1.words[0]), 0, 1) * 2 + clamp((T - n1.words[1]) / (n1.ends[1] - n1.words[1]), 0, 1) * 9 + clamp((T - n1.words[2]) / (n1.ends[2] - n1.words[2]), 0, 1) * 6 + clamp((T - n1.words[3]) / (n1.ends[3] - n1.words[3]), 0, 1) * 5 + clamp((T - n1.words[4]) / (n1.ends[4] - n1.words[4]), 0, 1) * 4 + clamp((T - n1.words[5]) / (n1.ends[5] - n1.words[5]), 0, 1) * 5 + clamp((T - n1.words[6]) / (n1.ends[6] - n1.words[6]), 0, 1) * 9 + clamp((T - n1.words[7]) / (n1.ends[7] - n1.words[7]), 0, 1) * 4 + clamp((T - n1.words[8]) / (n1.ends[8] - n1.words[8]), 0, 1) * 7 + clamp((T - n1.words[9]) / (n1.ends[9] - n1.words[9]), 0, 1) * 3 + clamp((T - n1.words[10]) / (n1.ends[10] - n1.words[10]), 0, 1) * 6 + clamp((T - n1.words[11]) / (n1.ends[11] - n1.words[11]), 0, 1) * 8 + clamp((T - n1.words[12]) / (n1.ends[12] - n1.words[12]), 0, 1) * 7 + clamp((T - n1.words[13]) / (n1.ends[13] - n1.words[13]), 0, 1) * 3 + clamp((T - n1.words[14]) / (n1.ends[14] - n1.words[14]), 0, 1) * 7 + clamp((T 