// Entraînement — Thus Spoke Master Foo, AI 07: where the weights come
// from. At first they are random; training is a game: a sentence from the
// internet, the next word hidden, the machine guesses; the error is how
// far the guess is from the truth; it flows backward and every weight
// moves a tiny step; done on everything ever written, on thousands of
// machines for months, the error goes down; and to guess the next word
// well the machine had to learn grammar, facts, styles, arithmetic. The
// numbers are illustrative. Master Foo speaks Japanese, translated in the
// captions.

use "scenes/koan.alea"
use "scenes/guess.alea"
use "scenes/nudge.alea"
use "scenes/scale.alea"
use "scenes/learned.alea"

work Entrainement {
  let total = 143.2
  let T = t * total
  let EN = "../voices/narrator.sh"
  let JA = "../voices/master.sh"

  // ── the voices: the master, in Japanese; the one who explains, in English ──
  let m1 = say("弟子は尋ねた。機械は、どこで言葉を学んだのですか。", at: 1.50, engine: JA, voice: "jm_kumo", speed: 0.82, gain: 2.3)
  let m2 = say("師は言った。書かれたものを、すべて読んだ。そして、1語ずつ、間違えた。", at: m1.end + 1.4, engine: JA, voice: "jm_kumo", speed: 0.82, gain: 2.3)
  let m3 = say("弟子は尋ねた。間違えて、どうなるのですか。", at: m2.end + 1.4, engine: JA, voice: "jm_kumo", speed: 0.82, gain: 2.3)
  let n1 = say("Where do the weights come from? At first, they are random. The machine knows nothing: every token is as likely as any other.", at: 24.70, engine: EN, voice: "af_heart", speed: 1.0, gain: 2.3)
  let n2 = say("Training is a game. Take a sentence from the internet. Hide the next word. Let the machine guess.", at: n1.end + 1.4, engine: EN, voice: "af_heart", speed: 1.0, gain: 2.3)
  let n3 = say("Once upon a: the machine gives time three percent. The truth is time, one hundred percent. The error is how far three is from one hundred.", at: n2.end + 1.4, engine: EN, voice: "af_heart", speed: 1.0, gain: 2.3)
  let n4 = say("One sentence, one error. That number is all the machine learns from.", at: n3.end + 1.4, engine: EN, voice: "af_heart", speed: 1.0, gain: 2.3)
  let n5 = say("The error flows backward through the layers, like in the episode on error. Every weight learns which way to move.", at: 55.30, engine: EN, voice: "af_heart", speed: 1.0, gain: 2.3)
  let n6 = say("Each weight moves a tiny step. Billions of weights, all at once.", at: n5.end + 1.4, engine: EN, voice: "af_heart", speed: 1.0, gain: 2.3)
  let n7 = say("Next time, on the same sentence, time gets four percent. A little better. Then the next sentence.", at: n6.end + 1.4, engine: EN, voice: "af_heart", speed: 1.0, gain: 2.3)
  let n8 = say("Now do it on everything ever written. Trillions of words. Thousands of machines, for months.", at: 76.80, engine: EN, voice: "af_heart", speed: 1.0, gain: 2.3)
  let n9 = say("The error goes down. Fast at first, then slower. Each step is tiny, but there are billions of them.", at: n8.end + 1.4, engine: EN, voice: "af_heart", speed: 1.0, gain: 2.3)
  let n10 = say("Nobody writes a rule. Nobody tells it what a noun is, or what the capital of France is. Only: guess the next word.", at: n9.end + 1.4, engine: EN, voice: "af_heart", speed: 1.0, gain: 2.3)
  let n11 = say("To guess the next word well, the machine had to learn grammar. Facts. Styles. Arithmetic. Everything the next word depends on.", at: 100.80, engine: EN, voice: "af_heart", speed: 1.0, gain: 2.3)
  let n12 = say("The capital of France is: Paris. Two plus two equals: four. Dear Sir: I hope this. The weights hold it all.", at: n11.end + 1.4, engine: EN, voice: "af_heart", speed: 1.0, gain: 2.3)
  let n13 = say("It learned the internet: the true and the false alike. Next time: how much it can hold in mind at once. Memory.", at: n12.end + 1.4, engine: EN, voice: "af_heart", speed: 1.0, gain: 2.3)
  let m4 = say("師は言った。間違えるたびに、少し変わる。", at: 126.60, engine: JA, voice: "jm_kumo", speed: 0.82, gain: 2.3)
  let m5 = say("何十億回も。それが、学ぶということだ。", at: m4.end + 1.4, engine: JA, voice: "jm_kumo", speed: 0.82, gain: 2.3)
  let m6 = say("その時、弟子は悟った。", at: m5.end + 1.6, engine: JA, voice: "jm_kumo", speed: 0.82, gain: 2.3)

  // ── the scenes: ink on paper, a vermilion accent, under the captions ──
  let PAPER = ["#efe9dc", "#d3c9b4", "#3b352c", "#17140f"]
  let fit(piece) = zoom(piece, by: 0.82, x: 0.5, y: 0.66)
  let ink(piece, accent) = overlay(paint(fit(piece), palette: PAPER, range: [0, 1]), paint(fit(accent), palette: ["#000000", "#c23b22"], range: [0, 1], alpha: fit(accent)))
  let reel = timeline([
      scene(ink(Koan(draw0: ((m1.start) - 0.00) / 23.2, draw1: ((m1.end) - 0.00) / 23.2, word: ((m3.end + 0.8) - 0.00) / 23.2, title: ((m3.end + 1.0) - 0.00) / 23.2, kana: ["ガ", "ク", "シ", "ュ", "ウ"], episode: "AI 07  ·  training", accent: 0), Koan(draw0: ((m1.start) - 0.00) / 23.2, draw1: ((m1.end) - 0.00) / 23.2, word: ((m3.end + 0.8) - 0.00) / 23.2, title: ((m3.end + 1.0) - 0.00) / 23.2, kana: ["ガ", "ク", "シ", "ュ", "ウ"], episode: "AI 07  ·  training", accent: 1)), 23.2),  wipe(0.8, angle: 0, softness: 0.12),
      scene(ink(Guess(flat0: ((n1.words[7]) - 23.20) / 30.6, sentence0: ((n2.words[4]) - 23.20) / 30.6, hide0: ((n2.words[10]) - 23.20) / 30.6, guess0: ((n3.words[3]) - 23.20) / 30.6, truth0: ((n3.words[8]) - 23.20) / 30.6, error0: ((n3.words[14]) - 23.20) / 30.6, accent: 0), Guess(flat0: ((n1.words[7]) - 23.20) / 30.6, sentence0: ((n2.words[4]) - 23.20) / 30.6, hide0: ((n2.words[10]) - 23.20) / 30.6, guess0: ((n3.words[3]) - 23.20) / 30.6, truth0: ((n3.words[8]) - 23.20) / 30.6, error0: ((n3.words[14]) - 23.20) / 30.6, accent: 1)), 30.6),  pixels(0.6, size: 0.05),
      scene(ink(Nudge(layers0: ((n5.start - 1.2) - 53.80) / 21.5, back0: ((n5.words[2]) - 53.80) / 21.5, step0: ((n6.words[3]) - 53.80) / 21.5, again0: ((n7.words[0]) - 53.80) / 21.5, accent: 0), Nudge(layers0: ((n5.start - 1.2) - 53.80) / 21.5, back0: ((n5.words[2]) - 53.80) / 21.5, step0: ((n6.words[3]) - 53.80) / 21.5, again0: ((n7.words[0]) - 53.80) / 21.5, accent: 1)), 21.5),  wipe(0.7, angle: 90, softness: 0.1),
      scene(ink(Scale(machines0: ((n8.words[8]) - 75.30) / 24.0, curve0: ((n9.words[0]) - 75.30) / 24.0, curve1: ((n10.end + 1.0) - 75.30) / 24.0, rule0: ((n10.words[0]) - 75.30) / 24.0, accent: 0), Scale(machines0: ((n8.words[8]) - 75.30) / 24.0, curve0: ((n9.words[0]) - 75.30) / 24.0, curve1: ((n10.end + 1.0) - 75.30) / 24.0, rule0: ((n10.words[0]) - 75.30) / 24.0, accent: 1)), 24.0),  morph(0.8, amount: 0.15),
      scene(ink(Learned(at: [((n12.words[0]) - 99.30) / 25.8, ((n12.words[6]) - 99.30) / 25.8, ((n12.words[11]) - 99.30) / 25.8], all0: ((n12.words[16]) - 99.30) / 25.8, accent: 0), Learned(at: [((n12.words[0]) - 99.30) / 25.8, ((n12.words[6]) - 99.30) / 25.8, ((n12.words[11]) - 99.30) / 25.8], all0: ((n12.words[16]) - 99.30) / 25.8, accent: 1)), 25.8),  wipe(0.8, angle: 180, softness: 0.12),
      scene(ink(Koan(draw0: ((m4.start) - 125.10) / 18.1, draw1: ((m6.end) - 125.10) / 18.1, word: ((m6.start + 0.5) - 125.10) / 18.1, title: ((m6.end + 0.6) - 125.10) / 18.1, kana: ["ガ", "ク", "シ", "ュ", "ウ"], episode: "AI 07  ·  training", accent: 0), Koan(draw0: ((m4.start) - 125.10) / 18.1, draw1: ((m6.end) - 125.10) / 18.1, word: ((m6.start + 0.5) - 125.10) / 18.1, title: ((m6.end + 0.6) - 125.10) / 18.1, kana: ["ガ", "ク", "シ", "ュ", "ウ"], episode: "AI 07  ·  training", accent: 1)), 18.1),  morph(1.2, amount: 0.2),
  ], loop: 1)

  // ── over it: the series, the step, the captions (the master's, translated, in vermilion) ──
  let adv = 0.021722
  let header = merge(text("1 / 4   the guess", x: 0.06, y: -0.15, size: 0.03, font: "mono", align: "left") * (reel.index > 1 - 0.5) * (reel.index < 1 + 0.5), text("2 / 4   the nudge", x: 0.06, y: -0.15, size: 0.03, font: "mono", align: "left") * (reel.index > 2 - 0.5) * (reel.index < 2 + 0.5), text("3 / 4   the scale", x: 0.06, y: -0.15, size: 0.03, font: "mono", align: "left") * (reel.index > 3 - 0.5) * (reel.index < 3 + 0.5), text("4 / 4   what it learned", x: 0.06, y: -0.15, size: 0.03, font: "mono", align: "left") * (reel.index > 4 - 0.5) * (reel.index < 4 + 0.5)) * 0.7
  let series = text("thus spoke master foo  ·  AI 07", x: 0.94, y: -0.3, size: 0.024, font: "mono", align: "right") * 0.45
  let c_m1 = merge(text("The novice asked: where did the", x: 0.06, y: -0.060, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - m1.start) / (m1.duration * 0.92), 0, 1) * 56) - 0, 0, 31) * adv), text("machine learn its words?", x: 0.06, y: -0.008, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - m1.start) / (m1.duration * 0.92), 0, 1) * 56) - 32, 0, 24) * adv)) * (T >= m1.start) * (T < min(m1.end + 1.5, m2.start))
  let c_m2 = merge(text("Master Foo said: it read", x: 0.06, y: -0.060, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - m2.start) / (m2.duration * 0.92), 0, 1) * 86) - 0, 0, 24) * adv), text("everything ever written. And, 1", x: 0.06, y: -0.008, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - m2.start) / (m2.duration * 0.92), 0, 1) * 86) - 25, 0, 31) * adv), text("word at a time, it was wrong.", x: 0.06, y: 0.044, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - m2.start) / (m2.duration * 0.92), 0, 1) * 86) - 57, 0, 29) * adv)) * (T >= m2.start) * (T < min(m2.end + 1.5, m3.start))
  let c_m3 = merge(text("The novice asked: and what comes", x: 0.06, y: -0.060, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - m3.start) / (m3.duration * 0.92), 0, 1) * 48) - 0, 0, 32) * adv), text("of being wrong?", x: 0.06, y: -0.008, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - m3.start) / (m3.duration * 0.92), 0, 1) * 48) - 33, 0, 15) * adv)) * (T >= m3.start) * (T < min(m3.end + 1.5, n1.start))
  let c_n1 = merge(text("Where do the weights come from?", x: 0.06, y: -0.060, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - n1.words[0]) / (n1.ends[0] - n1.words[0]), 0, 1) * 6 + clamp((T - n1.words[1]) / (n1.ends[1] - n1.words[1]), 0, 1) * 3 + clamp((T - n1.words[2]) / (n1.ends[2] - n1.words[2]), 0, 1) * 4 + clamp((T - n1.words[3]) / (n1.ends[3] - n1.words[3]), 0, 1) * 8 + clamp((T - n1.words[4]) / (n1.ends[4] - n1.words[4]), 0, 1) * 5 + clamp((T - n1.words[5]) / (n1.ends[5] - n1.words[5]), 0, 1) * 6 + clamp((T - n1.words[6]) / (n1.ends[6] - n1.words[6]), 0, 1) * 3 + clamp((T - n1.words[7]) / (n1.ends[7] - n1.words[7]), 0, 1) * 7 + clamp((T - n1.words[8]) / (n1.ends[8] - n1.words[8]), 0, 1) * 5 + clamp((T - n1.words[9]) / (n1.ends[9] - n1.words[9]), 0, 1) * 4 + clamp((T - n1.words[10]) / (n1.ends[10] - n1.words[10]), 0, 1) * 8 + clamp((T - n1.words[11]) / (n1.ends[11] - n1.words[11]), 0, 1) * 4 + clamp((T - n1.words[12]) / (n1.ends[12] - n1.words[12]), 0, 1) * 8 + clamp((T - n1.words[13]) / (n1.ends[13] - n1.words[13]), 0, 1) * 6 + clamp((T - n1.words[14]) / (n1.ends[14] - n1.words[14]), 0, 1) * 9 + clamp((T - n1.words[15]) / (n1.ends[15] - n1.words[15]), 0, 1) * 6 + clamp((T - n1.words[16]) / (n1.ends[16] - n1.words[16]), 0, 1) * 6 + clamp((T - n1.words[17]) / (n1.ends[17] - n1.words[17]), 0, 1) * 3 + clamp((T - n1.words[18]) / (n1.ends[18] - n1.words[18]), 0, 1) * 3 + clamp((T - n1.words[19]) / (n1.ends[19] - n1.words[19]), 0, 1) * 7 + clamp((T - n1.words[20]) / (n1.ends[20] - n1.words[20]), 0, 1) * 3 + clamp((T - n1.words[21]) / (n1.ends[21] - n1.words[21]), 0, 1) * 4 + clamp((T - n1.words[22]) / (n1.ends[22] - n1.words[22]), 0, 1) * 6) - 0, 0, 31) * adv), text("At first, they are random. The", x: 0.06, y: -0.008, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - n1.words[0]) / (n1.ends[0] - n1.words[0]), 0, 1) * 6 + clamp((T - n1.words[1]) / (n1.ends[1] - n1.words[1]), 0, 1) * 3 + clamp((T - n1.words[2]) / (n