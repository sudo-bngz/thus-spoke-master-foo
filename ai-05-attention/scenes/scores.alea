// Scores — `it` looks at every other word: a chord from `it` to each, as
// thick as the score (in vermilion); the scores written beside the words
// they go to; then every word looks at every word: all the chords, faint.
// The scores are illustrative. `accent: 1` gives only the chords of `it`
// and `it`. Times are the scene's own (0 to 1). What it returns: 0 paper,
// up to 1 ink.

use "words.alea"

work Scores(look0 = 0.1, scores0 = 0.35, sum0 = 0.55, all0 = 0.75, accent = 0) {
  let cx = 0.5
  let cy = 0.72
  let R = 0.28
  let N = 9
  let ang(k) = -tau / 4 + tau * k / N
  let px(k) = cx + R * cos(ang(k))
  let py(k) = cy + R * sin(ang(k))
  let s = [0.02, 0.55, 0.03, 0.12, 0.02, 0, 0.1, 0.02, 0.08]
  let words = Words(cx: cx, cy: cy, R: R, show: -1, lit: 5, accent: 0)
  let itword = Words(cx: cx, cy: cy, R: R, show: -1, lit: 5, accent: 1)
  // the chords of `it`, one by one, as thick as the score
  let when(k) = look0 + 0.025 * ((k + N - 6) % N)
  let grown(k) = clamp((t - when(k)) / 0.03, 0, 1)
  let chord(k) = line(px(5), py(5), px(5) + (px(k) - px(5)) * grown(k), py(5) + (py(k) - py(5)) * grown(k), 0.002 + 0.03 * s[k], 0.002) * (k != 5) * (t > when(k))
  let chords = merge([chord(k) for k in range(N)])
  // the scores, by their words
  let score(k) = text("{s[k]}", cx + (R + 0.15) * cos(ang(k)), cy + (R + 0.15) * sin(ang(k)), 0.024, 0, "mono") * (k != 5) * 0.7 * smoothstep(scores0 + 0.02 * ((k + N - 6) % N), scores0 + 0.02 * ((k + N - 6) % N) + 0.03, t)
  let scoresum = text("they add up to 1", cx, cy + R + 0.2, 0.028, 0, "mono") * 0.65 * smoothstep(sum0, sum0 + 0.04, t)
  // everyone looks at everyone: all the chords, faint
  let everyone = merge([line(px(a), py(a), px(b), py(b), 0.0025, 0.002) * (a < b) for a in range(N) for b in range(N)]) * 0.35 * smoothstep(all0, all0 + 0.08, t)
  let fade = 1 - 0.6 * smoothstep(all0, all0 + 0.08, t)
  output accent * merge(itword, chords * fade) + (1 - accent) * merge(words, merge([score(k) for k in range(N)]) * fade, scoresum * fade, everyone)
}
