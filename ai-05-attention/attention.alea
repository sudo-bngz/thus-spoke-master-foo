lamp((T - n14.words[5]) / (n14.ends[5] - n14.words[5]), 0, 1) * 5 + clamp((T - n14.words[6]) / (n14.ends[6] - n14.words[6]), 0, 1) * 6 + clamp((T - n14.words[7]) / (n14.ends[7] - n14.words[7]), 0, 1) * 3 + clamp((T - n14.words[8]) / (n14.ends[8] - n14.words[8]), 0, 1) * 4 + clamp((T - n14.words[9]) / (n14.ends[9] - n14.words[9]), 0, 1) * 6 + clamp((T - n14.words[10]) / (n14.ends[10] - n14.words[10]), 0, 1) * 4 + clamp((T - n14.words[11]) / (n14.ends[11] - n14.words[11]), 0, 1) * 7 + clamp((T - n14.words[12]) / (n14.ends[12] - n14.words[12]), 0, 1) * 7 + clamp((T - n14.words[13]) / (n14.ends[13] - n14.words[13]), 0, 1) * 3 + clamp((T - n14.words[14]) / (n14.ends[14] - n14.words[14]), 0, 1) * 7 + clamp((T - n14.words[15]) / (n14.ends[15] - n14.words[15]), 0, 1) * 5 + clamp((T - n14.words[16]) / (n14.ends[16] - n14.words[16]), 0, 1) * 6 + clamp((T - n14.words[17]) / (n14.ends[17] - n14.words[17]), 0, 1) * 6 + clamp((T - n14.words[18]) / (n14.ends[18] - n14.words[18]), 0, 1) * 5 + clamp((T - n14.words[19]) / (n14.ends[19] - n14.words[19]), 0, 1) * 6 + clamp((T - n14.words[20]) / (n14.ends[20] - n14.words[20]), 0, 1) * 3 + clamp((T - n14.words[21]) / (n14.ends[21] - n14.words[21]), 0, 1) * 4 + clamp((T - n14.words[22]) / (n14.ends[22] - n14.words[22]), 0, 1) * 4 + clamp((T - n14.words[23]) / (n14.ends[23] - n14.words[23]), 0, 1) * 7) - 94, 0, 24) * adv)) * (T >= n14.start) * (T < min(n14.end + 1.5, n15.start))
  let c_n15 = merge(text("That is a transformer: the T in", x: 0.06, y: -0.060, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - n15.start) / (n15.duration * 0.92), 0, 1) * 94) - 0, 0, 31) * adv), text("GPT. Next time: what it does with", x: 0.06, y: -0.008, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - n15.start) / (n15.duration * 0.92), 0, 1) * 94) - 32, 0, 33) * adv), text("all this, 1 token at a time.", x: 0.06, y: 0.044, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - n15.start) / (n15.duration * 0.92), 0, 1) * 94) - 66, 0, 28) * adv)) * (T >= n15.start) * (T < min(n15.end + 1.5, m4.start))
  let c_m4 = merge(text("The novice said: 'it' was looking", x: 0.06, y: -0.060, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - m4.start) / (m4.duration * 0.92), 0, 1) * 45) - 0, 0, 33) * adv), text("at the cat.", x: 0.06, y: -0.008, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - m4.start) / (m4.duration * 0.92), 0, 1) * 45) - 34, 0, 11) * adv)) * (T >= m4.start) * (T < min(m4.end + 1.5, m5.start))
  let c_m5 = merge(text("Master Foo said: words look at", x: 0.06, y: -0.060, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - m5.start) / (m5.duration * 0.92), 0, 1) * 61) - 0, 0, 30) * adv), text("each other. That is attention.", x: 0.06, y: -0.008, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - m5.start) / (m5.duration * 0.92), 0, 1) * 61) - 31, 0, 30) * adv)) * (T >= m5.start) * (T < min(m5.end + 1.5, m6.start))
  let c_m6 = text("And the novice was enlightened.", x: 0.06, y: -0.060, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - m6.start) / (m6.duration * 0.92), 0, 1) * 31) - 0, 0, 31) * adv) * (T >= m6.start) * (T < m6.end + 3)
  let said = merge(c_n1, c_n2, c_n3, c_n4, c_n5, c_n6, c_n7, c_n8, c_n9, c_n10, c_n11, c_n12, c_n13, c_n14, c_n15)
  let spoken = merge(c_m1, c_m2, c_m3, c_m4, c_m5, c_m6)
  let dark = paint(merge(header, series, said), palette: ["#000000", "#1a1712"], range: [0, 1], alpha: merge(header, series, said))
  let red  = paint(spoken, palette: ["#000000", "#b8361f"], range: [0, 1], alpha: spoken)
  let look = film(vignette(overlay(reel, dark, red), amount: 0.06), amount: 0.035)

  // ── the sound ──
  let pad = synth {
    let env = adsr(attack: 3, decay: 1, sustain: 0.9, release: 4)
    lowpass(saw(note.freq) + saw(note.freq * 1.003) + sine(note.freq * 0.5), cutoff: 260 + 300 * note.level, resonance: 0.2) * env
  }
  let brush = synth { bandpass(noise(), cutoff: 1400, resonance: 0.3) * adsr(attack: 0.12, decay: 0.3, sustain: 0.3, release: 0.5) * note.velocity }
  let tick = synth { highpass(noise(), cutoff: 4000, resonance: 0.2) * perc(release: 0.015) * note.velocity + sine(note.freq) * perc(release: 0.05) * 0.4 }
  let knock = synth { lowpass(noise(), cutoff: 700, resonance: 0.5) * perc(attack: 0.002, release: 0.12) * note.velocity + sine(note.freq) * perc(release: 0.1) * 0.5 }
  let chord = synth {
    let env = adsr(attack: 0.3, decay: 0.6, sustain: 0.8, release: 2.5)
    chorus(lowpass(saw(note.freq) + saw(note.freq * 1.004) + sine(note.freq * 0.5), cutoff: 1200, resonance: 0.15) * env, depth: 0.6)
  }
  // the temple bell when the master speaks; the question
  pattern bells = repeat 2 event(t: [m1.start - 1.0, m4.start - 1.0][i] / total, x: 0.5, y: 0.95, size: 0.12, intensity: 0.9)
  pattern asked = repeat 1 event(t: (m2.start + 0.85 * m2.duration) / total, x: 0.5, y: 0.5, size: 0.06, intensity: 0.8)
  // the sentence placed; `it` lit; the same point
  pattern placed = repeat 9 event(t: (n2.words[0] + 0.04 * 24.5 * (i / 9)) / total, x: 0.5 + 0.3 * cos(tau * i / 9), y: 0.5 + 0.3 * sin(tau * i / 9), intensity: 0.4)
  pattern itlit = repeat 1 event(t: n2.words[9] / total, x: 0.5, y: 0.5, size: 0.06, intensity: 0.8)
  // the chords of `it`, one by one, louder with the score; everyone looking
  pattern chords = repeat 8 event(t: (n4.words[3] + 0.025 * 26.5 * i) / total, x: 0.5 + 0.3 * cos(tau * (i + 6) / 9), y: 0.5 + 0.3 * sin(tau * (i + 6) / 9), size: 0.03 + 0.1 * [0.1, 0.02, 0.08, 0.02, 0.03, 0.55, 0.03, 0.12][i], intensity: 0.3 + 0.6 * [0.1, 0.02, 0.08, 0.02, 0.03, 0.55, 0.03, 0.12][i])
  pattern everyone = repeat 24 event(t: (n7.words[1] + 0.08 * 26.5 * (i / 24)) / total, x: ~between(0.2, 0.8), y: ~between(0.3, 0.8), intensity: 0.25)
  // the cards, the matches
  pattern cards = repeat 2 event(t: (n9.words[6] + 0.04 * 28.4 * i) / total, x: 0.55, y: 0.4 + 0.2 * i, size: 0.04, intensity: 0.6)
  pattern matches = repeat 3 event(t: (n10.words[17] + 0.06 * 28.4 * i + 0.1 * 28.4) / total, x: 0.6, y: 0.5 + 0.1 * i, size: 0.03 + 0.08 * [0.55, 0.12, 0.02][i], intensity: 0.3 + 0.6 * [0.55, 0.12, 0.02][i])
  // the move, the layers
  pattern moved = repeat 1 event(t: n13.words[5] / total, x: 0.4, y: 0.4, size: 0.1, intensity: 0.7)
  pattern layers = repeat 3 event(t: (n14.words[3] + 0.12 * 30.6 * i) / total, x: 0.5, y: 0.7 - 0.2 * i, size: 0.06, intensity: 0.6)

  let music = [
    m1, m2, m3, n1, n2, n3, n4, n5, n6, n7, n8, n9, n10, n11, n12, n13, n14, n15, m4, m5, m6,
    drone(0.45 + 0.15 * lfo(3) + x * 0, voices: 2, instrument: pad, scale: "hirajoshi", key: 55, gain: 0.9),
    notes(bells, instrument: "bell", scale: "hirajoshi", key: 110, gain: 0.7),
    notes(asked, instrument: "kalimba", scale: "hirajoshi", key: 392, gain: 0.6),
    notes(placed, instrument: "wood", scale: "hirajoshi", key: 330, gain: 0.35),
    notes(itlit, instrument: "glass", scale: "hirajoshi", key: 523, gain: 0.5),
    notes(chords, instrument: "kalimba", scale: "hirajoshi", key: 392, gain: 0.5),
    notes(everyone, instrument: tick, scale: "hirajoshi", key: 880, gain: 0.3),
    notes(cards, instrument: "glass", scale: "hirajoshi", key: 392, gain: 0.45),
    notes(matches, instrument: "kalimba", scale: "hirajoshi", key: 523, gain: 0.5),
    notes(moved, instrument: chord, scale: "major", key: 110, gain: 0.4),
    notes(layers, instrument: chord, scale: "major", key: 82, gain: 0.35),
    notes(reel.cues, instrument: brush, scale: "chromatic", key: 100, gain: 0.3),
  ]

  render image(look, width: 1080, height: 1920, at: 0.4055)
  render video(look, fps: 30, width: 1080, height: 1920, sound: music, room: 0.12, echo: 0)
}
