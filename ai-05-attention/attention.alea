// Attention — Thus Spoke Master Foo, AI 05: the transformer's idea. The
// cat was hungry, so it ate the fish: what is "it"? A word alone means
// little; each word looks at every other and gives it a score (the
// attention, adding up to one); the scores come from a question and a
// label made from each word's point on the map; then each word becomes a
// blend of the others, weighted by its scores, and absorbs its context;
// layer after layer. The scores are illustrative. Master Foo speaks
// Japanese, translated in the captions.

use "scenes/koan.alea"
use "scenes/problem.alea"
use "scenes/scores.alea"
use "scenes/keys.alea"
use "scenes/blend.alea"

work Attention {
  let total = 153.5
  let T = t * total
  let EN = "../voices/narrator.sh"
  let JA = "../voices/master.sh"

  // ── the voices: the master, in Japanese; the one who explains, in English ──
  let m1 = say("弟子は尋ねた。文の中で、どの言葉を見ればよいのですか。", at: 1.50, engine: JA, voice: "jm_kumo", speed: 0.82, gain: 2.3)
  let m2 = say("師は言った。猫は腹が減っていた。だから、それは魚を食べた。「それ」とは、何か。", at: m1.end + 1.4, engine: JA, voice: "jm_kumo", speed: 0.82, gain: 2.3)
  let m3 = say("弟子は答えた。猫です。師は言った。どうして分かった。", at: m2.end + 1.4, engine: JA, voice: "jm_kumo", speed: 0.82, gain: 2.3)
  let n1 = say("A word alone means little. 'it' could be anything. Its meaning comes from the words around it.", at: 26.00, engine: EN, voice: "af_heart", speed: 1.0, gain: 2.3)
  let n2 = say("The cat was hungry, so it ate the fish. Here, 'it' is the cat. You knew that at once. The model has to work it out.", at: n1.end + 1.4, engine: EN, voice: "af_heart", speed: 1.0, gain: 2.3)
  let n3 = say("Last time, each word became a point on the map. But that point is the same wherever the word appears. 'it' needs more than that.", at: n2.end + 1.4, engine: EN, voice: "af_heart", speed: 1.0, gain: 2.3)
  let n4 = say("So each word looks at every other word, and gives it a score: how much does that word matter to me, here?", at: 50.50, engine: EN, voice: "af_heart", speed: 1.0, gain: 2.3)
  let n5 = say("For 'it': cat, a lot. hungry, a little. fish and ate, a little. the and so, almost nothing.", at: n4.end + 1.4, engine: EN, voice: "af_heart", speed: 1.0, gain: 2.3)
  let n6 = say("The scores add up to one. They are the attention of 'it'.", at: n5.end + 1.4, engine: EN, voice: "af_heart", speed: 1.0, gain: 2.3)
  let n7 = say("And every word does this at the same time. All of them, looking at all of them.", at: n6.end + 1.4, engine: EN, voice: "af_heart", speed: 1.0, gain: 2.3)
  let n8 = say("Where do the scores come from? From the map.", at: 77.00, engine: EN, voice: "af_heart", speed: 1.0, gain: 2.3)
  let n9 = say("From its point, each word makes two small things: a question, and a label.", at: n8.end + 1.4, engine: EN, voice: "af_heart", speed: 1.0, gain: 2.3)
  let n10 = say("'it' asks: what is a living thing, mentioned before me? The label of cat answers that well. The score is how well a question matches a label.", at: n9.end + 1.4, engine: EN, voice: "af_heart", speed: 1.0, gain: 2.3)
  let n11 = say("Questions and labels are made with weights. And the weights are learned, like everything else, by the error flowing backward.", at: n10.end + 1.4, engine: EN, voice: "af_heart", speed: 1.0, gain: 2.3)
  let n12 = say("Then each word takes a blend of the others, weighted by its scores. 'it' takes mostly cat.", at: 105.40, engine: EN, voice: "af_heart", speed: 1.0, gain: 2.3)
  let n13 = say("Its point on the map moves. 'it' now stands near cat. The word has absorbed its context.", at: n12.end + 1.4, engine: EN, voice: "af_heart", speed: 1.0, gain: 2.3)
  let n14 = say("Do this in a layer, then again in the next, and again: dozens of times. Each time, every word looks at all the others.", at: n13.end + 1.4, engine: EN, voice: "af_heart", speed: 1.0, gain: 2.3)
  let n15 = say("That is a transformer: the T in GPT. Next time: what it does with all this, one token at a time.", at: n14.end + 1.4, engine: EN, voice: "af_heart", speed: 1.0, gain: 2.3)
  let m4 = say("弟子は言った。「それ」は、猫を見ていました。", at: 136.00, engine: JA, voice: "jm_kumo", speed: 0.82, gain: 2.3)
  let m5 = say("師は言った。言葉は、互いを見る。それが、注意だ。", at: m4.end + 1.4, engine: JA, voice: "jm_kumo", speed: 0.82, gain: 2.3)
  let m6 = say("その時、弟子は悟った。", at: m5.end + 1.6, engine: JA, voice: "jm_kumo", speed: 0.82, gain: 2.3)

  // ── the scenes: ink on paper, a vermilion accent, under the captions ──
  let PAPER = ["#efe9dc", "#d3c9b4", "#3b352c", "#17140f"]
  let fit(piece) = zoom(piece, by: 0.82, x: 0.5, y: 0.66)
  let ink(piece, accent) = overlay(paint(fit(piece), palette: PAPER, range: [0, 1]), paint(fit(accent), palette: ["#000000", "#c23b22"], range: [0, 1], alpha: fit(accent)))
  let reel = timeline([
      scene(ink(Koan(draw0: ((m1.start) - 0.00) / 24.5, draw1: ((m1.end) - 0.00) / 24.5, word: ((m3.end + 0.8) - 0.00) / 24.5, title: ((m3.end + 1.0) - 0.00) / 24.5, kana: ["チ", "ュ", "ウ", "イ"], episode: "AI 05  ·  attention", accent: 0), Koan(draw0: ((m1.start) - 0.00) / 24.5, draw1: ((m1.end) - 0.00) / 24.5, word: ((m3.end + 0.8) - 0.00) / 24.5, title: ((m3.end + 1.0) - 0.00) / 24.5, kana: ["チ", "ュ", "ウ", "イ"], episode: "AI 05  ·  attention", accent: 1)), 24.5),  wipe(0.8, angle: 0, softness: 0.12),
      scene(ink(Problem(show: ((n2.words[0]) - 24.50) / 24.5, it0: ((n2.words[9]) - 24.50) / 24.5, ask0: ((n2.words[9]) - 24.50) / 24.5, same0: ((n3.words[11]) - 24.50) / 24.5, accent: 0), Problem(show: ((n2.words[0]) - 24.50) / 24.5, it0: ((n2.words[9]) - 24.50) / 24.5, ask0: ((n2.words[9]) - 24.50) / 24.5, same0: ((n3.words[11]) - 24.50) / 24.5, accent: 1)), 24.5),  pixels(0.6, size: 0.05),
      scene(ink(Scores(look0: ((n4.words[3]) - 49.00) / 26.5, scores0: ((n5.words[1]) - 49.00) / 26.5, sum0: ((n6.words[1]) - 49.00) / 26.5, all0: ((n7.words[1]) - 49.00) / 26.5, accent: 0), Scores(look0: ((n4.words[3]) - 49.00) / 26.5, scores0: ((n5.words[1]) - 49.00) / 26.5, sum0: ((n6.words[1]) - 49.00) / 26.5, all0: ((n7.words[1]) - 49.00) / 26.5, accent: 1)), 26.5),  wipe(0.7, angle: 90, softness: 0.1),
      scene(ink(Keys(point0: ((n8.words[7]) - 75.50) / 28.4, cards0: ((n9.words[6]) - 75.50) / 28.4, labels0: ((n10.words[12]) - 75.50) / 28.4, match0: ((n10.words[17]) - 75.50) / 28.4, accent: 0), Keys(point0: ((n8.words[7]) - 75.50) / 28.4, cards0: ((n9.words[6]) - 75.50) / 28.4, labels0: ((n10.words[12]) - 75.50) / 28.4, match0: ((n10.words[17]) - 75.50) / 28.4, accent: 1)), 28.4),  morph(0.8, amount: 0.15),
      scene(ink(Blend(move0: ((n13.words[0]) - 103.90) / 30.6, moved0: ((n13.words[5]) - 103.90) / 30.6, layers0: ((n14.words[3]) - 103.90) / 30.6, accent: 0), Blend(move0: ((n13.words[0]) - 103.90) / 30.6, moved0: ((n13.words[5]) - 103.90) / 30.6, layers0: ((n14.words[3]) - 103.90) / 30.6, accent: 1)), 30.6),  wipe(0.8, angle: 180, softness: 0.12),
      scene(ink(Koan(draw0: ((m4.start) - 134.50) / 19.0, draw1: ((m6.end) - 134.50) / 19.0, word: ((m6.start + 0.5) - 134.50) / 19.0, title: ((m6.end + 0.6) - 134.50) / 19.0, kana: ["チ", "ュ", "ウ", "イ"], episode: "AI 05  ·  attention", accent: 0), Koan(draw0: ((m4.start) - 134.50) / 19.0, draw1: ((m6.end) - 134.50) / 19.0, word: ((m6.start + 0.5) - 134.50) / 19.0, title: ((m6.end + 0.6) - 134.50) / 19.0, kana: ["チ", "ュ", "ウ", "イ"], episode: "AI 05  ·  attention", accent: 1)), 19.0),  morph(1.2, amount: 0.2),
  ], loop: 1)

  // ── over it: the series, the step, the captions (the master's, translated, in vermilion) ──
  let adv = 0.021722
  let header = merge(text("1 / 4   the word alone", x: 0.06, y: -0.15, size: 0.03, font: "mono", align: "left") * (reel.index > 1 - 0.5) * (reel.index < 1 + 0.5), text("2 / 4   looking", x: 0.06, y: -0.15, size: 0.03, font: "mono", align: "left") * (reel.index > 2 - 0.5) * (reel.index < 2 + 0.5), text("3 / 4   the question and the label", x: 0.06, y: -0.15, size: 0.03, font: "mono", align: "left") * (reel.index > 3 - 0.5) * (reel.index < 3 + 0.5), text("4 / 4   the blend", x: 0.06, y: -0.15, size: 0.03, font: "mono", align: "left") * (reel.index > 4 - 0.5) * (reel.index < 4 + 0.5)) * 0.7
  let series = text("thus spoke master foo  ·  AI 05", x: 0.94, y: -0.3, size: 0.024, font: "mono", align: "right") * 0.45
  let c_m1 = merge(text("The novice asked: in a sentence,", x: 0.06, y: -0.060, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - m1.start) / (m1.duration * 0.92), 0, 1) * 62) - 0, 0, 32) * adv), text("which words should I look at?", x: 0.06, y: -0.008, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - m1.start) / (m1.duration * 0.92), 0, 1) * 62) - 33, 0, 29) * adv)) * (T >= m1.start) * (T < min(m1.end + 1.5, m2.start))
  let c_m2 = merge(text("Master Foo said: the cat was", x: 0.06, y: -0.060, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - m2.start) / (m2.duration * 0.92), 0, 1) * 70) - 0, 0, 28) * adv), text("hungry, so it ate the fish. What", x: 0.06, y: -0.008, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - m2.start) / (m2.duration * 0.92), 0, 1) * 70) - 29, 0, 32) * adv), text("is 'it'?", x: 0.06, y: 0.044, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - m2.start) / (m2.duration * 0.92), 0, 1) * 70) - 62, 0, 8) * adv)) * (T >= m2.start) * (T < min(m2.end + 1.5, m3.start))
