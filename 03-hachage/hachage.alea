// Hachage — Thus Spoke Master Foo, 03: what is a hash? A novice entrusts
// Master Foo with a letter: how will he know if someone changes it on the
// way? The master writes one word on the envelope. A hash is a fingerprint
// for data: any text in, 256 bits out, always the same for the same text;
// change one letter and about half the bits flip (the avalanche); and there
// is no way back. So a website keeps only the hash of a password, git names
// every commit by its hash, a download is checked by its fingerprint. The
// fingerprints are real SHA-256 digests of the texts shown (gen.py), to be
// checked with sha256sum; the edition chooses which letter is changed.
// Master Foo speaks Japanese, translated in the captions.

use "scenes/koan.alea"
use "scenes/fingerprint.alea"
use "scenes/avalanche.alea"
use "scenes/oneway.alea"
use "scenes/uses.alea"

work Hachage {
  let total = 107.2
  let T = t * total
  let EN = "../voices/narrator.sh"
  let JA = "../voices/master.sh"

  // ── the voices: the master, in Japanese; the one who explains, in English ──
  let m1 = say("ある弟子が、フー師に手紙を託した。", at: 1.40, engine: JA, voice: "jm_kumo", speed: 0.82, gain: 2.3)
  let m2 = say("途中で誰かが書き換えたら、どう分かりますか。", at: m1.end + 1.0, engine: JA, voice: "jm_kumo", speed: 0.82, gain: 2.3)
  let m3 = say("師は手紙を読み、封筒にひとつの言葉を書いた。", at: m2.end + 1.4, engine: JA, voice: "jm_kumo", speed: 0.82, gain: 2.3)
  let n1 = say("A hash is a fingerprint for data.", at: 21.40, engine: EN, voice: "af_heart", speed: 0.95, gain: 2.3)
  let n2 = say("Any text goes in: a word, a sentence, a whole book.", at: n1.end + 1.0, engine: EN, voice: "af_heart", speed: 0.95, gain: 2.3)
  let n3 = say("Out comes a code, always the same size: two hundred and fifty-six bits.", at: n2.end + 1.0, engine: EN, voice: "af_heart", speed: 0.95, gain: 2.3)
  let n4 = say("The same text always gives the same fingerprint.", at: n3.end + 1.6, engine: EN, voice: "af_heart", speed: 0.95, gain: 2.3)
  let n5 = say("Change a single letter, and the fingerprint changes completely.", at: 41.10, engine: EN, voice: "af_heart", speed: 0.95, gain: 2.3)
  let n6 = say("About half of the bits flip, as if by chance. This is called the avalanche.", at: n5.end + 1.2, engine: EN, voice: "af_heart", speed: 0.95, gain: 2.3)
  let n7 = say("And there is no way back: from the fingerprint, you cannot find the text.", at: 54.30, engine: EN, voice: "af_heart", speed: 0.95, gain: 2.3)
  let n8 = say("Only by trying every text there is, which would take longer than the universe has existed.", at: n7.end + 1.2, engine: EN, voice: "af_heart", speed: 0.95, gain: 2.3)
  let n9 = say("That is why a website keeps only the hash of your password, never the password.", at: 68.70, engine: EN, voice: "af_heart", speed: 0.95, gain: 2.3)
  let n10 = say("Why every commit in git is named by its hash.", at: n9.end + 1.0, engine: EN, voice: "af_heart", speed: 0.95, gain: 2.3)
  let n11 = say("And why a file's fingerprint tells you it was not changed on the way.", at: n10.end + 1.0, engine: EN, voice: "af_heart", speed: 0.95, gain: 2.3)
  let n12 = say("A hash is a seal. Change one letter, and the seal breaks.", at: n11.end + 1.6, engine: EN, voice: "af_heart", speed: 0.95, gain: 2.3)
  let m4 = say("手紙は戻ってきた。一文字だけ、変わっていた。", at: 90.10, engine: JA, voice: "jm_kumo", speed: 0.82, gain: 2.3)
  let m5 = say("封筒の言葉は、もう合わなかった。", at: m4.end + 1.2, engine: JA, voice: "jm_kumo", speed: 0.82, gain: 2.3)
  let m6 = say("その時、弟子は悟った。", at: m5.end + 1.4, engine: JA, voice: "jm_kumo", speed: 0.82, gain: 2.3)

