  let c_n12 = merge(text("A hash is a seal. Change one", x: 0.06, y: -0.060, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - n12.words[0]) / (n12.ends[0] - n12.words[0]), 0, 1) * 2 + clamp((T - n12.words[1]) / (n12.ends[1] - n12.words[1]), 0, 1) * 5 + clamp((T - n12.words[2]) / (n12.ends[2] - n12.words[2]), 0, 1) * 3 + clamp((T - n12.words[3]) / (n12.ends[3] - n12.words[3]), 0, 1) * 2 + clamp((T - n12.words[4]) / (n12.ends[4] - n12.words[4]), 0, 1) * 6 + clamp((T - n12.words[5]) / (n12.ends[5] - n12.words[5]), 0, 1) * 7 + clamp((T - n12.words[6]) / (n12.ends[6] - n12.words[6]), 0, 1) * 4 + clamp((T - n12.words[7]) / (n12.ends[7] - n12.words[7]), 0, 1) * 8 + clamp((T - n12.words[8]) / (n12.ends[8] - n12.words[8]), 0, 1) * 4 + clamp((T - n12.words[9]) / (n12.ends[9] - n12.words[9]), 0, 1) * 4 + clamp((T - n12.words[10]) / (n12.ends[10] - n12.words[10]), 0, 1) * 5 + clamp((T - n12.words[11]) / (n12.ends[11] - n12.words[11]), 0, 1) * 7) - 0, 0, 28) * adv), text("letter, and the seal breaks.", x: 0.06, y: -0.008, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - n12.words[0]) / (n12.ends[0] - n12.words[0]), 0, 1) * 2 + clamp((T - n12.words[1]) / (n12.ends[1] - n12.words[1]), 0, 1) * 5 + clamp((T - n12.words[2]) / (n12.ends[2] - n12.words[2]), 0, 1) * 3 + clamp((T - n12.words[3]) / (n12.ends[3] - n12.words[3]), 0, 1) * 2 + clamp((T - n12.words[4]) / (n12.ends[4] - n12.words[4]), 0, 1) * 6 + clamp((T - n12.words[5]) / (n12.ends[5] - n12.words[5]), 0, 1) * 7 + clamp((T - n12.words[6]) / (n12.ends[6] - n12.words[6]), 0, 1) * 4 + clamp((T - n12.words[7]) / (n12.ends[7] - n12.words[7]), 0, 1) * 8 + clamp((T - n12.words[8]) / (n12.ends[8] - n12.words[8]), 0, 1) * 4 + clamp((T - n12.words[9]) / (n12.ends[9] - n12.words[9]), 0, 1) * 4 + clamp((T - n12.words[10]) / (n12.ends[10] - n12.words[10]), 0, 1) * 5 + clamp((T - n12.words[11]) / (n12.ends[11] - n12.words[11]), 0, 1) * 7) - 29, 0, 28) * adv)) * (T >= n12.start) * (T < min(n12.end + 1.5, m4.start))
  let c_m4 = merge(text("The letter came back. 1 letter", x: 0.06, y: -0.060, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - m4.start) / (m4.duration * 0.92), 0, 1) * 43) - 0, 0, 30) * adv), text("had changed.", x: 0.06, y: -0.008, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - m4.start) / (m4.duration * 0.92), 0, 1) * 43) - 31, 0, 12) * adv)) * (T >= m4.start) * (T < min(m4.end + 1.5, m5.start))
  let c_m5 = merge(text("The word on the envelope no", x: 0.06, y: -0.060, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - m5.start) / (m5.duration * 0.92), 0, 1) * 43) - 0, 0, 27) * adv), text("longer matched.", x: 0.06, y: -0.008, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - m5.start) / (m5.duration * 0.92), 0, 1) * 43) - 28, 0, 15) * adv)) * (T >= m5.start) * (T < min(m5.end + 1.5, m6.start))
  let c_m6 = text("And the novice was enlightened.", x: 0.06, y: -0.060, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - m6.start) / (m6.duration * 0.92), 0, 1) * 31) - 0, 0, 31) * adv) * (T >= m6.start) * (T < m6.end + 3)
  let said = merge(c_n1, c_n2, c_n3, c_n4, c_n5, c_n6, c_n7, c_n8, c_n9, c_n10, c_n11, c_n12)
  let spoken = merge(c_m1, c_m2, c_m3, c_m4, c_m5, c_m6)
  let dark = paint(merge(header, series, said), palette: ["#000000", "#1a1712"], range: [0, 1], alpha: merge(header, series, said))
  let red  = paint(spoken, palette: ["#000000", "#b8361f"], range: [0, 1], alpha: spoken)
  let look = film(vignette(overlay(reel, dark, red), amount: 0.06), amount: 0.035)

  // ── the sound ──
  let pad = synth {
    let env = adsr(attack: 3, decay: 1, sustain: 0.9, release: 4)
    lowpass(saw(note.freq) + saw(note.freq * 1.003) + sine(note.freq * 0.5), cutoff: 260 + 300 * note.level, resonance: 0.2) * env
  }
  let brush = synth { bandpass(noise(), cutoff: 1400, resonance: 0.3) * adsr(attack: 0.12, decay: 0.3, sustain: 0.3, release: 0.5) * note.velocity }
  let stamp = synth { lowpass(noise(), cutoff: 600, resonance: 0.4) * perc(attack: 0.002, release: 0.25) * note.velocity + sine(70) * perc(release: 0.15) * 0.8 }
  let grind = synth { bandpass(noise(), cutoff: 900 + 1400 * note.time, resonance: 0.5) * adsr(attack: 0.05, decay: 0.3, sustain: 0.6, release: 0.3) * 0.7 }
  let click = synth { highpass(noise(), cutoff: 4000, resonance: 0.2) * perc(release: 0.012) * note.velocity }
  // the temple bell when the master speaks; the seal stamped on the envelope, twice
  pattern bells = repeat 2 event(t: [m1.start - 1.0, m4.start - 1.0][i] / total, x: 0.5, y: 0.95, size: 0.12, intensity: 0.9)
  pattern seals = repeat 2 event(t: [m3.start + 0.72 * m3.duration, m4.start + 0.3][i] / total, x: 0.5, y: 0.5, size: 0.06, intensity: 0.9)
  pattern broken = repeat 1 event(t: (m5.start + 0.5) / total, x: 0.5, y: 0.2, size: 0.08, intensity: 1)
  // the box working, twice; a cell of the fingerprint drawn, one by one
  pattern works = repeat 3 event(t: [n2.words[6], n2.end + 0.4, n4.words[3]][i] / total, x: 0.5, y: 0.5, size: 0.04, intensity: 0.8)
  pattern cells1 = repeat 64 event(t: (n2.words[6] + 0.6 + 0.08 * 19.7 * i / 64) / total, x: 0.3 + 0.4 * (i % 2), y: ~between(0.3, 0.8), intensity: 0.3)
  pattern cells2 = repeat 64 event(t: (n3.words[1] + 0.08 * 19.7 * i / 64) / total, x: 0.3 + 0.4 * (i % 2), y: ~between(0.3, 0.8), intensity: 0.3)
  pattern cells3 = repeat 64 event(t: (n4.words[6] + 0.08 * 19.7 * i / 64) / total, x: 0.3 + 0.4 * (i % 2), y: ~between(0.3, 0.8), intensity: 0.3)
  // the avalanche: a cascade of clicks, as many as bits changed, and the changed letter
  pattern letter = repeat 1 event(t: n5.words[3] / total, x: 0.73, y: 0.7, size: 0.05, intensity: 0.8)
  pattern cascade = repeat 128 event(t: (n6.words[0] + 0.1 * 13.2 * (i / 128)) / total, x: 0.6 + 0.3 * fract(i * 0.618), y: ~between(0.2, 0.9), intensity: 0.5)
  // the strike through the way back; the trying, faster and faster
  pattern strike = repeat 1 event(t: n7.words[11] / total, x: 0.6, y: 0.3, size: 0.05, intensity: 1)
  pattern tries = repeat 24 event(t: (n8.words[2] + 0.4 * 14.4 * (i / 24) ^ 0.6) / total, x: 0.5, y: 0.6 + 0.2 * (i % 2), intensity: 0.5)
  // the three uses: a lock, a commit, a match
  pattern uses = repeat 3 event(t: [n9.words[4], n10.words[1], n11.words[2]][i] / total, x: 0.3 + 0.2 * i, y: [0.6, 0.5, 0.4][i], size: 0.05, intensity: 0.7)
  pattern match = repeat 1 event(t: (n11.words[2] + 0.14 * 21.4) / total, x: 0.8, y: 0.3, size: 0.08, intensity: 0.8)

  let music = [
    m1, m2, m3, n1, n2, n3, n4, n5, n6, n7, n8, n9, n10, n11, n12, m4, m5, m6,
    drone(0.45 + 0.15 * lfo(3) + x * 0, voices: 2, instrument: pad, scale: "hirajoshi", key: 55, gain: 0.9),
    notes(bells, instrument: "bell", scale: "hirajoshi", key: 110, gain: 0.7),
    notes(seals, instrument: stamp, gain: 0.7),
    notes(broken, instrument: brush, scale: "chromatic", key: 100, gain: 0.7),
    notes(works, instrument: grind, scale: "chromatic", key: 200, gain: 0.4),
    notes(cells1, instrument: click, gain: 0.3),
    notes(cells2, instrument: click, gain: 0.3),
    notes(cells3, instrument: click, gain: 0.3),
    notes(letter, instrument: "kalimba", scale: "hirajoshi", key: 392, gain: 0.5),
    notes(cascade, instrument: "wood", scale: "hirajoshi", key: 330, gain: 0.3),
    notes(strike, instrument: brush, scale: "chromatic", key: 100, gain: 0.6),
    notes(tries, instrument: "wood", scale: "hirajoshi", key: 440, gain: 0.3),
    notes(uses, instrument: "glass", scale: "hirajoshi", key: 392, gain: 0.45),
    notes(match, instrument: "kalimba", scale: "hirajoshi", key: 784, gain: 0.5),
    notes(reel.cues, instrument: brush, scale: "chromatic", key: 100, gain: 0.3),
  ]

  render image(look, width: 1080, height: 1920, at: 0.4750)
  render video(look, fps: 30, width: 1080, height: 1920, sound: music, room: 0.12, echo: 0)
}
