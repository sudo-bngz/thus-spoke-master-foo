// Clé — Thus Spoke Master Foo, 04: how do two strangers agree on a secret
// in a square where everyone listens? Arithmetic on a clock of 23 hours: 20
// + 5 = 2; 23 is prime, and jumping by 5 visits every hour (5 is a
// generator mod 23); forward is easy (1 × 5, six times, lands on 8),
// backward is not (from 8, how many jumps? the discrete logarithm). Each
// stranger keeps a secret number of jumps (6, 15), says the result aloud
// (8, 19), jumps their secret again on the other's number, and both land
// on 2: the key, that no one carried. This is the lock in the browser's
// bar, with numbers of hundreds of digits. The numbers are checked by
// gen.py. Master Foo speaks Japanese, translated in the captions.

use "scenes/koan.alea"
use "scenes/clock.alea"
use "scenes/oneway.alea"
use "scenes/exchange.alea"
use "scenes/lock.alea"

work Cle {
  let total = 130.7
  let T = t * total
  let EN = "../voices/kokoro.py"
  let JA = "../voices/kokoro-ja.py"

  // ── the voices: the master, in Japanese; the one who explains, in English ──
  let m1 = say("弟子は尋ねた。皆が聞いている広場で、どうやって秘密を分かち合えますか。", at: 1.40, engine: JA, voice: "jm_kumo", speed: 0.82, gain: 2.3)
  let m2 = say("師は言った。それぞれ、数をひとつ選び、誰にも言うな。", at: m1.end + 1.2, engine: JA, voice: "jm_kumo", speed: 0.82, gain: 2.3)
  let m3 = say("あとは、すべて声に出して言え。", at: m2.end + 1.0, engine: JA, voice: "jm_kumo", speed: 0.82, gain: 2.3)
  let n1 = say("Arithmetic on a clock. This one has twenty-three hours.", at: 22.40, engine: EN, voice: "af_heart", speed: 0.95, gain: 2.3)
  let n2 = say("Twenty plus five is not twenty-five: it is two. Numbers wrap around.", at: n1.end + 1.0, engine: EN, voice: "af_heart", speed: 0.95, gain: 2.3)
  let n3 = say("Twenty-three is prime: it cannot be cut into equal parts.", at: n2.end + 1.2, engine: EN, voice: "af_heart", speed: 0.95, gain: 2.3)
  let n4 = say("So jumping by five, again and again, visits every hour before coming back.", at: n3.end + 1.2, engine: EN, voice: "af_heart", speed: 0.95, gain: 2.3)
  let n5 = say("Forward is easy: start at one, multiply by five six times. You land on eight.", at: 45.40, engine: EN, voice: "af_heart", speed: 0.95, gain: 2.3)
  let n6 = say("Backward is not: from eight, how many jumps? You can only try them all.", at: n5.end + 1.2, engine: EN, voice: "af_heart", speed: 0.95, gain: 2.3)
  let n7 = say("On a clock with hundreds of digits, that takes forever. This is the discrete logarithm.", at: n6.end + 1.2, engine: EN, voice: "af_heart", speed: 0.95, gain: 2.3)
  let n8 = say("Now, two strangers in the square. The clock and the jump are said aloud: twenty-three, five.", at: 65.40, engine: EN, voice: "af_heart", speed: 0.95, gain: 2.3)
  let n9 = say("Each chooses a secret number of jumps, and tells no one: six, and fifteen.", at: n8.end + 1.0, engine: EN, voice: "af_heart", speed: 0.95, gain: 2.3)
  let n10 = say("Each jumps their secret, and says the result: eight, and nineteen.", at: n9.end + 1.0, engine: EN, voice: "af_heart", speed: 0.95, gain: 2.3)
  let n11 = say("Then each takes the other's number, and jumps their own secret again.", at: n10.end + 1.2, engine: EN, voice: "af_heart", speed: 0.95, gain: 2.3)
  let n12 = say("Both land on two. The same number: a key, known to them alone.", at: n11.end + 1.0, engine: EN, voice: "af_heart", speed: 0.95, gain: 2.3)
  let n13 = say("Everyone heard twenty-three, five, eight, nineteen. Without a secret, there is no way to two.", at: n12.end + 1.2, engine: EN, voice: "af_heart", speed: 0.95, gain: 2.3)
  let n14 = say("This is the lock in your browser: the same idea, with numbers of hundreds of digits.", at: 101.30, engine: EN, voice: "af_heart", speed: 0.95, gain: 2.3)
  let n15 = say("A key no one carried. Made together, in the open.", at: n14.end + 1.4, engine: EN, voice: "af_heart", speed: 0.95, gain: 2.3)
  let m4 = say("広場の皆が、すべての言葉を聞いた。", at: 114.10, engine: JA, voice: "jm_kumo", speed: 0.82, gain: 2.3)
  let m5 = say("そして、鍵を知ったのは二人だけだった。", at: m4.end + 1.2, engine: JA, voice: "jm_kumo", speed: 0.82, gain: 2.3)
  let m6 = say("その時、弟子は悟った。", at: m5.end + 1.4, engine: JA, voice: "jm_kumo", speed: 0.82, gain: 2.3)

  // ── the numbers: a clock of 23 hours, jumps of 5; the secrets, the results, the key (gen.py) ──
  let seq = [5, 2, 10, 4, 20, 8, 17, 16, 11, 9, 22, 18, 21, 13, 19, 3, 15, 6, 7, 12, 14, 1]
  let path = [1, 5, 2, 10, 4, 20, 8]

  // ── the scenes: ink on paper, a vermilion accent, under the captions ──
  let PAPER = ["#efe9dc", "#d3c9b4", "#3b352c", "#17140f"]
  let fit(piece) = zoom(piece, by: 0.82, x: 0.5, y: 0.66)
  let ink(piece, accent) = overlay(paint(fit(piece), palette: PAPER, range: [0, 1]), paint(fit(accent), palette: ["#000000", "#c23b22"], range: [0, 1], alpha: fit(accent)))
  let reel = timeline([
      scene(ink(Koan(draw0: ((m1.start) - 0.00) / 21.0, draw1: ((m1.end) - 0.00) / 21.0, word: ((m3.end + 0.8) - 0.00) / 21.0, title: ((m3.end + 1.0) - 0.00) / 21.0, kana: ["カ", "ギ"], episode: "04  ·  key", big: "2", bigsize: 0.2, bigat: [((m2.start + 0.55 * m2.duration) - 0.00) / 21.0, ((m3.end + 5) - 0.00) / 21.0], bigoff: ((m3.end + 0.5) - 0.00) / 21.0, accent: 0), Koan(draw0: ((m1.start) - 0.00) / 21.0, draw1: ((m1.end) - 0.00) / 21.0, word: ((m3.end + 0.8) - 0.00) / 21.0, title: ((m3.end + 1.0) - 0.00) / 21.0, kana: ["カ", "ギ"], episode: "04  ·  key", big: "2", bigsize: 0.2, bigat: [((m2.start + 0.55 * m2.duration) - 0.00) / 21.0, ((m3.end + 5) - 0.00) / 21.0], bigoff: ((m3.end + 0.5) - 0.00) / 21.0, accent: 1)), 21.0),  wipe(0.8, angle: 0, softness: 0.12),
      scene(ink(Clock(seq: seq, add0: ((n2.words[0]) - 21.00) / 23.0, add1: ((n2.words[4]) - 21.00) / 23.0, prime0: ((n3.words[1]) - 21.00) / 23.0, jump0: ((n4.words[1]) - 21.00) / 23.0, jump1: ((n4.end + 0.8) - 21.00) / 23.0, accent: 0), Clock(seq: seq, add0: ((n2.words[0]) - 21.00) / 23.0, add1: ((n2.words[4]) - 21.00) / 23.0, prime0: ((n3.words[1]) - 21.00) / 23.0, jump0: ((n4.words[1]) - 21.00) / 23.0, jump1: ((n4.end + 0.8) - 21.00) / 23.0, accent: 1)), 23.0),  pixels(0.6, size: 0.05),
      scene(ink(Oneway(path: path, a: 6, A: 8, fwd0: ((n5.words[5]) - 44.00) / 20.0, fwd1: ((n5.words[11]) - 44.00) / 20.0, back0: ((n6.words[9]) - 44.00) / 20.0, back1: ((n6.end + 0.8) - 44.00) / 20.0, big: ((n7.words[2]) - 44.00) / 20.0, accent: 0), Oneway(path: path, a: 6, A: 8, fwd0: ((n5.words[5]) - 44.00) / 20.0, fwd1: ((n5.words[11]) - 44.00) / 20.0, back0: ((n6.words[9]) - 44.00) / 20.0, back1: ((n6.end + 0.8) - 44.00) / 20.0, big: ((n7.words[2]) - 44.00) / 20.0, accent: 1)), 20.0),  wipe(0.7, angle: 90, softness: 0.1),
      scene(ink(Exchange(a: 6, b: 15, A: 8, B: 19, key: 2, public0: ((n8.words[8]) - 64.00) / 35.9, secret0: ((n9.words[2]) - 64.00) / 35.9, send0: ((n10.words[7]) - 64.00) / 35.9, flight: 0.9 / 35.9, again0: ((n11.words[2]) - 64.00) / 35.9, key0: ((n12.words[2]) - 64.00) / 35.9, heard0: ((n13.words[1]) - 64.00) / 35.9, accent: 0), Exchange(a: 6, b: 15, A: 8, B: 19, key: 2, public0: ((n8.words[8]) - 64.00) / 35.9, secret0: ((n9.words[2]) - 64.00) / 35.9, send0: ((n10.words[7]) - 64.00) / 35.9, flight: 0.9 / 35.9, again0: ((n11.words[2]) - 64.00) / 35.9, key0: ((n12.words[2]) - 64.00) / 35.9, heard0: ((n13.words[1]) - 64.00) / 35.9, accent: 1)), 35.9),  morph(0.8, amount: 0.15),
      scene(ink(Lock(key: 2, bar0: ((n14.words[3]) - 99.90) / 12.8, lock0: ((n14.words[8]) - 99.90) / 12.8, closing: 2.0 / 12.8, accent: 0), Lock(key: 2, bar0: ((n14.words[3]) - 99.90) / 12.8, lock0: ((n14.words[8]) - 99.90) / 12.8, closing: 2.0 / 12.8, accent: 1)), 12.8),  wipe(0.8, angle: 180, softness: 0.12),
      scene(ink(Koan(draw0: ((m4.start) - 112.70) / 18.0, draw1: ((m6.end) - 112.70) / 18.0, word: ((m6.start + 0.5) - 112.70) / 18.0, title: ((m6.end + 0.6) - 112.70) / 18.0, kana: ["カ", "ギ"], episode: "04  ·  key", big: "2", bigsize: 0.2, bigat: [((m5.start + 0.6 * m5.duration) - 112.70) / 18.0, ((m6.end + 5) - 112.70) / 18.0], bigoff: ((m5.end + 0.6) - 112.70) / 18.0, accent: 0), Koan(draw0: ((m4.start) - 112.70) / 18.0, draw1: ((m6.end) - 112.70) / 18.0, word: ((m6.start + 0.5) - 112.70) / 18.0, title: ((m6.end + 0.6) - 112.70) / 18.0, kana: ["カ", "ギ"], episode: "04  ·  key", big: "2", bigsize: 0.2, bigat: [((m5.start + 0.6 * m5.duration) - 112.70) / 18.0, ((m6.end + 5) - 112.70) / 18.0], bigoff: ((m5.end + 0.6) - 112.70) / 18.0, accent: 1)), 18.0),  morph(1.2, amount: 0.2),
  ], loop: 1)

  // ── over it: the series, the step, the captions (the master's, translated, in vermilion) ──
  let adv = 0.021722
  let header = merge(text("1 / 4   the clock", x: 0.06, y: -0.15, size: 0.03, font: "mono", align: "left") * (reel.index > 1 - 0.5) * (reel.index < 1 + 0.5), text("2 / 4   one way", x: 0.06, y: -0.15, size: 0.03, font: "mono", align: "left") * (reel.index > 2 - 0.5) * (reel.index < 2 + 0.5), text("3 / 4   the exchange", x: 0.06, y: -0.15, size: 0.03, font: "mono", align: "left") * (reel.index > 3 - 0.5) * (reel.index < 3 + 0.5), text("4 / 4   the lock", x: 0.06, y: -0.15, size: 0.03, font: "mono", align: "left") * (reel.index > 4 - 0.5) * (reel.index < 4 + 0.5)) * 0.7
  let series = text("thus spoke master foo  ·  04", x: 0.94, y: -0.3, size: 0.024, font: "mono", align: "right") * 0.45
  let c_m1 = merge(text("The novice asked: in a square", x: 0.06, y: -0.060, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - m1.start) / (m1.duration * 0.92), 0, 1) * 81) - 0, 0, 29) * adv), text("where everyone listens, how can", x: 0.06, y: -0.008, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - m1.start) / (m1.duration * 0.92), 0, 1) * 81) - 30, 0, 31) * adv), text("two share a secret?", x: 0.06, y: 0.044, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - m1.start) / (m1.duration * 0.92), 0, 1) * 81) - 62, 0, 19) * adv)) * (T >= m1.start) * (T < min(m1.end + 1.5, m2.start))
  let c_m2 = merge(text("Master Foo said: each of you,", x: 0.06, y: -0.060, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - m2.start) / (m2.duration * 0.92), 0, 1) * 63) - 0, 0, 29) * adv), text("choose a number, and tell no one.", x: 0.06, y: -0.008, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - m2.start) / (m2.duration * 0.92), 0, 1) * 63) - 30, 0, 33) * adv)) * (T >= m2.start) * (T < min(m2.end + 1.5, m3.start))
  let c_m3 = merge(text("Then say everything else out", x: 0.06, y: -0.060, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - m3.start) / (m3.duration * 0.92), 0, 1) * 34) - 0, 0, 28) * adv), text("loud.", x: 0.06, y: -0.008, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - m3.start) / (m3.duration * 0.92), 0, 1) * 34) - 29, 0, 5) * adv)) * (T >= m3.start) * (T < min(m3.end + 1.5, n1.start))
  let c_n1 = merge(text("Arithmetic on a clock. This one", x: 0.06, y: -0.060, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - n1.words[0]) / (n1.ends[0] - n1.words[0]), 0, 1) * 11 + clamp((T - n1.words[1]) / (n1.ends[1] - n1.words[1]), 0, 1) * 3 + clamp((T - n1.words[2]) / (n1.ends[2] - n1.words[2]), 0, 1) * 2 + clamp((T - n1.words[3]) / (n1.ends[3] - n1.words[3]), 0, 1) * 7 + clamp((T - n1.words[4]) / (n1.ends[4] - n1.words[4]), 0, 1) * 5 + clamp((T - n1.words[5]) / (n1.ends[5] - n1.words[5]), 0, 1) * 4 + clamp((T - n1.words[6]) / (n1.ends[6] - n1.words[6]), 0, 1) * 4 + clamp((T - n1.words[7]) / (n1.ends[7] - n1.words[7]), 0, 1) * 13 + clamp((T - n1.words[8]) / (n1.ends[8] - n1.words[8]), 0, 1) * 6) - 0, 0, 31) * adv), text("has twenty-three hours.", x: 0.06, y: -0.008, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - n1.words[0]) / (n1.ends[0] - n1.words[0]), 0, 1) * 11 + clamp((T - n1.words[1]) / (n1.ends[1] - n1.words[1]), 0, 1) * 3 + clamp((T - n1.words[2]) / (n1.ends[2] - n1.words[2]), 0, 1) * 2 + clamp((T - n1.words[3]) / (n1.ends[3] - n1.words[3]), 0, 1) * 7 + clamp((T - n1.words[4]) / (n1.ends[4] - n1.words[4]), 0, 1) * 5 + clamp((T - n1.words[5]) / (n1.ends[5] - n1.words[5]), 0, 1) * 4 + clamp((T - n1.words[6]) / (n1.ends[6] - n1.words[6]), 0, 1) * 4 + clamp((T - n1.words[7]) / (n1.ends[7] - n1.words[7]), 0, 1) * 13 + clamp((T - n1.words[8]) / (n1.ends[8] - n1.words[8]), 0, 1) * 6) - 32, 0, 23) * adv)) * (T >= n1.start) * (T < min(n1.end + 1.5, n2.start))
  let c_n2 = merge(text("Twenty plus five is not", x: 0.06, y: -0.060, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - n2.words[0]) / (n2.ends[0] - n2.words[0]), 0, 1) * 7 + clamp((T - n2.words[1]) / (n2.ends[1] - n2.words[1]), 0, 1) * 5 + clamp((T - n2.words[2]) / (n2.ends[2] - n2.words[2]), 0, 1) * 5 + clamp((T - n2.words[3]) / (n2.ends[3] - n2.words[3]), 0, 1) * 3 + clamp((T - n2.words[4]) / (n2.ends[4] - n2.words[4]), 0, 1) * 4 + clamp((T - n2.words[5]) / (n2.ends[5] - n2.words[5]), 0, 1) * 13 + clamp((T - n2.words[6]) / (n2.ends[6] - n2.words[6]), 0, 1) * 3 + clamp((T - n2.words[7]) / (n2.ends[7] - n2.words[7]), 0, 1) * 3 + clamp((T - n2.words[8]) / (n2.ends[8] - n2.words[8]), 0, 1) * 5 + clamp((T - n2.words[9]) / (n2.ends[9] - n2.words[9]), 0, 1) * 8 + clamp((T - n2.words[10]) / (n2.ends[10] - n2.words[10]), 0, 1) * 5 + clamp((T - n2.words[11]) / (n2.ends[11] - n2.words[11]), 0, 1) * 7) - 0, 0, 23) * adv), text("twenty-five: it is two. Numbers", x: 0.06, y: -0.008, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - n2.words[0]) / (n2.ends[0] - n2.words[0]), 0, 1) * 7 + clamp((T - n2.words[1]) / (n2.ends[1] - n2.words[1]), 0, 1) * 5 + clamp((T - n2.words[2]) / (n2.ends[2] - n2.words[2]), 0, 1) * 5 + clamp((T - n2.words[3]) / (n2.ends[3] - n2.words[3]), 0, 1) * 3 + clamp((T - n2.words[4]) / (n2.ends[4] - n2.words[4]), 0, 1) * 4 + clamp((T - n2.words[5]) / (n2.ends[5] - n2.words[5]), 0, 1) * 13 + clamp((T - n2.words[6]) / (n2.ends[6] - n2.words[6]), 0, 1) * 3 + clamp((T - n2.words[7]) / (n2.ends[7] - n2.words[7]), 0, 1) * 3 + clamp((T - n2.words[8]) / (n2.ends[8] - n2.words[8]), 0, 1) * 5 + clamp((T - n2.words[9]) / (n2.ends[9] - n2.words[9]), 0, 1) * 8 + clamp((T - n2.words[10]) / (n2.ends[10] - n2.words[10]), 0, 1) * 5 + clamp((T - n2.words[11]) / (n2.ends[11] - n2.words[11]), 0, 1) * 7) - 24, 0, 31) * adv), text("wrap around.", x: 0.06, y: 0.044, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((cla