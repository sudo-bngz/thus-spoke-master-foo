// Pieces — a sentence cut into tokens, each in its box; a long word cut
// into three; then the vocabulary: a tall list of tiny lines, a few
// readable, 50 000 of them. `accent: 1` gives only the cuts (vermilion).
// Times are the scene's own (0 to 1). What it returns: 0 paper, up to 1
// ink.

work Pieces(sentence0 = 0.05, cut0 = 0.2, cut1 = 0.3, word0 = 0.45, vocab0 = 0.7, accent = 0) {
  let adv = 0.0238
  let pieces = ["thus", " spoke", " master", " foo"]
  let widths = [4, 6, 7, 4]
  let left = 0.5 - 21 * adv / 2
  let x0(k) = left + sum(slice(widths, 0, k)) * adv
  let xc(k) = x0(k) + widths[k] * adv / 2
  let yy = 0.4
  let shown = smoothstep(sentence0, sentence0 + 0.03, t)
  let sentence = merge([text(pieces[k], x0(k), yy, 0.046, 0, "mono", "left") for k in range(4)]) * shown
  let when(k) = cut0 + (cut1 - cut0) * k / 3
  let box(k) = cut(rect(xc(k), yy, widths[k] * adv + 0.004, 0.07, 0, 0.002), rect(xc(k), yy, widths[k] * adv - 0.004, 0.062, 0, 0.002)) * 0.5 * smoothstep(when(k), when(k) + 0.02, t)
  let cuts = merge([line(x0(k), yy - 0.05, x0(k), yy + 0.05, 0.005, 0.002) * smoothstep(when(k), when(k) + 0.015, t) for k in range(1, 4)])
  let count4 = text("4 tokens", 0.5, yy + 0.1, 0.03, 0, "mono") * smoothstep(cut1 + 0.04, cut1 + 0.07, t) * 0.6
  // the long word
  let wy = 0.66
  let parts = ["un", "believ", "able"]
  let pw = [2, 6, 4]
  let wadv = adv * 1.4
  let wl = 0.5 - 12 * wadv / 2
  let wx(k) = wl + sum(slice(pw, 0, k)) * wadv
  let shownw = smoothstep(word0, word0 + 0.03, t)
  let word = merge([text(parts[k], wx(k), wy, 0.064, 0, "mono", "left") for k in range(3)]) * shownw
  let wcuts = merge([line(wx(k), wy - 0.06, wx(k), wy + 0.06, 0.006, 0.002) * smoothstep(word0 + 0.08 + 0.06 * k, word0 + 0.1 + 0.06 * k, t) for k in range(1, 3)])
  let count3 = text("3 tokens", 0.5, wy + 0.1, 0.03, 0, "mono") * smoothstep(word0 + 0.24, word0 + 0.27, t) * 0.6
  // the vocabulary: a column of tiny lines, some words readable
  let vy0 = 0.86
  let vh = 0.42
  let shownv = smoothstep(vocab0, vocab0 + 0.05, t)
  let lines = merge([line(0.3, vy0 + vh * r / 60, 0.3 + 0.1 + 0.15 * fract(r * 0.37), vy0 + vh * r / 60, 0.003, 0.001) for r in range(61)]) * 0.3
  let words = merge([text(["a", "able", "believ", "foo", "master", "spoke", "thus", "un", "zone"][k], 0.62, vy0 + vh * [0, 2, 9, 20, 31, 42, 47, 50, 60][k] / 60, 0.024, 0, "mono", "left") * 0.6 for k in range(9)])
  let vocab = merge(lines, words, text("vocabulary: 50 000 tokens", 0.5, vy0 + vh + 0.07, 0.03, 0, "mono") * 0.7) * shownv
  output accent * merge(cuts * shown, wcuts * shownw) + (1 - accent) * merge(sentence, merge([box(k) for k in range(4)]), count4, word, count3, vocab)
}
