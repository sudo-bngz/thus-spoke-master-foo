// Jeton — Thus Spoke Master Foo, AI 04: tokens, and the map of meaning.
// The machine does not read words; it reads numbers; Master Foo unrolls a
// map. A token is a piece of text (a sentence of four, a long word of
// three, a vocabulary of 50 000); each has a number, which says nothing
// about meaning; so each gets a place on a map, learned, where words used
// in the same ways sit close (an embedding); and directions mean
// something: king − man + woman ≈ queen. The ids and the places are
// illustrative; the edition jitters the map. Master Foo speaks Japanese,
// translated in the captions.

use "scenes/koan.alea"
use "scenes/pieces.alea"
use "scenes/numbers.alea"
use "scenes/atlas.alea"

work Jeton {
  let total = 150.0
  let T = t * total
  let EN = "../voices/narrator.sh"
  let JA = "../voices/master.sh"

  // ── the voices: the master, in Japanese; the one who explains, in English ──
  let m1 = say("弟子は尋ねた。機械は、言葉をどう読むのですか。", at: 1.50, engine: JA, voice: "jm_kumo", speed: 0.82, gain: 2.3)
  let m2 = say("師は言った。機械は、言葉を読まない。数を読む。", at: m1.end + 1.4, engine: JA, voice: "jm_kumo", speed: 0.82, gain: 2.3)
  let m3 = say("そして師は、一枚の地図を広げた。", at: m2.end + 1.4, engine: JA, voice: "jm_kumo", speed: 0.82, gain: 2.3)
  let n1 = say("A language model does not read letters. And not quite words, either. It reads tokens.", at: 20.70, engine: EN, voice: "af_heart", speed: 1.0, gain: 2.3)
  let n2 = say("A token is a piece of text: a short word, a part of a long one, a punctuation mark.", at: n1.end + 1.4, engine: EN, voice: "af_heart", speed: 1.0, gain: 2.3)
  let n3 = say("This sentence is four tokens.", at: n2.end + 1.4, engine: EN, voice: "af_heart", speed: 1.0, gain: 2.3)
  let n4 = say("This long word is three.", at: n3.end + 1.4, engine: EN, voice: "af_heart", speed: 1.0, gain: 2.3)
  let n5 = say("A model knows about fifty thousand tokens. That list is its vocabulary. Everything it ever reads or writes is made of them.", at: n4.end + 1.4, engine: EN, voice: "af_heart", speed: 1.0, gain: 2.3)
  let n6 = say("Each token has a place in the vocabulary: a number.", at: 50.70, engine: EN, voice: "af_heart", speed: 1.0, gain: 2.3)
  let n7 = say("So to the machine, a sentence is only a list of numbers.", at: n6.end + 1.4, engine: EN, voice: "af_heart", speed: 1.0, gain: 2.3)
  let n8 = say("But a number says nothing about meaning. Four thousand nine hundred fifty-eight and fifty-nine are neighbours by chance, like two words on the same page of a dictionary.", at: n7.end + 1.4, engine: EN, voice: "af_heart", speed: 1.0, gain: 2.3)
  let n9 = say("So the model gives every token a second thing: a place on a map.", at: 72.30, engine: EN, voice: "af_heart", speed: 1.0, gain: 2.3)
  let n10 = say("A point, with coordinates. Hundreds of them, in a real model. Here, two, so that we can see it.", at: n9.end + 1.4, engine: EN, voice: "af_heart", speed: 1.0, gain: 2.3)
  let n11 = say("Words used in the same ways end up close together: cat near dog, king near queen. Tuesday, far from both.", at: n10.end + 1.4, engine: EN, voice: "af_heart", speed: 1.0, gain: 2.3)
  let n12 = say("This place is called an embedding. Nobody draws the map: the model learns it, like the weights of the last episode, by moving words until their neighbours make sense.", at: n11.end + 1.4, engine: EN, voice: "af_heart", speed: 1.0, gain: 2.3)
  let n13 = say("And on this map, directions mean something.", at: 104.40, engine: EN, voice: "af_heart", speed: 1.0, gain: 2.3)
  let n14 = say("From man to woman is an arrow. Start from king, follow the same arrow: you land near queen.", at: n13.end + 1.4, engine: EN, voice: "af_heart", speed: 1.0, gain: 2.3)
  let n15 = say("Points that can be added and subtracted like this are called vectors. King, minus man, plus woman, is queen.", at: n14.end + 1.4, engine: EN, voice: "af_heart", speed: 1.0, gain: 2.3)
  let n16 = say("This is what the model computes with: not words, but points on a map, where meaning is nearness. Next time: how it knows which words to look at.", at: n15.end + 1.4, engine: EN, voice: "af_heart", speed: 1.0, gain: 2.3)
  let m4 = say("弟子は見た。地図の上で、王と女王は隣り合っていた。", at: 134.00, engine: JA, voice: "jm_kumo", speed: 0.82, gain: 2.3)
  let m5 = say("師は言った。意味とは、近さだ。", at: m4.end + 1.4, engine: JA, voice: "jm_kumo", speed: 0.82, gain: 2.3)
  let m6 = say("その時、弟子は悟った。", at: m5.end + 1.6, engine: JA, voice: "jm_kumo", speed: 0.82, gain: 2.3)

  // ── the map, jittered by the edition ──
  let jx = [~between(-0.02, 0.02) for k in range(13)]
  let jy = [~between(-0.02, 0.02) for k in range(13)]

  // ── the scenes: ink on paper, a vermilion accent, under the captions ──
  let PAPER = ["#efe9dc", "#d3c9b4", "#3b352c", "#17140f"]
  let fit(piece) = zoom(piece, by: 0.82, x: 0.5, y: 0.66)
  let ink(piece, accent) = overlay(paint(fit(piece), palette: PAPER, range: [0, 1]), paint(fit(accent), palette: ["#000000", "#c23b22"], range: [0, 1], alpha: fit(accent)))
  let reel = timeline([
      scene(ink(Koan(draw0: ((m1.start) - 0.00) / 19.2, draw1: ((m1.end) - 0.00) / 19.2, word: ((m3.end + 0.8) - 0.00) / 19.2, title: ((m3.end + 1.0) - 0.00) / 19.2, kana: ["ト", "ー", "ク", "ン"], episode: "AI 04  ·  token", accent: 0), Koan(draw0: ((m1.start) - 0.00) / 19.2, draw1: ((m1.end) - 0.00) / 19.2, word: ((m3.end + 0.8) - 0.00) / 19.2, title: ((m3.end + 1.0) - 0.00) / 19.2, kana: ["ト", "ー", "ク", "ン"], episode: "AI 04  ·  token", accent: 1)), 19.2),  wipe(0.8, angle: 0, softness: 0.12),
      scene(ink(Pieces(sentence0: ((n3.words[0]) - 19.20) / 30.0, cut0: ((n3.words[2]) - 19.20) / 30.0, cut1: ((n3.words[3]) - 19.20) / 30.0, word0: ((n4.words[0]) - 19.20) / 30.0, vocab0: ((n5.words[4]) - 19.20) / 30.0, accent: 0), Pieces(sentence0: ((n3.words[0]) - 19.20) / 30.0, cut0: ((n3.words[2]) - 19.20) / 30.0, cut1: ((n3.words[3]) - 19.20) / 30.0, word0: ((n4.words[0]) - 19.20) / 30.0, vocab0: ((n5.words[4]) - 19.20) / 30.0, accent: 1)), 30.0),  pixels(0.6, size: 0.05),
      scene(ink(Numbers(ids0: ((n6.words[6]) - 49.20) / 21.6, list0: ((n7.words[6]) - 49.20) / 21.6, dict0: ((n8.words[8]) - 49.20) / 21.6, accent: 0), Numbers(ids0: ((n6.words[6]) - 49.20) / 21.6, list0: ((n7.words[6]) - 49.20) / 21.6, dict0: ((n8.words[8]) - 49.20) / 21.6, accent: 1)), 21.6),  wipe(0.7, angle: 90, softness: 0.1),
      scene(ink(Atlas(jx: jx, jy: jy, axes0: ((n9.words[9]) - 70.80) / 32.1, first0: ((n10.words[0]) - 70.80) / 32.1, cluster0: ((n11.words[0]) - 70.80) / 32.1, far0: ((n11.words[15]) - 70.80) / 32.1, arrow0: 5, same0: 5, land0: 5, accent: 0), Atlas(jx: jx, jy: jy, axes0: ((n9.words[9]) - 70.80) / 32.1, first0: ((n10.words[0]) - 70.80) / 32.1, cluster0: ((n11.words[0]) - 70.80) / 32.1, far0: ((n11.words[15]) - 70.80) / 32.1, arrow0: 5, same0: 5, land0: 5, accent: 1)), 32.1),  morph(0.8, amount: 0.15),
      scene(ink(Atlas(jx: jx, jy: jy, axes0: -1, first0: -1, cluster0: -1, far0: -1, arrow0: ((n14.words[0]) - 102.90) / 29.6, same0: ((n14.words[6]) - 102.90) / 29.6, land0: ((n14.words[13]) - 102.90) / 29.6, accent: 0), Atlas(jx: jx, jy: jy, axes0: -1, first0: -1, cluster0: -1, far0: -1, arrow0: ((n14.words[0]) - 102.90) / 29.6, same0: ((n14.words[6]) - 102.90) / 29.6, land0: ((n14.words[13]) - 102.90) / 29.6, accent: 1)), 29.6),  wipe(0.8, angle: 180, softness: 0.12),
      scene(ink(Koan(draw0: ((m4.start) - 132.50) / 17.5, draw1: ((m6.end) - 132.50) / 17.5, word: ((m6.start + 0.5) - 132.50) / 17.5, title: ((m6.end + 0.6) - 132.50) / 17.5, kana: ["ト", "ー", "ク", "ン"], episode: "AI 04  ·  token", accent: 0), Koan(draw0: ((m4.start) - 132.50) / 17.5, draw1: ((m6.end) - 132.50) / 17.5, word: ((m6.start + 0.5) - 132.50) / 17.5, title: ((m6.end + 0.6) - 132.50) / 17.5, kana: ["ト", "ー", "ク", "ン"], episode: "AI 04  ·  token", accent: 1)), 17.5),  morph(1.2, amount: 0.2),
  ], loop: 1)

  // ── over it: the series, the step, the captions (the master's, translated, in vermilion) ──
  let adv = 0.021722
  let header = merge(text("1 / 4   the pieces", x: 0.06, y: -0.15, size: 0.03, font: "mono", align: "left") * (reel.index > 1 - 0.5) * (reel.index < 1 + 0.5), text("2 / 4   the numbers", x: 0.06, y: -0.15, size: 0.03, font: "mono", align: "left") * (reel.index > 2 - 0.5) * (reel.index < 2 + 0.5), text("3 / 4   the map", x: 0.06, y: -0.15, size: 0.03, font: "mono", align: "left") * (reel.index > 3 - 0.5) * (reel.index < 3 + 0.5), text("4 / 4   the directions", x: 0.06, y: -0.15, size: 0.03, font: "mono", align: "left") * (reel.index > 4 - 0.5) * (reel.index < 4 + 0.5)) * 0.7
  let series = text("thus spoke master foo  ·  AI 04", x: 0.94, y: -0.3, size: 0.024, font: "mono", align: "right") * 0.45
  let c_m1 = merge(text("The novice asked: how does a", x: 0.06, y: -0.060, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - m1.start) / (m1.duration * 0.92), 0, 1) * 48) - 0, 0, 28) * adv), text("machine read words?", x: 0.06, y: -0.008, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - m1.start) / (m1.duration * 0.92), 0, 1) * 48) - 29, 0, 19) * adv)) * (T >= m1.start) * (T < min(m1.end + 1.5, m2.start))
  let c_m2 = merge(text("Master Foo said: the machine does", x: 0.06, y: -0.060, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - m2.start) / (m2.duration * 0.92), 0, 1) * 67) - 0, 0, 33) * adv), text("not read words. It reads numbers.", x: 0.06, y: -0.008, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - m2.start) / (m2.duration * 0.92), 0, 1) * 67) - 34, 0, 33) * adv)) * (T >= m2.start) * (T < min(m2.end + 1.5, m3.start))
  let c_m3 = text("And Master Foo unrolled a map.", x: 0.06, y: -0.060, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - m3.start) / (m3.duration * 0.92), 0, 1) * 30) - 0, 0, 30) * adv) * (T >= m3.start) * (T < min(m3.end + 1.5, n1.start))
  let c_n1 = merge(text("A language model does not read", x: 0.06, y: -0.060, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - n1.words[0]) / (n1.ends[0] - n1.words[0]), 0, 1) * 2 + clamp((T - n1.words[1]) / (n1.ends[1] - n1.words[1]), 0, 1) * 9 + clamp((T - n1.words[2]) / (n1.ends[2] - n1.words[2]), 0, 1) * 6 + clamp((T - n1.words[3]) / (n1.ends[3] - n1.words[3]), 0, 1) * 5 + clamp((T - n1.words[4]) / (n1.ends[4] - n1.words[4]), 0, 1) * 4 + clamp((T - n1.words[5]) / (n1.ends[5] - n1.words[5]), 0, 1) * 5 + clamp((T - n1.words[6]) / (n1.ends[6] - n1.words[6]), 0, 1) * 9 + clamp((T - n1.words[7]) / (n1.ends[7] - n1.words[7]), 0, 1) * 4 + clamp((T - n1.words[8]) / (n1.ends[8] - n1.words[8]), 0, 1) * 4 + clamp((T - n1.words[9]) / (n1.ends[9] - n1.words[9]), 0, 1) * 6 + clamp((T - n1.words[10]) / (n1.ends[10] - n1.words[10]), 0, 1) * 7 + clamp((T - n1.words[11]) / (n1.ends[11] - n1.words[11]), 0, 1) * 8 + clamp((T - n1.words[12]) / (n1.ends[12] - n1.words[12]), 0, 1) * 3 + clamp((T - n1.words[13]) / (n1.ends[13] - n1.words[13]), 0, 1) * 6 + clamp((T - n1.words[14]) / (n1.ends[14] - n1.words[14]), 0, 1) * 7) - 0, 0, 30) * adv), text("letters. And not quite words,", x: 0.06, y: -0.008, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - n1.words[0]) / (n1.ends[0] - n1.words[0]), 0, 1) * 2 + clamp((T - n1.words[1]) / (n1.ends[1] - n1.words[1]), 0, 1) * 9 + clamp((T - n1.words[2]) / (n1.ends[2] - n1.words[2]), 0, 1) * 6 + clamp((T - n1.words[3]) / (n1.ends[3] - n1.words[3]), 0, 1) * 5 + clamp((T - n1.words[4]) / (n1.ends[4] - n1.words[4]), 0, 1) * 4 + clamp((T - n1.words[5]) / (n1.ends[5] - n1.words[5]), 0, 1) * 5 + clamp((T - n1.words[6]) / (n1.ends[6] - n1.words[6]), 0, 1) * 9 + clamp((T - n1.words[7]) / (n1.ends[7] - n1.words[7]), 0, 1) * 4 + clamp((T - n1.words[8]) / (n1.ends[8] - n1.words[8]), 0, 1) * 4 + clamp((T - n1.words[9]) / (n1.ends[9] - n1.words[9]), 0, 1) * 6 + clamp((T - n1.words[10]) / (n1.ends[10] - n1.words[10]), 0, 1) * 7 + clamp((T - n1.words[11]) / (n1.ends[11] - n1.words[11]), 0, 1) * 8 + clamp((T - n1.words[12]) / (n1.ends[12] - n1.words[12]), 0, 1) * 3 + clamp((T - n1.words[13]) / (n1.ends[13] - n1.words[13]), 0, 1) * 6 + clamp((T - n1.words[14]) / (n1.ends[14] - n1.words[14]), 0, 1) * 7) - 31, 0, 29) * adv), text("either. It reads tokens.", x: 0.06, y: 0.044, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - n1.words[0]) / (n1.ends[0] - n1.words[0]), 0, 1) * 2 + clamp((T - n1.words[1]) / (n1.ends[1] - n1.words[1]), 0, 1) * 9 + clamp((T - n1.words[2]) / (n1.ends[2] - n1.words[2]), 0, 1) * 6 + clamp((T - n1.words[3]) / (n1.ends[3] - n1.words[3]), 0, 1) * 5 + clamp((T - n1.words[4]) / (n1.ends[4] - n1.words[4]), 0, 1) * 4 + clamp((T - n1.words[5]) / (n1.ends[5] - n1.words[5]), 0, 1) * 5 + clamp((T - n1.words[6]) / (n1.ends[6] - n1.words[6]), 0, 1) * 9 + clamp((T - n1.words[7]) / (n1.ends[7] - n1.words[7]), 0, 1) * 4 + clamp((T - n1.words[8]) / (n1.ends[8] - n1.words[8]), 0, 1) * 4 + clamp((T - n1.words[9]) / (n1.ends[9] - n1.words[9]), 0, 1) * 6 + clamp((T - n1.words[10]) / (n1.ends[10] - n1.words[10]), 0, 1) * 7 + clamp((T - n1.words[11]) / (n1.ends[11] - n1.words[11]), 0, 1) * 8 + clamp((T - n1.words[12]) / (n1.ends[12] - n1.words[12]), 0, 1) * 3 + clamp((T - n1.words[13]) / (n1.ends[13] - n1.words[13]), 0, 1) * 6 + clamp((T - n1.words[14]) / (n1.ends[14] - n1.words[14]), 0, 1) * 7) - 61, 0, 24) * adv)) * (T >= n1.start) * (T < min(n1.end + 1.5, n2.start))
