rds[19]) / (n16.ends[19] - n16.words[19]), 0, 1) * 6 + clamp((T - n16.words[20]) / (n16.ends[20] - n16.words[20]), 0, 1) * 4 + clamp((T - n16.words[21]) / (n16.ends[21] - n16.words[21]), 0, 1) * 3 + clamp((T - n16.words[22]) / (n16.ends[22] - n16.words[22]), 0, 1) * 6 + clamp((T - n16.words[23]) / (n16.ends[23] - n16.words[23]), 0, 1) * 6 + clamp((T - n16.words[24]) / (n16.ends[24] - n16.words[24]), 0, 1) * 6 + clamp((T - n16.words[25]) / (n16.ends[25] - n16.words[25]), 0, 1) * 3 + clamp((T - n16.words[26]) / (n16.ends[26] - n16.words[26]), 0, 1) * 5 + clamp((T - n16.words[27]) / (n16.ends[27] - n16.words[27]), 0, 1) * 3) - 127, 0, 17) * adv)) * (T >= n16.start) * (T < min(n16.end + 1.5, m4.start))
  let c_m4 = merge(text("The novice looked: on the map,", x: 0.06, y: -0.060, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - m4.start) / (m4.duration * 0.92), 0, 1) * 73) - 0, 0, 30) * adv), text("the king and the queen stood side", x: 0.06, y: -0.008, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - m4.start) / (m4.duration * 0.92), 0, 1) * 73) - 31, 0, 33) * adv), text("by side.", x: 0.06, y: 0.044, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - m4.start) / (m4.duration * 0.92), 0, 1) * 73) - 65, 0, 8) * adv)) * (T >= m4.start) * (T < min(m4.end + 1.5, m5.start))
  let c_m5 = merge(text("Master Foo said: meaning is", x: 0.06, y: -0.060, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - m5.start) / (m5.duration * 0.92), 0, 1) * 37) - 0, 0, 27) * adv), text("nearness.", x: 0.06, y: -0.008, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - m5.start) / (m5.duration * 0.92), 0, 1) * 37) - 28, 0, 9) * adv)) * (T >= m5.start) * (T < min(m5.end + 1.5, m6.start))
  let c_m6 = text("And the novice was enlightened.", x: 0.06, y: -0.060, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - m6.start) / (m6.duration * 0.92), 0, 1) * 31) - 0, 0, 31) * adv) * (T >= m6.start) * (T < m6.end + 3)
  let said = merge(c_n1, c_n2, c_n3, c_n4, c_n5, c_n6, c_n7, c_n8, c_n9, c_n10, c_n11, c_n12, c_n13, c_n14, c_n15, c_n16)
  let spoken = merge(c_m1, c_m2, c_m3, c_m4, c_m5, c_m6)
  let dark = paint(merge(header, series, said), palette: ["#000000", "#1a1712"], range: [0, 1], alpha: merge(header, series, said))
  let red  = paint(spoken, palette: ["#000000", "#b8361f"], range: [0, 1], alpha: spoken)
  let look = film(vignette(overlay(reel, dark, red), amount: 0.06), amount: 0.035)

  // ── the sound ──
  let pad = synth {
    let env = adsr(attack: 3, decay: 1, sustain: 0.9, release: 4)
    lowpass(saw(note.freq) + saw(note.freq * 1.003) + sine(note.freq * 0.5), cutoff: 260 + 300 * note.level, resonance: 0.2) * env
  }
  let brush = synth { bandpass(noise(), cutoff: 1400, resonance: 0.3) * adsr(attack: 0.12, decay: 0.3, sustain: 0.3, release: 0.5) * note.velocity }
  let tick = synth { highpass(noise(), cutoff: 4000, resonance: 0.2) * perc(release: 0.015) * note.velocity + sine(note.freq) * perc(release: 0.05) * 0.4 }
  let knock = synth { lowpass(noise(), cutoff: 700, resonance: 0.5) * perc(attack: 0.002, release: 0.12) * note.velocity + sine(note.freq) * perc(release: 0.1) * 0.5 }
  let chord = synth {
    let env = adsr(attack: 0.3, decay: 0.6, sustain: 0.8, release: 2.5)
    chorus(lowpass(saw(note.freq) + saw(note.freq * 1.004) + sine(note.freq * 0.5), cutoff: 1200, resonance: 0.15) * env, depth: 0.6)
  }
  // the temple bell when the master speaks; the map unrolled
  pattern bells = repeat 2 event(t: [m1.start - 1.0, m4.start - 1.0][i] / total, x: 0.5, y: 0.95, size: 0.12, intensity: 0.9)
  pattern unrolled = repeat 1 event(t: (m3.start + 0.5 * m3.duration) / total, x: 0.5, y: 0.5, size: 0.08, intensity: 0.7)
  // the cuts, the long word, the vocabulary scrolling
  pattern cuts = repeat 3 event(t: (n3.words[2] + (n3.words[3] - n3.words[2]) * i / 3) / total, x: 0.3 + 0.2 * i, y: 0.5, intensity: 0.7)
  pattern wcuts = repeat 2 event(t: (n4.words[0] + 30.0 * (0.08 + 0.06 * i)) / total, x: 0.4 + 0.2 * i, y: 0.6, intensity: 0.7)
  pattern vocab = repeat 12 event(t: (n5.words[4] + 0.12 * i) / total, x: 0.3, y: 0.9 - 0.05 * i, intensity: 0.3)
  // the numbers, the list, the neighbour
  pattern numbers = repeat 4 event(t: (n6.words[6] + 0.05 * 21.6 * i) / total, x: 0.3 + 0.13 * i, y: 0.5, intensity: 0.5)
  pattern listed = repeat 1 event(t: n7.words[6] / total, x: 0.5, y: 0.6, size: 0.06, intensity: 0.6)
  pattern neighbour = repeat 1 event(t: (n8.words[8] + 0.1 * 21.6) / total, x: 0.45, y: 0.8, size: 0.04, intensity: 0.7)
  // the map: the words placed, one by one
  pattern placed = repeat 13 event(t: ([n10.words[0], n10.words[0], n11.words[0], n11.words[0] + 0.025 * 32.1, n11.words[0] + 0.05 * 32.1, n11.words[0] + 0.075 * 32.1, n11.words[0] + 0.1 * 32.1, n11.words[0] + 0.125 * 32.1, n11.words[0] + 0.15 * 32.1, n11.words[0] + 0.175 * 32.1, n11.words[15], n11.words[15] + 0.03 * 32.1, n11.words[15] + 0.06 * 32.1][i]) / total, x: 0.2 + 0.6 * fract(i * 0.37), y: 0.3 + 0.5 * fract(i * 0.61), intensity: 0.5)
  // the arrows, the landing
  pattern arrows = repeat 2 event(t: [n14.words[0], n14.words[6]][i] / total, x: 0.8, y: 0.5, size: 0.08, intensity: 0.6)
  pattern landed = repeat 3 event(t: n14.words[13] / total, x: 0.7, y: [0.5, 0.4, 0.3][i], size: 0.1, intensity: 0.7)

  let music = [
    m1, m2, m3, n1, n2, n3, n4, n5, n6, n7, n8, n9, n10, n11, n12, n13, n14, n15, n16, m4, m5, m6,
    drone(0.45 + 0.15 * lfo(3) + x * 0, voices: 2, instrument: pad, scale: "hirajoshi", key: 55, gain: 0.9),
    notes(bells, instrument: "bell", scale: "hirajoshi", key: 110, gain: 0.7),
    notes(unrolled, instrument: brush, scale: "chromatic", key: 100, gain: 0.5),
    notes(cuts, instrument: tick, scale: "hirajoshi", key: 880, gain: 0.5),
    notes(wcuts, instrument: tick, scale: "hirajoshi", key: 880, gain: 0.5),
    notes(vocab, instrument: "wood", scale: "hirajoshi", key: 330, gain: 0.25),
    notes(numbers, instrument: "wood", scale: "hirajoshi", key: 330, gain: 0.4),
    notes(listed, instrument: "glass", scale: "hirajoshi", key: 392, gain: 0.5),
    notes(neighbour, instrument: knock, scale: "hirajoshi", key: 165, gain: 0.5),
    notes(placed, instrument: "kalimba", scale: "hirajoshi", key: 392, gain: 0.45),
    notes(arrows, instrument: "glass", scale: "hirajoshi", key: 523, gain: 0.5),
    notes(landed, instrument: chord, scale: "major", key: 110, gain: 0.4),
    notes(reel.cues, instrument: brush, scale: "chromatic", key: 100, gain: 0.3),
  ]

  render image(look, width: 1080, height: 1920, at: 0.8241)
  render video(look, fps: 30, width: 1080, height: 1920, sound: music, room: 0.12, echo: 0)
}
