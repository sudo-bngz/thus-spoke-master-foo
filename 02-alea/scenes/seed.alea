// Seed — the bits a register starts from. Three registers, each with its
// seed above (its first fifteen bits) and its tape below, 16 by 16: the
// first two from the same seed, the same tape, bit for bit; the third from
// the same seed with one bit changed (in vermilion): its first eleven bits
// are the same, the time the change takes to reach the end of the row, then
// nothing in common. Then the command that drew this film, typed. `r` is
// the grown register (as in Lfsr): its row at y = 0.5 the seed, the next
// row the same seed with cell `flip` changed. `accent: 1` gives only the
// changed bit. Times are the scene's own (0 to 1). What it returns: 0
// paper, up to 1 ink.

work Seed(r = 0, flip = 3, show = [0.1, 0.35, 0.6], fill = 0.12, cmd = "$ alea alea.alea --seed 0xa161", typed = [0.8, 0.9], accent = 0) {
  let G = 575
  let names = ["seed", "same seed", "one bit changed"]
  let sy = 0.4
  let ty = 0.48
  let cw = 0.017
  // which panel a point is in, its centre, and the register row it reads
  let j = (x > 0.34) + (x > 0.66)
  let cx = 0.18 + 0.32 * j
  let row = 0.5 + (j > 1.5) / 15
  let look(cell, g) = at(move(r, x: x - (cell + 0.5) / 15, y: y - row), time: g / G)
  let on = smoothstep(show[0], show[0] + 0.02, t) * (j < 0.5) + smoothstep(show[1], show[1] + 0.02, t) * (j > 0.5) * (j < 1.5) + smoothstep(show[2], show[2] + 0.02, t) * (j > 1.5)
  let start = show[0] * (j < 0.5) + show[1] * (j > 0.5) * (j < 1.5) + show[2] * (j > 1.5)
  // the seeds: fifteen cells, filled where the bit is 1 (one look per point)
  let k = clamp(floor((x - cx + 0.126 + 0.009) / 0.018), 0, 14)
  let boxes = merge([cut(rect(cxs - 0.126 + 0.018 * q, sy, 0.015, 0.015, 0, 0.001), rect(cxs - 0.126 + 0.018 * q, sy, 0.011, 0.011, 0, 0.001)) for q in range(15) for cxs in [0.18, 0.5, 0.82]]) * 0.5
  let fills = merge([rect(cxs - 0.126 + 0.018 * q, sy, 0.009, 0.009, 0, 0.001) for q in range(15) for cxs in [0.18, 0.5, 0.82]])
  let seeds = merge(boxes, fills * look(k, 0))
  // the tapes: bit m is what fell out at step m (one look per point)
  let m = floor((y - ty) / cw) * 16 + floor((x - cx + 8 * cw) / cw)
  let tapes = look(14, m) * (x > cx - 8 * cw) * (x < cx + 8 * cw) * (y > ty) * (y < ty + 16 * cw)
              * (fract((x - cx + 8 * cw) / cw) > 0.12) * (fract((y - ty) / cw) > 0.12) * (m <= 256 * clamp((t - start) / fill, 0, 1))
  let labels = merge([text(names[q], [0.18, 0.5, 0.82][q], sy - 0.05, 0.024, 0, "mono") for q in range(3)]) * 0.7
  let panels = merge(seeds, tapes, labels) * on
  let mark = rect(0.82 - 0.126 + 0.018 * flip, sy, 0.021, 0.021, 0, 0.001) * smoothstep(show[2], show[2] + 0.02, t)
  let line1 = text(cmd, 0.07, 0.95, 0.03, 0, "mono", "left") * (x < 0.07 + 0.0155 * 31 * clamp((t - typed[0]) / (typed[1] - typed[0]), 0, 1)) * (t > typed[0])
  let cursor = rect(0.07 + 0.0155 * 31 * clamp((t - typed[0]) / (typed[1] - typed[0]), 0, 1) + 0.01, 0.95, 0.012, 0.03, 0, 0.001) * (fract(t * 40) < 0.5) * (t > typed[0])
  output accent * mark + (1 - accent) * cut(merge(panels, line1, cursor), mark)
}
