// Aléa — Thus Spoke Master Foo, 02: can a computer roll a die? A novice
// asks Master Foo for a random number; twice, the master says seven. A
// computer only follows recipes, so it fakes chance: fifteen bits slide
// along a register, the last two are mixed and come back at the start (a
// linear-feedback shift register, the noise of old game consoles), grown
// here step by step from the edition's own seed. Same seed, same numbers;
// one bit changed, another tape. Real chance comes from the world: keys,
// mouse, the noise of circuits. Master Foo speaks Japanese, translated in
// the captions. Written by gen.py; the scenes are in scenes/.

use "scenes/koan.alea"
use "scenes/machine.alea"
use "scenes/lfsr.alea"
use "scenes/seed.alea"
use "scenes/entropy.alea"

work Alea {
  let total = 107.2
  let T = t * total
  let EN = "../voices/kokoro.py"
  let JA = "../voices/kokoro-ja.py"

  // ── the voices: the master, in Japanese; the one who explains, in English ──
  let m1 = say("ある弟子が、フー師に乱数をひとつ求めた。", at: 1.40, engine: JA, voice: "jm_kumo", speed: 0.85, gain: 2.3)
  let m2 = say("師は答えた。七。", at: m1.end + 1.0, engine: JA, voice: "jm_kumo", speed: 0.85, gain: 2.3)
  let m3 = say("弟子はもう一度たずねた。師は答えた。七。", at: m2.end + 1.4, engine: JA, voice: "jm_kumo", speed: 0.85, gain: 2.3)
  let n1 = say("A computer cannot roll a die.", at: 18.30, engine: EN, voice: "af_heart", speed: 0.95, gain: 2.3)
  let n2 = say("It only follows recipes, and the same recipe always gives the same answer.", at: n1.end + 1.0, engine: EN, voice: "af_heart", speed: 0.95, gain: 2.3)
  let n3 = say("So it fakes chance, with a recipe that scrambles bits.", at: 30.00, engine: EN, voice: "af_heart", speed: 0.95, gain: 2.3)
  let n4 = say("Fifteen bits slide to the right. The last two are mixed, and the result comes back at the start.", at: n3.end + 1.0, engine: EN, voice: "af_heart", speed: 0.95, gain: 2.3)
  let n5 = say("Step after step, the bits that fall out look like chance.", at: n4.end + 1.4, engine: EN, voice: "af_heart", speed: 0.95, gain: 2.3)
  let n6 = say("Played fast, they are noise: the very noise of an old game console.", at: n5.end + 1.6, engine: EN, voice: "af_heart", speed: 0.95, gain: 2.3)
  let n7 = say("But after thirty-two thousand, seven hundred and sixty-seven steps, it all starts again.", at: n6.end + 1.4, engine: EN, voice: "af_heart", speed: 0.95, gain: 2.3)
  let n8 = say("The bits it starts from are its seed.", at: 59.30, engine: EN, voice: "af_heart", speed: 0.95, gain: 2.3)
  let n9 = say("Same seed, same numbers. Every time.", at: n8.end + 1.2, engine: EN, voice: "af_heart", speed: 0.95, gain: 2.3)
  let n10 = say("Change a single bit, and everything changes.", at: n9.end + 1.2, engine: EN, voice: "af_heart", speed: 0.95, gain: 2.3)
  let n11 = say("This film, too, was drawn from a seed. Another seed, another film.", at: n10.end + 1.6, engine: EN, voice: "af_heart", speed: 0.95, gain: 2.3)
  let n12 = say("When chance must be real, for a password or a key, the machine listens to the world:", at: 78.60, engine: EN, voice: "af_heart", speed: 0.95, gain: 2.3)
  let n13 = say("the timing of your keys, the moves of your mouse, the noise in its own circuits.", at: n12.end + 0.8, engine: EN, voice: "af_heart", speed: 0.95, gain: 2.3)
  let n14 = say("It stirs them into a seed that no one can guess.", at: n13.end + 1.2, engine: EN, voice: "af_heart", speed: 0.95, gain: 2.3)
  let m4 = say("そして師は、弟子にたねを渡した。", at: 96.10, engine: JA, voice: "jm_kumo", speed: 0.85, gain: 2.3)
  let m5 = say("その時、弟子は悟った。", at: m4.end + 1.4, engine: JA, voice: "jm_kumo", speed: 0.85, gain: 2.3)

  // ── the register: fifteen bits from the edition's seed; at each generation
  // they slide right and the last two, mixed, come back at the start. Each row
  // of the grid is a register: row 7 (y = 0.5) is the one shown; row 8 starts
  // from the same bits but one, cell 3, changed (its twin). ──
  let seedbits = ~~uniform(0, 1) < 0.5
  let first = move(seedbits, x: 0, y: y - 0.5)
  grow over 15 for 575 {
    reg = abs(first - (y > 8 / 15) * (y < 9 / 15) * (x > 3 / 15) * (x < 4 / 15))
      then (x < 1 / 15) * abs(move(reg, x: -13 / 15, y: 0) - move(reg, x: -14 / 15, y: 0)) + (x >= 1 / 15) * move(reg, x: 1 / 15, y: 0)
  }
  // the steps: slowly, then faster and faster, from "Fifteen" to the end of the noise
  let s0 = n4.words[0]
  let s1 = n6.end
  let stepat(k) = s0 + (s1 - s0) * (k / 575) ^ (1 / 3)

  // ── the scenes: ink on paper, a vermilion accent, under the captions ──
  let PAPER = ["#efe9dc", "#d3c9b4", "#3b352c", "#17140f"]
  let fit(piece) = zoom(piece, by: 0.82, x: 0.5, y: 0.66)
  let ink(piece, accent) = overlay(paint(fit(piece), palette: PAPER, range: [0, 1]), paint(fit(accent), palette: ["#000000", "#c23b22"], range: [0, 1], alpha: fit(accent)))
  let reel = timeline([
      scene(ink(Koan(draw0: ((m1.start) - 0.00) / 16.9, draw1: ((m1.end) - 0.00) / 16.9, word: ((m3.end + 0.8) - 0.00) / 16.9, title: ((m3.end + 1.0) - 0.00) / 16.9, kana: ["ラ", "ン", "ダ", "ム"], episode: "02  ·  chance", big: "7", bigat: [((m2.end - 0.5) - 0.00) / 16.9, ((m3.end - 0.5) - 0.00) / 16.9], bigoff: ((m3.end + 0.5) - 0.00) / 16.9, accent: 0), Koan(draw0: ((m1.start) - 0.00) / 16.9, draw1: ((m1.end) - 0.00) / 16.9, word: ((m3.end + 0.8) - 0.00) / 16.9, title: ((m3.end + 1.0) - 0.00) / 16.9, kana: ["ラ", "ン", "ダ", "ム"], episode: "02  ·  chance", big: "7", bigat: [((m2.end - 0.5) - 0.00) / 16.9, ((m3.end - 0.5) - 0.00) / 16.9], bigoff: ((m3.end + 0.5) - 0.00) / 16.9, accent: 1)), 16.9),  wipe(0.8, angle: 0, softness: 0.12),
      scene(ink(Machine(die: ((n1.words[3]) - 16.90) / 11.7, strike: ((n1.end) - 16.90) / 11.7, box: ((n2.words[3]) - 16.90) / 11.7, runs: [((n2.words[7]) - 16.90) / 11.7, ((n2.words[9]) - 16.90) / 11.7, ((n2.words[12]) - 16.90) / 11.7], accent: 0), Machine(die: ((n1.words[3]) - 16.90) / 11.7, strike: ((n1.end) - 16.90) / 11.7, box: ((n2.words[3]) - 16.90) / 11.7, runs: [((n2.words[7]) - 16.90) / 11.7, ((n2.words[9]) - 16.90) / 11.7, ((n2.words[12]) - 16.90) / 11.7], accent: 1)), 11.7),  glitch(0.6, amount: 0.5),
      scene(ink(Lfsr(reg: reg, s0: ((s0) - 28.60) / 29.3, s1: ((s1) - 28.60) / 29.3, mix: ((n4.words[10]) - 28.60) / 29.3, period: ((n7.words[2]) - 28.60) / 29.3, accent: 0), Lfsr(reg: reg, s0: ((s0) - 28.60) / 29.3, s1: ((s1) - 28.60) / 29.3, mix: ((n4.words[10]) - 28.60) / 29.3, period: ((n7.words[2]) - 28.60) / 29.3, accent: 1)), 29.3),  wipe(0.7, angle: 90, softness: 0.1),
      scene(ink(Seed(r: reg, flip: 3, show: [((n8.words[7]) - 57.90) / 19.3, ((n9.words[0]) - 57.90) / 19.3, ((n10.words[3]) - 57.90) / 19.3], fill: 1.6 / 19.3, cmd: "$ alea alea.alea --seed 0xa161", typed: [((n11.words[8]) - 57.90) / 19.3, ((n11.end) - 57.90) / 19.3], accent: 0), Seed(r: reg, flip: 3, show: [((n8.words[7]) - 57.90) / 19.3, ((n9.words[0]) - 57.90) / 19.3, ((n10.words[3]) - 57.90) / 19.3], fill: 1.6 / 19.3, cmd: "$ alea alea.alea --seed 0xa161", typed: [((n11.words[8]) - 57.90) / 19.3, ((n11.end) - 57.90) / 19.3], accent: 1)), 19.3),  morph(0.8, amount: 0.15),
      scene(ink(Entropy(when: [((n13.words[4]) - 77.20) / 17.5, ((n13.words[9]) - 77.20) / 17.5, ((n13.words[15]) - 77.20) / 17.5], stir: ((n14.words[1]) - 77.20) / 17.5, seed: ((n14.words[5]) - 77.20) / 17.5, accent: 0), Entropy(when: [((n13.words[4]) - 77.20) / 17.5, ((n13.words[9]) - 77.20) / 17.5, ((n13.words[15]) - 77.20) / 17.5], stir: ((n14.words[1]) - 77.20) / 17.5, seed: ((n14.words[5]) - 77.20) / 17.5, accent: 1)), 17.5),  wipe(0.8, angle: 180, softness: 0.12),
      scene(ink(Koan(draw0: ((m4.start) - 94.70) / 12.5, draw1: ((m5.end) - 94.70) / 12.5, word: ((m4.start + 1.0) - 94.70) / 12.5, title: ((m5.end + 0.6) - 94.70) / 12.5, kana: ["ラ", "ン", "ダ", "ム"], episode: "02  ·  chance", accent: 0), Koan(draw0: ((m4.start) - 94.70) / 12.5, draw1: ((m5.end) - 94.70) / 12.5, word: ((m4.start + 1.0) - 94.70) / 12.5, title: ((m5.end + 0.6) - 94.70) / 12.5, kana: ["ラ", "ン", "ダ", "ム"], episode: "02  ·  chance", accent: 1)), 12.5),  morph(1.2, amount: 0.2),
  ], loop: 1)

  // ── over it: the series, the step, the captions (the master's, translated, in vermilion) ──
  let adv = 0.021722
  let header = merge(text("1 / 4   a machine can't guess", x: 0.06, y: -0.15, size: 0.03, font: "mono", align: "left") * (reel.index > 1 - 0.5) * (reel.index < 1 + 0.5), text("2 / 4   a fake die", x: 0.06, y: -0.15, size: 0.03, font: "mono", align: "left") * (reel.index > 2 - 0.5) * (reel.index < 2 + 0.5), text("3 / 4   the seed", x: 0.06, y: -0.15, size: 0.03, font: "mono", align: "left") * (reel.index > 3 - 0.5) * (reel.index < 3 + 0.5), text("4 / 4   real chance", x: 0.06, y: -0.15, size: 0.03, font: "mono", align: "left") * (reel.index > 4 - 0.5) * (reel.index < 4 + 0.5)) * 0.7
  let series = text("thus spoke master foo  ·  02", x: 0.94, y: -0.3, size: 0.024, font: "mono", align: "right") * 0.45
  let c_m1 = merge(text("A novice asked Master Foo for a", x: 0.06, y: -0.060, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - m1.start) / (m1.duration * 0.92), 0, 1) * 46) - 0, 0, 31) * adv), text("random number.", x: 0.06, y: -0.008, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - m1.start) / (m1.duration * 0.92), 0, 1) * 46) - 32, 0, 14) * adv)) * (T >= m1.start) * (T < min(m1.end + 1.5, m2.start))
  let c_m2 = text("Master Foo answered: seven.", x: 0.06, y: -0.060, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - m2.start) / (m2.duration * 0.92), 0, 1) * 27) - 0, 0, 27) * adv) * (T >= m2.start) * (T < min(m2.end + 1.5, m3.start))
  let c_m3 = merge(text("The novice asked again. Master", x: 0.06, y: -0.060, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - m3.start) / (m3.duration * 0.92), 0, 1) * 51) - 0, 0, 30) * adv), text("Foo answered: seven.", x: 0.06, y: -0.008, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - m3.start) / (m3.duration * 0.92), 0, 1) * 51) - 31, 0, 20) * adv)) * (T >= m3.start) * (T < min(m3.end + 1.5, n1.start))
  let c_n1 = text("A computer cannot roll a die.", x: 0.06, y: -0.060, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - n1.words[0]) / (n1.ends[0] - n1.words[0]), 0, 1) * 2 + clamp((T - n1.words[1]) / (n1.ends[1] - n1.words[1]), 0, 1) * 9 + clamp((T - n1.words[2]) / (n1.ends[2] - n1.words[2]), 0, 1) * 7 + clamp((T - n1.words[3]) / (n1.ends[3] - n1.words[3]), 0, 1) * 5 + clamp((T - n1.words[4]) / (n1.ends[4] - n1.words[4]), 0, 1) * 2 + clamp((T - n1.words[5]) / (n1.ends[5] - n1.words[5]), 0, 1) * 4) - 0, 0, 29) * adv) * (T >= n1.start) * (T < min(n1.end + 1.5, n2.start))
  let c_n2 = merge(text("It only follows recipes, and the", x: 0.06, y: -0.060, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - n2.words[0]) / (n2.ends[0] - n2.words[0]), 0, 1) * 3 + clamp((T - n2.words[1]) / (n2.ends[1] - n2.words[1]), 0, 1) * 5 + clamp((T - n2.words[2]) / (n2.ends[2] - n2.words[2]), 0, 1) * 8 + clamp((T - n2.words[3]) / (n2.ends[3] - n2.words[3]), 0, 1) * 9 + clamp((T - n2.words[4]) / (n2.ends[4] - n2.words[4]), 0, 1) * 4 + clamp((T - n2.words[5]) / (n2.ends[5] - n2.words[5]), 0, 1) * 4 + clamp((T - n2.words[6]) / (n2.ends[6] - n2.words[6]), 0, 1) * 5 + clamp((T - n2.words[7]) / (n2.ends[7] - n2.words[7]), 0, 1) * 7 + clamp((T - n2.words[8]) / (n2.ends[8] - n2.words[8]), 0, 1) * 7 + clamp((T - n2.words[9]) / (n2.ends[9] - n2.words[9]), 0, 1) * 6 + clamp((T - n2.words[10]) / (n2.ends[10] - n2.words[10]), 0, 1) * 4 + clamp((T - n2.words[11]) / (n2.ends[11] - n2.words[11]), 0, 1) * 5 + clamp((T - n2.words[12]) / (n2.ends[12] - n2.words[12]), 0, 1) * 7) - 0, 0, 32) * adv), text("same recipe always gives the same", x: 0.06, y: -0.008, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - n2.words[0]) / (n2.ends[0] - n2.words[0]), 0, 1) * 3 + clamp((T - n2.words[1]) / (n2.ends[1] - n2.words[1]), 0, 1) * 5 + clamp((T - n2.words[2]) / (n2.ends[2] - n2.words[2]), 0, 1) * 8 + clamp((T - n2.words[3]) / (n2.ends[3] - n2.words[3]), 0, 1) * 9 + clamp((T - n2.words[4]) / (n2.ends[4] - n2.words[4]), 0, 1) * 4 + clamp((T - n2.words[5]) / (n2.ends[5] - n2.words[5]), 0, 1) * 4 + clamp((T - n2.words[6]) / (n2.ends[6] - n2.words[6]), 0, 1) * 5 + clamp((T - n2.words[7]) / (n2.ends[7] - n2.words[7]), 0, 1) * 7 + clamp((T - n2.words[8]) / (n2.ends[8] - n2.words[8]), 0, 1) * 7 + clamp((T - n2.words[9]) / (n2.ends[9] - n2.words[9]), 0, 1) * 6 + clamp((T - n2.words[10]) / (n2.ends[10] - n2.words[10]), 0, 1) * 4 + clamp((T - n2.words[11]) / (n2.ends[11] - n2.words[11]), 0, 1) * 5 + clamp((T - n2.words[12]) / (n2.ends[12] - n2.wor