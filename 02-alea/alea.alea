n13.words[8]), 0, 1) * 5 + clamp((T - n13.words[9]) / (n13.ends[9] - n13.words[9]), 0, 1) * 7 + clamp((T - n13.words[10]) / (n13.ends[10] - n13.words[10]), 0, 1) * 4 + clamp((T - n13.words[11]) / (n13.ends[11] - n13.words[11]), 0, 1) * 6 + clamp((T - n13.words[12]) / (n13.ends[12] - n13.words[12]), 0, 1) * 3 + clamp((T - n13.words[13]) / (n13.ends[13] - n13.words[13]), 0, 1) * 4 + clamp((T - n13.words[14]) / (n13.ends[14] - n13.words[14]), 0, 1) * 4 + clamp((T - n13.words[15]) / (n13.ends[15] - n13.words[15]), 0, 1) * 9) - 29, 0, 33) * adv), text("its own circuits.", x: 0.06, y: 0.044, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - n13.words[0]) / (n13.ends[0] - n13.words[0]), 0, 1) * 4 + clamp((T - n13.words[1]) / (n13.ends[1] - n13.words[1]), 0, 1) * 7 + clamp((T - n13.words[2]) / (n13.ends[2] - n13.words[2]), 0, 1) * 3 + clamp((T - n13.words[3]) / (n13.ends[3] - n13.words[3]), 0, 1) * 5 + clamp((T - n13.words[4]) / (n13.ends[4] - n13.words[4]), 0, 1) * 6 + clamp((T - n13.words[5]) / (n13.ends[5] - n13.words[5]), 0, 1) * 4 + clamp((T - n13.words[6]) / (n13.ends[6] - n13.words[6]), 0, 1) * 6 + clamp((T - n13.words[7]) / (n13.ends[7] - n13.words[7]), 0, 1) * 3 + clamp((T - n13.words[8]) / (n13.ends[8] - n13.words[8]), 0, 1) * 5 + clamp((T - n13.words[9]) / (n13.ends[9] - n13.words[9]), 0, 1) * 7 + clamp((T - n13.words[10]) / (n13.ends[10] - n13.words[10]), 0, 1) * 4 + clamp((T - n13.words[11]) / (n13.ends[11] - n13.words[11]), 0, 1) * 6 + clamp((T - n13.words[12]) / (n13.ends[12] - n13.words[12]), 0, 1) * 3 + clamp((T - n13.words[13]) / (n13.ends[13] - n13.words[13]), 0, 1) * 4 + clamp((T - n13.words[14]) / (n13.ends[14] - n13.words[14]), 0, 1) * 4 + clamp((T - n13.words[15]) / (n13.ends[15] - n13.words[15]), 0, 1) * 9) - 63, 0, 17) * adv)) * (T >= n13.start) * (T < min(n13.end + 1.5, n14.start))
  let c_n14 = merge(text("It stirs them into a seed that no", x: 0.06, y: -0.060, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - n14.words[0]) / (n14.ends[0] - n14.words[0]), 0, 1) * 3 + clamp((T - n14.words[1]) / (n14.ends[1] - n14.words[1]), 0, 1) * 6 + clamp((T - n14.words[2]) / (n14.ends[2] - n14.words[2]), 0, 1) * 5 + clamp((T - n14.words[3]) / (n14.ends[3] - n14.words[3]), 0, 1) * 5 + clamp((T - n14.words[4]) / (n14.ends[4] - n14.words[4]), 0, 1) * 2 + clamp((T - n14.words[5]) / (n14.ends[5] - n14.words[5]), 0, 1) * 5 + clamp((T - n14.words[6]) / (n14.ends[6] - n14.words[6]), 0, 1) * 5 + clamp((T - n14.words[7]) / (n14.ends[7] - n14.words[7]), 0, 1) * 3 + clamp((T - n14.words[8]) / (n14.ends[8] - n14.words[8]), 0, 1) * 4 + clamp((T - n14.words[9]) / (n14.ends[9] - n14.words[9]), 0, 1) * 4 + clamp((T - n14.words[10]) / (n14.ends[10] - n14.words[10]), 0, 1) * 6) - 0, 0, 33) * adv), text("one can guess.", x: 0.06, y: -0.008, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - n14.words[0]) / (n14.ends[0] - n14.words[0]), 0, 1) * 3 + clamp((T - n14.words[1]) / (n14.ends[1] - n14.words[1]), 0, 1) * 6 + clamp((T - n14.words[2]) / (n14.ends[2] - n14.words[2]), 0, 1) * 5 + clamp((T - n14.words[3]) / (n14.ends[3] - n14.words[3]), 0, 1) * 5 + clamp((T - n14.words[4]) / (n14.ends[4] - n14.words[4]), 0, 1) * 2 + clamp((T - n14.words[5]) / (n14.ends[5] - n14.words[5]), 0, 1) * 5 + clamp((T - n14.words[6]) / (n14.ends[6] - n14.words[6]), 0, 1) * 5 + clamp((T - n14.words[7]) / (n14.ends[7] - n14.words[7]), 0, 1) * 3 + clamp((T - n14.words[8]) / (n14.ends[8] - n14.words[8]), 0, 1) * 4 + clamp((T - n14.words[9]) / (n14.ends[9] - n14.words[9]), 0, 1) * 4 + clamp((T - n14.words[10]) / (n14.ends[10] - n14.words[10]), 0, 1) * 6) - 34, 0, 14) * adv)) * (T >= n14.start) * (T < min(n14.end + 1.5, m4.start))
  let c_m4 = merge(text("Then Master Foo gave the novice", x: 0.06, y: -0.060, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - m4.start) / (m4.duration * 0.92), 0, 1) * 41) - 0, 0, 31) * adv), text("the seed.", x: 0.06, y: -0.008, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - m4.start) / (m4.duration * 0.92), 0, 1) * 41) - 32, 0, 9) * adv)) * (T >= m4.start) * (T < min(m4.end + 1.5, m5.start))
  let c_m5 = text("And the novice was enlightened.", x: 0.06, y: -0.060, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - m5.start) / (m5.duration * 0.92), 0, 1) * 31) - 0, 0, 31) * adv) * (T >= m5.start) * (T < m5.end + 3)
  let said = merge(c_n1, c_n2, c_n3, c_n4, c_n5, c_n6, c_n7, c_n8, c_n9, c_n10, c_n11, c_n12, c_n13, c_n14)
  let spoken = merge(c_m1, c_m2, c_m3, c_m4, c_m5)
  let dark = paint(merge(header, series, said), palette: ["#000000", "#1a1712"], range: [0, 1], alpha: merge(header, series, said))
  let red  = paint(spoken, palette: ["#000000", "#b8361f"], range: [0, 1], alpha: spoken)
  let look = film(vignette(overlay(reel, dark, red), amount: 0.06), amount: 0.035)

  // ── the sound ──
  let pad = synth {
    let env = adsr(attack: 3, decay: 1, sustain: 0.9, release: 4)
    lowpass(saw(note.freq) + saw(note.freq * 1.003) + sine(note.freq * 0.5), cutoff: 260 + 300 * note.level, resonance: 0.2) * env
  }
  let brush = synth { bandpass(noise(), cutoff: 1400, resonance: 0.3) * adsr(attack: 0.12, decay: 0.3, sustain: 0.3, release: 0.5) * note.velocity }
  // the register's voice: a square wave, on while the bit that falls out is 1
  let chip = synth { lowpass(square(note.freq), cutoff: 3000) * 0.5 }
  // the console's noise, two bursts, the second lower
  let console = synth { lowpass(noise(), cutoff: note.freq, resonance: 0.3) * perc(attack: 0.002, release: 0.9) * note.velocity }
  let click = synth { highpass(noise(), cutoff: 4000, resonance: 0.2) * perc(release: 0.012) * note.velocity }
  // the bit falling out of the register, step by step, as a field of t
  let gnow = floor(575 * clamp((T - s0) / (s1 - s0), 0, 1) ^ 3)
  let outbit = at(move(reg, x: x - 14.5 / 15, y: y - 0.5), time: gnow / 575) * (T > s0) * (T < s1)
  // the temple bell, when the master speaks; a chime on each seven, the same
  pattern bells = repeat 2 event(t: [m1.start - 1.0, m4.start - 1.0][i] / total, x: 0.5, y: 0.95, size: 0.12, intensity: 0.9)
  pattern sevens = repeat 2 event(t: [m2.end - 0.5, m3.end - 0.5][i] / total, x: 0.5, y: 0.5, size: 0.06, intensity: 0.8)
  // the recipe, three times, and three times the same answer
  pattern knocks = repeat 3 event(t: [n2.words[7], n2.words[9], n2.words[12]][i] / total, x: 0.3, y: 0.6, intensity: 0.6)
  pattern answers = repeat 3 event(t: ([n2.words[7], n2.words[9], n2.words[12]][i] + 0.6) / total, x: 0.7, y: 0.5, size: 0.04, intensity: 0.7)
  // a click at every step, while they can still be told apart
  pattern steps = repeat 160 event(t: stepat(i + 1) / total, x: 0.4 + 0.2 * (i % 2), y: 0.5, intensity: 0.5)
  pattern noisy = repeat 2 event(t: (n6.words[4] + 1.1 * i) / total, x: 0.35 + 0.3 * i, y: 0.3 + 0.3 * i, size: 0.05, intensity: 0.9)
  // the seeds: a chime for each tape, the same twice, a stranger one for the third
  pattern tapes = repeat 3 event(t: [n8.words[7], n9.words[0], n10.words[3]][i] / total, x: 0.2 + 0.3 * i, y: [0.5, 0.5, 0.42][i], size: 0.05, intensity: 0.7)
  // the world: taps of keys, the seed's bits coming out
  pattern taps = repeat 14 event(t: (n13.words[4] + ~between(0, 2.2)) / total, x: ~between(0.2, 0.5), y: 0.5, intensity: ~between(0.3, 0.7))
  pattern seedbits_out = repeat 15 event(t: (n14.words[5] + 0.12 * i) / total, x: 0.2 + 0.04 * i, y: 0.8 - 0.04 * i, intensity: 0.5)

  let music = [
    m1, m2, m3, n1, n2, n3, n4, n5, n6, n7, n8, n9, n10, n11, n12, n13, n14, m4, m5,
    drone(0.45 + 0.15 * lfo(3) + x * 0, voices: 2, instrument: pad, scale: "hirajoshi", key: 55, gain: 0.9),
    drone(outbit, voices: 1, instrument: chip, scale: "chromatic", key: 880, gain: 0.35),
    notes(bells, instrument: "bell", scale: "hirajoshi", key: 110, gain: 0.7),
    notes(sevens, instrument: "kalimba", scale: "hirajoshi", key: 392, gain: 0.6),
    notes(knocks, instrument: "wood", scale: "hirajoshi", key: 330, gain: 0.4),
    notes(answers, instrument: "kalimba", scale: "hirajoshi", key: 392, gain: 0.5),
    notes(steps, instrument: click, gain: 0.3),
    notes(noisy, instrument: console, scale: "chromatic", key: 2400, gain: 0.5),
    notes(tapes, instrument: "glass", scale: "hirajoshi", key: 392, gain: 0.45),
    notes(taps, instrument: "tick", gain: 0.35),
    notes(seedbits_out, instrument: "kalimba", scale: "hirajoshi", key: 392, gain: 0.35),
    notes(reel.cues, instrument: brush, scale: "chromatic", key: 100, gain: 0.3),
  ]

  render image(look, width: 1080, height: 1920, at: 0.4718)
  render video(look, fps: 30, width: 1080, height: 1920, sound: music, room: 0.45, echo: 0.12)
}
