// Suivant — Thus Spoke Master Foo, AI 06: the next token. Once upon a:
// the last word's point, after all the layers, becomes a score for every
// token the machine knows; squeezed, the scores are probabilities; the
// machine picks one, adds it to the text, and starts over, one token at a
// time; which one it picks is a weighted die, shaped by the temperature
// and rolled with a seed; and the whole machine is a loop: text, tokens,
// map, layers, probabilities, die, and back into the text. The
// probabilities are illustrative; the die's temperatures are computed by
// gen.py. Master Foo speaks Japanese, translated in the captions.

use "scenes/koan.alea"
use "scenes/job.alea"
use "scenes/next.alea"
use "scenes/dice.alea"
use "scenes/loop.alea"

work Suivant {
  let total = 157.5
  let T = t * total
  let EN = "../voices/narrator.sh"
  let JA = "../voices/master.sh"

  // ── the voices: the master, in Japanese; the one who explains, in English ──
  let m1 = say("弟子は尋ねた。機械は、どうやって話すのですか。", at: 1.50, engine: JA, voice: "jm_kumo", speed: 0.82, gain: 2.3)
  let m2 = say("師は言った。むかしむかし、あるところに。次の言葉は？", at: m1.end + 1.4, engine: JA, voice: "jm_kumo", speed: 0.82, gain: 2.3)
  let m3 = say("弟子は答えた。おじいさん。", at: m2.end + 1.4, engine: JA, voice: "jm_kumo", speed: 0.82, gain: 2.3)
  let n1 = say("Last time, every word looked at every other, layer after layer. At the end, the last word's point holds the whole sentence so far.", at: 20.20, engine: EN, voice: "af_heart", speed: 1.0, gain: 2.3)
  let n2 = say("One more layer turns that point into a score for every token the machine knows. Fifty thousand scores, one per token.", at: n1.end + 1.4, engine: EN, voice: "af_heart", speed: 1.0, gain: 2.3)
  let n3 = say("The scores are squeezed so that they add up to one. Now they are probabilities: how likely each token is to come next.", at: n2.end + 1.4, engine: EN, voice: "af_heart", speed: 1.0, gain: 2.3)
  let n4 = say("Once upon a: time, sixty-two percent. midnight, eight. the, five. dragon, one. And forty-nine thousand nine hundred ninety-six others, sharing the rest.", at: n3.end + 1.4, engine: EN, voice: "af_heart", speed: 1.0, gain: 2.3)
  let n5 = say("The machine picks one, adds it to the text, and starts over. The new text goes through all the layers again.", at: 56.90, engine: EN, voice: "af_heart", speed: 1.0, gain: 2.3)
  let n6 = say("Once upon a time. It asks again, and picks: there. It asks again: was. One token at a time, each one chosen after the whole text so far.", at: n5.end + 1.4, engine: EN, voice: "af_heart", speed: 1.0, gain: 2.3)
  let n7 = say("That is all the machine does. A paragraph is a few hundred rounds. A long answer, a few thousand.", at: n6.end + 1.4, engine: EN, voice: "af_heart", speed: 1.0, gain: 2.3)
  let n8 = say("Which one does it pick? Not always the top one. It rolls a die, weighted by the probabilities.", at: 83.40, engine: EN, voice: "af_heart", speed: 1.0, gain: 2.3)
  let n9 = say("A setting called temperature shapes the die. At zero, it always takes the top token: the same text every time.", at: n8.end + 1.4, engine: EN, voice: "af_heart", speed: 1.0, gain: 2.3)
  let n10 = say("Higher, and the rare ones get their chance: dragon, sometimes. Same question, different answers. That is why the machine never says the same thing twice.", at: n9.end + 1.4, engine: EN, voice: "af_heart", speed: 1.0, gain: 2.3)
  let n11 = say("And the die is rolled with a seed, like in the episode on chance. Same seed, same rolls, same text.", at: n10.end + 1.4, engine: EN, voice: "af_heart", speed: 1.0, gain: 2.3)
  let n12 = say("Put it together. Text. Tokens. The map. The layers. Probabilities. The die. And the chosen token goes back into the text.", at: 116.70, engine: EN, voice: "af_heart", speed: 1.0, gain: 2.3)
  let n13 = say("Round and round, billions of times. That is a language model. Nothing else is inside: no dictionary, no rules, no plan. Only the next token.", at: n12.end + 1.4, engine: EN, voice: "af_heart", speed: 1.0, gain: 2.3)
  let n14 = say("Next time: where the weights come from. Training.", at: n13.end + 1.4, engine: EN, voice: "af_heart", speed: 1.0, gain: 2.3)
  let m4 = say("師は言った。それが、機械のすることのすべてだ。", at: 142.00, engine: JA, voice: "jm_kumo", speed: 0.82, gain: 2.3)
  let m5 = say("一語ずつ。何十億回も。", at: m4.end + 1.4, engine: JA, voice: "jm_kumo", speed: 0.82, gain: 2.3)
  let m6 = say("その時、弟子は悟った。", at: m5.end + 1.6, engine: JA, voice: "jm_kumo", speed: 0.82, gain: 2.3)

  // ── the candidates and their probabilities (illustrative), and the die's three temperatures (gen.py) ──
  let cand = ["time", "midnight", "the", "dragon"]
  let tprobs = [100, 0, 0, 0, 92, 5, 3, 0, 66, 17, 12, 4]
  let picks = [0, 0, 3]

  // ── the scenes: ink on paper, a vermilion accent, under the captions ──
  let PAPER = ["#efe9dc", "#d3c9b4", "#3b352c", "#17140f"]
  let fit(piece) = zoom(piece, by: 0.82, x: 0.5, y: 0.66)
  let ink(piece, accent) = overlay(paint(fit(piece), palette: PAPER, range: [0, 1]), paint(fit(accent), palette: ["#000000", "#c23b22"], range: [0, 1], alpha: fit(accent)))
  let reel = timeline([
      scene(ink(Koan(draw0: ((m1.start) - 0.00) / 18.7, draw1: ((m1.end) - 0.00) / 18.7, word: ((m3.end + 0.8) - 0.00) / 18.7, title: ((m3.end + 1.0) - 0.00) / 18.7, kana: ["ツ", "ギ"], episode: "AI 06  ·  next", accent: 0), Koan(draw0: ((m1.start) - 0.00) / 18.7, draw1: ((m1.end) - 0.00) / 18.7, word: ((m3.end + 0.8) - 0.00) / 18.7, title: ((m3.end + 1.0) - 0.00) / 18.7, kana: ["ツ", "ギ"], episode: "AI 06  ·  next", accent: 1)), 18.7),  wipe(0.8, angle: 0, softness: 0.12),
      scene(ink(Job(point0: ((n1.words[14]) - 18.70) / 36.7, layer0: ((n2.words[0]) - 18.70) / 36.7, column0: ((n2.words[8]) - 18.70) / 36.7, squeeze0: ((n3.words[3]) - 18.70) / 36.7, top: [((n4.words[3]) - 18.70) / 36.7, ((n4.words[6]) - 18.70) / 36.7, ((n4.words[8]) - 18.70) / 36.7, ((n4.words[10]) - 18.70) / 36.7], rest0: ((n4.words[12]) - 18.70) / 36.7, accent: 0), Job(point0: ((n1.words[14]) - 18.70) / 36.7, layer0: ((n2.words[0]) - 18.70) / 36.7, column0: ((n2.words[8]) - 18.70) / 36.7, squeeze0: ((n3.words[3]) - 18.70) / 36.7, top: [((n4.words[3]) - 18.70) / 36.7, ((n4.words[6]) - 18.70) / 36.7, ((n4.words[8]) - 18.70) / 36.7, ((n4.words[10]) - 18.70) / 36.7], rest0: ((n4.words[12]) - 18.70) / 36.7, accent: 1)), 36.7),  pixels(0.6, size: 0.05),
      scene(ink(Next(cand: ["time", "midnight", "the", "dragon", "there", "a", "in", "the", "was", "lived", "were", "is"], starts: [((n5.start - 1.2) - 55.40) / 26.5, ((n5.words[8]) - 55.40) / 26.5, ((n6.words[11] + 0.3) - 55.40) / 26.5], taken: [((n5.words[2]) - 55.40) / 26.5, ((n6.words[9]) - 55.40) / 26.5, ((n6.words[13]) - 55.40) / 26.5], accent: 0), Next(cand: ["time", "midnight", "the", "dragon", "there", "a", "in", "the", "was", "lived", "were", "is"], starts: [((n5.start - 1.2) - 55.40) / 26.5, ((n5.words[8]) - 55.40) / 26.5, ((n6.words[11] + 0.3) - 55.40) / 26.5], taken: [((n5.words[2]) - 55.40) / 26.5, ((n6.words[9]) - 55.40) / 26.5, ((n6.words[13]) - 55.40) / 26.5], accent: 1)), 26.5),  wipe(0.7, angle: 90, softness: 0.1),
      scene(ink(Dice(cand: cand, probs: tprobs, picks: picks, at: [((n9.words[7]) - 81.90) / 33.3, ((n8.words[11]) - 81.90) / 33.3, ((n10.words[0]) - 81.90) / 33.3], accent: 0), Dice(cand: cand, probs: tprobs, picks: picks, at: [((n9.words[7]) - 81.90) / 33.3, ((n8.words[11]) - 81.90) / 33.3, ((n10.words[0]) - 81.90) / 33.3], accent: 1)), 33.3),  morph(0.8, amount: 0.15),
      scene(ink(Loop(when: [((n12.words[3]) - 115.20) / 25.3, ((n12.words[4]) - 115.20) / 25.3, ((n12.words[6]) - 115.20) / 25.3, ((n12.words[8]) - 115.20) / 25.3, ((n12.words[9]) - 115.20) / 25.3, ((n12.words[11]) - 115.20) / 25.3], back0: ((n12.words[12]) - 115.20) / 25.3, round0: ((n13.words[0]) - 115.20) / 25.3, accent: 0), Loop(when: [((n12.words[3]) - 115.20) / 25.3, ((n12.words[4]) - 115.20) / 25.3, ((n12.words[6]) - 115.20) / 25.3, ((n12.words[8]) - 115.20) / 25.3, ((n12.words[9]) - 115.20) / 25.3, ((n12.words[11]) - 115.20) / 25.3], back0: ((n12.words[12]) - 115.20) / 25.3, round0: ((n13.words[0]) - 115.20) / 25.3, accent: 1)), 25.3),  wipe(0.8, angle: 180, softness: 0.12),
      scene(ink(Koan(draw0: ((m4.start) - 140.50) / 17.0, draw1: ((m6.end) - 140.50) / 17.0, word: ((m6.start + 0.5) - 140.50) / 17.0, title: ((m6.end + 0.6) - 140.50) / 17.0, kana: ["ツ", "ギ"], episode: "AI 06  ·  next", accent: 0), Koan(draw0: ((m4.start) - 140.50) / 17.0, draw1: ((m6.end) - 140.50) / 17.0, word: ((m6.start + 0.5) - 140.50) / 17.0, title: ((m6.end + 0.6) - 140.50) / 17.0, kana: ["ツ", "ギ"], episode: "AI 06  ·  next", accent: 1)), 17.0),  morph(1.2, amount: 0.2),
  ], loop: 1)

  // ── over it: the series, the step, the captions (the master's, translated, in vermilion) ──
  let adv = 0.021722
  let header = merge(text("1 / 4   the job", x: 0.06, y: -0.15, size: 0.03, font: "mono", align: "left") * (reel.index > 1 - 0.5) * (reel.index < 1 + 0.5), text("2 / 4   the pick", x: 0.06, y: -0.15, size: 0.03, font: "mono", align: "left") * (reel.index > 2 - 0.5) * (reel.index < 2 + 0.5), text("3 / 4   the die", x: 0.06, y: -0.15, size: 0.03, font: "mono", align: "left") * (reel.index > 3 - 0.5) * (reel.index < 3 + 0.5), text("4 / 4   the loop", x: 0.06, y: -0.15, size: 0.03, font: "mono", align: "left") * (reel.index > 4 - 0.5) * (reel.index < 4 + 0.5)) * 0.7
  let series = text("thus spoke master foo  ·  AI 06", x: 0.94, y: -0.3, size: 0.024, font: "mono", align: "right") * 0.45
  let c_m1 = merge(text("The novice asked: how does the", x: 0.06, y: -0.060, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - m1.start) / (m1.duration * 0.92), 0, 1) * 45) - 0, 0, 30) * adv), text("machine speak?", x: 0.06, y: -0.008, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - m1.start) / (m1.duration * 0.92), 0, 1) * 45) - 31, 0, 14) * adv)) * (T >= m1.start) * (T < min(m1.end + 1.5, m2.start))
  let c_m2 = merge(text("Master Foo said: once upon a", x: 0.06, y: -0.060, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - m2.start) / (m2.duration * 0.92), 0, 1) * 69) - 0, 0, 28) * adv), text("time, in a certain place. The", x: 0.06, y: -0.008, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - m2.start) / (m2.duration * 0.92), 0, 1) * 69) - 29, 0, 29) * adv), text("next word?", x: 0.06, y: 0.044, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - m2.start) / (m2.duration * 0.92), 0, 1) * 69) - 59, 0, 10) * adv)) * (T >= m2.start) * (T < min(m2.end + 1.5, m3.start))
  let c_m3 = text("The novice answered: an old man.", x: 0.06, y: -0.060, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - m3.start) / (m3.duration * 0.92), 0, 1) * 32) - 0, 0, 32) * adv) * (T >= m3.start) * (T < min(m3.end + 1.5, n1.start))
