  let c_n14 = merge(text("Next time: where the weights come", x: 0.06, y: -0.060, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - n14.words[0]) / (n14.ends[0] - n14.words[0]), 0, 1) * 5 + clamp((T - n14.words[1]) / (n14.ends[1] - n14.words[1]), 0, 1) * 6 + clamp((T - n14.words[2]) / (n14.ends[2] - n14.words[2]), 0, 1) * 6 + clamp((T - n14.words[3]) / (n14.ends[3] - n14.words[3]), 0, 1) * 4 + clamp((T - n14.words[4]) / (n14.ends[4] - n14.words[4]), 0, 1) * 8 + clamp((T - n14.words[5]) / (n14.ends[5] - n14.words[5]), 0, 1) * 5 + clamp((T - n14.words[6]) / (n14.ends[6] - n14.words[6]), 0, 1) * 6 + clamp((T - n14.words[7]) / (n14.ends[7] - n14.words[7]), 0, 1) * 9) - 0, 0, 33) * adv), text("from. Training.", x: 0.06, y: -0.008, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - n14.words[0]) / (n14.ends[0] - n14.words[0]), 0, 1) * 5 + clamp((T - n14.words[1]) / (n14.ends[1] - n14.words[1]), 0, 1) * 6 + clamp((T - n14.words[2]) / (n14.ends[2] - n14.words[2]), 0, 1) * 6 + clamp((T - n14.words[3]) / (n14.ends[3] - n14.words[3]), 0, 1) * 4 + clamp((T - n14.words[4]) / (n14.ends[4] - n14.words[4]), 0, 1) * 8 + clamp((T - n14.words[5]) / (n14.ends[5] - n14.words[5]), 0, 1) * 5 + clamp((T - n14.words[6]) / (n14.ends[6] - n14.words[6]), 0, 1) * 6 + clamp((T - n14.words[7]) / (n14.ends[7] - n14.words[7]), 0, 1) * 9) - 34, 0, 15) * adv)) * (T >= n14.start) * (T < min(n14.end + 1.5, m4.start))
  let c_m4 = merge(text("Master Foo said: that is all the", x: 0.06, y: -0.060, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - m4.start) / (m4.duration * 0.92), 0, 1) * 46) - 0, 0, 32) * adv), text("machine does.", x: 0.06, y: -0.008, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - m4.start) / (m4.duration * 0.92), 0, 1) * 46) - 33, 0, 13) * adv)) * (T >= m4.start) * (T < min(m4.end + 1.5, m5.start))
  let c_m5 = merge(text("1 word at a time. Billions of", x: 0.06, y: -0.060, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - m5.start) / (m5.duration * 0.92), 0, 1) * 36) - 0, 0, 29) * adv), text("times.", x: 0.06, y: -0.008, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - m5.start) / (m5.duration * 0.92), 0, 1) * 36) - 30, 0, 6) * adv)) * (T >= m5.start) * (T < min(m5.end + 1.5, m6.start))
  let c_m6 = text("And the novice was enlightened.", x: 0.06, y: -0.060, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - m6.start) / (m6.duration * 0.92), 0, 1) * 31) - 0, 0, 31) * adv) * (T >= m6.start) * (T < m6.end + 3)
  let said = merge(c_n1, c_n2, c_n3, c_n4, c_n5, c_n6, c_n7, c_n8, c_n9, c_n10, c_n11, c_n12, c_n13, c_n14)
  let spoken = merge(c_m1, c_m2, c_m3, c_m4, c_m5, c_m6)
  let dark = paint(merge(header, series, said), palette: ["#000000", "#1a1712"], range: [0, 1], alpha: merge(header, series, said))
  let red  = paint(spoken, palette: ["#000000", "#b8361f"], range: [0, 1], alpha: spoken)
  let look = film(vignette(overlay(reel, dark, red), amount: 0.06), amount: 0.035)

  // ── the sound ──
  let pad = synth {
    let env = adsr(attack: 3, decay: 1, sustain: 0.9, release: 4)
    lowpass(saw(note.freq) + saw(note.freq * 1.003) + sine(note.freq * 0.5), cutoff: 260 + 300 * note.level, resonance: 0.2) * env
  }
  let brush = synth { bandpass(noise(), cutoff: 1400, resonance: 0.3) * adsr(attack: 0.12, decay: 0.3, sustain: 0.3, release: 0.5) * note.velocity }
  let tick = synth { highpass(noise(), cutoff: 4000, resonance: 0.2) * perc(release: 0.015) * note.velocity + sine(note.freq) * perc(release: 0.05) * 0.4 }
  let knock = synth { lowpass(noise(), cutoff: 700, resonance: 0.5) * perc(attack: 0.002, release: 0.12) * note.velocity + sine(note.freq) * perc(release: 0.1) * 0.5 }
  let chord = synth {
    let env = adsr(attack: 0.3, decay: 0.6, sustain: 0.8, release: 2.5)
    chorus(lowpass(saw(note.freq) + saw(note.freq * 1.004) + sine(note.freq * 0.5), cutoff: 1200, resonance: 0.15) * env, depth: 0.6)
  }
  // the temple bell when the master speaks; the question
  pattern bells = repeat 2 event(t: [m1.start - 1.0, m4.start - 1.0][i] / total, x: 0.5, y: 0.95, size: 0.12, intensity: 0.9)
  pattern asked = repeat 1 event(t: (m2.start + 0.85 * m2.duration) / total, x: 0.5, y: 0.5, size: 0.06, intensity: 0.8)
  // the point; the column pouring; the four bars, and the rest
  pattern point = repeat 1 event(t: n1.words[14] / total, x: 0.16, y: 0.5, size: 0.05, intensity: 0.7)
  pattern pour = repeat 24 event(t: (n2.words[8] + 0.06 * 36.7 * (i / 24)) / total, x: 0.72, y: 0.3 + 0.4 * i / 24, intensity: 0.3)
  pattern four = repeat 4 event(t: [n4.words[3], n4.words[6], n4.words[8], n4.words[10]][i] / total, x: 0.5, y: 0.98 + 0.08 * i, size: 0.03 + 0.1 * [0.62, 0.08, 0.05, 0.01][i], intensity: 0.3 + 0.6 * [0.62, 0.08, 0.05, 0.01][i])
  // the three picks
  pattern picked = repeat 3 event(t: [n5.words[2], n6.words[9], n6.words[13]][i] / total, x: 0.5, y: 0.3, size: 0.06, intensity: 0.8)
  // the die landing, three times
  pattern lands = repeat 3 event(t: ([n9.words[7], n8.words[11], n10.words[0]][i] + 0.17 * 33.3) / total, x: 0.84, y: 0.35 + 0.3 * i, size: 0.05, intensity: 0.7)
  // the six stations, then the light going round
  pattern stations = repeat 6 event(t: [n12.words[3], n12.words[4], n12.words[6], n12.words[8], n12.words[9], n12.words[11]][i] / total, x: 0.5 + 0.3 * cos(-tau / 4 + tau * i / 6), y: 0.78 + 0.3 * sin(-tau / 4 + tau * i / 6), size: 0.05, intensity: 0.6)
  pattern round = repeat 12 event(t: (n13.words[0] + 25.3 * 0.45 * ((i / 12) ^ (1 / 1.5))) / total, x: 0.5 + 0.3 * cos(-tau / 4 + tau * 2.2 * i / 12), y: 0.78 + 0.3 * sin(-tau / 4 + tau * 2.2 * i / 12), intensity: 0.35)

  let music = [
    m1, m2, m3, n1, n2, n3, n4, n5, n6, n7, n8, n9, n10, n11, n12, n13, n14, m4, m5, m6,
    drone(0.45 + 0.15 * lfo(3) + x * 0, voices: 2, instrument: pad, scale: "hirajoshi", key: 55, gain: 0.9),
    notes(bells, instrument: "bell", scale: "hirajoshi", key: 110, gain: 0.7),
    notes(asked, instrument: "kalimba", scale: "hirajoshi", key: 392, gain: 0.6),
    notes(point, instrument: "glass", scale: "hirajoshi", key: 523, gain: 0.5),
    notes(pour, instrument: tick, scale: "hirajoshi", key: 880, gain: 0.3),
    notes(four, instrument: "kalimba", scale: "hirajoshi", key: 392, gain: 0.5),
    notes(picked, instrument: chord, scale: "major", key: 110, gain: 0.4),
    notes(lands, instrument: knock, scale: "hirajoshi", key: 220, gain: 0.6),
    notes(stations, instrument: "wood", scale: "hirajoshi", key: 330, gain: 0.45),
    notes(round, instrument: tick, scale: "hirajoshi", key: 660, gain: 0.3),
    notes(reel.cues, instrument: brush, scale: "chromatic", key: 100, gain: 0.3),
  ]

  render image(look, width: 1080, height: 1920, at: 0.6786)
  render video(look, fps: 30, width: 1080, height: 1920, sound: music, room: 0.12, echo: 0)
}
