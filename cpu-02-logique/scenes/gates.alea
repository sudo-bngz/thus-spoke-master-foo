// Gates — the three questions: AND, OR, NOT, each a box with inputs on
// the left (squares, filled for 1) and a lamp on the right, the answer
// computed from the inputs; each gate runs through its cases in its own
// window (`at`, `cycle` long). `accent: 1` gives only the lamps. Times
// are the scene's own (0 to 1). What it returns: 0 paper, up to 1 ink.

work Gates(at = [0.1, 0.4, 0.7], cycle = 0.2, accent = 0) {
  let names = ["AND", "OR", "NOT"]
  let gy(g) = 0.36 + 0.3 * g
  let shown(g) = smoothstep(at[g], at[g] + 0.05, t)
  let u(g) = clamp((t - at[g] - 0.05) / cycle, 0, 0.999)
  let step(g) = floor(u(g) * 4) * (t > at[g] + 0.05)
  let a(g) = floor(step(g) / 2)
  let b(g) = step(g) % 2
  let answer(g) = (g == 0) * a(g) * b(g) + (g == 1) * clamp(a(g) + b(g), 0, 1) + (g == 2) * (1 - b(g))
  let box(g) = merge(cut(rect(0.5, gy(g), 0.2, 0.14, 0, 0.002), rect(0.5, gy(g), 0.194, 0.134, 0, 0.002)) * 0.6, text(names[g], 0.5, gy(g), 0.036, 0, "mono") * 0.9) * shown(g)
  let insq(cx, cy, v) = merge(cut(rect(cx, cy, 0.05, 0.05, 0, 0.002), rect(cx, cy, 0.044, 0.044, 0, 0.002)) * 0.6, rect(cx, cy, 0.036, 0.036, 0, 0.002) * 0.8 * v)
  let two(g) = (g < 2)
  let ins(g) = merge(insq(0.22, gy(g) - 0.04, a(g)) * two(g), insq(0.22, gy(g) + 0.04 * two(g), b(g)),
                     line(0.245, gy(g) - 0.04, 0.4, gy(g) - 0.04, 0.004, 0.002) * 0.5 * two(g), line(0.245, gy(g) + 0.04 * two(g), 0.4, gy(g) + 0.04 * two(g), 0.004, 0.002) * 0.5) * shown(g)
  let outwire(g) = line(0.6, gy(g), 0.72, gy(g), 0.004, 0.002) * 0.5 * shown(g)
  let lamp(g) = cut(circle(0.78, gy(g), 0.04, 0.002), circle(0.78, gy(g), 0.034, 0.002)) * 0.7 * shown(g)
  let lit(g) = glow(x: 0.78, y: gy(g), size: 0.1) * answer(g) * (t > at[g] + 0.05)
  let labels = ["both on?", "at least 1 on?", "the opposite"]
  let label(g) = text(labels[g], 0.5, gy(g) + 0.11, 0.024, 0, "mono") * 0.55 * smoothstep(at[g] + 0.06, at[g] + 0.1, t)
  let gate = text("a gate: a small circuit that answers 1 question", 0.5, 1.3, 0.026, 0, "mono") * 0.6 * smoothstep(at[2] + 0.12, at[2] + 0.16, t)
  output accent * merge([lit(g) for g in range(3)]) + (1 - accent) * merge(merge([merge(box(g), ins(g), outwire(g), lamp(g), label(g)) for g in range(3)]), gate)
}
