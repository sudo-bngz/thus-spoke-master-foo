      scene(ink(Koan(draw0: ((m4.start) - 137.00) / 18.2, draw1: ((m6.end) - 137.00) / 18.2, word: ((m6.start + 0.5) - 137.00) / 18.2, title: ((m6.end + 0.6) - 137.00) / 18.2, kana: ["ロ", "ン", "リ"], episode: "CPU 02  ·  logic", accent: 0), Koan(draw0: ((m4.start) - 137.00) / 18.2, draw1: ((m6.end) - 137.00) / 18.2, word: ((m6.start + 0.5) - 137.00) / 18.2, title: ((m6.end + 0.6) - 137.00) / 18.2, kana: ["ロ", "ン", "リ"], episode: "CPU 02  ·  logic", accent: 1)), 18.2),  morph(1.2, amount: 0.2),
  ], loop: 1)

  // ── over it: the series, the step, the captions (the master's, translated, in vermilion) ──
  let adv = 0.021722
  let header = merge(text("1 / 4   three questions", x: 0.06, y: -0.15, size: 0.03, font: "mono", align: "left") * (reel.index > 1 - 0.5) * (reel.index < 1 + 0.5), text("2 / 4   the table", x: 0.06, y: -0.15, size: 0.03, font: "mono", align: "left") * (reel.index > 2 - 0.5) * (reel.index < 2 + 0.5), text("3 / 4   building", x: 0.06, y: -0.15, size: 0.03, font: "mono", align: "left") * (reel.index > 3 - 0.5) * (reel.index < 3 + 0.5), text("4 / 4   anything", x: 0.06, y: -0.15, size: 0.03, font: "mono", align: "left") * (reel.index > 4 - 0.5) * (reel.index < 4 + 0.5)) * 0.7
  let series = text("thus spoke master foo  ·  CPU 02", x: 0.94, y: -0.3, size: 0.024, font: "mono", align: "right") * 0.45
  let c_m1 = merge(text("The novice asked: what can you", x: 0.06, y: -0.060, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - m1.start) / (m1.duration * 0.92), 0, 1) * 44) - 0, 0, 30) * adv), text("ask a switch?", x: 0.06, y: -0.008, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - m1.start) / (m1.duration * 0.92), 0, 1) * 44) - 31, 0, 13) * adv)) * (T >= m1.start) * (T < min(m1.end + 1.5, m2.start))
  let c_m2 = merge(text("Master Foo said: both? Either? Or", x: 0.06, y: -0.060, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - m2.start) / (m2.duration * 0.92), 0, 1) * 47) - 0, 0, 33) * adv), text("the opposite?", x: 0.06, y: -0.008, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - m2.start) / (m2.duration * 0.92), 0, 1) * 47) - 34, 0, 13) * adv)) * (T >= m2.start) * (T < min(m2.end + 1.5, m3.start))
  let c_m3 = merge(text("The novice said: only that?", x: 0.06, y: -0.060, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - m3.start) / (m3.duration * 0.92), 0, 1) * 71) - 0, 0, 27) * adv), text("Master Foo said: only that, and", x: 0.06, y: -0.008, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - m3.start) / (m3.duration * 0.92), 0, 1) * 71) - 28, 0, 31) * adv), text("everything.", x: 0.06, y: 0.044, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - m3.start) / (m3.duration * 0.92), 0, 1) * 71) - 60, 0, 11) * adv)) * (T >= m3.start) * (T < min(m3.end + 1.5, n1.start))
  let c_n1 = merge(text("A switch answers 1 question: is", x: 0.06, y: -0.060, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - n1.start) / (n1.duration * 0.92), 0, 1) * 114) - 0, 0, 31) * adv), text("it on? George Boole, 1854, asked", x: 0.06, y: -0.008, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - n1.start) / (n1.duration * 0.92), 0, 1) * 114) - 32, 0, 32) * adv), text("what can be done with yes and no", x: 0.06, y: 0.044, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - n1.start) / (n1.duration * 0.92), 0, 1) * 114) - 65, 0, 32) * adv), text("alone. 3 things.", x: 0.06, y: 0.096, size: 0.042, font: "mono", align: "left") * (x < 0.06 + clamp((clamp((T - n1.start) / (n1.duration * 0.92), 0, 1) * 114) - 98, 0, 16) * adv)) * (T >= n1.start) * (T < min(n1.end + 1.5, n2.start))
