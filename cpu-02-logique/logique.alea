// Logique — Thus Spoke Master Foo, CPU 02: what you can ask a switch.
// Boole's 3 questions, AND, OR, NOT, each a gate with inputs and a lamp,
// the answers computed; the truth table, 4 cases and nothing hidden;
// exclusive or built from 4 gates, the 4 cases flowing through the
// wires, the answer computed from the gates; and the big idea: any table
// can be built from gates. Master Foo speaks Japanese, translated in the
// captions.

use "scenes/koan.alea"
use "scenes/gates.alea"
use "scenes/table.alea"
use "scenes/xor.alea"
use "scenes/any.alea"

work Logique {
  let total = 155.2
  let T = t * total
  let EN = "../voices/narrator.sh"
  let JA = "../voices/master.sh"

  // ── the voices: the master, in Japanese; the one who explains, in English ──
  let m1 = say("弟子は尋ねた。スイッチに、何を聞けるのですか。", at: 1.50, engine: JA, voice: "jm_kumo", speed: 0.82, gain: 2.3)
  let m2 = say("師は言った。両方か。どちらかか。それとも、逆か。", at: m1.end + 1.4, engine: JA, voice: "jm_kumo", speed: 0.82, gain: 2.3)
  let m3 = say("弟子は言った。それだけ？ 師は言った。それだけで、すべてだ。", at: m2.end + 1.4, engine: JA, voice: "jm_kumo", speed: 0.82, gain: 2.3)
  let n1 = say("A switch answers one question: is it on? George Boole, eighteen fifty-four, asked what can be done with yes and no alone. Three things.", at: 22.60, engine: EN, voice: "af_heart", speed: 1.0, gain: 2.3)
  let n2 = say("AND: are both on? Yes, only if the first is on and the second is on.", at: n1.end + 1.4, engine: EN, voice: "af_heart", speed: 1.0, gain: 2.3)
  let n3 = say("OR: is at least one on? Yes if either is on, or both.", at: n2.end + 1.4, engine: EN, voice: "af_heart", speed: 1.0, gain: 2.3)
  let n4 = say("NOT: the opposite. On becomes off, off becomes on. A gate is a small circuit that answers one of these questions.", at: n3.end + 1.4, engine: EN, voice: "af_heart", speed: 1.0, gain: 2.3)
  let n5 = say("Two inputs, each zero or one: four cases, no more. Write the answer for each. That is a truth table.", at: 51.90, engine: EN, voice: "af_heart", speed: 1.0, gain: 2.3)
  let n6 = say("AND. Zero and zero: zero. Zero and one: zero. One and zero: zero. One and one: one. Four lines, and the gate is completely described.", at: n5.end + 1.4, engine: EN, voice: "af_heart", speed: 1.0, gain: 2.3)
  let n7 = say("Nothing is hidden. Whatever the gate does, it does one of these four things. A table is the whole truth.", at: n6.end + 1.4, engine: EN, voice: "af_heart", speed: 1.0, gain: 2.3)
  let n8 = say("Gates can be wired together: the answer of one is the question of the next. Let us build one that no single gate gives: exclusive or, on if exactly one input is on.", at: 78.60, engine: EN, voice: "af_heart", speed: 1.0, gain: 2.3)
  let n9 = say("Four gates. An OR: at least one. An AND then a NOT: not both. And an AND on their two answers: at least one, and not both.", at: n8.end + 1.4, engine: EN, voice: "af_heart", speed: 1.0, gain: 2.3)
  let n10 = say("Watch the four cases flow through. Zero zero: off. Zero one: on. One zero: on. One one: off. The line that no neuron could draw, in the first AI episode, is four gates.", at: n9.end + 1.4, engine: EN, voice: "af_heart", speed: 1.0, gain: 2.3)
  let n11 = say("Here is the big idea. Any truth table at all, any number of inputs, any answers you choose, can be built from these gates.", at: 111.80, engine: EN, voice: "af_heart", speed: 1.0, gain: 2.3)
  let n12 = say("A comparison, an addition, a decision in a program: all of them are tables, and all tables are gates. Billions of gates, and the only question each one answers is: are both on?", at: n11.end + 1.4, engine: EN, voice: "af_heart", speed: 1.0, gain: 2.3)
  let n13 = say("Next time: the first thing worth building. Adding.", at: n12.end + 1.4, engine: EN, voice: "af_heart", speed: 1.0, gain: 2.3)
  let m4 = say("師は言った。問いは3つ。答えは、はいか、いいえ。", at: 138.50, engine: JA, voice: "jm_kumo", speed: 0.82, gain: 2.3)
  let m5 = say("それを何十億も重ねれば、機械が考える。", at: m4.end + 1.4, engine: JA, voice: "jm_kumo", speed: 0.82, gain: 2.3)
  let m6 = say("その時、弟子は悟った。", at: m5.end + 1.6, engine: JA, voice: "jm_kumo", speed: 0.82, gain: 2.3)

  // ── the scenes: ink on paper, a vermilion accent, under the captions ──
  let PAPER = ["#efe9dc", "#d3c9b4", "#3b352c", "#17140f"]
  let fit(piece) = zoom(piece, by: 0.82, x: 0.5, y: 0.66)
  let ink(piece, accent) = overlay(paint(fit(piece), palette: PAPER, range: [0, 1]), paint(fit(accent), palette: ["#000000", "#c23b22"], range: [0, 1], alpha: fit(accent)))
  let reel = timeline([
      scene(ink(Koan(draw0: ((m1.start) - 0.00) / 21.1, draw1: ((m1.end) - 0.00) / 21.1, word: ((m3.end + 0.8) - 0.00) / 21.1, title: ((m3.end + 1.0) - 0.00) / 21.1, kana: ["ロ", "ン", "リ"], episode: "CPU 02  ·  logic", accent: 0), Koan(draw0: ((m1.start) - 0.00) / 21.1, draw1: ((m1.end) - 0.00) / 21.1, word: ((m3.end + 0.8) - 0.00) / 21.1, title: ((m3.end + 1.0) - 0.00) / 21.1, kana: ["ロ", "ン", "リ"], episode: "CPU 02  ·  logic", accent: 1)), 21.1),  wipe(0.8, angle: 0, softness: 0.12),
      scene(ink(Gates(at: [((n2.words[0]) - 21.10) / 29.3, ((n3.words[0]) - 21.10) / 29.3, ((n4.words[0]) - 21.10) / 29.3], cycle: 0.2048, accent: 0), Gates(at: [((n2.words[0]) - 21.10) / 29.3, ((n3.words[0]) - 21.10) / 29.3, ((n4.words[0]) - 21.10) / 29.3], cycle: 0.2048, accent: 1)), 29.3),  pixels(0.6, size: 0.05),
      scene(ink(Table(head0: ((n5.words[0]) - 50.40) / 26.7, rows: [((n6.words[1]) - 50.40) / 26.7, ((n6.words[5]) - 50.40) / 26.7, ((n6.words[9]) - 50.40) / 26.7, ((n6.words[13]) - 50.40) / 26.7], whole0: ((n6.words[17]) - 50.40) / 26.7, accent: 0), Table(head0: ((n5.words[0]) - 50.40) / 26.7, rows: [((n6.words[1]) - 50.40) / 26.7, ((n6.words[5]) - 50.40) / 26.7, ((n6.words[9]) - 50.40) / 26.7, ((n6.words[13]) - 50.40) / 26.7], whole0: ((n6.words[17]) - 50.40) / 26.7, accent: 1)), 26.7),  wipe(0.7, angle: 90, softness: 0.1),
      scene(ink(Xor(draw0: ((n8.words[0]) - 77.10) / 33.2, cases: [((n10.words[5]) - 77.10) / 33.2, ((n10.words[8]) - 77.10) / 33.2, ((n10.words[11]) - 77.10) / 33.2, ((n10.words[14]) - 77.10) / 33.2], hold: 0.0723, neuron0: ((n10.words[17]) - 77.10) / 33.2, accent: 0), Xor(draw0: ((n8.words[0]) - 77.10) / 33.2, cases: [((n10.words[5]) - 77.10) / 33.2, ((n10.words[8]) - 77.10) / 33.2, ((n10.words[11]) - 77.10) / 33.2, ((n10.words[14]) - 77.10) / 33.2], hold: 0.0723, neuron0: ((n10.words[17]) - 77.10) / 33.2, accent: 1)), 33.2),  morph(0.8, amount: 0.15),
